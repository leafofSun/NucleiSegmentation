def _as_1d_int_list(x):
    """Convert tensor/list/tuple/scalar to a flat Python int list."""
    if x is None:
        return []
    if isinstance(x, torch.Tensor):
        if x.numel() == 0:
            return []
        return [int(v) for v in x.detach().cpu().view(-1).tolist()]
    if isinstance(x, (list, tuple)):
        out = []
        for v in x:
            if isinstance(v, torch.Tensor):
                out.extend(_as_1d_int_list(v))
            elif isinstance(v, (list, tuple)):
                out.extend(_as_1d_int_list(v))
            elif v is not None:
                out.append(int(v))
        return out
    return [int(x)]

    
