# Structure & Boundary Attribute Heads (GT-derived pathology attributes)
# ---------------------------------------------------------------------------
STRUCTURE_ATTR_NAMES = (
    "nuclear_density",
    "nuclear_area_fraction",
    "mean_nuclear_size",
    "nuclear_size_heterogeneity",
    "spatial_crowding",
)

BOUNDARY_ATTR_NAMES = (
    "boundary_density",
    "nuclear_irregularity",
    "nuclear_elongation",
    "small_nuclei_ratio",
)

STRUCTURE_ATTR_NCLASS = 5 * 3  # 5 attrs, 3 classes each (0=low,1=mid,2=high)
BOUNDARY_ATTR_NCLASS = 4 * 3   # 4 attrs, 3 classes each

NUM_STRUCTURE_ATTRS = 5
NUM_BOUNDARY_ATTRS = 4


class StructureBoundaryAttrHeads(nn.Module):
    """
    轻量级 structure / boundary attribute 分类头。

    输入：image_embeddings [B, C, H, W] (SAM ViT 输出)
    流程：GAP → [B, C] → 两个独立 Linear head
    输出：
        structure_attr_logits: [B, 5, 3]
        boundary_attr_logits:  [B, 4, 3]

    这是最小侵入方案：不改 mask_decoder，不改 low/high path，不改 gate bias，不改 zero-init。
    """

    def __init__(self, embed_dim: int = 256):
        super().__init__()
        self.embed_dim = int(embed_dim)

        # 5 structure attrs × 3 classes
        self.structure_head = nn.Linear(embed_dim, STRUCTURE_ATTR_NCLASS)
        # 4 boundary attrs × 3 classes
        self.boundary_head = nn.Linear(embed_dim, BOUNDARY_ATTR_NCLASS)

        # 轻量初始化
        nn.init.normal_(self.structure_head.weight, std=0.02)
        nn.init.zeros_(self.structure_head.bias)
        nn.init.normal_(self.boundary_head.weight, std=0.02)
        nn.init.zeros_(self.boundary_head.bias)

    def forward(
        self, image_embeddings: torch.Tensor, return_features: bool = False
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        # image_embeddings: [B, C, H, W] → GAP → [B, C]
        pooled = image_embeddings.mean(dim=[2, 3])  # [B, C]

        struct_logits = self.structure_head(pooled)  # [B, 15]
        bound_logits = self.boundary_head(pooled)     # [B, 12]

        struct_logits = struct_logits.view(-1, NUM_STRUCTURE_ATTRS, 3)  # [B, 5, 3]
        bound_logits = bound_logits.view(-1, NUM_BOUNDARY_ATTRS, 3)    # [B, 4, 3]

        if return_features:
            # Return pooled GAP features as pre-logit hidden features
            # These are the intermediate features before the structure/boundary linear heads
            return struct_logits, bound_logits, pooled  # pooled: [B, C]
        return struct_logits, bound_logits


# ---------------------------------------------------------------------------
# DenseBoundaryHead — 密集边界属性头 (Phase B)
# ---------------------------------------------------------------------------
# 输入: image_embeddings [B, 256, 64, 64]
# 输出: 4张密集边界图 [B, 1, 64, 64]:
#   boundary_map, touching_region, small_nuclei, hv_gradient
# 损失: BCE + Dice
# 指标: per-pixel F1


class DenseBoundaryHead(nn.Module):
    """
    密集边界属性头：4个并行卷积头，从 image_embeddings 预测密集边界图。
    与 StructureBoundaryAttrHeads 不同，这是 pixel-level 输出，不是 image-level 分类。
    """

    DENSE_BOUNDARY_NAMES: Tuple[str, ...] = (
        "boundary_map",
        "touching_region",
        "small_nuclei",
        "hv_gradient",
    )
    NUM_DENSE_BOUNDARY_MAPS: int = 4

    def __init__(self, embed_dim: int = 256):
        super().__init__()
        self.embed_dim = int(embed_dim)

        self.heads = nn.ModuleDict()
        for name in self.DENSE_BOUNDARY_NAMES:
            self.heads[name] = nn.Sequential(
                nn.Conv2d(embed_dim, embed_dim // 2, kernel_size=3, padding=1),
                nn.GELU(),
                nn.Conv2d(embed_dim // 2, embed_dim // 4, kernel_size=3, padding=1),
                nn.GELU(),
                nn.Conv2d(embed_dim // 4, 1, kernel_size=1),
            )
            # 轻量初始化
            for m in self.heads[name]:
                if isinstance(m, nn.Conv2d):
                    nn.init.kaiming_normal_(m.weight, mode="fan_out", nonlinearity="relu")
                    if m.bias is not None:
                        nn.init.zeros_(m.bias)

    def forward(self, image_embeddings: torch.Tensor) -> Dict[str, torch.Tensor]:
        # image_embeddings: [B, C, H, W]
        outputs: Dict[str, torch.Tensor] = {}
        for name in self.DENSE_BOUNDARY_NAMES:
            outputs[name] = self.heads[name](image_embeddings)  # [B, 1, H, W]
        return outputs


# ---------------------------------------------------------------------------
# InstanceMorphologyHead — 实例级形态属性头 (Phase B)
# ---------------------------------------------------------------------------
# 输入:
#   image_embeddings [B, 256, 64, 64]
#   label_inst [B, 1, H, W] (GT instance mask)
# 流程:
#   1. Resize label_inst → [B, 64, 64]
#   2. 对每个实例: masked_avg_pool(image_embeddings) → instance_feat [256]
#   3. MLP(256→128→18) → per-instance logits [N_inst, 6, 3]
#   4. Max-pool across instances → [B, 6, 3]
# 输出: [B, 6, 3]   (6 instance attributes: size, elongation, boundary_irregularity,
#                     local_crowding, roundness, solidity)


class InstanceMorphologyHead(nn.Module):
    """
    实例级形态属性头。对每个实例做 masked average pooling，
    然后用 MLP 预测 6 个 per-instance 形态属性。

    **输出格式** (v3 — per-instance, 带 kept_indices 对齐):
        Dict[str, Any] with keys:
            - "logits": List[Tensor[N_kept_i, 6, 3]] — per-instance logits for each image
            - "batch_splits": List[int] — cumulative instance counts, length B+1
            - "kept_indices": List[Tensor[N_kept_i]] — 每张图保留的原始 instance 索引
            - "raw_counts": List[int] — 每张图原始 instance 数量
            - "drop_info": List[Dict] — 每张图 drop 详情
    """

    INSTANCE_ATTR_NAMES: Tuple[str, ...] = (
        "size",
        "elongation",
        "boundary_irregularity",
        "local_crowding",
        "roundness",
        "solidity",
    )
    NUM_INSTANCE_ATTRS: int = 6
    NUM_CLASSES: int = 3

    def __init__(self, embed_dim: int = 256, hidden_dim: int = 128):
        super().__init__()
        self.embed_dim = int(embed_dim)
        self.hidden_dim = int(hidden_dim)

        self.mlp = nn.Sequential(
            nn.Linear(embed_dim, hidden_dim),
            nn.GELU(),
            nn.Linear(hidden_dim, self.NUM_INSTANCE_ATTRS * self.NUM_CLASSES),
        )

        # 初始化
        nn.init.normal_(self.mlp[0].weight, std=0.02)
        nn.init.zeros_(self.mlp[0].bias)
        nn.init.normal_(self.mlp[2].weight, std=0.02)
        nn.init.zeros_(self.mlp[2].bias)

    def forward(
        self,
        image_embeddings: torch.Tensor,
        label_inst: torch.Tensor,
    ) -> Dict[str, Any]:
        """
        Args:
            image_embeddings: [B, C, H, W] (e.g. [B, 256, 64, 64])
            label_inst: [B, 1, H_orig, W_orig] instance ID mask (0=background)
        Returns:
            dict with:
                - "logits": List[Tensor[N_kept_i, 6, 3]] — per-instance logits for each image
                - "batch_splits": List[int] — cumulative instance counts, length B+1
                - "kept_indices": List[Tensor[N_kept_i]] — 保留的 indices into orig_unique (deprecated, use kept_instance_ids)
                - "kept_instance_ids": List[Tensor[N_kept_i]] — 实际保留的 instance ID (如 [1,2,19])
                - "raw_instance_ids": List[Tensor[N_raw_i]] — 全部原始 instance ID (如 [1,2,5,19])
                - "raw_counts": List[int] — 每张图原始 instance 数量 (pre-downsample)
                - "drop_info": List[Dict] — 每张图 drop 详情
        """
        B, C, H, W = image_embeddings.shape

        # --- 保存原始 label (pre-downsample) 用于获取完整 instance ID 列表 ---
        orig_label = label_inst.long()
        if orig_label.dim() == 4 and orig_label.shape[1] == 1:
            orig_label_sq = orig_label.squeeze(1)  # [B, H_orig, W_orig]
        else:
            orig_label_sq = orig_label

        # --- Resize label_inst to embedding spatial size ---
        if label_inst.shape[-2:] != (H, W):
            label_inst_rs = F.interpolate(
                label_inst.float(), size=(H, W), mode="nearest"
            ).long()
        else:
            label_inst_rs = label_inst.long()

        # Squeeze channel dim: [B, 1, H, W] → [B, H, W]
        if label_inst_rs.dim() == 4 and label_inst_rs.shape[1] == 1:
            label_inst_rs = label_inst_rs.squeeze(1)

        per_image_logits: List[torch.Tensor] = []
        intermediate_feats_list: List[torch.Tensor] = []  # List[Tensor[N_kept_i, C]] — pre-MLP features for Phase C
        batch_splits: List[int] = [0]
        kept_indices_list: List[torch.Tensor] = []       # indices into orig_unique (deprecated)
        kept_instance_ids_list: List[torch.Tensor] = []  # actual kept instance IDs
        raw_instance_ids_list: List[torch.Tensor] = []   # all instance IDs before drop
        raw_counts: List[int] = []
        drop_info_list: List[Dict] = []

        for b in range(B):
            emb = image_embeddings[b]        # [C, H, W]

            # --- 获取原始分辨率下的全部 instance ID (排序后) ---
            orig_mask = orig_label_sq[b]     # [H_orig, W_orig]
            orig_unique = torch.unique(orig_mask)
            orig_unique = orig_unique[orig_unique != 0]  # exclude background

            raw_count = len(orig_unique)
            raw_counts.append(raw_count)

            if raw_count == 0:
                # No instances → empty logits and empty intermediate feats for this image
                per_image_logits.append(
                    torch.zeros(0, self.NUM_INSTANCE_ATTRS, self.NUM_CLASSES, device=emb.device)
                )
                intermediate_feats_list.append(
                    torch.zeros(0, self.embed_dim, device=emb.device)
                )
                batch_splits.append(batch_splits[-1])
                kept_indices_list.append(
                    torch.zeros(0, dtype=torch.long, device=emb.device)
                )
                kept_instance_ids_list.append(
                    torch.zeros(0, dtype=torch.long, device=emb.device)
                )
                raw_instance_ids_list.append(
                    torch.zeros(0, dtype=torch.long, device=emb.device)
                )
                drop_info_list.append({
                    "image": b,
                    "raw": 0,
                    "kept": 0,
                    "dropped": 0,
                    "dropped_indices": [],
                    "reasons": [],
                })
                continue

            # --- 下采样后的 mask ---
            inst_mask = label_inst_rs[b]     # [H, W]

            # --- 对每个原始 instance ID，检查下采样后是否仍有像素 ---
            kept_feats: List[torch.Tensor] = []
            kept_local_indices: List[int] = []  # indices into orig_unique
            kept_local_ids: List[int] = []      # actual instance IDs
            dropped_indices: List[int] = []
            drop_reasons: List[str] = []

            for local_idx, uid in enumerate(orig_unique):
                mask = (inst_mask == uid).float()  # [H, W]

                if mask.sum() == 0:
                    # 下采样后 mask 为空 → 这个实例丢失了
                    dropped_indices.append(local_idx)
                    drop_reasons.append(f"downsampled_mask_empty_uid={uid.item()}")
                    continue

                # Masked average pooling
                masked = emb * mask.unsqueeze(0)   # [C, H, W]
                feat = masked.view(C, -1).sum(dim=1) / (mask.sum() + 1e-8)  # [C]
                kept_feats.append(feat)
                kept_local_indices.append(local_idx)
                kept_local_ids.append(uid.item())

            kept_count = len(kept_feats)
            dropped_count = raw_count - kept_count

            if kept_count > 0:
                instance_feats_t = torch.stack(kept_feats, dim=0)  # [N_kept, C]
                intermediate_feats_list.append(instance_feats_t)   # [N_kept, C] — pre-MLP features
                logits = self.mlp(instance_feats_t)                # [N_kept, 18]
                logits = logits.view(-1, self.NUM_INSTANCE_ATTRS, self.NUM_CLASSES)  # [N_kept, 6, 3]
            else:
                logits = torch.zeros(0, self.NUM_INSTANCE_ATTRS, self.NUM_CLASSES, device=emb.device)
                intermediate_feats_list.append(
                    torch.zeros(0, self.embed_dim, device=emb.device)
                )

            per_image_logits.append(logits)
            kept_indices_list.append(
                torch.tensor(kept_local_indices, dtype=torch.long, device=emb.device)
            )
            kept_instance_ids_list.append(
                torch.tensor(kept_local_ids, dtype=torch.long, device=emb.device)
            )
            raw_instance_ids_list.append(orig_unique.long().to(emb.device))
            batch_splits.append(batch_splits[-1] + kept_count)

            drop_info_list.append({
                "image": b,
                "raw": raw_count,
                "kept": kept_count,
                "dropped": dropped_count,
                "dropped_indices": dropped_indices,
                "reasons": drop_reasons,
            })

        return {
            "logits": per_image_logits,
            "intermediate_feats": intermediate_feats_list,  # List[Tensor[N_kept_i, C]] — pre-MLP features for Phase C alignment
            "batch_splits": batch_splits,
            "kept_indices": kept_indices_list,
            "kept_instance_ids": kept_instance_ids_list,
            "raw_instance_ids": raw_instance_ids_list,
            "raw_counts": raw_counts,
            "drop_info": drop_info_list,
        }


# ---------------------------------------------------------------------------
# MultiLevelAttributeHeads — 多层级属性头容器 (Phase B)
# ---------------------------------------------------------------------------
# 包含3个子头:
#   1. Patch-level Structure Head  → 复用 StructureBoundaryAttrHeads → [B,5,3]
#   2. Dense Boundary Head        → 4张密集图 [B,1,H,W] × 4
#   3. Instance Morphology Head   → [B,6,3]


class MultiLevelAttributeHeads(nn.Module):
    """
    多层级属性头容器，整合3个子头：

    - patch_structure_head: 复用 StructureBoundaryAttrHeads, [B,5,3]
    - dense_boundary_head:   4×Conv2d → [B,1,H,W] × 4
    - instance_morph_head:   masked_avg_pool + MLP → [B,6,3]
    """

    def __init__(self, embed_dim: int = 256):
        super().__init__()
        self.embed_dim = int(embed_dim)

        # 1. Patch-level Structure Head — 复用现有结构
        self.patch_structure_head = StructureBoundaryAttrHeads(embed_dim=embed_dim)

        # 2. Dense Boundary Head — 4个密集边界图
        self.dense_boundary_head = DenseBoundaryHead(embed_dim=embed_dim)

        # 3. Instance-level Morphology Head
        self.instance_morph_head = InstanceMorphologyHead(embed_dim=embed_dim)

    def forward(
        self,
        image_embeddings: torch.Tensor,
        label_inst: Optional[torch.Tensor] = None,
        return_features: bool = False,
    ) -> Dict[str, Any]:
        """
        Args:
            image_embeddings: [B, C, H, W]
            label_inst: optional [B, 1, H_orig, W_orig] instance mask for instance head
            return_features: if True, also return intermediate visual features for alignment
        Returns:
            dict with keys:
                - structure_attr_logits: [B, 5, 3] or None
                - dense_boundary_maps: Dict[str, Tensor[B,1,H,W]]
                - instance_attr_logits: Dict with:
                    - "logits": List[Tensor[N_kept_i, 6, 3]]
                    - "batch_splits": List[int]
                    - "kept_indices": List[Tensor[N_kept_i]]
                    - "raw_counts": List[int]
                    - "drop_info": List[Dict]
                  or None
                - (if return_features=True):
                    - "structure_visual_feat": [B, embed_dim] — pre-logit hidden feature from StructureBoundaryAttrHeads.structure_head (GAP-pooled image_embeddings before linear head)
                    - "boundary_visual_feat": [B, embed_dim] — GAP of dense boundary feature maps
                    - "instance_visual_feat": [B, embed_dim] — per-instance pooled features averaged
        """
        device = image_embeddings.device
        B = image_embeddings.shape[0]

        # 1. Patch-level structure & boundary — return pooled pre-logit features when requested
        if return_features:
            struct_logits, bound_logits, _struct_pooled_feat = self.patch_structure_head(
                image_embeddings, return_features=True
            )  # struct_logits: [B,5,3], bound_logits: [B,4,3], _struct_pooled_feat: [B, C]
        else:
            struct_logits, bound_logits = self.patch_structure_head(image_embeddings)  # [B,5,3], [B,4,3]

        # 2. Dense boundary maps
        dense_maps = self.dense_boundary_head(image_embeddings)  # Dict of [B,1,64,64]

        # 3. Instance-level morphology (per-instance)
        instance_logits: Optional[Dict[str, Any]] = None
        if label_inst is not None:
            instance_logits = self.instance_morph_head(
                image_embeddings, label_inst
            )

        # --- Phase C: return intermediate visual features for attribute-text alignment ---
        visual_feats: Dict[str, Any] = {}
        if return_features:
            # Structure visual feature: pre-logit hidden feature from StructureBoundaryAttrHeads.structure_head
            # This is the GAP-pooled image_embeddings BEFORE the structure linear head (not the raw backbone feature)
            visual_feats["structure_visual_feat"] = _struct_pooled_feat  # [B, embed_dim]

            # Boundary visual feature: GAP of dense boundary feature maps (stack + pool)
            _dense_tensors = [v for v in dense_maps.values() if v is not None]
            if _dense_tensors:
                _stacked = torch.cat(_dense_tensors, dim=1)  # [B, 4, H, W]
                bound_vis_feat = _stacked.mean(dim=(2, 3))   # [B, 4]
                # Project to embed_dim via learned linear if not matching, else zero-pad
                if bound_vis_feat.shape[-1] < self.embed_dim:
                    _pad = self.embed_dim - bound_vis_feat.shape[-1]
                    bound_vis_feat = F.pad(bound_vis_feat, (0, _pad))
                visual_feats["boundary_visual_feat"] = bound_vis_feat  # [B, embed_dim]
            else:
                visual_feats["boundary_visual_feat"] = torch.zeros(B, self.embed_dim, device=device)

            # Instance visual feature: use INTERMEDIATE features (pre-MLP) for per-instance alignment
            _inst_intermediate = instance_logits.get("intermediate_feats", None) if instance_logits is not None else None
            if _inst_intermediate is not None and len(_inst_intermediate) > 0:
                # _inst_intermediate is List[Tensor[N_kept_i, C]]
                visual_feats["instance_intermediate_feats"] = _inst_intermediate  # pass-through for per-instance alignment
                visual_feats["instance_batch_splits"] = instance_logits.get("batch_splits", [0])  # cumulative counts
                # Also provide a [B, embed_dim] pooled version for diagnostics / summary
                _pooled_list = []
                for _feat_i in _inst_intermediate:
                    if _feat_i.shape[0] > 0:
                        _pooled_list.append(_feat_i.mean(dim=0, keepdim=True))  # [1, C]
                    else:
                        _pooled_list.append(torch.zeros(1, self.embed_dim, device=device))
                visual_feats["instance_visual_feat"] = torch.cat(_pooled_list, dim=0)  # [B, embed_dim]
                # === Phase C instance alignment: thread kept info through ===
                # kept_positions (alias: kept_indices): indices into per_instance_attr_labels rows
                _inst_kept_positions = instance_logits.get("kept_indices", None)
                if _inst_kept_positions is not None:
                    visual_feats["instance_kept_positions"] = _inst_kept_positions
                # kept_instance_ids: actual instance IDs that survived filtering
                _inst_kept_instance_ids = instance_logits.get("kept_instance_ids", None)
                if _inst_kept_instance_ids is not None:
                    visual_feats["instance_kept_instance_ids"] = _inst_kept_instance_ids
                # raw_instance_ids: all instance IDs before filtering
                _inst_raw_instance_ids = instance_logits.get("raw_instance_ids", None)
                if _inst_raw_instance_ids is not None:
                    visual_feats["instance_raw_instance_ids"] = _inst_raw_instance_ids
                # drop_info: per-image drop details
                _inst_drop_info = instance_logits.get("drop_info", None)
                if _inst_drop_info is not None:
                    visual_feats["instance_drop_info"] = _inst_drop_info
                # raw_counts: per-image raw instance counts
                _inst_raw_counts = instance_logits.get("raw_counts", None)
                if _inst_raw_counts is not None:
                    visual_feats["instance_raw_counts"] = _inst_raw_counts
            else:
                visual_feats["instance_intermediate_feats"] = []
                visual_feats["instance_batch_splits"] = [0]
                visual_feats["instance_visual_feat"] = torch.zeros(B, self.embed_dim, device=device)

        result = {
            "structure_attr_logits": struct_logits,
            "boundary_attr_logits": bound_logits,
            "dense_boundary_maps": dense_maps,
            "instance_attr_logits": instance_logits,
        }
        if return_features:
            result.update(visual_feats)
        return result


# ---------------------------------------------------------------------------
# SBConchGuidanceAdapter — GT-CONCH upper-bound guidance
# ---------------------------------------------------------------------------
# Label-to-level mapping
SB_LEVEL_NAMES = {0: "low", 1: "mid", 2: "high"}
INVALID_ATTR_LABEL = -1


class SBConchGuidanceAdapter(nn.Module):
    """
    最小独立 adapter，将 GT-derived CONCH text embeddings 转换为 low/high guidance deltas。

    输入：
        structure_text_embed: [B, text_dim]
        boundary_text_embed:  [B, text_dim]
    输出：
        low_guidance_delta:   [B, text_dim]
        high_guidance_delta:  [B, text_dim]

    Zero-init 确保初始阶段 guidance delta = 0，不破坏原始 forward 输出。
    """

    def __init__(self, text_dim: int = 512):
        super().__init__()
        self.text_dim = int(text_dim)

        self.low_adapter = nn.Linear(text_dim, text_dim)
        self.high_adapter = nn.Linear(text_dim, text_dim)

        # Zero-init: 初始输出为零，不破坏原始语义注入路径
        nn.init.zeros_(self.low_adapter.weight)
        nn.init.zeros_(self.low_adapter.bias)
        nn.init.zeros_(self.high_adapter.weight)
        nn.init.zeros_(self.high_adapter.bias)

    def forward(
        self,
        structure_text_embed: torch.Tensor,
        boundary_text_embed: torch.Tensor,
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        low_delta = self.low_adapter(structure_text_embed)
        high_delta = self.high_adapter(boundary_text_embed)
        return low_delta, high_delta


class SBDirectAttrGuidanceAdapter(nn.Module):
    """
    GT direct structure/boundary attribute → guidance delta (bypass CONCH).

    对 structure (5 attrs × 3 classes) 和 boundary (4 attrs × 3 classes)
    分别做 per-attribute one-hot → Linear(3→hidden) → sum → Linear(hidden→guidance_dim)。
    Zero-init 最后一层，初始不破坏原始 forward 输出。

    用于 --sb_guidance_mode=gt_direct 消融实验，回答：
      "attribute labels 本身是否有效，还是 CONCH text path 无效?"
    """

    def __init__(self, guidance_dim: int = 512, hidden_dim: int = 64):
        super().__init__()
        self.guidance_dim = int(guidance_dim)
        self.hidden_dim = int(hidden_dim)

        # Structure: 5 attrs, each 3-class → per-attr MLP → sum
        self.structure_mlps = nn.ModuleList([
            nn.Sequential(
                nn.Linear(3, self.hidden_dim),
                nn.ReLU(inplace=True),
            )
            for _ in range(5)
        ])
        self.structure_out = nn.Linear(self.hidden_dim, self.guidance_dim)

        # Boundary: 4 attrs, each 3-class → per-attr MLP → sum
        self.boundary_mlps = nn.ModuleList([
            nn.Sequential(
                nn.Linear(3, self.hidden_dim),
                nn.ReLU(inplace=True),
            )
            for _ in range(4)
        ])
        self.boundary_out = nn.Linear(self.hidden_dim, self.guidance_dim)

        # Zero-init final layers
        nn.init.zeros_(self.structure_out.weight)
        nn.init.zeros_(self.structure_out.bias)
        nn.init.zeros_(self.boundary_out.weight)
        nn.init.zeros_(self.boundary_out.bias)

    def forward(
        self,
        structure_attr_labels: torch.Tensor,  # [B, 5] long, values 0/1/2
        boundary_attr_labels: torch.Tensor,   # [B, 4] long, values 0/1/2
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        # Structure: [B, 5] → one-hot [B, 5, 3] → per-attr MLP → sum → [B, hidden] → Linear → [B, guidance_dim]
        struct_onehot = torch.nn.functional.one_hot(
            structure_attr_labels.long(), num_classes=3
        ).float()  # [B, 5, 3]
        struct_feats = sum(
            mlp(struct_onehot[:, i, :]) for i, mlp in enumerate(self.structure_mlps)
        )  # [B, hidden_dim]
        low_delta = self.structure_out(struct_feats)  # [B, guidance_dim]

        # Boundary: [B, 4] → one-hot [B, 4, 3] → per-attr MLP → sum → [B, hidden] → Linear → [B, guidance_dim]
        bound_onehot = torch.nn.functional.one_hot(
            boundary_attr_labels.long(), num_classes=3
        ).float()  # [B, 4, 3]
        bound_feats = sum(
            mlp(bound_onehot[:, i, :]) for i, mlp in enumerate(self.boundary_mlps)
        )  # [B, hidden_dim]
        high_delta = self.boundary_out(bound_feats)  # [B, guidance_dim]

        return low_delta, high_delta


class NumericAttrFreqPathProj(nn.Module):
    """
    将数值型 structure/boundary attribute logits 投影到
    FreqPath 所需的 attr_prompt / morph_feat 维度 [B, 512]。

    structure_attr_logits [B, 5, 3] → flatten [B, 15] → LayerNorm → MLP → [B, 512]
    boundary_attr_logits  [B, 4, 3] → flatten [B, 12] → LayerNorm → MLP → [B, 512]

    用于 --enable_numeric_attr_freqpath_guidance Exp5，
    使无 CONCH / 无 PNuRL 情况下属性头 logits 直接驱动 FreqPath low/high route。
    """

    def __init__(
        self,
        out_dim: int = 512,
        hidden_dim: int = 128,
        init: str = "zero",
    ):
        super().__init__()
        self.out_dim = int(out_dim)
        self.hidden_dim = int(hidden_dim)
        self.init = str(init).strip().lower()

        # Structure: [B, 5, 3] → flatten [B, 15] → LayerNorm → Linear(15→hidden) → GELU → Linear(hidden→512)
        self.structure_norm = nn.LayerNorm(15)
        self.structure_mlp = nn.Sequential(
            nn.Linear(15, self.hidden_dim),
            nn.GELU(),
            nn.Linear(self.hidden_dim, self.out_dim),
        )

        # Boundary: [B, 4, 3] → flatten [B, 12] → LayerNorm → Linear(12→hidden) → GELU → Linear(hidden→512)
        self.boundary_norm = nn.LayerNorm(12)
        self.boundary_mlp = nn.Sequential(
            nn.Linear(12, self.hidden_dim),
            nn.GELU(),
            nn.Linear(self.hidden_dim, self.out_dim),
        )

        # Init final layer
        if self.init == "zero":
            nn.init.zeros_(self.structure_mlp[-1].weight)
            nn.init.zeros_(self.structure_mlp[-1].bias)
            nn.init.zeros_(self.boundary_mlp[-1].weight)
            nn.init.zeros_(self.boundary_mlp[-1].bias)
        elif self.init == "small_normal":
            nn.init.normal_(self.structure_mlp[-1].weight, std=1e-3)
            nn.init.zeros_(self.structure_mlp[-1].bias)
            nn.init.normal_(self.boundary_mlp[-1].weight, std=1e-3)
            nn.init.zeros_(self.boundary_mlp[-1].bias)
        else:
            raise ValueError(f"Unknown init={self.init}, use 'zero' or 'small_normal'")

    def forward(
        self,
        structure_attr_logits: torch.Tensor,  # [B, 5, 3]
        boundary_attr_logits: torch.Tensor,   # [B, 4, 3]
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        B = structure_attr_logits.shape[0]

        # Structure: [B, 5, 3] → [B, 15] → LayerNorm → MLP → [B, 512]
        struct_flat = structure_attr_logits.reshape(B, -1).float()  # [B, 15]
        struct_flat = self.structure_norm(struct_flat)
        attr_prompt = self.structure_mlp(struct_flat)  # [B, 512]

        # Boundary: [B, 4, 3] → [B, 12] → LayerNorm → MLP → [B, 512]
        bound_flat = boundary_attr_logits.reshape(B, -1).float()  # [B, 12]
        bound_flat = self.boundary_norm(bound_flat)
        morph_feat = self.boundary_mlp(bound_flat)  # [B, 512]

        return attr_prompt, morph_feat


def _extract_structure_boundary_logits(
    forward_locals: Dict[str, Any],
) -> Tuple[Optional[torch.Tensor], Optional[torch.Tensor], str]:
    """从 forward() 局部变量中提取 structure/boundary attr logits。

    按优先级尝试多种可能的变量名组合，返回 (structure_logits, boundary_logits, source_name)。
    source_name 描述实际使用的变量名组合（如 "structure_attr_logits/boundary_attr_logits"）。
    如果均未找到，返回 (None, None, "not_found")。
    """
    _candidates: List[Tuple[str, str]] = [
        ("structure_attr_logits", "boundary_attr_logits"),
        ("structure_logits", "boundary_logits"),
        ("sb_structure_logits", "sb_boundary_logits"),
    ]
    for s_key, b_key in _candidates:
        s_val = forward_locals.get(s_key, None)
        b_val = forward_locals.get(b_key, None)
        if s_val is not None and b_val is not None:
            if isinstance(s_val, torch.Tensor) and isinstance(b_val, torch.Tensor):
                return s_val, b_val, f"{s_key}/{b_key}"
    return None, None, "not_found"


class PromptNuGuidedAdapter(nn.Module):
    """
    PromptNu-guided v3.3: predicted structure/boundary attributes → guided text_scale + text_delta
    → modulate semantic_delta (scale + additive).

    Two shared encoder paths:
      1) Legacy attr-logit gating (v3): flatten logits → Linear → weighted sum.
      2) Soft text prompt guidance (v3.1): softmax over logits → weighted CONCH text bank → concat.

    After shared encoder → [B, hidden_dim], two parallel zero-init heads:
      - scale_head: Linear(hidden_dim → C) → text_scale [B, C]
      - delta_head: Linear(hidden_dim → C) → text_delta [B, C]

    Modulation formulas (controlled by guidance_mode):
      "scale"     (v3.2 compat): guided = sd * (1.0 + scale_weight * tanh(text_scale))
      "additive"  (v3.3 new)   : guided = sd + delta_weight * tanh(text_delta)
      "scale_add" (v3.3, default): guided = sd * (1.0 + scale_weight * tanh(text_scale))
                                        + delta_weight * tanh(text_delta)

    The additive term is amplitude-controlled via max_guided_delta_ratio:
        if max_guided_delta_ratio > 0 and base_feat_norm > 0:
            additive_norm = ||delta_weight * tanh(text_delta)||  (spatial mean)
            if additive_norm > max_guided_delta_ratio * base_feat_norm:
                scale down additive term to the limit.
    """

    def __init__(
        self,
        embed_dim: int = 256,
        hidden_dim: int = 128,
        struct_attr_count: int = 5,
        bound_attr_count: int = 4,
        level_count: int = 3,
        text_dim: int = 512,
        use_text_bank: bool = False,
        delta_init_std: float = 1e-5,
        prompt_source: str = "pred_attr",
        fixed_global_text: str = "cell nuclei with irregular nuclear morphology and dense chromatin",
        # ── v3.3: Scale + Additive guidance config (stored for audit & forward fallback) ──
        guidance_mode: str = "scale_add",
        scale_weight: Optional[float] = None,
        delta_weight: float = 0.001,
        max_guided_delta_ratio: float = 0.0,
        semantic_dim: int = 256,
    ):
        super().__init__()
        self.use_text_bank = bool(use_text_bank)
        self.text_dim = int(text_dim)
        self.struct_attr_count = int(struct_attr_count)
        self.bound_attr_count = int(bound_attr_count)
        self.level_count = int(level_count)
        self.prompt_source = str(prompt_source).strip().lower()
        self.fixed_global_text = str(fixed_global_text)
        self._fixed_global_embedding: Optional[torch.Tensor] = None  # lazy CONCH-encoded
        # ── v3.3 stored config ──
        self.guidance_mode = str(guidance_mode).strip().lower()
        self.scale_weight = float(scale_weight) if scale_weight is not None else None
        self.delta_weight = float(delta_weight)
        self.max_guided_delta_ratio = float(max_guided_delta_ratio)
        self.semantic_dim = int(semantic_dim)

        # ── Shared text encoder ──
        # Always 2*text_dim → hidden_dim to match v3.3 checkpoint (text-bank mode).
        # text-bank forward: s_text [B, text_dim] + b_text [B, text_dim] → concat → [B, 2*text_dim]
        self.text_encoder = nn.Sequential(
            nn.Linear(2 * self.text_dim, hidden_dim),
            nn.GELU(),
        )

        if self.use_text_bank:
            # ── Soft text prompt guidance path (v3.1) ──
            # Forward does: softmax(logits) → weighted text_bank → s_text/b_text → concat → text_encoder
            pass
        else:
            # ── Legacy attr-logit gating path (v3) ──
            self.structure_attr_proj = nn.Linear(struct_attr_count * level_count, embed_dim)
            self.boundary_attr_proj = nn.Linear(bound_attr_count * level_count, embed_dim)
            # Project legacy combined [B, embed_dim] → [B, 2*text_dim] for text_encoder
            self.legacy_text_proj = nn.Linear(embed_dim, 2 * self.text_dim)

        # ── Parallel scale head and delta head ──
        # Both map [B, hidden_dim] → [B, C] (channel-wise, C = embed_dim = semantic_dim)
        self.scale_head = nn.Linear(hidden_dim, embed_dim)
        self.delta_head = nn.Linear(hidden_dim, embed_dim)

        # Zero-init scale_head so initial text_scale=0 → identity scale modulation
        nn.init.zeros_(self.scale_head.weight)
        nn.init.zeros_(self.scale_head.bias)

        # delta_head: small normal init so initial additive term ≈ 0 but not exactly zero
        # (allows early gradient flow even when semantic_delta ≈ 0)
        nn.init.normal_(self.delta_head.weight, mean=0.0, std=float(delta_init_std))
        nn.init.normal_(self.delta_head.bias, mean=0.0, std=float(delta_init_std))

    def forward(
        self,
        structure_attr_logits: torch.Tensor,    # [B, 5, 3]
        boundary_attr_logits: torch.Tensor,     # [B, 4, 3]
        semantic_delta: torch.Tensor,           # [B, C, H, W]
        text_weight: float = 0.01,
        scale_weight: Optional[float] = None,   # v3.3: explicit scale weight (overrides text_weight if set)
        delta_weight: Optional[float] = None,   # default None → use self.delta_weight
        struct_weight: float = 1.0,
        boundary_weight: float = 1.0,
        structure_text_bank: Optional[torch.Tensor] = None,   # [5, 3, D] or None
        boundary_text_bank: Optional[torch.Tensor] = None,    # [4, 3, D] or None
        guidance_mode: Optional[str] = None,    # default None → use self.guidance_mode
        max_guided_delta_ratio: Optional[float] = None,  # default None → use self.max_guided_delta_ratio
        base_feat_norm: float = 0.0,
        # ── Prompt source diagnostic parameters ──
        prompt_source_override: Optional[str] = None,   # overrides self.prompt_source if set
        gt_struct_labels: Optional[torch.Tensor] = None,  # [B, 5] GT labels for oracle_gt_attr mode
        gt_bound_labels: Optional[torch.Tensor] = None,   # [B, 4] GT labels for oracle_gt_attr mode
        fixed_global_embedding: Optional[torch.Tensor] = None,  # [1, D] pre-encoded CONCH embedding
    ) -> Tuple[torch.Tensor, Dict[str, torch.Tensor]]:
        B = structure_attr_logits.shape[0]
        C = semantic_delta.shape[1]
        device = structure_attr_logits.device

        # Resolve scale_weight (v3.3 explicit) vs text_weight (v3.2 backward compat)
        _scale_weight = scale_weight if scale_weight is not None else text_weight

        # Resolve guidance_mode, delta_weight, max_guided_delta_ratio from stored defaults if not explicitly passed
        if guidance_mode is None:
            guidance_mode = self.guidance_mode
        if delta_weight is None:
            delta_weight = self.delta_weight
        if max_guided_delta_ratio is None:
            max_guided_delta_ratio = self.max_guided_delta_ratio

        # ── Resolve prompt source ──
        _prompt_source = prompt_source_override if prompt_source_override is not None else self.prompt_source

        # Handle oracle_gt_attr: convert GT labels to one-hot pseudo-logits
        _s_logits = structure_attr_logits
        _b_logits = boundary_attr_logits
        if _prompt_source == "oracle_gt_attr":
            if gt_struct_labels is not None and gt_bound_labels is not None:
                # Create one-hot pseudo-logits: -10 for non-target, +10 for target
                _s_logits = torch.full_like(structure_attr_logits, -10.0)
                _s_logits.scatter_(2, gt_struct_labels.unsqueeze(-1).long(), 10.0)
                _b_logits = torch.full_like(boundary_attr_logits, -10.0)
                _b_logits.scatter_(2, gt_bound_labels.unsqueeze(-1).long(), 10.0)
            # else: keep predicted logits (graceful fallback)

        # ── Determine if we can use the text_bank path ──
        _can_use_text_bank = (
            self.use_text_bank
            and structure_text_bank is not None
            and boundary_text_bank is not None
        )

        if _can_use_text_bank:
            # ── Soft text prompt guidance (v3.1) ──
            if _prompt_source in ("fixed_global",):
                # Use fixed global CONCH embedding directly, bypassing attr logits
                if fixed_global_embedding is not None:
                    _fg = fixed_global_embedding.to(device, dtype=semantic_delta.dtype)
                    s_text = _fg.expand(B, -1)  # [B, D]
                    b_text = _fg.expand(B, -1)  # [B, D]
                else:
                    # Fallback: use mean of text bank (uniform over attributes and levels)
                    s_text = structure_text_bank.mean(dim=(0, 1), keepdim=True).expand(B, -1)
                    b_text = boundary_text_bank.mean(dim=(0, 1), keepdim=True).expand(B, -1)
                # Uniform diagnostics for fixed_global (no entropy since no distribution)
                with torch.no_grad():
                    s_entropy = torch.zeros(B, device=device)
                    b_entropy = torch.zeros(B, device=device)
                    _s_feat_norm = s_text.detach().norm(dim=-1).mean().item()
                    _b_feat_norm = b_text.detach().norm(dim=-1).mean().item()
            elif _prompt_source in ("uniform_bank",):
                # Use uniform weighting over all text bank entries
                s_probs = torch.ones_like(_s_logits) / _s_logits.shape[-1]  # [B, 5, 3] uniform
                b_probs = torch.ones_like(_b_logits) / _b_logits.shape[-1]  # [B, 4, 3] uniform
                # Weighted sum with uniform weights
                s_text = (s_probs.unsqueeze(-1) * structure_text_bank.unsqueeze(0)).sum(dim=2).mean(dim=1)
                b_text = (b_probs.unsqueeze(-1) * boundary_text_bank.unsqueeze(0)).sum(dim=2).mean(dim=1)
                # Uniform diagnostics
                with torch.no_grad():
                    s_entropy = torch.full((B,), float(_s_logits.shape[-1]), device=device)
                    b_entropy = torch.full((B,), float(_b_logits.shape[-1]), device=device)
                    _s_feat_norm = s_text.detach().norm(dim=-1).mean().item()
                    _b_feat_norm = b_text.detach().norm(dim=-1).mean().item()
            else:
                # Default pred_attr (or oracle_gt_attr with available GT): softmax-weighted
                s_probs = torch.softmax(_s_logits, dim=-1)
                b_probs = torch.softmax(_b_logits, dim=-1)
                s_text = (s_probs.unsqueeze(-1) * structure_text_bank.unsqueeze(0)).sum(dim=2).mean(dim=1)
                b_text = (b_probs.unsqueeze(-1) * boundary_text_bank.unsqueeze(0)).sum(dim=2).mean(dim=1)
                with torch.no_grad():
                    s_entropy = -(s_probs * torch.log(s_probs.clamp_min(1e-8))).sum(dim=-1).mean(dim=1)
                    b_entropy = -(b_probs * torch.log(b_probs.clamp_min(1e-8))).sum(dim=-1).mean(dim=1)
                    _s_feat_norm = s_text.detach().norm(dim=-1).mean().item()
                    _b_feat_norm = b_text.detach().norm(dim=-1).mean().item()

            combined = torch.cat([s_text, b_text], dim=-1)  # [B, 2*D]
            hidden_feat = self.text_encoder(combined)  # [B, hidden_dim]
            _text_prompt_norm = combined.detach().norm(dim=-1).mean().item()
        else:
            # ── Legacy attr-logit gating path (v3) ──
            # For fixed_global/uniform_bank without text_bank, fall back to pred_attr
            if _prompt_source in ("fixed_global", "uniform_bank"):
                # Warn via diagnostics: no text_bank available for the requested mode
                _fallback_warning = f"prompt_source={_prompt_source} requires --promptnu_guided_v3_use_text_bank; falling back to pred_attr"
                print(f"[PROMPTNU_GUIDED_V3_FALLBACK] {_fallback_warning}")

            s_flat = _s_logits.reshape(B, -1)   # [B, 15]
            b_flat = _b_logits.reshape(B, -1)    # [B, 12]

            s_feat = self.structure_attr_proj(s_flat)       # [B, embed_dim]
            b_feat = self.boundary_attr_proj(b_flat)        # [B, embed_dim]

            combined = struct_weight * s_feat + boundary_weight * b_feat  # [B, embed_dim]
            # Project [B, embed_dim] → [B, 2*text_dim] so text_encoder (always 2*text_dim) works
            combined = self.legacy_text_proj(combined)                     # [B, 2*text_dim]
            hidden_feat = self.text_encoder(combined)                     # [B, hidden_dim]

            # Legacy diagnostics
            with torch.no_grad():
                s_entropy = torch.zeros(B, device=hidden_feat.device)
                b_entropy = torch.zeros(B, device=hidden_feat.device)
                _s_feat_norm = s_feat.detach().norm(dim=-1).mean().item()
                _b_feat_norm = b_feat.detach().norm(dim=-1).mean().item()
                _text_prompt_norm = float("nan")

        # ── Shape audit (gated via audit_mode) ──
        _audit_combined = tuple(combined.shape)
        _audit_hidden = tuple(hidden_feat.shape)
        _audit_in_features = self.text_encoder[0].in_features
        audit_print(
            "PROMPTNU_GUIDED_V3_ADAPTER_SHAPE_AUDIT",
            f"[PROMPTNU_GUIDED_V3_ADAPTER_SHAPE_AUDIT] "
            f"prompt_source={_prompt_source} | "
            f"combined_shape={_audit_combined} | "
            f"text_encoder_in_features={_audit_in_features} | "
            f"hidden_shape={_audit_hidden}",
            flush=True,
        )

        # ── Parallel heads ──
        text_scale = self.scale_head(hidden_feat)  # [B, C]
        text_delta = self.delta_head(hidden_feat)  # [B, C]

        # Print scale/delta shapes after heads
        audit_print(
            "PROMPTNU_GUIDED_V3_ADAPTER_SHAPE_AUDIT",
            f"[PROMPTNU_GUIDED_V3_ADAPTER_SHAPE_AUDIT] "
            f"scale_shape={tuple(text_scale.shape)} | "
            f"delta_shape={tuple(text_delta.shape)}",
            flush=True,
        )

        # ── Modulation by guidance_mode ──
        guidance_mode = str(guidance_mode).strip().lower()
        if guidance_mode == "scale":
            # v3.2 compatible: scale-only modulation
            scale_factor = 1.0 + _scale_weight * torch.tanh(text_scale)  # [B, C]
            guided_semantic_delta = semantic_delta * scale_factor.view(B, C, 1, 1)
        elif guidance_mode == "additive":
            # v3.3: additive-only modulation (no scale dependence on semantic_delta)
            additive_raw = delta_weight * torch.tanh(text_delta)  # [B, C]
            guided_semantic_delta = semantic_delta + additive_raw.view(B, C, 1, 1)
            scale_factor = torch.ones_like(text_scale)  # dummy for diagnostics
        elif guidance_mode == "scale_add":
            # v3.3 default: combined scale + additive
            scale_factor = 1.0 + _scale_weight * torch.tanh(text_scale)  # [B, C]
            additive_raw = delta_weight * torch.tanh(text_delta)  # [B, C]
            guided_semantic_delta = (
                semantic_delta * scale_factor.view(B, C, 1, 1)
                + additive_raw.view(B, C, 1, 1)
            )
        else:
            raise ValueError(
                f"Unknown guidance_mode='{guidance_mode}'. "
                f"Must be one of: 'scale', 'additive', 'scale_add'."
            )

        # ── Amplitude control for additive term ──
        # Clamp the additive component so its norm does not exceed
        # max_guided_delta_ratio * base_feat_norm.
        _additive_amp_scale = 1.0  # no scaling by default
        if guidance_mode in ("additive", "scale_add"):
            additive_component = guided_semantic_delta - semantic_delta  # the actual additive delta
            _add_norm = additive_component.detach().float().norm(dim=1).mean().item()
            if max_guided_delta_ratio > 0.0 and base_feat_norm > 0.0:
                _limit = max_guided_delta_ratio * base_feat_norm
                if _add_norm > _limit:
                    _additive_amp_scale = _limit / (_add_norm + 1e-8)
                    guided_semantic_delta = semantic_delta + additive_component * _additive_amp_scale
        else:
            _add_norm = 0.0

        # ── Diagnostics ──
        with torch.no_grad():
            _ts = text_scale.detach()
            _ts_mean = _ts.mean().item()
            _ts_std = _ts.std().item() if _ts.numel() > 1 else 0.0
            _ts_min = _ts.min().item()
            _ts_max = _ts.max().item()

            _td = text_delta.detach()
            _td_mean = _td.mean().item()
            _td_std = _td.std().item() if _td.numel() > 1 else 0.0
            _td_min = _td.min().item()
            _td_max = _td.max().item()

        debug = {
            "text_scale": _ts,                                          # [B, C]
            "text_delta": _td,                                          # [B, C]
            "scale_factor": scale_factor.detach(),                      # [B, C]
            "guidance_mode": guidance_mode,
            "prompt_source": _prompt_source,
            "pred_struct_levels": _s_logits.argmax(dim=-1).detach(),    # [B, 5] (may be oracle)
            "pred_bound_levels": _b_logits.argmax(dim=-1).detach(),    # [B, 4] (may be oracle)
            # ── Scale diagnostics ──
            "promptnu_guided_v3_text_scale_mean": _ts_mean,
            "promptnu_guided_v3_text_scale_std": _ts_std,
            "promptnu_guided_v3_text_scale_min": _ts_min,
            "promptnu_guided_v3_text_scale_max": _ts_max,
            # ── Additive diagnostics ──
            "promptnu_guided_v3_text_delta_mean": _td_mean,
            "promptnu_guided_v3_text_delta_std": _td_std,
            "promptnu_guided_v3_text_delta_min": _td_min,
            "promptnu_guided_v3_text_delta_max": _td_max,
            "promptnu_guided_v3_additive_delta_norm": _add_norm,
            "promptnu_guided_v3_additive_amp_scale": _additive_amp_scale,
            # ── Entropy diagnostics ──
            "promptnu_guided_v3_struct_entropy": (
                s_entropy.detach().mean().item() if s_entropy.numel() > 0 else 0.0
            ),
            "promptnu_guided_v3_boundary_entropy": (
                b_entropy.detach().mean().item() if b_entropy.numel() > 0 else 0.0
            ),
            # ── Soft text norm diagnostics ──
            "promptnu_guided_v3_soft_text_struct_norm": (
                s_text.detach().norm(dim=-1).mean().item()
                if _can_use_text_bank
                else 0.0
            ),
            "promptnu_guided_v3_soft_text_boundary_norm": (
                b_text.detach().norm(dim=-1).mean().item()
                if _can_use_text_bank
                else 0.0
            ),
            # ── Unified diagnostics keys ──
            "s_feat_norm": _s_feat_norm,
            "b_feat_norm": _b_feat_norm,
            "text_prompt_norm": _text_prompt_norm,
        }

        return guided_semantic_delta, debug


def load_sb_prompt_templates(template_path: str) -> Dict[str, Any]:
    """Load structure/boundary prompt templates from JSON file."""
    if not os.path.isfile(template_path):
        raise FileNotFoundError(
            f"sb_prompt_template_path not found: {template_path}"
        )
    with open(template_path, "r") as f:
        templates = json.load(f)
    return templates


def build_sb_prompt_texts(
    templates: Dict[str, Any],
) -> Tuple[List[str], List[str], List[str], List[str]]:
    """
    从模板字典构建所有 27 个 prompt 文本。

    Returns:
        structure_keys:  ["nuclear_density_low", "nuclear_density_mid", ...]  (15 items)
        structure_texts: [prompt_string, ...]                                 (15 items)
        boundary_texts:  [prompt_string, ...]                                 (12 items)
        boundary_keys:   ["boundary_density_low", "boundary_density_mid", ...] (12 items)
    """
    struct_prompts = templates.get("structure_prompts", {})
    bound_prompts = templates.get("boundary_prompts", {})

    structure_keys: List[str] = []
    structure_texts: List[str] = []

    for attr_name in STRUCTURE_ATTR_NAMES:
        attr_data = struct_prompts.get(attr_name, {})
        for level_name in ("low", "mid", "high"):
            key = f"{attr_name}_{level_name}"
            text = attr_data.get(level_name, "")
            if not text:
                print(f"⚠️ [SB_CONCH] Missing template for {key}, using fallback.")
                text = f"{attr_name} {level_name}"
            structure_keys.append(key)
            structure_texts.append(text)

    boundary_keys: List[str] = []
    boundary_texts: List[str] = []

    for attr_name in BOUNDARY_ATTR_NAMES:
        attr_data = bound_prompts.get(attr_name, {})
        for level_name in ("low", "mid", "high"):
            key = f"{attr_name}_{level_name}"
            text = attr_data.get(level_name, "")
            if not text:
                print(f"⚠️ [SB_CONCH] Missing template for {key}, using fallback.")
                text = f"{attr_name} {level_name}"
            boundary_keys.append(key)
            boundary_texts.append(text)

    return structure_keys, structure_texts, boundary_texts, boundary_keys


# ═══════════════════════════════════════════════════════════════════
# SGA-SB v1 CORRECTION: Spatial Structure/Boundary Heads
# ═══════════════════════════════════════════════════════════════════
#
# Renamed legacy modules:
#   SpatialAttrHead  → SpatialInstanceAttrHead  (kept for ablation)
#   SpatialSBGuidance → SpatialInstanceSBGuidance (kept for ablation)
#
# New modules for corrected implementation:
#   SpatialStructureHead  → predicts 1-channel structure occupancy
#   SpatialBoundaryHead   → predicts 1-channel instance boundary
# ═══════════════════════════════════════════════════════════════════


class SpatialInstanceAttrHead(nn.Module):
    """
    [LEGACY / ABLATION] Per-instance morphology attribute classification head.

    Transforms image_embeddings [B, 256, 64, 64] to per-pixel attribute
    logits [B, NUM_ATTRS * NUM_CLASSES, 64, 64] = [B, 18, 64, 64],
    where each group of 3 channels represents the 3-class logits for
    one morphology attribute (edge, shape, size, texture, color, population).

    This was the original SGA-SB v1 head. It is retained as
    `spatial_instance_attr_mode` for future ablation but is NOT the
    corrected structure/boundary spatial guidance.

    See also:
        SpatialStructureHead  (corrected)
        SpatialBoundaryHead   (corrected)
    """

    NUM_ATTRS: int = 6
    NUM_CLASSES: int = 3

    def __init__(self, embed_dim: int = 256, hidden_dim: int = 128):
        super().__init__()
        self.conv1 = nn.Conv2d(embed_dim, hidden_dim, 3, padding=1)
        self.norm1 = nn.GroupNorm(8, hidden_dim)
        self.conv2 = nn.Conv2d(hidden_dim, hidden_dim, 3, padding=1)
        self.norm2 = nn.GroupNorm(8, hidden_dim)
        self.conv_out = nn.Conv2d(hidden_dim, self.NUM_ATTRS * self.NUM_CLASSES, 1)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = F.relu_(self.norm1(self.conv1(x)))
        x = F.relu_(self.norm2(self.conv2(x)))
        x = self.conv_out(x)  # [B, 18, 64, 64]
        return x


class SpatialInstanceSBGuidance(nn.Module):
    """
    [LEGACY / ABLATION] Aggregate per-instance attr logits into guidance map.

    Takes the 18-channel spatial attribute logits at 64x64 resolution
    and produces a single-channel [B, 1, 64, 64] spatial guidance map
    via a learned 1x1 convolution + Sigmoid.

    Retained for ablation only — not part of corrected SGA-SB v1.
    """

    def __init__(self, hidden_dim: int = 32):
        super().__init__()
        self.aggr = nn.Sequential(
            nn.Conv2d(18, hidden_dim, 1),
            nn.GroupNorm(4, hidden_dim),
            nn.ReLU(),
            nn.Conv2d(hidden_dim, 1, 1),
            nn.Sigmoid(),
        )

    def forward(self, spatial_attr_logits: torch.Tensor) -> Dict[str, torch.Tensor]:
        guidance_64 = self.aggr(spatial_attr_logits)  # [B, 1, 64, 64]
        return {"guidance_64": guidance_64}


# ═══════════════════════════════════════════════════════════════════
# New Spatial Heads (corrected SGA-SB v1)
# ═══════════════════════════════════════════════════════════════════


class SpatialStructureHead(nn.Module):
    """Predict 1-channel structure occupancy map from image features.

    Architecture:
        structure_feature [B, C, H_low, W_low]
        → Conv 3×3 → GroupNorm → ReLU
        → Conv 1×1
        → structure_logits [B, 1, H_low, W_low]

    The output is supervised by local occupancy targets (avg-pooled
    foreground mask) during training, and used to inject structure-aware
    residuals into the low-frequency / structure branch of FreqPathASRBlock.
    """

    def __init__(self, in_dim: int = 256, hidden_dim: int = 128):
        super().__init__()
        self.conv1 = nn.Conv2d(in_dim, hidden_dim, kernel_size=3, padding=1, bias=False)
        self.norm1 = nn.GroupNorm(8, hidden_dim)
        self.act = nn.ReLU(inplace=False)
        self.conv_out = nn.Conv2d(hidden_dim, 1, kernel_size=1, bias=True)

        # Zero-init final conv so initial predictions are near-zero
        nn.init.zeros_(self.conv_out.weight)
        nn.init.zeros_(self.conv_out.bias)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.act(self.norm1(self.conv1(x)))
        logits = self.conv_out(x)  # [B, 1, H_low, W_low]
        return logits


class SpatialBoundaryHead(nn.Module):
    """Predict 1-channel instance boundary map from image features.

    Architecture:
        boundary_feature [B, C, H_high, W_high]
        → Conv 3×3 → GroupNorm → ReLU
        → Conv 1×1
        → boundary_logits [B, 1, H_high, W_high]

    The output is supervised by GT instance boundary targets during
    training, and used to inject boundary-aware residuals into the
    high-frequency / boundary branch of FreqPathASRBlock.
    """

    def __init__(self, in_dim: int = 256, hidden_dim: int = 128):
        super().__init__()
        self.conv1 = nn.Conv2d(in_dim, hidden_dim, kernel_size=3, padding=1, bias=False)
        self.norm1 = nn.GroupNorm(8, hidden_dim)
        self.act = nn.ReLU(inplace=False)
        self.conv_out = nn.Conv2d(hidden_dim, 1, kernel_size=1, bias=True)

        # Zero-init final conv so initial predictions are near-zero
        nn.init.zeros_(self.conv_out.weight)
        nn.init.zeros_(self.conv_out.bias)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.act(self.norm1(self.conv1(x)))
        logits = self.conv_out(x)  # [B, 1, H_high, W_high]
        return logits


# ═══════════════════════════════════════════════════════════════════
# Structure/Boundary Adapters (for gamma-residual injection)
# ═══════════════════════════════════════════════════════════════════


class SpatialStructureAdapter(nn.Module):
    """Projects structure prob [B, 1, H, W] to feature residual [B, C, H, W].

    This enables per-pixel structure-aware residuals without GAP.
    shape: [B, 1, H, W] → Conv → [B, C, H, W]
    """

    def __init__(self, in_dim: int = 1, out_dim: int = 256, hidden_dim: int = 32):
        super().__init__()
        self.net = nn.Sequential(
            nn.Conv2d(in_dim, hidden_dim, kernel_size=3, padding=1, bias=False),
            nn.GroupNorm(4, hidden_dim),
            nn.ReLU(inplace=False),
            nn.Conv2d(hidden_dim, out_dim, kernel_size=1, bias=True),
        )
        nn.init.zeros_(self.net[-1].weight)
        nn.init.zeros_(self.net[-1].bias)

    def forward(self, prob: torch.Tensor) -> torch.Tensor:
        """prob: [B, 1, H, W] → delta: [B, C, H, W]"""
        return self.net(prob)


class SpatialBoundaryAdapter(nn.Module):
    """Projects boundary prob [B, 1, H, W] to feature residual [B, C, H, W].

    This enables per-pixel boundary-aware residuals without GAP.
    shape: [B, 1, H, W] → Conv → [B, C, H, W]
    """

    def __init__(self, in_dim: int = 1, out_dim: int = 256, hidden_dim: int = 32):
        super().__init__()
        self.net = nn.Sequential(
            nn.Conv2d(in_dim, hidden_dim, kernel_size=3, padding=1, bias=False),
            nn.GroupNorm(4, hidden_dim),
            nn.ReLU(inplace=False),
            nn.Conv2d(hidden_dim, out_dim, kernel_size=1, bias=True),
        )
        nn.init.zeros_(self.net[-1].weight)
        nn.init.zeros_(self.net[-1].bias)

    def forward(self, prob: torch.Tensor) -> torch.Tensor:
        """prob: [B, 1, H, W] → delta: [B, C, H, W]"""
        return self.net(prob)


class Sam(nn.Module):
    mask_threshold: float = 0.0
    image_format: str = "RGB"

    def __init__(
        self,
        image_encoder: ImageEncoderViT,
        prompt_encoder: PromptEncoder,
        mask_decoder: MaskDecoder,
        pixel_mean: List[float] = [123.675, 116.28, 103.53],
        pixel_std: List[float] = [58.395, 57.12, 57.375],
    ) -> None:
        super().__init__()

        self.image_encoder = image_encoder
        self.prompt_encoder = prompt_encoder
        self.mask_decoder = mask_decoder

        self.register_buffer("pixel_mean", torch.Tensor(pixel_mean).view(-1, 1, 1), False)
        self.register_buffer("pixel_std", torch.Tensor(pixel_std).view(-1, 1, 1), False)

    @property
    def device(self) -> Any:
        return self.pixel_mean.device

    def postprocess_masks(
        self,
        masks: torch.Tensor,
        input_size: Tuple[int, ...],
        original_size: Tuple[int, ...],
    ) -> torch.Tensor:
        if masks.dim() == 3:
            masks = masks.unsqueeze(0)

        masks = F.interpolate(
            masks,
            (self.image_encoder.img_size, self.image_encoder.img_size),
            mode="bilinear",
            align_corners=False,
        )

        masks = masks[..., : input_size[0], : input_size[1]]
        masks = F.interpolate(masks, original_size, mode="bilinear", align_corners=False)

        return masks

    def preprocess(self, x: torch.Tensor) -> torch.Tensor:
        # Defensive device alignment: ensure pixel_mean / pixel_std live on
        # the same device as the input tensor, even if they somehow became
        # detached during checkpoint loading or model surgery.
        pixel_mean = self.pixel_mean.to(x.device)
        pixel_std = self.pixel_std.to(x.device)
        x = (x - pixel_mean) / pixel_std

        h, w = x.shape[-2:]
        padh = self.image_encoder.img_size - h
        padw = self.image_encoder.img_size - w

        x = F.pad(x, (0, padw, 0, padh))

        return x


class TextSam(Sam):
    def __init__(
        self,
        image_encoder,
        prompt_encoder,
        mask_decoder,
        pixel_mean=[123.675, 116.28, 103.53],
        pixel_std=[58.395, 57.12, 57.375],
        clip_model_name="ViT-B/16",
        text_dim=512,
        embed_dim=256,
        num_organs=21,
        num_heads=8,
        sg_epsilon=0.05,
        sg_iters=3,
        use_pnurl: bool = True,
        use_coop: bool = True,
        use_ot: bool = False,
        use_asr: bool = True,
        asr_variant: str = "legacy",
        asr_regression: Optional[bool] = None,
        max_semantic_gate: float = 0.10,
        max_delta_ratio: float = 0.10,
        init_delta_ratio: float = 0.02,
        semantic_gate_bias_init: Optional[float] = None,
        semantic_injection_scale: float = 1.0,
        enable_structure_boundary_attr_heads: bool = False,
        # --- MultiLevel Attribute Heads (Phase B) ---
        enable_multilevel_attr_heads: bool = False,
        # --- Phase C: Attribute-Text Alignment ---
        enable_attr_text_alignment: bool = False,
        attr_text_alignment_visual_dim: int = 256,
        attr_text_alignment_text_dim: int = 512,
        debug_phase_c_audit: bool = False,
        # --- Phase D: Instance align audit gating ---
        debug_instance_align_audit: bool = False,
        # --- Numeric Attribute → FreqPath guidance (Exp5) ---
        enable_numeric_attr_freqpath_guidance: bool = False,
        numeric_attr_freqpath_hidden_dim: int = 128,
        numeric_attr_freqpath_init: str = "zero",
        # --- PromptNu-lite v2: Residual-Coupled Semantic Alignment ---
        enable_promptnu_lite_align: bool = False,
        promptnu_lite_target: str = "semantic_delta",
        promptnu_lite_struct_weight: float = 0.0,
        promptnu_lite_boundary_weight: float = 0.0,
        promptnu_lite_instance_weight: float = 0.0,
        promptnu_lite_detach_text: bool = True,
        promptnu_lite_detach_visual: bool = False,
        promptnu_lite_proj_lr_mult: float = 0.5,
        promptnu_lite_pool_mode: str = "gap",
        # --- PromptNu-guided v3: Predicted-Attribute Semantic Guidance ---
        enable_promptnu_guided_v3: bool = False,
        promptnu_guided_v3_struct_weight: float = 1.0,
        promptnu_guided_v3_boundary_weight: float = 1.0,
        promptnu_guided_v3_text_weight: float = 0.01,
        promptnu_guided_v3_embed_dim: int = 256,
        promptnu_guided_v3_hidden_dim: int = 128,
        promptnu_guided_v3_vis_proj_dim: int = 512,
        promptnu_guided_v3_align_loss_weight: float = 0.1,
        ablate_semantic_injection: bool = False,
        ablate_pred_attr_guidance: bool = False,
        # --- PromptNu-guided v3.1: CONCH text bank & GT align target ---
        promptnu_guided_v3_use_text_bank: bool = False,
        promptnu_guided_v3_use_gt_align_target: bool = False,
        promptnu_guided_v3_semantic_dim: int = 256,
        promptnu_guided_v3_text_dim: int = 512,
        # --- PromptNu-guided v3 strict audit ---
        promptnu_guided_v3_strict_audit: bool = False,
        # --- PromptNu-guided v3 diagnostic: prompt source ---
        promptnu_guided_v3_prompt_source: str = "pred_attr",
        # --- PromptNu-guided v3.3: Scale + Additive guidance ---
        promptnu_guided_v3_guidance_mode: str = "scale_add",
        promptnu_guided_v3_scale_weight: Optional[float] = None,
        promptnu_guided_v3_delta_weight: float = 0.001,
        promptnu_guided_v3_delta_init_std: float = 1e-5,
        promptnu_guided_v3_max_guided_delta_ratio: float = 0.0,
        # --- PromptNu-guided v3.3 alignment stability ---
        promptnu_guided_v3_align_eps: float = 1e-8,
        promptnu_guided_v3_cosine_eps: float = 1e-8,
        promptnu_guided_v3_min_align_delta_norm: float = 0.0,
        promptnu_guided_v3_align_low_norm_mode: str = "detach_guided",
        # --- PromptNu-guided v3 injection ablation ---
        promptnu_guided_v3_injection_ablation: str = "default",
        promptnu_guided_v3_post_gate_alpha: float = 1.0,
        # --- PNuDP: PromptNu Dense Prediction diagnostic ---
        enable_pnudp_diag: bool = False,
        pnudp_fusion_mode: str = "none",
        pnudp_scale: float = 20.0,
        # --- PNuDP Dense Training (Stage D) ---
        enable_pnudp_dense_train: bool = False,
        pnudp_dense_alpha_init: float = 0.0,
        pnudp_dense_logit_proj_init: str = "zero",
        pnudp_dense_logit_proj_init_std: float = 1.0,
        pnudp_dense_apply_in_eval: bool = False,
        pnudp_dense_num_mask_channels: int = 1,
        # --- SB GT-CONCH / GT-DIRECT guidance ---
        sb_guidance_mode: str = "none",
        sb_guidance_weight: float = 1.0,
        sb_conch_freeze: bool = True,
        sb_prompt_template_path: str = "workdir/attr_stats/structure_boundary_prompt_templates.json",
        sb_guidance_routing: str = "structure_low_boundary_high",
        sb_direct_adapter_hidden_dim: int = 64,
        # --- Text encoder backend ---
        enable_conch_text_encoder: bool = True,
        # ── CONCHLESS test mode: use text_bank from checkpoint, skip CONCH loading ──
        use_checkpoint_text_bank_without_conch: bool = False,
        # ── CLIP text encoder backend (Exp7: CLIP_BACKEND_ABLATION) ──
        clip_text_encoder: bool = False,
        clip_text_encoder_model: str = "ViT-B/32",
        clip_text_encoder_cache_path: str = "hf_cache/clip",
        # --- SGA-SB v1 CORRECTION: Spatial Granularity-Aligned Structure-Boundary Guidance ---
        #
        # Modes:
        #   "none"             — disabled (no heads, no losses, no guidance)
        #   "supervision_only" — predict + supervise, but do NOT inject guidance into features
        #   "guidance"         — predict + supervise + inject guidance into FreqPath blocks
        #
        # Branch options (used with supervision_only or guidance):
        #   "structure"  — only structure head / loss / guidance
        #   "boundary"   — only boundary head / loss / guidance
        #   "both"       — both heads / losses / guidance
        #
        # Legacy mode "v1" maps to "guidance" with deprecation warning.
        #
        # Separate module: spatial_instance_attr_mode (old 18-channel per-instance attr map).
        # This is kept for ablation only and defaults to "none".
        spatial_sb_mode: str = "none",
        spatial_sb_branch: str = "both",
        spatial_structure_guidance_init: float = 0.05,
        spatial_boundary_guidance_init: float = 0.05,
        # --- Legacy per-instance attr mode (ablation) ---
        spatial_instance_attr_mode: str = "none",
    ):
        super().__init__(image_encoder, prompt_encoder, mask_decoder, pixel_mean, pixel_std)

        # ── SGA-SB v1 CORRECTION: Spatial Guidance Mode ──
        spatial_sb_mode = str(spatial_sb_mode).lower().strip()
        spatial_sb_branch = str(spatial_sb_branch).lower().strip()

        # Map legacy "v1" to "guidance" with deprecation warning
        if spatial_sb_mode == "v1":
            import warnings
            warnings.warn(
                "[DEPRECATION] spatial_sb_mode='v1' is deprecated. "
                "Mapping to spatial_sb_mode='guidance'. "
                "Use 'none', 'supervision_only', or 'guidance' instead.",
                DeprecationWarning,
                stacklevel=2,
            )
            print("[SGA-SB_v1_DEPRECATION] spatial_sb_mode='v1' → mapping to 'guidance'")
            spatial_sb_mode = "guidance"

        valid_modes = ("none", "supervision_only", "guidance")
        if spatial_sb_mode not in valid_modes:
            raise ValueError(
                f"spatial_sb_mode must be one of {valid_modes}, got {spatial_sb_mode}"
            )
        valid_branches = ("structure", "boundary", "both")
        if spatial_sb_branch not in valid_branches:
            raise ValueError(
                f"spatial_sb_branch must be one of {valid_branches}, got {spatial_sb_branch}"
            )

        self.spatial_sb_mode = spatial_sb_mode
        self.spatial_sb_branch = spatial_sb_branch
        self.spatial_structure_guidance_init = float(spatial_structure_guidance_init)
        self.spatial_boundary_guidance_init = float(spatial_boundary_guidance_init)

        # ── New spatial heads ──
        self.spatial_structure_head: Optional[SpatialStructureHead] = None
        self.spatial_boundary_head: Optional[SpatialBoundaryHead] = None
        self.spatial_structure_adapter: Optional[SpatialStructureAdapter] = None
        self.spatial_boundary_adapter: Optional[SpatialBoundaryAdapter] = None

        self.structure_guidance_channels = getattr(
            self.mask_decoder, "structure_guidance_channels", None
        )
        self.boundary_guidance_channels = getattr(
            self.mask_decoder, "boundary_guidance_channels", None
        )
        if self.spatial_sb_mode == "guidance":
            if str(asr_variant).lower().strip() != "freqpath" or not use_asr:
                raise ValueError(
                    "SGA-SB guidance requires use_asr=True and asr_variant='freqpath'."
                )
            if not isinstance(self.structure_guidance_channels, int) or self.structure_guidance_channels <= 0:
                raise RuntimeError("Missing decoder structure guidance channel contract.")
            if not isinstance(self.boundary_guidance_channels, int) or self.boundary_guidance_channels <= 0:
                raise RuntimeError("Missing decoder boundary guidance channel contract.")

        if self.spatial_sb_mode != "none":
            _use_struct = spatial_sb_branch in ("structure", "both")
            _use_bound = spatial_sb_branch in ("boundary", "both")

            if _use_struct:
                self.spatial_structure_head = SpatialStructureHead(in_dim=256, hidden_dim=128)
                if self.spatial_sb_mode == "guidance":
                    self.spatial_structure_adapter = SpatialStructureAdapter(
                        in_dim=1,
                        out_dim=self.structure_guidance_channels,
                        hidden_dim=32,
                    )
                    assert self.spatial_structure_adapter.net[-1].out_channels == self.structure_guidance_channels
                    self.gamma_structure = nn.Parameter(
                        torch.tensor(float(spatial_structure_guidance_init))
                    )

            if _use_bound:
                self.spatial_boundary_head = SpatialBoundaryHead(in_dim=256, hidden_dim=128)
                if self.spatial_sb_mode == "guidance":
                    self.spatial_boundary_adapter = SpatialBoundaryAdapter(
                        in_dim=1,
                        out_dim=self.boundary_guidance_channels,
                        hidden_dim=32,
                    )
                    assert self.spatial_boundary_adapter.net[-1].out_channels == self.boundary_guidance_channels
                    self.gamma_boundary = nn.Parameter(
                        torch.tensor(float(spatial_boundary_guidance_init))
                    )

        # ── Legacy spatial_instance_attr_mode (ablation) ──
        spatial_instance_attr_mode = str(spatial_instance_attr_mode).lower().strip()
        if spatial_instance_attr_mode not in ("none", "v1"):
            raise ValueError(
                f"spatial_instance_attr_mode must be 'none' or 'v1', got {spatial_instance_attr_mode}"
            )
        self.spatial_instance_attr_mode = spatial_instance_attr_mode
        if self.spatial_instance_attr_mode != "none":
            self.spatial_instance_attr_head = SpatialInstanceAttrHead(
                embed_dim=256, hidden_dim=128
            )
            self.spatial_instance_sb_guidance = SpatialInstanceSBGuidance(hidden_dim=32)
        else:
            self.spatial_instance_attr_head = None
            self.spatial_instance_sb_guidance = None

        _build_sam_print(
            f"[SGA-SB_v1_CORRECTED] spatial_sb_mode={self.spatial_sb_mode} | "
            f"spatial_sb_branch={self.spatial_sb_branch} | "
            f"struct_guidance_init={self.spatial_structure_guidance_init} | "
            f"bound_guidance_init={self.spatial_boundary_guidance_init} | "
            f"spatial_instance_attr_mode={self.spatial_instance_attr_mode}"
        )

        asr_variant = str(asr_variant).lower().strip()
        if asr_variant not in ("legacy", "freqpath"):
            raise ValueError(f"asr_variant must be 'legacy' or 'freqpath', got {asr_variant}")

        if asr_regression is None:
            asr_regression = False

        self.asr_variant = asr_variant
        self.asr_regression = bool(asr_regression)

        if self.asr_regression:
            if use_pnurl or use_coop or use_ot:
                print(
                    "🔒 ASR regression mode enabled: forcing PNuRL=False, CoOp=False, OT=False, "
                    "and using base prompt 'Cell nuclei'."
                )
            use_pnurl = False
            use_coop = False
            use_ot = False

        # ── CONCHLESS mode: PNuRL stays enabled as specified by --use_pnurl ──
        # CONCH encoder is skipped below, but PNuRL (semantic_delta_adapter,
        # semantic_channel_gate, PromptNu-guided v3) does NOT depend on CONCH.
        # text_embed=None is handled gracefully by PNuRL._prepare_text_embed → zeros.
        if use_checkpoint_text_bank_without_conch and use_pnurl:
            if int(os.environ.get("RANK", "0")) == 0:
                print(
                    "[CONCHLESS_KEEP_PNURL] use_checkpoint_text_bank_without_conch=True, "
                    f"use_pnurl={use_pnurl} (KEPT from command line). "
                    "PNuRL will receive text_embed=None; text_bank provides "
                    "pre-computed embeddings for PromptNu-guided v3."
                )

        self.use_pnurl = bool(use_pnurl)
        self._use_pnurl_constructor = bool(use_pnurl)  # preserved for forward routing guard
        self.use_pnurl_config = bool(use_pnurl)  # immutable config copy, never mutated post-init
        self.use_coop = bool(use_coop)

        if use_ot:
            print("⚠️ use_ot=True was passed, but OT is disabled in this version of TextSam.")
        self.use_ot = False

        self.use_asr = bool(use_asr)
        self.max_semantic_gate = float(max_semantic_gate)
        self.max_delta_ratio = float(max_delta_ratio)
        self.init_delta_ratio = float(init_delta_ratio)
        self.semantic_gate_bias_init = float(semantic_gate_bias_init) if semantic_gate_bias_init is not None else None
        self.semantic_injection_scale = float(semantic_injection_scale)

        self.enable_conch_text_encoder = bool(enable_conch_text_encoder)
        self.use_checkpoint_text_bank_without_conch = bool(use_checkpoint_text_bank_without_conch)
        # ── CLIP text encoder backend (Exp7: CLIP_BACKEND_ABLATION) ──
        self.clip_text_encoder = bool(clip_text_encoder)
        self.clip_text_encoder_model = str(clip_text_encoder_model)
        self.clip_text_encoder_cache_path = str(clip_text_encoder_cache_path)
        _rank_for_log = int(os.environ.get("RANK", "0"))
        if _rank_for_log == 0:
            print(f"[CONCHLESS_ARG_AUDIT:sam.py] use_checkpoint_text_bank_without_conch={self.use_checkpoint_text_bank_without_conch}")
            if self.clip_text_encoder:
                print(f"[CLIP_BACKEND_ARG_AUDIT:sam.py] clip_text_encoder=True, "
                      f"model={self.clip_text_encoder_model}, "
                      f"cache={self.clip_text_encoder_cache_path}")

        # ── CONCH / Text encoder required logic ──
        # CONCH is only needed when at least one CONCH-dependent module requires
        # real-time text encoding (not checkpoint text bank, not CLIP backend).
        self.conch_required = any([
            bool(enable_attr_text_alignment),
            bool(enable_promptnu_lite_align),
            (bool(enable_promptnu_guided_v3)
             and bool(promptnu_guided_v3_use_text_bank)
             and not bool(use_checkpoint_text_bank_without_conch)),
            (bool(use_pnurl) and not bool(use_checkpoint_text_bank_without_conch)),
        ]) and not self.clip_text_encoder  # CLIP backend replaces CONCH

        if hasattr(self.mask_decoder, "asr_variant"):
            if getattr(self.mask_decoder, "asr_variant") != self.asr_variant:
                print(
                    f"⚠️ mask_decoder.asr_variant={getattr(self.mask_decoder, 'asr_variant')} "
                    f"but TextSam.asr_variant={self.asr_variant}. "
                    "Please update build_sam.py to pass the same asr_variant into MaskDecoder."
                )

        # ================================================================
        # Text Encoder — conditionally loaded based on backend (CONCH or CLIP)
        # ================================================================
        _conch_source: str = "disabled"
        # ── CLIP text encoder backend (Exp7) ──
        if self.clip_text_encoder:
            if self.use_checkpoint_text_bank_without_conch:
                # Skip CLIP loading, use checkpoint text bank buffers
                self.clip_model = None
                self.tokenizer = None
                self.prompt_learner = None
                _conch_source = "clip_checkpoint_text_bank"
                if _rank_for_log == 0:
                    print("[CLIP_BACKEND] CLIP encoder skipped (text_bank from checkpoint).")
            else:
                # Load CLIP model via open_clip
                try:
                    _clip_model_name_openclip = self.clip_text_encoder_model.replace("/", "-")
                    if _rank_for_log == 0:
                        print(f"[CLIP_BACKEND] Loading CLIP model: {_clip_model_name_openclip}, "
                              f"cache_dir={self.clip_text_encoder_cache_path}")
                    self.clip_model, _, _ = open_clip.create_model_and_transforms(
                        _clip_model_name_openclip,
                        cache_dir=self.clip_text_encoder_cache_path,
                    )
                    self.tokenizer = open_clip.get_tokenizer(_clip_model_name_openclip)
                    self.prompt_learner = None  # DualPromptLearner is CONCH-specific
                    _conch_source = f"clip:{self.clip_text_encoder_model}"

                    for param in self.clip_model.parameters():
                        param.requires_grad = False
                    self.clip_model.eval()

                    if _rank_for_log == 0:
                        print(f"[CLIP_BACKEND] CLIP model loaded successfully: {_clip_model_name_openclip}, "
                              f"text_dim=512 (compatible)")
                except Exception as _clip_err:
                    raise RuntimeError(
                        f"CLIP model loading failed: {self.clip_text_encoder_model}\n"
                        f"  cache_dir={self.clip_text_encoder_cache_path}\n"
                        f"  Original error: {_clip_err}"
                    )
        elif self.enable_conch_text_encoder and self.conch_required and not (
                self.use_checkpoint_text_bank_without_conch or not self.conch_required):
            # ── CONCH Text Encoder ──
            # ── CONCHLESS mode: skip CONCH loading, use checkpoint text_bank buffers ──
            # ── Also skip if no CONCH-dependent module is active (Visual baseline) ──
            if _rank_for_log == 0:
                if self.use_checkpoint_text_bank_without_conch:
                    print("[CONCHLESS_TEST] CONCH encoder skipped (text_bank from checkpoint).")
                elif not self.conch_required:
                    print(f"[CONCH_SKIP] CONCH encoder skipped (conch_required=False). "
                          f"No CONCH-dependent module needs real-time text encoding.")

            # ── Hard protection: last-resort guard before create_model_from_pretrained ──
            assert not self.use_checkpoint_text_bank_without_conch, (
                "[CONCHLESS_PROTECTION] FATAL: use_checkpoint_text_bank_without_conch=True "
                "but CONCH loading path has been reached. Flag propagation is broken — "
                "the flag was NOT respected by the code path leading here. "
                "Check build_sam.py flag extraction and TextSam constructor argument passing."
            )
            hf_auth_token = os.environ.get("HF_TOKEN")
            if not hf_auth_token:
                print("⚠️ Warning: HF_TOKEN environment variable is not set. Model load may fail if not cached.")

            try:
                self.clip_model, _ = create_model_from_pretrained(
                    "conch_ViT-B-16",
                    "hf_hub:MahmoodLab/conch",
                    hf_auth_token=hf_auth_token,
                )
                self.tokenizer = get_tokenizer()
                _conch_source = "hf_hub"
            except Exception as _conch_err:
                raise RuntimeError(
                    "CONCH checkpoint/cache not found locally and HuggingFace download failed.\n"
                    "  Options:\n"
                    "    1) Set HF_HOME or HUGGINGFACE_HUB_CACHE to the cache directory used\n"
                    "       by previous successful runs.\n"
                    "    2) Provide --conch_checkpoint_path to a local checkpoint file.\n"
                    "    3) Set --hf_hub_offline or export HF_HUB_OFFLINE=1 if offline.\n"
                    f"  Original error: {_conch_err}"
                )

            for param in self.clip_model.parameters():
                param.requires_grad = False

            self.prompt_learner = DualPromptLearner(
                self.clip_model,
                num_organs=num_organs,
                n_ctx_gen=8,
                n_ctx_spec=8,
                embed_dim=embed_dim,
            )
            for param in self.prompt_learner.parameters():
                param.requires_grad = self.use_coop
        elif self.use_checkpoint_text_bank_without_conch:
            # CONCHLESS mode: skip CONCH/CLIP loading, use checkpoint text bank
            self.clip_model = None
            self.tokenizer = None
            self.prompt_learner = None
            _conch_source = "checkpoint_text_bank"
            if _rank_for_log == 0:
                _pnurl_status = "ENABLED (from --use_pnurl)" if use_pnurl else "disabled (--use_pnurl not set)"
                print(
                    f"[CONCHLESS_PNURL_AUDIT] CONCH encoder skipped. "
                    f"use_pnurl={use_pnurl} ({_pnurl_status}). "
                    f"PNuRL module is instantiated. "
                    f"text_embed will be None → PNuRL._prepare_text_embed returns zeros. "
                    f"semantic_delta_adapter / semantic_channel_gate / PromptNu-guided v3 "
                    f"all operate on image_features + text_bank only, no CONCH dependency."
                )
        elif not self.conch_required and not self.clip_text_encoder:
            # No text encoder required: disable all encoder components
            self.clip_model = None
            self.tokenizer = None
            self.prompt_learner = None
            _conch_source = "disabled (not required)"
        else:
            self.clip_model = None
            self.tokenizer = None
            self.prompt_learner = None
            _conch_source = "disabled"

            if self.use_coop and not self.asr_regression:
                raise RuntimeError(
                    "CONCH text encoder is disabled (enable_conch_text_encoder=False) "
                    "but use_coop=True. CoOp prompt learner requires CONCH. "
                    "Either enable CONCH or set --use_coop=False."
                )

        # ── Text bank buffers (CONCHLESS mode: populated from checkpoint state_dict) ──
        self.register_buffer("_structure_text_bank_buffer", torch.zeros(0), persistent=True)
        self.register_buffer("_boundary_text_bank_buffer", torch.zeros(0), persistent=True)

        # Print initialization banner — rank0-only to avoid DDP spam
        if _rank_for_log == 0:
            print(
                f"[CONCH_CONFIG][TextSam] "
                f"enable_conch_text_encoder={self.enable_conch_text_encoder} | "
                f"source={_conch_source} | "
                f"clip_text_encoder={self.clip_text_encoder} | "
                f"ASR={self.use_asr}, asr_variant={self.asr_variant}, "
                f"asr_regression={self.asr_regression} | "
                f"use_pnurl={self.use_pnurl} | use_coop={self.use_coop}"
            )

        self.pnurl = PNuRL(
            embed_dim=embed_dim,
            text_dim=512,
            num_classes_per_attr=[2, 3, 2, 3, 3],
            attr_loss_weight=1.0,
            max_delta_ratio=max_delta_ratio,
            init_delta_ratio=init_delta_ratio,
        )

        _gate_init_bias = float(semantic_gate_bias_init) if semantic_gate_bias_init is not None else -4.0
        self.pnurl.semantic_channel_gate = SemanticChannelGate(
            embed_dim=embed_dim,
            reduction=16,
            init_bias=_gate_init_bias,
            max_gate=max_semantic_gate,
        )

        for param in self.pnurl.parameters():
            param.requires_grad = self.use_pnurl

        # Structure & Boundary Attribute Heads (GT-derived pathology attributes)
        self.enable_structure_boundary_attr_heads = bool(enable_structure_boundary_attr_heads)
        self.structure_boundary_attr_heads: Optional[StructureBoundaryAttrHeads] = None
        if self.enable_structure_boundary_attr_heads:
            self.structure_boundary_attr_heads = StructureBoundaryAttrHeads(embed_dim=embed_dim)
            if self.enable_structure_boundary_attr_heads:
                for param in self.structure_boundary_attr_heads.parameters():
                    param.requires_grad = True

        # --- Numeric Attribute → FreqPath guidance (Exp5) ---
        self.enable_numeric_attr_freqpath_guidance = bool(enable_numeric_attr_freqpath_guidance)
        self.numeric_attr_freqpath_hidden_dim = int(numeric_attr_freqpath_hidden_dim)
        self.numeric_attr_freqpath_init = str(numeric_attr_freqpath_init).strip().lower()
        self.numeric_attr_freqpath_proj: Optional[NumericAttrFreqPathProj] = None
        if self.enable_numeric_attr_freqpath_guidance:
            self.numeric_attr_freqpath_proj = NumericAttrFreqPathProj(
                out_dim=512,
                hidden_dim=self.numeric_attr_freqpath_hidden_dim,
                init=self.numeric_attr_freqpath_init,
            )
            for p in self.numeric_attr_freqpath_proj.parameters():
                p.requires_grad = True
            _n_total = sum(p.numel() for p in self.numeric_attr_freqpath_proj.parameters())
            if _rank_for_log == 0:
                print(
                    f"[NUMERIC_ATTR_FREQPATH_INIT]\n"
                    f"  enabled={self.enable_numeric_attr_freqpath_guidance}\n"
                    f"  structure_in_dim=15\n"
                    f"  boundary_in_dim=12\n"
                    f"  out_dim=512\n"
                    f"  hidden_dim={self.numeric_attr_freqpath_hidden_dim}\n"
                    f"  init={self.numeric_attr_freqpath_init}\n"
                    f"  total_params={_n_total:,}\n",
                    flush=True,
                )

        # MultiLevel Attribute Heads (Phase B)
        self.enable_multilevel_attr_heads = bool(enable_multilevel_attr_heads)
        self.multilevel_attr_heads: Optional[MultiLevelAttributeHeads] = None
        if self.enable_multilevel_attr_heads:
            self.multilevel_attr_heads = MultiLevelAttributeHeads(embed_dim=embed_dim)
            for param in self.multilevel_attr_heads.parameters():
                param.requires_grad = True
            _n_ml = sum(p.numel() for p in self.multilevel_attr_heads.parameters())
            print(
                f"[MULTILEVEL_ATTR_HEADS] created | embed_dim={embed_dim} | "
                f"total_params={_n_ml:,}"
            )

        self.prompt_generator = TextGuidedPointGenerator(
            embed_dim=embed_dim,
            text_dim=text_dim,
            num_heads=num_heads,
        )

        self.basic_hv_head = nn.Sequential(
            nn.Conv2d(embed_dim, embed_dim // 2, kernel_size=3, padding=1),
            nn.GELU(),
            nn.Conv2d(embed_dim // 2, 2, kernel_size=1),
        )

        if self.use_asr:
            resnet = models.resnet50(weights=models.ResNet50_Weights.DEFAULT)

            self.cnn_stage0 = nn.Sequential(
                resnet.conv1,
                resnet.bn1,
                resnet.relu,
                resnet.maxpool,
            )
            self.cnn_stage1 = resnet.layer1
            self.cnn_stage2 = resnet.layer2

            # 关键修正：
            # TextSam.asr_variant == "freqpath" 时，只让 MaskDecoder 进入 freqpath。
            # GlobalASRUpsampler 必须保持 legacy，以便继承 legacy_asr_* checkpoint 的 HV/heatmap 权重。
            self.global_asr_upsampler = GlobalASRUpsampler(
                embed_dim=embed_dim,
                use_asr=True,
                hm_channels=2,
                asr_variant="legacy",
            )

        for param in self.image_encoder.parameters():
            param.requires_grad = False

        for param in self.prompt_encoder.parameters():
            param.requires_grad = False

        for param in self.mask_decoder.parameters():
            param.requires_grad = True

        for param in self.pnurl.parameters():
            param.requires_grad = self.use_pnurl

        if self.prompt_learner is not None:
            for param in self.prompt_learner.parameters():
                param.requires_grad = self.use_coop

        # ------------------------------------------------------------------
        # SB GT-CONCH / GT-DIRECT guidance
        # ------------------------------------------------------------------
        VALID_SB_GUIDANCE_MODES = ("none", "gt_conch", "gt_direct", "pred_direct")
        sb_guidance_mode = str(sb_guidance_mode).lower().strip()
        if sb_guidance_mode not in VALID_SB_GUIDANCE_MODES:
            raise ValueError(
                f"sb_guidance_mode must be one of {VALID_SB_GUIDANCE_MODES}, got {sb_guidance_mode}"
            )
        self.sb_guidance_mode = sb_guidance_mode
        self.sb_guidance_weight = float(sb_guidance_weight)
        self.sb_conch_freeze = bool(sb_conch_freeze)
        self.sb_prompt_template_path = str(sb_prompt_template_path)
        self.sb_direct_adapter_hidden_dim = int(sb_direct_adapter_hidden_dim)

        VALID_SB_GUIDANCE_ROUTING = ("structure_low_boundary_high",)
        routing = str(sb_guidance_routing).lower().strip()
        if routing not in VALID_SB_GUIDANCE_ROUTING:
            raise ValueError(
                f"sb_guidance_routing must be one of {VALID_SB_GUIDANCE_ROUTING}, got {routing}"
            )
        self.sb_guidance_routing = routing

        # SBConchGuidanceAdapter — only created when mode=gt_conch
        self.sb_conch_adapter: Optional[SBConchGuidanceAdapter] = None
        if self.sb_guidance_mode == "gt_conch":
            self.sb_conch_adapter = SBConchGuidanceAdapter(text_dim=text_dim)
            for p in self.sb_conch_adapter.parameters():
                p.requires_grad = True  # 进入 optimizer
            _n_low = sum(p.numel() for p in self.sb_conch_adapter.low_adapter.parameters())
            _n_high = sum(p.numel() for p in self.sb_conch_adapter.high_adapter.parameters())
            _n_total = _n_low + _n_high
            print(
                f"[SB_CONCH_ADAPTER] created | text_dim={text_dim} | "
                f"low_adapter={_n_low:,} params (Linear {text_dim}->{text_dim}) | "
                f"high_adapter={_n_high:,} params (Linear {text_dim}->{text_dim}) | "
                f"total={_n_total:,} params"
            )

        # CONCH 冻结 (only for gt_conch mode; requires enabled CONCH)
        if self.sb_conch_freeze and self.sb_guidance_mode == "gt_conch":
            if self.clip_model is None:
                raise RuntimeError(
                    "sb_guidance_mode='gt_conch' requires CONCH text encoder, "
                    "but enable_conch_text_encoder=False. "
                    "Set enable_conch_text_encoder=True or use sb_guidance_mode='gt_direct'/'pred_direct'."
                )
            self.clip_model.eval()
            for param in self.clip_model.parameters():
                param.requires_grad = False
            print(
                f"🧊 [SB_CONCH] CONCH frozen: sb_conch_freeze={self.sb_conch_freeze}, "
                f"sb_guidance_mode={self.sb_guidance_mode}"
            )

        # SBDirectAttrGuidanceAdapter — created when mode=gt_direct or pred_direct
        self.sb_direct_adapter: Optional[SBDirectAttrGuidanceAdapter] = None
        if self.sb_guidance_mode in ("gt_direct", "pred_direct"):
            self.sb_direct_adapter = SBDirectAttrGuidanceAdapter(
                guidance_dim=text_dim,
                hidden_dim=self.sb_direct_adapter_hidden_dim,
            )
            for p in self.sb_direct_adapter.parameters():
                p.requires_grad = True
            # Count per-attribute MLP params
            _n_struct_mlp = sum(
                sum(p.numel() for p in mlp.parameters())
                for mlp in self.sb_direct_adapter.structure_mlps
            )
            _n_bound_mlp = sum(
                sum(p.numel() for p in mlp.parameters())
                for mlp in self.sb_direct_adapter.boundary_mlps
            )
            _n_struct_out = sum(p.numel() for p in self.sb_direct_adapter.structure_out.parameters())
            _n_bound_out = sum(p.numel() for p in self.sb_direct_adapter.boundary_out.parameters())
            _n_total = _n_struct_mlp + _n_bound_mlp + _n_struct_out + _n_bound_out
            print(
                f"[SB_DIRECT_ADAPTER] created | "
                f"guidance_dim={text_dim} hidden_dim={self.sb_direct_adapter_hidden_dim} | "
                f"struct_mlps={_n_struct_mlp:,} | bound_mlps={_n_bound_mlp:,} | "
                f"struct_out={_n_struct_out:,} | bound_out={_n_bound_out:,} | "
                f"total={_n_total:,} params"
            )

        # ------------------------------------------------------------------
        # PromptNu-guided v3: Predicted-Attribute Semantic Guidance
        # ------------------------------------------------------------------
        self.enable_promptnu_guided_v3 = bool(enable_promptnu_guided_v3)
        self.promptnu_guided_v3_struct_weight = float(promptnu_guided_v3_struct_weight)
        self.promptnu_guided_v3_boundary_weight = float(promptnu_guided_v3_boundary_weight)
        self.promptnu_guided_v3_text_weight = float(promptnu_guided_v3_text_weight)
        self.promptnu_guided_v3_embed_dim = int(promptnu_guided_v3_embed_dim)
        self.promptnu_guided_v3_hidden_dim = int(promptnu_guided_v3_hidden_dim)
        self.promptnu_guided_v3_vis_proj_dim = int(promptnu_guided_v3_vis_proj_dim)
        self.promptnu_guided_v3_align_loss_weight = float(promptnu_guided_v3_align_loss_weight)
        self.ablate_semantic_injection = bool(ablate_semantic_injection)
        self.ablate_pred_attr_guidance = bool(ablate_pred_attr_guidance)
        # --- PromptNu-guided v3.1: CONCH text bank & GT align target ---
        self.promptnu_guided_v3_use_text_bank = bool(promptnu_guided_v3_use_text_bank)
        self.promptnu_guided_v3_use_gt_align_target = bool(promptnu_guided_v3_use_gt_align_target)
        self.promptnu_guided_v3_semantic_dim = int(promptnu_guided_v3_semantic_dim)
        self.promptnu_guided_v3_text_dim = int(promptnu_guided_v3_text_dim)
        self.promptnu_guided_v3_strict_audit = bool(promptnu_guided_v3_strict_audit)
        # --- PromptNu-guided v3.3: Scale + Additive guidance ---
        _valid_guidance_modes = ("scale", "additive", "scale_add")
        _gm = str(promptnu_guided_v3_guidance_mode).strip().lower()
        if _gm not in _valid_guidance_modes:
            raise ValueError(
                f"promptnu_guided_v3_guidance_mode must be one of {_valid_guidance_modes}, "
                f"got '{promptnu_guided_v3_guidance_mode}'"
            )
        self.promptnu_guided_v3_guidance_mode = _gm
        self.promptnu_guided_v3_scale_weight = (
            float(promptnu_guided_v3_scale_weight) if promptnu_guided_v3_scale_weight is not None
            else self.promptnu_guided_v3_text_weight  # fallback to text_weight
        )
        self.promptnu_guided_v3_delta_weight = float(promptnu_guided_v3_delta_weight)
        self.promptnu_guided_v3_delta_init_std = float(promptnu_guided_v3_delta_init_std)
        self.promptnu_guided_v3_max_guided_delta_ratio = float(promptnu_guided_v3_max_guided_delta_ratio)
        # --- PromptNu-guided v3.3 alignment stability ---
        self.promptnu_guided_v3_align_eps = float(promptnu_guided_v3_align_eps)
        self.promptnu_guided_v3_cosine_eps = float(promptnu_guided_v3_cosine_eps)
        self.promptnu_guided_v3_min_align_delta_norm = float(promptnu_guided_v3_min_align_delta_norm)
        _valid_low_norm_modes = ("detach_semantic", "detach_guided")
        _lnm = str(promptnu_guided_v3_align_low_norm_mode).strip().lower()
        if _lnm not in _valid_low_norm_modes:
            raise ValueError(
                f"promptnu_guided_v3_align_low_norm_mode must be one of {_valid_low_norm_modes}, "
                f"got '{promptnu_guided_v3_align_low_norm_mode}'"
            )
        self.promptnu_guided_v3_align_low_norm_mode = _lnm
        # --- PromptNu-guided v3 diagnostic: prompt source ---
        self.promptnu_guided_v3_prompt_source = str(promptnu_guided_v3_prompt_source).strip().lower()
        _valid_prompt_sources = ("pred_attr", "fixed_global", "uniform_bank", "oracle_gt_attr")
        if self.promptnu_guided_v3_prompt_source not in _valid_prompt_sources:
            raise ValueError(
                f"promptnu_guided_v3_prompt_source must be one of {_valid_prompt_sources}, "
                f"got '{promptnu_guided_v3_prompt_source}'"
            )

        # --- PromptNu-guided v3 injection ablation ---
        _valid_ablation = ("default", "bypass_gate", "post_gate_add", "replace_semantic_delta")
        _ablation = str(promptnu_guided_v3_injection_ablation).strip().lower()
        if _ablation not in _valid_ablation:
            raise ValueError(
                f"promptnu_guided_v3_injection_ablation must be one of {_valid_ablation}, "
                f"got '{_ablation}'"
            )
        self.promptnu_guided_v3_injection_ablation = _ablation
        self.promptnu_guided_v3_post_gate_alpha = float(promptnu_guided_v3_post_gate_alpha)
        if _ablation != "default":
            print(
                f"[V3_INJECTION_ABLATION] mode={_ablation} "
                f"post_gate_alpha={self.promptnu_guided_v3_post_gate_alpha:.4f} | "
                f"NOTE: This is a test-time diagnostic mode. Do NOT train with ablation enabled."
            )

        # --- PNuDP: PromptNu Dense Prediction diagnostic module ---
        self.enable_pnudp_diag = bool(enable_pnudp_diag)
        self.pnudp_fusion_mode = str(pnudp_fusion_mode).strip().lower()
        self.pnudp_scale = float(pnudp_scale)
        self.pnudp_diag: Optional[PromptNuDensePrediction] = None
        if self.enable_pnudp_diag:
            self.pnudp_diag = PromptNuDensePrediction(
                feat_dim=embed_dim,
                text_dim=self.promptnu_guided_v3_text_dim,
                num_prompts=27,
                scale=self.pnudp_scale,
            )
            # Move to same device as main params on first forward call
            _pnudp_fusion = self.pnudp_fusion_mode
            print(
                f"[PNUDP_DIAG] PNuDP diagnostic enabled | "
                f"fusion_mode={_pnudp_fusion} | "
                f"scale={self.pnudp_scale:.2f} | "
                f"NOTE: Diagnostic only. No training or full test.",
                flush=True,
            )

        # --- PNuDP Dense Training module (Stage D) ---
        self.enable_pnudp_dense_train = bool(enable_pnudp_dense_train)
        self.pnudp_dense_apply_in_eval = bool(pnudp_dense_apply_in_eval)
        self.pnudp_dense_train: Optional[PNuDPDenseTrain] = None
        if self.enable_pnudp_dense_train:
            self.pnudp_dense_train = PNuDPDenseTrain(
                feat_dim=embed_dim,
                text_dim=self.promptnu_guided_v3_text_dim,
                logit_scale=20.0,
                num_prompts=NUM_SB_PROMPTS,
                alpha_init=float(pnudp_dense_alpha_init),
                logit_proj_init=str(pnudp_dense_logit_proj_init),
                logit_proj_init_std=float(pnudp_dense_logit_proj_init_std),
                pnudp_dense_num_mask_channels=int(pnudp_dense_num_mask_channels),
            )
            print(
                f"[PNUDP_DENSE_TRAIN] PNuDP dense training enabled | "
                f"alpha_init={pnudp_dense_alpha_init:.4f} | "
                f"feat_dim={embed_dim} | text_dim={self.promptnu_guided_v3_text_dim} | "
                f"num_mask_channels={pnudp_dense_num_mask_channels} | "
                f"logit_proj_init={pnudp_dense_logit_proj_init} "
                f"logit_proj_init_std={pnudp_dense_logit_proj_init_std}",
                flush=True,
            )

        # --- use_pnurl warning for v3 ---
        if self.enable_promptnu_guided_v3 and not self.use_pnurl:
            print(
                f"[PROMPTNU_GUIDED_V3_WARNING] "
                f"enable_promptnu_guided_v3=True but use_pnurl=False. "
                f"Semantic residual path may be inactive or degenerate. "
                f"v3 training requires --use_pnurl.",
                flush=True,
            )
        # PromptNuGuidedAdapter — only created when v3 is enabled
        self.promptnu_guided_adapter: Optional[PromptNuGuidedAdapter] = None
        if self.enable_promptnu_guided_v3:
            self.promptnu_guided_adapter = PromptNuGuidedAdapter(
                embed_dim=self.promptnu_guided_v3_embed_dim,
                hidden_dim=self.promptnu_guided_v3_hidden_dim,
                text_dim=self.promptnu_guided_v3_text_dim,
                use_text_bank=self.promptnu_guided_v3_use_text_bank,
                delta_init_std=self.promptnu_guided_v3_delta_init_std,
                prompt_source=self.promptnu_guided_v3_prompt_source,
                # ── v3.3: pass guidance config directly ──
                guidance_mode=self.promptnu_guided_v3_guidance_mode,
                scale_weight=self.promptnu_guided_v3_scale_weight,
                delta_weight=self.promptnu_guided_v3_delta_weight,
                max_guided_delta_ratio=self.promptnu_guided_v3_max_guided_delta_ratio,
                semantic_dim=self.promptnu_guided_v3_semantic_dim,
            )
            for p in self.promptnu_guided_adapter.parameters():
                p.requires_grad = True
            _n_v3 = sum(p.numel() for p in self.promptnu_guided_adapter.parameters())
            _v3_mode = "text_bank" if self.promptnu_guided_v3_use_text_bank else "attr_logit_gating"

            # ── Adapter config audit: compare TextSam's stored config vs adapter's internal config ──
            _adapter_guidance_mode = getattr(self.promptnu_guided_adapter, "guidance_mode", "MISSING")
            _adapter_scale_weight = getattr(self.promptnu_guided_adapter, "scale_weight", None)
            _adapter_delta_weight = getattr(self.promptnu_guided_adapter, "delta_weight", None)
            _adapter_max_guided_delta_ratio = getattr(self.promptnu_guided_adapter, "max_guided_delta_ratio", None)
            _adapter_semantic_dim = getattr(self.promptnu_guided_adapter, "semantic_dim", None)

            _config_mismatch = False
            if _adapter_guidance_mode != self.promptnu_guided_v3_guidance_mode:
                print(f"[PROMPTNU_GUIDED_V3_CONFIG_MISMATCH] guidance_mode: adapter={_adapter_guidance_mode} vs TextSam={self.promptnu_guided_v3_guidance_mode}")
                _config_mismatch = True
            if _adapter_scale_weight != self.promptnu_guided_v3_scale_weight:
                print(f"[PROMPTNU_GUIDED_V3_CONFIG_MISMATCH] scale_weight: adapter={_adapter_scale_weight} vs TextSam={self.promptnu_guided_v3_scale_weight}")
                _config_mismatch = True
            if _adapter_delta_weight != self.promptnu_guided_v3_delta_weight:
                print(f"[PROMPTNU_GUIDED_V3_CONFIG_MISMATCH] delta_weight: adapter={_adapter_delta_weight} vs TextSam={self.promptnu_guided_v3_delta_weight}")
                _config_mismatch = True
            if _adapter_max_guided_delta_ratio != self.promptnu_guided_v3_max_guided_delta_ratio:
                print(f"[PROMPTNU_GUIDED_V3_CONFIG_MISMATCH] max_guided_delta_ratio: adapter={_adapter_max_guided_delta_ratio} vs TextSam={self.promptnu_guided_v3_max_guided_delta_ratio}")
                _config_mismatch = True
            if _adapter_semantic_dim != self.promptnu_guided_v3_semantic_dim:
                print(f"[PROMPTNU_GUIDED_V3_CONFIG_MISMATCH] semantic_dim: adapter={_adapter_semantic_dim} vs TextSam={self.promptnu_guided_v3_semantic_dim}")
                _config_mismatch = True

            if _config_mismatch:
                print("[PROMPTNU_GUIDED_V3_CONFIG_MISMATCH] ⚠️ One or more config fields differ between TextSam and adapter! Check the above logs.")
            else:
                print(f"[PROMPTNU_GUIDED_V3_CONFIG_AUDIT] ✅ All {5} v3.3 config fields match between TextSam and adapter.")

            print(
                f"[PROMPTNU_GUIDED_V3] PromptNuGuidedAdapter created | "
                f"embed_dim={self.promptnu_guided_v3_embed_dim} | "
                f"hidden_dim={self.promptnu_guided_v3_hidden_dim} | "
                f"text_dim={self.promptnu_guided_v3_text_dim} | "
                f"mode={_v3_mode} | "
                f"guidance_mode={self.promptnu_guided_v3_guidance_mode} | "
                f"scale_weight={self.promptnu_guided_v3_scale_weight:.4f} | "
                f"delta_weight={self.promptnu_guided_v3_delta_weight:.4f} | "
                f"delta_init_std={self.promptnu_guided_v3_delta_init_std:.2e} | "
                f"max_guided_delta_ratio={self.promptnu_guided_v3_max_guided_delta_ratio:.2e} | "
                f"use_gt_align_target={self.promptnu_guided_v3_use_gt_align_target} | "
                f"total_params={_n_v3:,}"
            )

        # Visual/text projection heads for v3 cosine alignment loss.
        # v3.2 design: separate struct_text_proj and bound_text_proj instead of
        # a single concatenated projection. This enables independent structure
        # and boundary cosine alignment losses.
        self.promptnu_guided_v3_vis_proj: Optional[nn.Linear] = None
        self.promptnu_guided_v3_struct_text_proj: Optional[nn.Linear] = None
        self.promptnu_guided_v3_boundary_text_proj: Optional[nn.Linear] = None
        if self.enable_promptnu_guided_v3:
            _vp = self.promptnu_guided_v3_vis_proj_dim
            _text_dim = self.promptnu_guided_v3_text_dim  # CONCH embedding dim (usually 512)
            self.promptnu_guided_v3_vis_proj = nn.Linear(self.promptnu_guided_v3_embed_dim, _vp)
            self.promptnu_guided_v3_struct_text_proj = nn.Linear(_text_dim, _vp)
            self.promptnu_guided_v3_boundary_text_proj = nn.Linear(_text_dim, _vp)
            nn.init.xavier_uniform_(self.promptnu_guided_v3_vis_proj.weight)
            nn.init.zeros_(self.promptnu_guided_v3_vis_proj.bias)
            nn.init.xavier_uniform_(self.promptnu_guided_v3_struct_text_proj.weight)
            nn.init.zeros_(self.promptnu_guided_v3_struct_text_proj.bias)
            nn.init.xavier_uniform_(self.promptnu_guided_v3_boundary_text_proj.weight)
            nn.init.zeros_(self.promptnu_guided_v3_boundary_text_proj.bias)
            _n_vp = sum(p.numel() for p in self.promptnu_guided_v3_vis_proj.parameters())
            _n_stp = sum(p.numel() for p in self.promptnu_guided_v3_struct_text_proj.parameters())
            _n_btp = sum(p.numel() for p in self.promptnu_guided_v3_boundary_text_proj.parameters())
            print(
                f"[PROMPTNU_GUIDED_V3] projection heads created | "
                f"vis_proj={_n_vp:,} params | "
                f"struct_text_proj={_n_stp:,} params | "
                f"boundary_text_proj={_n_btp:,} params | "
                f"proj_dim={_vp}"
            )

        # ------------------------------------------------------------------
        # Phase C: Attribute-Text Alignment modules
        # ------------------------------------------------------------------
        self.enable_attr_text_alignment = bool(enable_attr_text_alignment)
        self.attr_text_alignment_visual_dim = int(attr_text_alignment_visual_dim)
        self.attr_text_alignment_text_dim = int(attr_text_alignment_text_dim)
        self.debug_phase_c_audit = bool(debug_phase_c_audit)
        self.debug_instance_align_audit = bool(debug_instance_align_audit)
        self._instance_align_warning_count: int = 0
        self._instance_align_audit_count: int = 0

        # ------------------------------------------------------------------
        # PromptNu-lite v2: Residual-Coupled Semantic Alignment
        # ------------------------------------------------------------------
        self.enable_promptnu_lite_align = bool(enable_promptnu_lite_align)
        self.promptnu_lite_target = str(promptnu_lite_target)
        self.promptnu_lite_struct_weight = float(promptnu_lite_struct_weight)
        self.promptnu_lite_boundary_weight = float(promptnu_lite_boundary_weight)
        self.promptnu_lite_instance_weight = float(promptnu_lite_instance_weight)
        self.promptnu_lite_detach_text = bool(promptnu_lite_detach_text)
        self.promptnu_lite_detach_visual = bool(promptnu_lite_detach_visual)
        self.promptnu_lite_proj_lr_mult = float(promptnu_lite_proj_lr_mult)
        _pool_mode = str(promptnu_lite_pool_mode).strip().lower()
        if _pool_mode not in ("gap", "absmean", "rms"):
            _pool_mode = "gap"
        self.promptnu_lite_pool_mode = _pool_mode
        # Debug audit counter (first 2 batches only)
        self._pnurl_lite_audit_count: int = 0
        # Logger reference (set from train.py for audit log file output)
        self._pnurl_lite_logger = None

        # ------------------------------------------------------------------
        # Visual projection heads: map visual features [visual_dim] → [text_dim=512]
        # (Phase C: Attribute-Text Alignment)
        # ------------------------------------------------------------------
        self.attr_align_vis_proj_structure: Optional[nn.Linear] = None
        self.attr_align_vis_proj_boundary: Optional[nn.Linear] = None
        self.attr_align_vis_proj_instance: Optional[nn.Linear] = None
        # Text projection head: map text [text_dim] → [text_dim] (identity-ish)
        self.attr_align_text_proj: Optional[nn.Linear] = None

        if self.enable_attr_text_alignment:
            _vis_dim = self.attr_text_alignment_visual_dim
            _txt_dim = self.attr_text_alignment_text_dim
            self.attr_align_vis_proj_structure = nn.Linear(_vis_dim, _txt_dim)
            self.attr_align_vis_proj_boundary = nn.Linear(_vis_dim, _txt_dim)
            self.attr_align_vis_proj_instance = nn.Linear(_vis_dim, _txt_dim)
            self.attr_align_text_proj = nn.Linear(_txt_dim, _txt_dim)

            # Xavier uniform init for non-zero gradient flow at epoch 0
            for _proj in [self.attr_align_vis_proj_structure,
                          self.attr_align_vis_proj_boundary,
                          self.attr_align_vis_proj_instance,
                          self.attr_align_text_proj]:
                nn.init.xavier_uniform_(_proj.weight)
                nn.init.zeros_(_proj.bias)

            _n_struct_vis = sum(p.numel() for p in self.attr_align_vis_proj_structure.parameters())
            _n_bound_vis = sum(p.numel() for p in self.attr_align_vis_proj_boundary.parameters())
            _n_inst_vis = sum(p.numel() for p in self.attr_align_vis_proj_instance.parameters())
            _n_text = sum(p.numel() for p in self.attr_align_text_proj.parameters())
            _n_total = _n_struct_vis + _n_bound_vis + _n_inst_vis + _n_text
            print(
                f"[PHASE_C_ALIGN] created | "
                f"vis_proj_structure={_n_struct_vis:,} | "
                f"vis_proj_boundary={_n_bound_vis:,} | "
                f"vis_proj_instance={_n_inst_vis:,} | "
                f"text_proj={_n_text:,} | "
                f"total={_n_total:,} params"
            )

        # Instance attribute text prompt templates (for per-instance CONCH embedding)
        INSTANCE_ATTR_TEXT_TEMPLATES: Dict[str, Tuple[str, str, str]] = {
            "size": ("small cell", "medium-sized cell", "large cell"),
            "elongation": ("round cell", "slightly elongated cell", "very elongated cell"),
            "boundary_irregularity": ("smooth cell boundary", "moderately irregular cell boundary", "very irregular cell boundary"),
            "local_crowding": ("isolated cell", "moderately crowded cell", "densely crowded cell"),
            "roundness": ("non-round cell", "somewhat round cell", "very round cell"),
            "solidity": ("low solidity cell", "moderate solidity cell", "high solidity cell"),
        }
        self._instance_attr_text_templates = INSTANCE_ATTR_TEXT_TEMPLATES

        # Prompt embedding cache (延迟初始化, only used by gt_conch)
        self._sb_conch_cache_initialized: bool = False
        self._sb_structure_cache: Dict[str, torch.Tensor] = {}  # key -> [1, text_dim]
        self._sb_boundary_cache: Dict[str, torch.Tensor] = {}   # key -> [1, text_dim]
        self._sb_cache_hit_count: int = 0
        self._sb_cache_total_count: int = 0
        # Phase C instance attribute text cache
        self._attr_text_instance_cache_initialized: bool = False
        self._attr_text_instance_cache: Dict[str, torch.Tensor] = {}  # key -> [1, text_dim]
        # Prompt text strings for debug printing (key -> text)
        self._sb_structure_prompt_texts: Dict[str, str] = {}   # key -> prompt text
        self._sb_boundary_prompt_texts: Dict[str, str] = {}    # key -> prompt text
        self._attr_text_instance_prompt_texts: Dict[str, str] = {}  # key -> prompt text

        # ── CONCH module audit: rank0-only ──
        if _rank_for_log == 0:
            _clip_status = "OK" if self.clip_model is not None else "None"
            _tok_status = "OK" if self.tokenizer is not None else "None"
            _pl_status = "OK" if self.prompt_learner is not None else "None"
            print(
                f"[CONCH_MODULE_AUDIT] clip_model={_clip_status} | "
                f"tokenizer={_tok_status} | prompt_learner={_pl_status}"
            )

    def set_pnurl_lite_logger(self, logger):
        """Store a logger reference for audit log file output (set from train.py)."""
        self._pnurl_lite_logger = logger

    def _pnurl_lite_log(self, msg: str):
        """Log via both stored logger (log file) and print (stdout)."""
        print(msg, flush=True)
        if self._pnurl_lite_logger is not None:
            self._pnurl_lite_logger.info(msg)

        if self.enable_promptnu_lite_align and self.promptnu_lite_instance_weight > 0.0:
            print(
                f"[PROMPTNU_LITE_V2_WARN] --promptnu_lite_instance_weight={self.promptnu_lite_instance_weight} "
                f"is not supported in v2. Setting to 0.0. Use v1 (Phase C) for instance alignment.",
                flush=True,
            )
            self.promptnu_lite_instance_weight = 0.0

    def _tokenize_to_input_ids(self, texts: List[str], device: torch.device) -> torch.Tensor:
        tokenized = self.tokenizer(
            texts,
            padding="max_length",
            max_length=77,
            truncation=True,
            return_tensors="pt",
        )

        if hasattr(tokenized, "input_ids"):
            tokens = tokenized.input_ids
        elif isinstance(tokenized, dict) and "input_ids" in tokenized:
            tokens = tokenized["input_ids"]
        else:
            tokens = tokenized

        if not torch.is_tensor(tokens):
            tokens = torch.tensor(tokens)

        return tokens.to(device)

    @staticmethod
    def _get_int_value(value, default: int = 20) -> int:
        if value is None:
            return default
        if torch.is_tensor(value):
            if value.numel() == 0:
                return default
            return int(value.detach().cpu().view(-1)[0].item())
        return int(value)

    @staticmethod
    def _safe_text(value, default: str = "Cell nuclei") -> str:
        if value is None:
            return default
        if isinstance(value, str):
            return value if value.strip() else default
        return str(value)

    @staticmethod
    def _safe_scalar(
        value: Optional[torch.Tensor],
        device: torch.device,
        dtype: torch.dtype = torch.float32,
        default: float = 0.0,
    ) -> torch.Tensor:
        if value is None:
            return torch.tensor(default, device=device, dtype=dtype)
        if torch.is_tensor(value):
            if value.numel() == 0:
                return torch.tensor(default, device=device, dtype=dtype)
            return value.detach().float().mean().to(device=device, dtype=dtype)
        return torch.tensor(float(value), device=device, dtype=dtype)

    @staticmethod
    def _feature_norm(x: Optional[torch.Tensor], device: Optional[torch.device] = None) -> torch.Tensor:
        if x is None:
            if device is None:
                return torch.tensor(0.0)
            return torch.tensor(0.0, device=device)
        if x.dim() >= 2:
            return x.detach().float().norm(dim=1).mean()
        return x.detach().float().norm()

    def reset_instance_align_warning_count(self) -> None:
        """Reset per-epoch counters for PHASE_D_INSTANCE_ALIGN_WARNING (called from train.py)."""
        self._instance_align_warning_count = 0
        self._instance_align_audit_count = 0

    # ------------------------------------------------------------------
    # SB GT-CONCH cache: 一次性编码所有 prompt，后续 lookup
    # ------------------------------------------------------------------
    def _init_sb_conch_cache(self) -> None:
        """Load prompt templates, encode all 27 prompts with text encoder, cache embeddings.

        Supports CONCH (default) and CLIP (clip_text_encoder=True) backends.
        """
        if self._sb_conch_cache_initialized:
            return

        # ── Checkpoint text bank mode: skip encoding, text_bank already in checkpoint ──
        if self.use_checkpoint_text_bank_without_conch:
            self._sb_conch_cache_initialized = True
            return

        if self.clip_model is None:
            raise RuntimeError(
                "Text encoder is required but clip_model is None. "
                "Ensure either enable_conch_text_encoder=True or clip_text_encoder=True."
            )

        device = next(self.clip_model.parameters()).device
        dtype = next(self.clip_model.parameters()).dtype

        # 加载模板
        templates = load_sb_prompt_templates(self.sb_prompt_template_path)
        struct_keys, struct_texts, bound_texts, bound_keys = build_sb_prompt_texts(templates)

        # Cache keys from build_sb_prompt_texts:
        #   structure: "nuclear_density_low", "nuclear_density_mid", ...
        #   boundary:  "boundary_density_low", "boundary_density_mid", ...
        struct_cache_keys = struct_keys.copy()
        bound_cache_keys = bound_keys.copy()

        # Encode all at once for efficiency
        all_texts_list = struct_texts + bound_texts
        all_keys_list = struct_cache_keys + bound_cache_keys

        was_training = self.clip_model.training
        self.clip_model.eval()

        with torch.no_grad():
            if self.clip_text_encoder:
                # ── CLIP text encoder: open_clip tokenizer returns tensor directly ──
                tokens = self.tokenizer(all_texts_list).to(device)
            else:
                # ── CONCH text encoder: HuggingFace tokenizer ──
                tokens = self._tokenize_to_input_ids(all_texts_list, device)
            # Text encoder forward (CONCH or CLIP)
            text_embed = self.clip_model.encode_text(tokens).float()  # [27, text_dim]

        if was_training:
            self.clip_model.train()

        # Populate cache (embeddings + prompt texts for debug)
        for key, emb, txt in zip(all_keys_list, text_embed, all_texts_list):
            if key in struct_cache_keys:
                self._sb_structure_cache[key] = emb.unsqueeze(0).detach().cpu()  # [1, text_dim]
                self._sb_structure_prompt_texts[key] = txt
            else:
                self._sb_boundary_cache[key] = emb.unsqueeze(0).detach().cpu()
                self._sb_boundary_prompt_texts[key] = txt

        self._sb_conch_cache_initialized = True
        _num_struct_prompts = len(self._sb_structure_cache)
        _num_bound_prompts = len(self._sb_boundary_cache)
        _num_total_prompts = _num_struct_prompts + _num_bound_prompts
        _backend_tag = "CLIP" if self.clip_text_encoder else "CONCH"
        audit_print(
            "SB_CONCH_CACHE_INIT",
            f"🧠 [SB_{_backend_tag}] Prompt cache initialized: "
            f"backend={_backend_tag} | "
            f"structure={_num_struct_prompts} entries, "
            f"boundary={_num_bound_prompts} entries, "
            f"template_path={self.sb_prompt_template_path}"
        )
        audit_print(
            "PNUDP_TEXT_PROMPT_SOURCE_AUDIT",
            f"[PNUDP_TEXT_PROMPT_SOURCE_AUDIT] "
            f"prompt_bank_mode=fixed_global_sb_bank | "
            f"template_path={self.sb_prompt_template_path} | "
            f"num_structure_prompts={_num_struct_prompts} | "
            f"num_boundary_prompts={_num_bound_prompts} | "
            f"num_total_prompts={_num_total_prompts} | "
            f"uses_per_image_gt_attrs=False",
            flush=True,
        )
        audit_print(
            "PNUDP_SAMPLE_ATTR_PROMPT_AUDIT",
            f"[PNUDP_SAMPLE_ATTR_PROMPT_AUDIT] "
            f"uses_per_image_gt_attrs=False | "
            f"reason=fixed_global_27_prompt_bank",
            flush=True,
        )

    # ------------------------------------------------------------------
    # Phase C: Instance attribute text prompt cache (6 attrs × 3 levels = 18 prompts)
    # ------------------------------------------------------------------
    def _init_attr_text_instance_cache(self) -> None:
        """Encode all 18 instance attribute prompts with CONCH, cache embeddings."""
        if self._attr_text_instance_cache_initialized:
            return

        if self.clip_model is None:
            raise RuntimeError(
                "Phase C attribute-text alignment requires CONCH text encoder, "
                "but enable_conch_text_encoder=False. "
                "Either enable CONCH or disable Phase C."
            )

        device = next(self.clip_model.parameters()).device
        dtype = next(self.clip_model.parameters()).dtype

        # Build all instance attribute prompts: 6 attrs × 3 levels = 18 prompts
        all_texts: List[str] = []
        all_keys: List[str] = []
        for attr_name, (low_text, mid_text, high_text) in self._instance_attr_text_templates.items():
            for level_name, text in zip(SB_LEVEL_NAMES.values(), [low_text, mid_text, high_text]):
                key = f"{attr_name}_{level_name}"
                all_keys.append(key)
                all_texts.append(text)

        was_training = self.clip_model.training
        self.clip_model.eval()

        with torch.no_grad():
            tokens = self._tokenize_to_input_ids(all_texts, device)
            text_embed = self.clip_model.encode_text(tokens).float()  # [18, text_dim]

        if was_training:
            self.clip_model.train()

        # Populate cache (embeddings + prompt texts for debug)
        for key, emb, txt in zip(all_keys, text_embed, all_texts):
            self._attr_text_instance_cache[key] = emb.unsqueeze(0).detach().cpu()  # [1, text_dim]
            self._attr_text_instance_prompt_texts[key] = txt

        self._attr_text_instance_cache_initialized = True
        print(
            f"[PHASE_C] Instance attribute text cache initialized: "
            f"{len(self._attr_text_instance_cache)} entries "
            f"(6 attrs × 3 levels)"
        )

    def _lookup_sb_conch_embedding(
        self,
        attr_name: str,
        level_idx: int,
        is_boundary: bool,
        device: torch.device,
    ) -> Optional[torch.Tensor]:
        """
        Look up cached CONCH embedding for a single attribute.

        Returns:
            [1, text_dim] tensor or None if label is invalid.
        """
        if level_idx < 0 or level_idx > 2:
            return None
        level_name = SB_LEVEL_NAMES[level_idx]
        # Cache keys from build_sb_prompt_texts:
        #   structure: "nuclear_density_low"  (attr_name="nuclear_density")
        #   boundary:  "boundary_density_low" (attr_name="boundary_density", already has "boundary_" prefix)
        # So both branches use the same key pattern: f"{attr_name}_{level_name}"
        key = f"{attr_name}_{level_name}"
        cache = self._sb_boundary_cache if is_boundary else self._sb_structure_cache

        emb = cache.get(key, None)
        if emb is None:
            print(f"⚠️ [SB_CONCH] Cache miss for key={key}")
            return None

        self._sb_cache_hit_count += 1
        return emb.to(device=device, dtype=torch.float32)

    def _get_sb_conch_embeddings(
        self,
        structure_attr_labels: Optional[torch.Tensor],  # [B, 5]
        boundary_attr_labels: Optional[torch.Tensor],   # [B, 4]
    ) -> Tuple[Optional[torch.Tensor], Optional[torch.Tensor], Dict[str, Any]]:
        """
        从 GT labels lookup cached CONCH embeddings，聚合为 structure / boundary text embeddings。

        Returns:
            structure_text_embed: [B, text_dim] or None
            boundary_text_embed:  [B, text_dim] or None
            debug_info: dict with norms, invalid counts, cache stats
        """
        device = next(self.clip_model.parameters()).device

        # Ensure cache is initialized
        if not self._sb_conch_cache_initialized:
            self._init_sb_conch_cache()

        debug_info: Dict[str, Any] = {}
        debug_info["invalid_label_count"] = 0

        # --- Structure ---
        struct_embeds: List[torch.Tensor] = []
        struct_valid = torch.ones(structure_attr_labels.shape[0], device=device, dtype=torch.bool) if structure_attr_labels is not None else None

        if structure_attr_labels is not None:
            B, N_struct = structure_attr_labels.shape
            for b in range(B):
                sample_embeds: List[torch.Tensor] = []
                for j in range(N_struct):
                    label = int(structure_attr_labels[b, j].item())
                    if label < 0 or label > 2:
                        debug_info["invalid_label_count"] += 1
                        continue
                    emb = self._lookup_sb_conch_embedding(
                        STRUCTURE_ATTR_NAMES[j], label, is_boundary=False, device=device
                    )
                    if emb is not None:
                        sample_embeds.append(emb)  # [1, text_dim]
                if len(sample_embeds) > 0:
                    mean_emb = torch.mean(torch.cat(sample_embeds, dim=0), dim=0, keepdim=True)  # [1, text_dim]
                    struct_embeds.append(mean_emb)
                else:
                    # All invalid — use zero vector
                    struct_embeds.append(torch.zeros(1, 512, device=device, dtype=torch.float32))
                    if b == 0:
                        print("⚠️ [SB_CONCH] All structure attrs invalid for a sample, using zero vector.")
            structure_text_embed = torch.cat(struct_embeds, dim=0)  # [B, text_dim]
        else:
            structure_text_embed = None

        # --- Boundary ---
        bound_embeds: List[torch.Tensor] = []
        if boundary_attr_labels is not None:
            B, N_bound = boundary_attr_labels.shape
            for b in range(B):
                sample_embeds = []
                for j in range(N_bound):
                    label = int(boundary_attr_labels[b, j].item())
                    if label < 0 or label > 2:
                        debug_info["invalid_label_count"] += 1
                        continue
                    emb = self._lookup_sb_conch_embedding(
                        BOUNDARY_ATTR_NAMES[j], label, is_boundary=True, device=device
                    )
                    if emb is not None:
                        sample_embeds.append(emb)
                if len(sample_embeds) > 0:
                    mean_emb = torch.mean(torch.cat(sample_embeds, dim=0), dim=0, keepdim=True)
                    bound_embeds.append(mean_emb)
                else:
                    bound_embeds.append(torch.zeros(1, 512, device=device, dtype=torch.float32))
                    print("⚠️ [SB_CONCH] All boundary attrs invalid for a sample, using zero vector.")
            boundary_text_embed = torch.cat(bound_embeds, dim=0)  # [B, text_dim]
        else:
            boundary_text_embed = None

        # Debug norms
        if structure_text_embed is not None:
            debug_info["structure_text_embed_norm"] = structure_text_embed.detach().float().norm(dim=1).mean().item()
        if boundary_text_embed is not None:
            debug_info["boundary_text_embed_norm"] = boundary_text_embed.detach().float().norm(dim=1).mean().item()

        debug_info["cache_hit_count"] = self._sb_cache_hit_count
        debug_info["cache_size"] = len(self._sb_structure_cache) + len(self._sb_boundary_cache)

        return structure_text_embed, boundary_text_embed, debug_info

    # ------------------------------------------------------------------
    # v3.1: Build CONCH text bank tensors for soft text prompt guidance
    # ------------------------------------------------------------------
    def _get_sb_text_bank(self, attr_type: str, device: torch.device) -> torch.Tensor:
        """Build [num_attrs, num_levels, D] text bank from cached CONCH embeddings.

        Args:
            attr_type: "structure" (5 attrs) or "boundary" (4 attrs)
            device: target device

        Returns:
            Tensor [num_attrs, num_levels, text_dim] where level order is [low, mid, high]
        """
        # ── CONCHLESS mode: return checkpoint text_bank buffer directly ──
        if self.use_checkpoint_text_bank_without_conch:
            if attr_type == "structure":
                buf = self._structure_text_bank_buffer
            elif attr_type == "boundary":
                buf = self._boundary_text_bank_buffer
            else:
                raise ValueError(f"attr_type must be 'structure' or 'boundary', got {attr_type}")
            if buf is None or buf.numel() == 0:
                raise RuntimeError(
                    f"[CONCHLESS] {attr_type}_text_bank_buffer is empty ({buf.shape if buf is not None else 'None'}). "
                    "The checkpoint does not contain text bank buffers. "
                    "Run NuSeg/scripts/extract_text_bank_from_ckpt.py first to embed them."
                )
            return buf.to(device=device, dtype=torch.float32)

        # Ensure cache is initialized
        if not self._sb_conch_cache_initialized:
            self._init_sb_conch_cache()

        if attr_type == "structure":
            attr_names = STRUCTURE_ATTR_NAMES  # 5 attrs
            cache = self._sb_structure_cache
        elif attr_type == "boundary":
            attr_names = BOUNDARY_ATTR_NAMES  # 4 attrs
            cache = self._sb_boundary_cache
        else:
            raise ValueError(f"attr_type must be 'structure' or 'boundary', got {attr_type}")

        level_names = ("low", "mid", "high")
        text_dim = self.promptnu_guided_v3_text_dim
        bank_list: List[torch.Tensor] = []

        for attr_name in attr_names:
            levels: List[torch.Tensor] = []
            for lvl in level_names:
                key = f"{attr_name}_{lvl}"
                if key in cache:
                    emb = cache[key].to(device=device, dtype=torch.float32)  # [1, D]
                else:
                    emb = torch.zeros(1, text_dim, device=device, dtype=torch.float32)
                levels.append(emb)
            bank_list.append(torch.cat(levels, dim=0))  # [3, D]

        return torch.stack(bank_list, dim=0)  # [num_attrs, 3, D]

    # ------------------------------------------------------------------
    # Phase C: Attribute-Text embedding lookup (structure + boundary + instance)
    # ------------------------------------------------------------------
    def _get_attr_text_embeddings(
        self,
        structure_attr_labels: Optional[torch.Tensor],     # [B, 5]
        boundary_attr_labels: Optional[torch.Tensor],      # [B, 4]
        per_instance_attr_labels: Optional[torch.Tensor],  # [B, max_Ni, 6] padded
        kept_positions: Optional[List[torch.Tensor]] = None,  # List[Tensor[N_kept_i]] per image, indices into raw labels
        return_per_instance_text: bool = False,            # if True, instance_text_embed returns List[Tensor[N_kept_i, D]]
        per_instance_ids: Optional[Union[List, torch.Tensor]] = None,  # List[Tensor[N_i]] or Tensor[B, max_Ni] — per-instance IDs
        kept_instance_ids: Optional[List[torch.Tensor]] = None,  # List[Tensor[N_kept_i]] per image — IDs that survived filtering
    ) -> Tuple[Optional[torch.Tensor], Optional[torch.Tensor], Optional[Union[torch.Tensor, List[torch.Tensor]]], Dict[str, Any]]:
        """
        Look up cached CONCH embeddings for structure, boundary, and instance attributes.

        Args:
            kept_positions: per-image indices selecting which rows from per_instance_attr_labels[i]
                            correspond to instances that survived visual filtering.
                            When provided, instance text embeddings are only generated for kept instances.

        Returns:
            structure_text_embed: [B, text_dim] or None
            boundary_text_embed:  [B, text_dim] or None
            instance_text_embed:  [B, text_dim] (if return_per_instance_text=False) or
                                  List[Tensor[N_valid_i, text_dim]] (if return_per_instance_text=True)
            debug_info: dict with invalid counts per type
        """
        device = next(self.clip_model.parameters()).device

        # Ensure caches are initialized
        if not self._sb_conch_cache_initialized:
            self._init_sb_conch_cache()
        if not self._attr_text_instance_cache_initialized:
            self._init_attr_text_instance_cache()

        debug_info: Dict[str, Any] = {
            "s_invalid": 0, "b_invalid": 0, "i_invalid": 0,
            "s_valid": 0, "b_valid": 0, "i_valid": 0,
        }

        # [PHASE_C_TEXT] RuntimeError on missing labels when attr_text_source=gt
        # structure and boundary labels are REQUIRED in Phase C.
        # instance labels may be None if the image has no valid instances (skip instance branch).
        if structure_attr_labels is None:
            raise RuntimeError(
                "[PHASE_C_TEXT] structure_attr_labels is None — required when "
                f"enable_attr_text_alignment={self.enable_attr_text_alignment}. "
                "Check that train_one_epoch passes structure_attr_labels in model_input."
            )
        if boundary_attr_labels is None:
            raise RuntimeError(
                "[PHASE_C_TEXT] boundary_attr_labels is None — required when "
                f"enable_attr_text_alignment={self.enable_attr_text_alignment}. "
                "Check that train_one_epoch passes boundary_attr_labels in model_input."
            )
        # instance labels may be None if no valid instances in this batch — allow skip
        if per_instance_attr_labels is None:
            debug_info["i_invalid"] += 1  # mark as skipped
            # NOTE: instance branch will be skipped below; this is acceptable.

        # --- Structure (reuse _get_sb_conch_embeddings logic) ---
        struct_te: Optional[torch.Tensor] = None
        if structure_attr_labels is not None:
            struct_embeds: List[torch.Tensor] = []
            B, N_struct = structure_attr_labels.shape
            for b in range(B):
                sample_embeds: List[torch.Tensor] = []
                for j in range(N_struct):
                    label = int(structure_attr_labels[b, j].item())
                    if label < 0 or label > 2:
                        debug_info["s_invalid"] += 1
                        continue
                    level_name = SB_LEVEL_NAMES[label]
                    key = f"{STRUCTURE_ATTR_NAMES[j]}_{level_name}"
                    emb = self._sb_structure_cache.get(key, None)
                    if emb is not None:
                        sample_embeds.append(emb.to(device=device, dtype=torch.float32))
                if len(sample_embeds) > 0:
                    mean_emb = torch.mean(torch.cat(sample_embeds, dim=0), dim=0, keepdim=True)
                    struct_embeds.append(mean_emb)
                    debug_info["s_valid"] += 1
                else:
                    struct_embeds.append(torch.zeros(1, 512, device=device, dtype=torch.float32))
            struct_te = torch.cat(struct_embeds, dim=0)  # [B, text_dim]

        # --- Boundary (reuse _get_sb_conch_embeddings logic) ---
        bound_te: Optional[torch.Tensor] = None
        if boundary_attr_labels is not None:
            bound_embeds: List[torch.Tensor] = []
            B, N_bound = boundary_attr_labels.shape
            for b in range(B):
                sample_embeds = []
                for j in range(N_bound):
                    label = int(boundary_attr_labels[b, j].item())
                    if label < 0 or label > 2:
                        debug_info["b_invalid"] += 1
                        continue
                    level_name = SB_LEVEL_NAMES[label]
                    key = f"{BOUNDARY_ATTR_NAMES[j]}_{level_name}"
                    emb = self._sb_boundary_cache.get(key, None)
                    if emb is not None:
                        sample_embeds.append(emb.to(device=device, dtype=torch.float32))
                if len(sample_embeds) > 0:
                    mean_emb = torch.mean(torch.cat(sample_embeds, dim=0), dim=0, keepdim=True)
                    bound_embeds.append(mean_emb)
                    debug_info["b_valid"] += 1
                else:
                    bound_embeds.append(torch.zeros(1, 512, device=device, dtype=torch.float32))
            bound_te = torch.cat(bound_embeds, dim=0)

        # --- Instance (6 attrs × 3 levels, [B, max_Ni, 6]) ---
        inst_te: Optional[Union[torch.Tensor, List[torch.Tensor]]] = None
        if per_instance_attr_labels is not None:
            B, max_Ni, N_inst_attr = per_instance_attr_labels.shape
            inst_attr_names = list(self._instance_attr_text_templates.keys())  # ["size", "elongation", ...]

            # ==============================================================
            # Determine which label rows to use per image
            # ==============================================================
            # Strategy (in priority order):
            #   1. Id-based alignment: use per_instance_ids + kept_instance_ids
            #      to map kept instance IDs → label rows.
            #   2. Position-based fallback: use kept_positions to index labels,
            #      only when labels_i.shape[0] == raw_instance_count (legacy).
            # ==============================================================

            # --- Detect whether per_instance_ids are available to enable id-based alignment ---
            _use_id_alignment = (
                per_instance_ids is not None
                and kept_instance_ids is not None
                and len(kept_instance_ids) > 0
            )

            if return_per_instance_text:
                inst_per_sample: List[torch.Tensor] = []

                for b in range(B):
                    labels_i = per_instance_attr_labels[b]  # [max_Ni, 6]

                    # ---------- Id-based alignment (preferred) ----------
                    if _use_id_alignment and b < len(per_instance_ids) and b < len(kept_instance_ids):
                        ids_i = per_instance_ids[b]      # Tensor[N_i] or list
                        kept_ids_i = kept_instance_ids[b]  # Tensor[N_kept_i] or list

                        ids_list = _as_1d_int_list(ids_i)
                        kept_list = _as_1d_int_list(kept_ids_i)

                        # Build id → row mapping (skip padding sentinels < 0)
                        id_to_row: Dict[int, int] = {}
                        n_valid = min(len(ids_list), labels_i.shape[0])
                        for row_idx in range(n_valid):
                            inst_id = ids_list[row_idx]
                            if inst_id >= 0:
                                id_to_row[inst_id] = row_idx

                        # Match kept instance IDs to label rows
                        matched_labels: List[torch.Tensor] = []
                        matched_kept_ids: List[int] = []
                        matched_kept_positions: List[int] = []  # indices within kept_list that matched
                        missing_ids: List[int] = []
                        for pos_idx, inst_id in enumerate(kept_list):
                            row_idx = id_to_row.get(inst_id)
                            if row_idx is None:
                                missing_ids.append(inst_id)
                                continue
                            matched_labels.append(labels_i[row_idx])
                            matched_kept_ids.append(inst_id)
                            matched_kept_positions.append(pos_idx)

                        # Record matched positions and IDs for downstream visual sync
                        debug_info.setdefault("matched_kept_positions_per_image", []).append(matched_kept_positions)
                        debug_info.setdefault("matched_instance_ids_per_image", []).append(matched_kept_ids)
                        debug_info.setdefault("missing_ids_per_image", []).append(missing_ids)

                        # Audit log (first batch only-ish via debug_info flag; warning freq-limited)
                        if len(missing_ids) > 0:
                            _audit_note = (
                                f"image={b} | labels_shape={tuple(labels_i.shape)} | "
                                f"ids_len={len(ids_list)} | kept_count={len(kept_list)} | "
                                f"matched={len(matched_labels)} | missing={len(missing_ids)} | "
                                f"missing_ids_sample={missing_ids[:5]}"
                            )
                            debug_info.setdefault("instance_align_missing", []).append(_audit_note)
                            if self._instance_align_warning_count < 5:
                                self._instance_align_warning_count += 1
                                print(
                                    f"[PHASE_D_INSTANCE_ALIGN_WARNING] "
                                    f"missing_labels_for_kept_ids={_audit_note}",
                                    flush=True,
                                )

                        if len(matched_labels) == 0:
                            # All kept ids missing labels → skip this image
                            inst_per_sample.append(
                                torch.zeros(0, 512, device=device, dtype=torch.float32)
                            )
                            debug_info["i_invalid"] += 1
                            continue

                        labels_kept_i = torch.stack(matched_labels, dim=0)  # [N_matched, 6]
                        n_kept = labels_kept_i.shape[0]

                    # ---------- Position-based fallback (kept_positions) ----------
                    elif kept_positions is not None and b < len(kept_positions):
                        kept_pos_i = kept_positions[b]  # [N_kept_i]
                        if kept_pos_i.numel() == 0:
                            inst_per_sample.append(
                                torch.zeros(0, 512, device=device, dtype=torch.float32)
                            )
                            debug_info["i_invalid"] += 1
                            continue

                        pos_min = kept_pos_i.min().item()
                        pos_max = kept_pos_i.max().item()

                        # Check bounds: safe if labels_i has enough rows
                        if pos_min >= 0 and pos_max < labels_i.shape[0]:
                            labels_kept_i = labels_i[kept_pos_i]  # [N_kept_i, 6]
                            n_kept = labels_kept_i.shape[0]
                            if self._instance_align_warning_count < 5:
                                self._instance_align_warning_count += 1
                                print(
                                    f"[PHASE_D_INSTANCE_ALIGN_FALLBACK] using position-based alignment "
                                    f"because per_instance_ids is missing for image={b}",
                                    flush=True,
                                )
                        else:
                            # OOB with position-based → skip this image entirely
                            if self._instance_align_warning_count < 5:
                                self._instance_align_warning_count += 1
                                print(
                                    f"[PHASE_D_INSTANCE_ALIGN_WARNING] image={b} position-based "
                                    f"alignment OOB: kept_positions [{pos_min}, {pos_max}] vs "
                                    f"labels.shape[0]={labels_i.shape[0]} — skipping instance text",
                                    flush=True,
                                )
                            inst_per_sample.append(
                                torch.zeros(0, 512, device=device, dtype=torch.float32)
                            )
                            debug_info["i_invalid"] += 1
                            continue
                    else:
                        # No alignment info available → skip
                        inst_per_sample.append(
                            torch.zeros(0, 512, device=device, dtype=torch.float32)
                        )
                        debug_info["i_invalid"] += 1
                        continue

                    # ---------- Build text embedding from matched labels ----------
                    if n_kept == 0:
                        inst_per_sample.append(
                            torch.zeros(0, 512, device=device, dtype=torch.float32)
                        )
                        debug_info["i_invalid"] += 1
                        continue

                    per_inst_texts: List[torch.Tensor] = []
                    for inst_idx in range(n_kept):
                        inst_6 = labels_kept_i[inst_idx]  # [6]
                        attr_embeds: List[torch.Tensor] = []
                        for j in range(N_inst_attr):
                            level = int(inst_6[j].item())
                            level = max(0, min(level, 2))
                            level_name = SB_LEVEL_NAMES[level]
                            key = f"{inst_attr_names[j]}_{level_name}"
                            emb = self._attr_text_instance_cache.get(key, None)
                            if emb is not None:
                                attr_embeds.append(emb.to(device=device, dtype=torch.float32))
                        if len(attr_embeds) > 0:
                            inst_embed = torch.mean(
                                torch.cat(attr_embeds, dim=0), dim=0, keepdim=True
                            )  # [1, 512]
                            per_inst_texts.append(inst_embed)
                    if len(per_inst_texts) > 0:
                        inst_per_sample.append(torch.cat(per_inst_texts, dim=0))  # [N_kept_i, 512]
                        debug_info["i_valid"] += 1
                    else:
                        inst_per_sample.append(
                            torch.zeros(0, 512, device=device, dtype=torch.float32)
                        )
                        debug_info["i_invalid"] += 1

                # [PHASE_C_INSTANCE_TEXT_AUDIT] per-instance mode audit
                _total_inst_n = sum(t.shape[0] for t in inst_per_sample if t is not None)
                debug_info["per_instance_mode"] = True
                debug_info["per_instance_total_N"] = _total_inst_n
                debug_info["instance_text_feat_is_none"] = (_total_inst_n == 0)
                inst_te = inst_per_sample  # List[Tensor[N_kept_i, 512]]

            else:
                # ----------------------------------------------------------------
                # Centroid mode: aggregate all kept instance labels → single [6] centroid
                # ----------------------------------------------------------------
                inst_embeds: List[torch.Tensor] = []
                _all_kept_labels: List[torch.Tensor] = []  # collect across batch for centroid computation

                for b in range(B):
                    labels_i = per_instance_attr_labels[b]  # [max_Ni, 6]

                    # ---------- Id-based alignment (preferred) ----------
                    if _use_id_alignment and b < len(per_instance_ids) and b < len(kept_instance_ids):
                        ids_i = per_instance_ids[b]
                        kept_ids_i = kept_instance_ids[b]

                        ids_list = _as_1d_int_list(ids_i)
                        kept_list = _as_1d_int_list(kept_ids_i)

                        id_to_row = {}
                        n_valid = min(len(ids_list), labels_i.shape[0])
                        for row_idx in range(n_valid):
                            inst_id = ids_list[row_idx]
                            if inst_id >= 0:
                                id_to_row[inst_id] = row_idx

                        matched_labels = []
                        missing_ids = []
                        for inst_id in kept_list:
                            row_idx = id_to_row.get(inst_id)
                            if row_idx is None:
                                missing_ids.append(inst_id)
                                continue
                            matched_labels.append(labels_i[row_idx])

                        if len(missing_ids) > 0:
                            if self._instance_align_warning_count < 5:
                                self._instance_align_warning_count += 1
                                print(
                                    f"[PHASE_D_INSTANCE_ALIGN_WARNING] centroid mode: "
                                    f"image={b} missing_labels_for_kept_ids={missing_ids[:5]}",
                                    flush=True,
                                )

                        if len(matched_labels) > 0:
                            labels_kept_i = torch.stack(matched_labels, dim=0)
                        else:
                            labels_kept_i = torch.zeros(0, 6, device=device, dtype=torch.long)

                    # ---------- Position-based fallback ----------
                    elif kept_positions is not None and b < len(kept_positions):
                        kept_pos_i = kept_positions[b]
                        if kept_pos_i.numel() > 0:
                            pos_min = kept_pos_i.min().item()
                            pos_max = kept_pos_i.max().item()
                            if pos_min >= 0 and pos_max < labels_i.shape[0]:
                                labels_kept_i = labels_i[kept_pos_i]
                                if self._instance_align_warning_count < 5:
                                    self._instance_align_warning_count += 1
                                    print(
                                        f"[PHASE_D_INSTANCE_ALIGN_FALLBACK] centroid mode: "
                                        f"using position-based alignment for image={b}",
                                        flush=True,
                                    )
                            else:
                                if self._instance_align_warning_count < 5:
                                    self._instance_align_warning_count += 1
                                    print(
                                        f"[PHASE_D_INSTANCE_ALIGN_WARNING] centroid mode: "
                                        f"image={b} position-based OOB — skipping",
                                        flush=True,
                                    )
                                labels_kept_i = torch.zeros(0, 6, device=device, dtype=torch.long)
                        else:
                            labels_kept_i = torch.zeros(0, 6, device=device, dtype=torch.long)
                    else:
                        labels_kept_i = torch.zeros(0, 6, device=device, dtype=torch.long)

                    n_kept = labels_kept_i.shape[0]
                    if n_kept > 0:
                        _all_kept_labels.append(labels_kept_i)
                    else:
                        inst_embeds.append(torch.zeros(1, 512, device=device, dtype=torch.float32))
                        debug_info["i_invalid"] += 1

                # Compute centroid across all kept instances in the batch
                if len(_all_kept_labels) > 0:
                    all_labels = torch.cat(_all_kept_labels, dim=0)  # [Total_N, 6]
                    attr_means = all_labels.float().mean(dim=0).long()  # [6]

                    # Build centroid text embedding
                    attr_embeds_centroid: List[torch.Tensor] = []
                    for j in range(N_inst_attr):
                        level = int(attr_means[j].item())
                        level = max(0, min(level, 2))
                        level_name = SB_LEVEL_NAMES[level]
                        key = f"{inst_attr_names[j]}_{level_name}"
                        emb = self._attr_text_instance_cache.get(key, None)
                        if emb is not None:
                            attr_embeds_centroid.append(emb.to(device=device, dtype=torch.float32))
                    if len(attr_embeds_centroid) > 0:
                        mean_emb = torch.mean(torch.cat(attr_embeds_centroid, dim=0), dim=0, keepdim=True)
                        inst_embeds.append(mean_emb)
                        debug_info["i_valid"] += 1
                    else:
                        inst_embeds.append(torch.zeros(1, 512, device=device, dtype=torch.float32))
                        debug_info["i_invalid"] += 1

                # [PHASE_C_INSTANCE_TEXT_AUDIT] centroid-mode audit
                debug_info["per_instance_mode"] = False
                debug_info["len_inst_embeds"] = len(inst_embeds)
                debug_info["len_inst_embeds_gt_0"] = len(inst_embeds) > 0
                debug_info["instance_text_feat_is_none"] = False
                inst_te = torch.cat(inst_embeds, dim=0)  # [B, text_dim]

        return struct_te, bound_te, inst_te, debug_info

    def _compute_attr_text_alignment_loss(
        self,
        struct_vis_feat: Optional[torch.Tensor],   # [B, visual_dim]
        bound_vis_feat: Optional[torch.Tensor],    # [B, visual_dim]
        inst_vis_feat: Optional[Union[torch.Tensor, List[torch.Tensor]]],  # [B, visual_dim] or List[Tensor[N_i, C]]
        struct_text_embed: Optional[torch.Tensor], # [B, text_dim]
        bound_text_embed: Optional[torch.Tensor],  # [B, text_dim]
        inst_text_embed: Optional[Union[torch.Tensor, List[torch.Tensor]]],  # [B, text_dim] or List[Tensor[N_i, D]]
    ) -> Dict[str, Any]:
        """
        Compute cosine alignment losses for structure, boundary, and instance pairs.

        Returns dict with keys:
            total_align_loss, s_loss, b_loss, i_loss,
            s_sim, b_sim, i_sim (mean cosine similarity per type),
            valid_instance_count, text_norm_mean, visual_norm_mean,
            text_norm_min, text_norm_max, visual_norm_min, visual_norm_max
        """
        result: Dict[str, Any] = {
            "total_align_loss": torch.tensor(0.0, device=next(self.parameters()).device, requires_grad=True),
            "s_loss": None, "b_loss": None, "i_loss": None,
            "s_sim": None, "b_sim": None, "i_sim": None,
            "valid_instance_count": 0,
        }

        def _pair_loss(
            vis_feat: Optional[torch.Tensor],
            text_embed: Optional[torch.Tensor],
            vis_proj: Optional[nn.Linear],
            text_proj: Optional[nn.Linear],
            pair_name: str = "unknown",
        ) -> Tuple[Optional[torch.Tensor], Optional[torch.Tensor]]:
            """Compute cosine alignment loss for one pair. Returns (loss, sim).
            Shape validation:
              Pre-projection:  only N (batch/instance) dimension must match.
                               vis_feat.shape = [N, C_vis], text_embed.shape = [N, D_text].
                               C_vis and D_text may differ (e.g. 256 vs 512) — this is expected.
              Post-projection: full shape must match after both are projected to common space.
            """
            if vis_feat is None or text_embed is None or vis_proj is None or text_proj is None:
                return None, None
            # Pre-projection: only validate N dimension and tensor rank.
            #   vis_feat may be [N, 256], text_embed may be [N, 512] — this is normal.
            if vis_feat.dim() != text_embed.dim():
                raise RuntimeError(
                    f"[PHASE_C][SHAPE_MISMATCH] {pair_name}: vis_feat.dim()={vis_feat.dim()} "
                    f"!= text_embed.dim()={text_embed.dim()}. "
                    f"vis_feat.shape={tuple(vis_feat.shape)}, text_embed.shape={tuple(text_embed.shape)}"
                )
            if vis_feat.shape[0] != text_embed.shape[0]:
                raise RuntimeError(
                    f"[PHASE_C][SHAPE_MISMATCH] {pair_name}: vis_feat.shape[0]={vis_feat.shape[0]} "
                    f"!= text_embed.shape[0]={text_embed.shape[0]}. "
                    f"vis_feat.shape={tuple(vis_feat.shape)}, text_embed.shape={tuple(text_embed.shape)}"
                )
            # Project to common space
            v = vis_proj(vis_feat)  # [N, text_dim]
            t = text_proj(text_embed)  # [N, text_dim]
            # Post-projection: full shape must match (both now [N, text_dim])
            if v.shape != t.shape:
                raise RuntimeError(
                    f"[PHASE_C][SHAPE_MISMATCH] {pair_name}: post-projection shape mismatch. "
                    f"v.shape={tuple(v.shape)} != t.shape={tuple(t.shape)}. "
                    f"vis_feat.shape={tuple(vis_feat.shape)}, text_embed.shape={tuple(text_embed.shape)}. "
                    f"vis_proj={vis_proj}, text_proj={text_proj}"
                )
            # Normalize
            v = F.normalize(v, dim=-1, eps=1e-6)
            t = F.normalize(t, dim=-1, eps=1e-6)
            # Cosine similarity
            sim = (v * t).sum(dim=-1)  # [N]
            loss = (1.0 - sim).mean()  # scalar
            sim_mean = sim.detach().mean()  # scalar
            return loss, sim_mean

        device = next(self.parameters()).device

        # Structure pair
        s_loss, s_sim = _pair_loss(
            struct_vis_feat, struct_text_embed,
            self.attr_align_vis_proj_structure, self.attr_align_text_proj,
            pair_name="structure",
        )
        if s_loss is not None:
            result["s_loss"] = s_loss
            result["s_sim"] = s_sim

        # Boundary pair
        b_loss, b_sim = _pair_loss(
            bound_vis_feat, bound_text_embed,
            self.attr_align_vis_proj_boundary, self.attr_align_text_proj,
            pair_name="boundary",
        )
        if b_loss is not None:
            result["b_loss"] = b_loss
            result["b_sim"] = b_sim

        # Instance pair: supports both [B, D] (per-sample centroid) and List[Tensor[N_i, D]] (per-instance)
        i_loss: Optional[torch.Tensor] = None
        i_sim: Optional[torch.Tensor] = None
        valid_instance_count: int = 0

        # --- Empty instance guard: skip instance alignment if NO valid instances survive ---
        if isinstance(inst_vis_feat, list) and isinstance(inst_text_embed, list):
            # Per-instance alignment: concatenate all instances across batch → [N_total, D]
            _valid_vis = [f for f in inst_vis_feat if f is not None and f.shape[0] > 0]
            _valid_txt = [f for f in inst_text_embed if f is not None and f.shape[0] > 0]
            valid_instance_count = sum(f.shape[0] for f in _valid_vis)
            _valid_txt_count = sum(f.shape[0] for f in _valid_txt)

            # Guard: visual and text must agree on empty/non-empty status
            if (len(_valid_vis) == 0) != (len(_valid_txt) == 0):
                raise RuntimeError(
                    f"[ATTR_TEXT_INSTANCE_ALIGN_ERROR][EMPTY_MISMATCH] visual has {len(_valid_vis)} non-empty "
                    f"samples (total N={valid_instance_count}) but text has {len(_valid_txt)} "
                    f"non-empty samples (total N={_valid_txt_count}). "
                    "Visual and text instance lists disagree on which images have valid instances."
                )
            if valid_instance_count != _valid_txt_count:
                raise RuntimeError(
                    f"[ATTR_TEXT_INSTANCE_ALIGN_ERROR] visual total N={valid_instance_count} != "
                    f"text total N={_valid_txt_count}. Instance-level alignment requires equal "
                    "counts between visual and text branches."
                )

            if len(_valid_vis) > 0 and len(_valid_txt) > 0 and valid_instance_count > 0:
                _i_vis_all = torch.cat(_valid_vis, dim=0)   # [N_total, C]
                _i_txt_all = torch.cat(_valid_txt, dim=0)   # [N_total, D]
                i_loss, i_sim = _pair_loss(
                    _i_vis_all, _i_txt_all,
                    self.attr_align_vis_proj_instance, self.attr_align_text_proj,
                    pair_name="instance_per_inst",
                )
            # else: all instances are empty → skip instance alignment (valid_instance_count stays 0)
        elif isinstance(inst_vis_feat, torch.Tensor) and isinstance(inst_text_embed, torch.Tensor):
            # Per-sample centroid mode: [B, D]
            valid_instance_count = inst_vis_feat.shape[0]
            if valid_instance_count != inst_text_embed.shape[0]:
                raise RuntimeError(
                    f"[ATTR_TEXT_INSTANCE_ALIGN_ERROR] centroid mode: "
                    f"vis.shape[0]={valid_instance_count} != text.shape[0]={inst_text_embed.shape[0]}. "
                    f"vis.shape={tuple(inst_vis_feat.shape)}, text.shape={tuple(inst_text_embed.shape)}"
                )
            if valid_instance_count > 0:
                i_loss, i_sim = _pair_loss(
                    inst_vis_feat, inst_text_embed,
                    self.attr_align_vis_proj_instance, self.attr_align_text_proj,
                    pair_name="instance",
                )
            # else: 0 instances → skip instance alignment
        if i_loss is not None:
            result["i_loss"] = i_loss
            result["i_sim"] = i_sim
        result["valid_instance_count"] = valid_instance_count

        # Total loss: sum of individual losses (each defaults to 0 if None)
        total = torch.tensor(0.0, device=device, requires_grad=True)
        count = 0
        for loss_key in ["s_loss", "b_loss", "i_loss"]:
            if result[loss_key] is not None:
                total = total + result[loss_key]
                count += 1
        result["total_align_loss"] = total / max(count, 1)

        # --- RuntimeError on unexpected NaN/Inf in any loss or sim ---
        for _nan_key in ["s_loss", "b_loss", "i_loss", "s_sim", "b_sim", "i_sim"]:
            _nan_val = result.get(_nan_key, None)
            if _nan_val is not None and torch.is_tensor(_nan_val):
                if torch.isnan(_nan_val).any() or torch.isinf(_nan_val).any():
                    raise RuntimeError(
                        f"[PHASE_C][FATAL] {_nan_key} contains NaN/Inf "
                        f"(value={_nan_val}). Check feature extraction or projection heads."
                    )

        # --- Aggregate text_norm_mean / visual_norm_mean always (not just debug) ---
        with torch.no_grad():
            # Collect all visual feature norms
            _all_v_norms: List[torch.Tensor] = []
            # Collect all text embedding norms
            _all_t_norms: List[torch.Tensor] = []

        # Structure
        if struct_vis_feat is not None and struct_text_embed is not None:
            _all_v_norms.append(struct_vis_feat.float().norm(dim=-1))
            _all_t_norms.append(struct_text_embed.float().norm(dim=-1))

        # Boundary
        if bound_vis_feat is not None and bound_text_embed is not None:
            _all_v_norms.append(bound_vis_feat.float().norm(dim=-1))
            _all_t_norms.append(bound_text_embed.float().norm(dim=-1))

        # Instance (per-instance mode)
        if isinstance(inst_vis_feat, list) and len(inst_vis_feat) > 0:
            _valid_i_vis = [f for f in inst_vis_feat if f is not None and f.shape[0] > 0]
            if _valid_i_vis:
                _all_v_norms.append(torch.cat(_valid_i_vis, dim=0).float().norm(dim=-1))
        elif isinstance(inst_vis_feat, torch.Tensor) and inst_vis_feat is not None:
            _all_v_norms.append(inst_vis_feat.float().norm(dim=-1))

        if isinstance(inst_text_embed, list) and len(inst_text_embed) > 0:
            _valid_i_txt = [f for f in inst_text_embed if f is not None and f.shape[0] > 0]
            if _valid_i_txt:
                _all_t_norms.append(torch.cat(_valid_i_txt, dim=0).float().norm(dim=-1))
        elif isinstance(inst_text_embed, torch.Tensor) and inst_text_embed is not None:
            _all_t_norms.append(inst_text_embed.float().norm(dim=-1))

        # Compute aggregated stats
        _audit_info = {}
        if _all_v_norms:
            _cat_v = torch.cat(_all_v_norms, dim=0)
            _audit_info["visual_norm_mean"] = _cat_v.mean().item()
            _audit_info["visual_norm_min"] = _cat_v.min().item()
            _audit_info["visual_norm_max"] = _cat_v.max().item()
        if _all_t_norms:
            _cat_t = torch.cat(_all_t_norms, dim=0)
            _audit_info["text_norm_mean"] = _cat_t.mean().item()
            _audit_info["text_norm_min"] = _cat_t.min().item()
            _audit_info["text_norm_max"] = _cat_t.max().item()

        result["audit_norms"] = _audit_info

        return result

    def _get_semantic_channel_gate(
        self,
        semantic_delta: torch.Tensor,
        device: torch.device,
        dtype: torch.dtype,
    ) -> torch.Tensor:
        if not hasattr(self.pnurl, "semantic_channel_gate"):
            _lazy_init_bias = float(self.semantic_gate_bias_init) if self.semantic_gate_bias_init is not None else -4.0
            self.pnurl.semantic_channel_gate = SemanticChannelGate(
                embed_dim=semantic_delta.shape[1],
                reduction=16,
                init_bias=_lazy_init_bias,
                max_gate=self.max_semantic_gate,
            ).to(device)

        channel_gate = self.pnurl.semantic_channel_gate(semantic_delta.to(dtype=torch.float32))

        # ==================================================================
        # PNURL_AUDIT: SemanticChannelGate debug prints (Item 4)
        # ==================================================================
        global _PNURL_AUDIT_SAM_COUNTER
        if _PNURL_AUDIT and _PNURL_AUDIT_SAM_COUNTER < 6:
            # Gate input norm (semantic_delta norm before gate)
            _gate_input_norm = semantic_delta.detach().float().norm(dim=1).mean().item()
            # Gate logits = output of gate conv (before sigmoid)
            _gate_module = self.pnurl.semantic_channel_gate
            with torch.no_grad():
                gate_input_f32 = semantic_delta.detach().float()
                gap = gate_input_f32.mean(dim=(2, 3), keepdim=True)
                gate_logits = _gate_module.gate[0](gap)  # Conv2d(256->16)
                gate_logits = _gate_module.gate[1](gate_logits)  # GELU
                gate_logits = _gate_module.gate[2](gate_logits)  # Conv2d(16->256)
                gate_logits = gate_logits.view(gate_logits.shape[0], -1)
            _sigmoid_gate = torch.sigmoid(gate_logits) * _gate_module.max_gate
            print(f"\n[PNURL_AUDIT_GATE] call={_PNURL_AUDIT_SAM_COUNTER}", flush=True)
            print(f"  gate_input_norm={_gate_input_norm:.6e}", flush=True)
            print(f"  gate_logits: mean={gate_logits.mean().item():.4f}  "
                  f"std={gate_logits.std().item():.4f}  "
                  f"min={gate_logits.min().item():.4f}  "
                  f"max={gate_logits.max().item():.4f}", flush=True)
            print(f"  sigmoid_gate: mean={_sigmoid_gate.mean().item():.6e}  "
                  f"std={_sigmoid_gate.std().item():.6e}  "
                  f"min={_sigmoid_gate.min().item():.6e}  "
                  f"max={_sigmoid_gate.max().item():.6e}", flush=True)
            print(f"  max_gate_param={_gate_module.max_gate}", flush=True)

        return channel_gate.to(device=device, dtype=dtype)

    @staticmethod
    def _controlled_residual_injection(
        image_embeddings: torch.Tensor,
        semantic_delta: torch.Tensor,
        channel_gate: torch.Tensor,
        semantic_injection_scale: float = 1.0,
    ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
        if semantic_delta.shape != image_embeddings.shape:
            raise ValueError(
                f"semantic_delta shape mismatch: expected {tuple(image_embeddings.shape)}, "
                f"got {tuple(semantic_delta.shape)}"
            )

        injected_delta = channel_gate * semantic_delta * semantic_injection_scale
        refined_image_embeddings = image_embeddings + injected_delta

        base_feat_norm = image_embeddings.detach().float().norm(dim=1).mean()
        injected_delta_norm = injected_delta.detach().float().norm(dim=1).mean()
        injection_ratio = injected_delta_norm / (base_feat_norm + 1e-6)

        return refined_image_embeddings, injected_delta, injected_delta_norm, injection_ratio

    def _rescale_semantic_delta(
        self,
        semantic_delta: torch.Tensor,
        image_embeddings: torch.Tensor,
        target_ratio: float = 0.02,
        max_scale: float = 10000.0,
    ) -> torch.Tensor:
        if semantic_delta is None:
            return semantic_delta

        with torch.no_grad():
            base_norm = (
                image_embeddings.detach()
                .float()
                .norm(dim=1, keepdim=True)
                .mean(dim=(2, 3), keepdim=True)
                .clamp_min(1e-6)
            )

            delta_norm = (
                semantic_delta.detach()
                .float()
                .norm(dim=1, keepdim=True)
                .mean(dim=(2, 3), keepdim=True)
                .clamp_min(1e-6)
            )

            scale = (base_norm * float(target_ratio)) / delta_norm
            scale = torch.clamp(scale, min=0.0, max=float(max_scale))

        return semantic_delta * scale.to(
            device=semantic_delta.device,
            dtype=semantic_delta.dtype,
        )

    def forward(self, batched_input, multimask_output=False):
        # ═══════════════════════════════════════════════════════════════
        # GT Leakage Protection: reject oracle spatial maps in eval mode
        # ═══════════════════════════════════════════════════════════════
        if not self.training and self.spatial_sb_mode != "none":
            for _b_item in batched_input:
                if "structure_target" in _b_item or "boundary_target" in _b_item:
                    raise RuntimeError(
                        f"[GT_LEAKAGE] Oracle spatial map detected in batched_input "
                        f"during eval mode! structure_target={_b_item.get('structure_target', 'N/A')} "
                        f"boundary_target={_b_item.get('boundary_target', 'N/A')}. "
                        f"GT spatial maps must NOT be passed to model in eval mode — "
                        f"they belong only in train.py loss computation."
                    )
        input_images = torch.stack([self.preprocess(x["image"]) for x in batched_input], dim=0)
        image_embeddings = self.image_encoder(input_images)
        device = image_embeddings.device

        # ==============================================================
        # SGA-SB v1 CORRECTION: Spatial Structure/Boundary Guidance
        #
        # Two independent prediction heads:
        #   SpatialStructureHead → structure_logits [B, 1, H_low, W_low]
        #   SpatialBoundaryHead  → boundary_logits [B, 1, H_high, W_high]
        #
        # Three modes:
        #   "none"              — skip entirely
        #   "supervision_only"  — predict + compute losses, NO feature injection
        #   "guidance"          — predict + losses + inject into FreqPathAsrBlock
        #
        # GT targets (structure_target, boundary_target) exist ONLY in train.py
        # loss computation. Model forward never receives GT spatial maps.
        # ==============================================================
        structure_logits: Optional[torch.Tensor] = None
        boundary_logits: Optional[torch.Tensor] = None
        structure_guidance_map: Optional[torch.Tensor] = None
        boundary_guidance_map: Optional[torch.Tensor] = None
        structure_delta: Optional[torch.Tensor] = None
        boundary_delta: Optional[torch.Tensor] = None

        if self.spatial_sb_mode != "none":
            # ── Structure head (low-res occupancy) ──
            if self.spatial_structure_head is not None:
                structure_logits = self.spatial_structure_head(image_embeddings)  # [B, 1, 64, 64]
                structure_prob = torch.sigmoid(structure_logits)
                structure_guidance_map = structure_prob

                if self.spatial_sb_mode == "guidance" and self.spatial_structure_adapter is not None:
                    structure_delta = self.spatial_structure_adapter(structure_prob)

            # ── Boundary head (high-res instance boundary) ──
            if self.spatial_boundary_head is not None:
                boundary_logits = self.spatial_boundary_head(image_embeddings)  # [B, 1, 64, 64]
                boundary_prob = torch.sigmoid(boundary_logits)
                boundary_guidance_map = boundary_prob

                if self.spatial_sb_mode == "guidance" and self.spatial_boundary_adapter is not None:
                    boundary_delta = self.spatial_boundary_adapter(boundary_prob)

        # ── Legacy spatial_instance_attr_mode (ablation, separate from corrected mode) ──
        spatial_attr_logits: Optional[torch.Tensor] = None
        spatial_guidance_map: Optional[torch.Tensor] = None
        if self.spatial_instance_attr_mode != "none" and self.spatial_instance_attr_head is not None:
            spatial_attr_logits = self.spatial_instance_attr_head(image_embeddings)  # [B, 18, 64, 64]
            _guidance_out = self.spatial_instance_sb_guidance(spatial_attr_logits)
            spatial_guidance_map = _guidance_out["guidance_64"]  # [B, 1, 64, 64]

        # ═══════════════════════════════════════════════════════════════
        # SPATIAL_SB_FORWARD_AUDIT: diagnostic logging (first 2 forward calls)
        # ═══════════════════════════════════════════════════════════════
        _spatial_sb_audit_count = getattr(self, "_spatial_sb_audit_count", 0)
        if _spatial_sb_audit_count < 2:
            self._spatial_sb_audit_count = _spatial_sb_audit_count + 1
            _spatial_sb_mode = self.spatial_sb_mode
            _spatial_sb_branch = self.spatial_sb_branch
            print(f"\n[SPATIAL_SB_FORWARD_AUDIT] count={_spatial_sb_audit_count}", flush=True)
            print(f"  spatial_sb_mode={_spatial_sb_mode} | spatial_sb_branch={_spatial_sb_branch}", flush=True)
            if structure_logits is not None:
                with torch.no_grad():
                    _s_norm = structure_logits.detach().float().norm().item()
                    _s_mean = structure_logits.detach().float().mean().item()
                    _s_std = structure_logits.detach().float().std().item()
                    print(f"  structure_logits: shape={tuple(structure_logits.shape)} norm={_s_norm:.6e} mean={_s_mean:.6e} std={_s_std:.6e}", flush=True)
            else:
                print(f"  structure_logits: None", flush=True)
            if boundary_logits is not None:
                with torch.no_grad():
                    _b_norm = boundary_logits.detach().float().norm().item()
                    _b_mean = boundary_logits.detach().float().mean().item()
                    _b_std = boundary_logits.detach().float().std().item()
                    print(f"  boundary_logits:  shape={tuple(boundary_logits.shape)} norm={_b_norm:.6e} mean={_b_mean:.6e} std={_b_std:.6e}", flush=True)
            else:
                print(f"  boundary_logits:  None", flush=True)
            if structure_delta is not None:
                with torch.no_grad():
                    _sd_norm = structure_delta.detach().float().norm().item()
                    print(f"  structure_delta:  shape={tuple(structure_delta.shape)} norm={_sd_norm:.6e}", flush=True)
            else:
                print(f"  structure_delta:  None (mode={_spatial_sb_mode})", flush=True)
            if boundary_delta is not None:
                with torch.no_grad():
                    _bd_norm = boundary_delta.detach().float().norm().item()
                    print(f"  boundary_delta:   shape={tuple(boundary_delta.shape)} norm={_bd_norm:.6e}", flush=True)
            else:
                print(f"  boundary_delta:   None (mode={_spatial_sb_mode})", flush=True)
            if getattr(self, "spatial_instance_attr_mode", "none") != "none":
                if spatial_attr_logits is not None:
                    with torch.no_grad():
                        _aa_norm = spatial_attr_logits.detach().float().norm().item()
                        print(f"  [LEGACY] spatial_attr_logits: shape={tuple(spatial_attr_logits.shape)} norm={_aa_norm:.6e}", flush=True)
            print(f"  ── end SPATIAL_SB_FORWARD_AUDIT ──\n", flush=True)

        # ==============================================================
        # PNuDP: PromptNu Dense Prediction Diagnostic
        # Projects spatial features to CONCH text space and computes dense
        # similarity maps with the text bank. Diagnostic-only — no training.
        # ==============================================================
        _pnudp_diag_data: Dict[str, Any] = {}
        _pnudp_enabled = getattr(self, "enable_pnudp_diag", False)
        _pnudp_module = getattr(self, "pnudp_diag", None)
        if _pnudp_enabled and _pnudp_module is not None and not self.training:
            with torch.no_grad():
                # Build combined text bank from structure + boundary
                _s_bank = self._get_sb_text_bank("structure", device)   # [5, 3, D]
                _b_bank = self._get_sb_text_bank("boundary", device)     # [4, 3, D]
                _s_bank_flat = _s_bank.reshape(-1, _s_bank.shape[-1])    # [15, D]
                _b_bank_flat = _b_bank.reshape(-1, _b_bank.shape[-1])    # [12, D]
                _pnudp_text_bank = torch.cat([_s_bank_flat, _b_bank_flat], dim=0)  # [27, D]

                # Run PNuDP on original image_embeddings
                _pnudp_logits, _pnudp_fused, _pnudp_diag = _pnudp_module(
                    spatial_feat=image_embeddings,
                    text_bank=_pnudp_text_bank,
                    fusion_mode=getattr(self, "pnudp_fusion_mode", "none"),
                )
                _pnudp_diag_data = _pnudp_diag

                # Apply fusion if mode is active (replace image_embeddings)
                _fm = getattr(self, "pnudp_fusion_mode", "none")
                if _fm not in (None, "none", ""):
                    # Fusion modifies image_embeddings; store original for diagnostics
                    _pnudp_diag_data["original_feat_norm_before_fusion"] = (
                        image_embeddings.detach().float().norm(dim=1).mean().item()
                    )
                    image_embeddings = _pnudp_fused
                    _pnudp_diag_data["fused_feat_norm_after_fusion"] = (
                        image_embeddings.detach().float().norm(dim=1).mean().item()
                    )
                    print(
                        f"[PNUDP_FUSION] fusion_mode={_fm} | "
                        f"original_feat_norm={_pnudp_diag_data['original_feat_norm_before_fusion']:.6e} | "
                        f"fused_feat_norm={_pnudp_diag_data['fused_feat_norm_after_fusion']:.6e}",
                        flush=True,
                    )

                # [PNUDP_DIAG] diagnostic print (first 2 calls)
                _pnudp_diag_count = getattr(self, "_pnudp_diag_count", 0)
                if _pnudp_diag_count < 2:
                    self._pnudp_diag_count = _pnudp_diag_count + 1
                    _dfn = _pnudp_diag.get("dense_feat_norm", float("nan"))
                    _tbn = _pnudp_diag.get("text_bank_norm", float("nan"))
                    _lm = _pnudp_diag.get("dense_text_logits_mean", float("nan"))
                    _ls = _pnudp_diag.get("dense_text_logits_std", float("nan"))
                    _lx = _pnudp_diag.get("dense_text_logits_max", float("nan"))
                    _ent = _pnudp_diag.get("dense_text_entropy", float("nan"))
                    # Top-1 prompt distribution (first few)
                    _top1_str = ", ".join(
                        f"p{kk}={_pnudp_diag.get(f'top1_prompt_{kk}_ratio', 0.0):.4f}"
                        for kk in range(min(6, _pnudp_text_bank.shape[0]))
                    )
                    print("[PNUDP_DIAG]", flush=True)
                    print(f"  dense_feat_norm={_dfn:.6e}", flush=True)
                    print(f"  text_bank_norm={_tbn:.6e}", flush=True)
                    print(f"  dense_text_logits_mean={_lm:.6e}  std={_ls:.6e}  max={_lx:.6e}", flush=True)
                    print(f"  dense_text_entropy={_ent:.6e}", flush=True)
                    print(f"  top1_prompt_distribution (first 6): {_top1_str}", flush=True)

        # Structure & Boundary Attribute Heads (GT-derived pathology attributes)
        # 使用 image_embeddings 的 GAP 特征，最小侵入方案
        structure_attr_logits: Optional[torch.Tensor] = None
        boundary_attr_logits: Optional[torch.Tensor] = None
        if self.enable_structure_boundary_attr_heads and self.structure_boundary_attr_heads is not None:
            structure_attr_logits, boundary_attr_logits = self.structure_boundary_attr_heads(
                image_embeddings
            )  # [B,5,3], [B,4,3]

        # MultiLevel Attribute Heads (Phase B)
        # 输出: structure_attr_logits [B,5,3], dense_boundary_maps Dict[4×B,1,H,W], instance_attr_logits [B,6,3]
        multilevel_attr_logits: Optional[Dict[str, Any]] = None
        if self.enable_multilevel_attr_heads and self.multilevel_attr_heads is not None:
            # Extract GT instance mask from batched_input for instance morphology head
            _label_inst_list = [x.get("label_inst", None) for x in batched_input]
            _label_inst: Optional[torch.Tensor] = None
            if all(l is not None for l in _label_inst_list):
                _label_inst = torch.stack(_label_inst_list, dim=0).float().to(device)
            multilevel_attr_logits = self.multilevel_attr_heads(
                image_embeddings,
                label_inst=_label_inst,
                return_features=self.enable_attr_text_alignment,
            )  # Dict with structure_attr_logits, dense_boundary_maps, instance_attr_logits

        # --- Forward order fix: extract structure/boundary logits from multilevel_attr_logits ---
        # When only enable_multilevel_attr_heads is True (standalone, without
        # enable_structure_boundary_attr_heads), structure_attr_logits and boundary_attr_logits
        # are stored inside the multilevel_attr_logits dict.  Extract them here, BEFORE the
        # use_pnurl / v3 guidance block, so that PromptNuGuidedAdapter and the cosine alignment
        # loss can access them even when the standalone heads are disabled.
        if multilevel_attr_logits is not None:
            _ml_struct: Optional[torch.Tensor] = multilevel_attr_logits.get("structure_attr_logits", None)
            _ml_bound: Optional[torch.Tensor] = multilevel_attr_logits.get("boundary_attr_logits", None)
            if structure_attr_logits is None and _ml_struct is not None:
                structure_attr_logits = _ml_struct
            if boundary_attr_logits is None and _ml_bound is not None:
                boundary_attr_logits = _ml_bound

        # ==============================================================
        # Phase C: Attribute-Text Alignment
        # ==============================================================
        attr_text_align_loss: Optional[torch.Tensor] = None
        attr_text_align_debug: Dict[str, Any] = {}
        if self.enable_attr_text_alignment and multilevel_attr_logits is not None:
            # 1. Extract visual features from multilevel_attr_heads (returned when return_features=True)
            _s_vis = multilevel_attr_logits.get("structure_visual_feat", None)  # [B, embed_dim]
            _b_vis = multilevel_attr_logits.get("boundary_visual_feat", None)   # [B, embed_dim]
            # Instance: use per-instance intermediate features [List[Tensor[N_i, C]]] for per-instance alignment
            _i_vis_intermediate = multilevel_attr_logits.get("instance_intermediate_feats", None)  # List[Tensor[N_i, C]]
            _i_vis_pooled = multilevel_attr_logits.get("instance_visual_feat", None)  # [B, embed_dim] — fallback

            # 2. Get GT labels from batched_input
            _s_labels_list = [x.get("structure_attr_labels", None) for x in batched_input]
            _b_labels_list = [x.get("boundary_attr_labels", None) for x in batched_input]
            _i_labels_list = [x.get("per_instance_attr_labels", None) for x in batched_input]
            _i_ids_list = [x.get("per_instance_ids", None) for x in batched_input]

            _s_labels: Optional[torch.Tensor] = None
            _b_labels: Optional[torch.Tensor] = None
            _i_labels: Optional[torch.Tensor] = None
            _i_ids: Optional[List] = None

            if all(l is not None for l in _s_labels_list):
                _s_labels = torch.stack(_s_labels_list, dim=0).to(device=device, dtype=torch.long)
            if all(l is not None for l in _b_labels_list):
                _b_labels = torch.stack(_b_labels_list, dim=0).to(device=device, dtype=torch.long)
            # Instance labels: [B, N_i, 6] — pad to same N_i
            if all(l is not None for l in _i_labels_list):
                _max_ni = max(l.shape[0] for l in _i_labels_list)
                _padded = []
                for l in _i_labels_list:
                    if l.shape[0] < _max_ni:
                        pad = torch.zeros(_max_ni - l.shape[0], 6, device=l.device, dtype=l.dtype)
                        _padded.append(torch.cat([l, pad], dim=0))
                    else:
                        _padded.append(l)
                _i_labels = torch.stack(_padded, dim=0).to(device=device, dtype=torch.long)
                # Per-instance IDs: keep as per-image list (avoids padding sentinel issues)
                if any(ids is not None for ids in _i_ids_list):
                    _i_ids = _i_ids_list  # List[Optional[Tensor[N_i]]]

            # 3. Extract kept_positions and kept_instance_ids from visual branch
            _i_kept_positions = multilevel_attr_logits.get("instance_kept_positions", None)
            _i_kept_instance_ids = multilevel_attr_logits.get("instance_kept_instance_ids", None)

            # 3a. Pre-validate kept_positions against padded instance labels (OOB audit → warning, not crash)
            if _i_kept_positions is not None and _i_labels is not None and (
                isinstance(_i_vis_intermediate, list) and len(_i_vis_intermediate) > 0
            ):
                _raw_counts = multilevel_attr_logits.get("instance_raw_counts", None)
                _raw_instance_ids = multilevel_attr_logits.get("instance_raw_instance_ids", None)
                for _b_idx in range(min(len(_i_kept_positions), _i_labels.shape[0])):
                    _kp = _i_kept_positions[_b_idx]
                    if _kp.numel() == 0:
                        continue
                    _pos_min = _kp.min().item()
                    _pos_max = _kp.max().item()
                    _labels_dim = _i_labels[_b_idx].shape[0]  # max_Ni (padded)
                    if _pos_min < 0 or _pos_max >= _labels_dim:
                        _num_kept = _kp.shape[0]
                        _kid_str = _i_kept_instance_ids[_b_idx].tolist() if (
                            _i_kept_instance_ids is not None and _b_idx < len(_i_kept_instance_ids)
                        ) else "N/A"
                        _raw_cnt = _raw_counts[_b_idx] if _raw_counts is not None and _b_idx < len(_raw_counts) else "N/A"
                        _rid_str = _raw_instance_ids[_b_idx].tolist() if (
                            _raw_instance_ids is not None and _b_idx < len(_raw_instance_ids)
                        ) else "N/A"
                        # Warning only — id-based alignment inside _get_attr_text_embeddings handles mismatch
                        if self.debug_instance_align_audit and self._instance_align_audit_count < 2:
                            self._instance_align_audit_count += 1
                            print(
                                f"[PHASE_D_INSTANCE_ALIGN_AUDIT] image={_b_idx} | "
                                f"kept_positions [{_pos_min},{_pos_max}] vs labels.shape[0]={_labels_dim} | "
                                f"raw_instance_count={_raw_cnt} | num_kept={_num_kept} | "
                                f"kept_instance_ids={_kid_str} | "
                                f"raw_instance_ids={_rid_str} | "
                                f"per_instance_ids available: {_i_ids is not None}",
                                flush=True,
                            )

            # 3b. Lookup text embeddings from cache, using per_instance_ids for alignment
            _use_per_instance = (
                isinstance(_i_vis_intermediate, list) and len(_i_vis_intermediate) > 0
            )
            _s_text, _b_text, _i_text, _align_debug = self._get_attr_text_embeddings(
                structure_attr_labels=_s_labels,
                boundary_attr_labels=_b_labels,
                per_instance_attr_labels=_i_labels,
                kept_positions=_i_kept_positions if _use_per_instance else None,
                return_per_instance_text=_use_per_instance,
                per_instance_ids=_i_ids if _use_per_instance else None,
                kept_instance_ids=_i_kept_instance_ids if _use_per_instance else None,
            )
            attr_text_align_debug.update(_align_debug)

            # Determine instance visual input for alignment
            _inst_vis_input = _i_vis_intermediate if _use_per_instance else _i_vis_pooled

            # ----------------------------------------------------------
            # 3b-i. Synchronize visual instance features with text alignment
            #       Use matched_kept_positions_per_image from _get_attr_text_embeddings
            #       to filter _inst_vis_input so visual N == text N.
            # ----------------------------------------------------------
            if _use_per_instance and isinstance(_inst_vis_input, list):
                _matched_positions = _align_debug.get("matched_kept_positions_per_image", None)
                if _matched_positions is not None and len(_matched_positions) > 0:
                    _filtered_vis: List[torch.Tensor] = []
                    for _b_idx in range(len(_inst_vis_input)):
                        _vis_t = _inst_vis_input[_b_idx]
                        # If matched_positions exists for this image, MUST filter by it
                        _pos = _matched_positions[_b_idx] if _b_idx < len(_matched_positions) else []
                        if _vis_t is None:
                            _filtered_vis.append(_vis_t)
                        elif _vis_t.shape[0] == 0:
                            # visual is already empty → keep as-is
                            _filtered_vis.append(_vis_t)
                        elif len(_pos) == 0:
                            # All instances missing labels → force to empty visual
                            _filtered_vis.append(
                                torch.zeros(0, _vis_t.shape[1], device=_vis_t.device, dtype=_vis_t.dtype)
                            )
                        else:
                            # Normal: keep only matched instance rows
                            _filtered_vis.append(_vis_t[_pos])
                    _inst_vis_input = _filtered_vis

                    # [PHASE_D_INSTANCE_ALIGN_AUDIT] report alignment counts
                    _vis_used_total = sum(
                        f.shape[0] for f in _inst_vis_input if f is not None
                    )
                    _txt_used_total = sum(
                        f.shape[0] for f in _i_text if isinstance(f, torch.Tensor) and f is not None
                    ) if isinstance(_i_text, list) else 0
                    _matched_total = sum(len(p) for p in _matched_positions)
                    _missing_total = sum(
                        len(m) for m in (_align_debug.get("missing_ids_per_image", []))
                    )
                    if self.debug_instance_align_audit and self._instance_align_audit_count < 2:
                        self._instance_align_audit_count += 1
                        print(
                            f"[PHASE_D_INSTANCE_ALIGN_AUDIT] "
                            f"visual_used={_vis_used_total} text_used={_txt_used_total} "
                            f"matched={_matched_total} missing={_missing_total}",
                            flush=True,
                        )
                        if _vis_used_total != _txt_used_total:
                            print(
                                f"[PHASE_D_INSTANCE_ALIGN_AUDIT][WARNING] "
                                f"visual_used ({_vis_used_total}) != text_used ({_txt_used_total}) "
                                f"— alignment may still fail!",
                                flush=True,
                            )

            # ----------------------------------------------------------
            # 3c. First-batch input/feature audit (debug_phase_c_audit)
            # ----------------------------------------------------------
            if self.debug_phase_c_audit:
                # Obtain label_inst (used by InstanceMorphologyHead for masked pooling)
                _label_inst_debug = None
                _label_inst_list_debug = [x.get("label_inst", None) for x in batched_input]
                if all(l is not None for l in _label_inst_list_debug):
                    _label_inst_debug = torch.stack(_label_inst_list_debug, dim=0)
                print("\n[PHASE_C_INPUT_AUDIT]", flush=True)
                print(f"  has_structure_attr_labels={_s_labels is not None}", flush=True)
                print(f"  structure_attr_labels_shape={tuple(_s_labels.shape) if _s_labels is not None else 'N/A'}", flush=True)
                print(f"  has_boundary_attr_labels={_b_labels is not None}", flush=True)
                print(f"  boundary_attr_labels_shape={tuple(_b_labels.shape) if _b_labels is not None else 'N/A'}", flush=True)
                print(f"  has_per_instance_attr_labels={_i_labels is not None}", flush=True)
                _i_type_str = "tensor" if isinstance(_i_labels, torch.Tensor) else ("list" if isinstance(_i_labels, list) else "None")
                print(f"  per_instance_attr_labels_type={_i_type_str}", flush=True)
                if _i_labels is not None and isinstance(_i_labels, torch.Tensor):
                    print(f"  per_instance_attr_labels_shape={tuple(_i_labels.shape)}", flush=True)
                print(f"  has_label_inst={_label_inst_debug is not None}", flush=True)
                if _label_inst_debug is not None:
                    print(f"  label_inst_shape={tuple(_label_inst_debug.shape)}", flush=True)
                print(f"  enable_attr_text_alignment={self.enable_attr_text_alignment}", flush=True)
                # PHASE_C_FEATURE_AUDIT
                print("\n[PHASE_C_FEATURE_AUDIT]", flush=True)
                print(f"  structure_visual_feat shape={tuple(_s_vis.shape) if _s_vis is not None else 'None'}", flush=True)
                print(f"  boundary_visual_feat shape={tuple(_b_vis.shape) if _b_vis is not None else 'None'}", flush=True)
                _i_vis_type = type(_inst_vis_input).__name__
                _i_vis_shape = "N/A"
                if isinstance(_inst_vis_input, torch.Tensor):
                    _i_vis_shape = str(tuple(_inst_vis_input.shape))
                elif isinstance(_inst_vis_input, list):
                    _i_vis_shape = f"List[{len(_inst_vis_input)} items]"
                print(f"  instance_visual_feat type={_i_vis_type} shape={_i_vis_shape}", flush=True)
                print(f"  structure_text_feat shape={tuple(_s_text.shape) if _s_text is not None else 'None'}", flush=True)
                print(f"  boundary_text_feat shape={tuple(_b_text.shape) if _b_text is not None else 'None'}", flush=True)
                _i_text_type = type(_i_text).__name__
                _i_text_shape = "N/A"
                if isinstance(_i_text, torch.Tensor):
                    _i_text_shape = str(tuple(_i_text.shape))
                elif isinstance(_i_text, list):
                    _i_text_shape = f"List[{len(_i_text)} items]"
                print(f"  instance_text_feat type={_i_text_type} shape={_i_text_shape}", flush=True)

                # PHASE_C_INSTANCE_ALIGN_AUDIT: diagnose instance-level shape alignment
                print("\n[PHASE_C_INSTANCE_ALIGN_AUDIT]", flush=True)
                print(f"  kept_positions present: {_i_kept_positions is not None}", flush=True)
                if _i_kept_positions is not None:
                    for _b_idx in range(len(_i_kept_positions)):
                        _kp = _i_kept_positions[_b_idx]
                        print(f"  image[{_b_idx}]: kept_positions.shape={tuple(_kp.shape) if torch.is_tensor(_kp) else 'N/A'} "
                              f"num_kept={_kp.numel() if torch.is_tensor(_kp) else 0}", flush=True)
                print(f"  kept_instance_ids present: {_i_kept_instance_ids is not None}", flush=True)
                if _i_kept_instance_ids is not None:
                    for _b_idx in range(len(_i_kept_instance_ids)):
                        _kid = _i_kept_instance_ids[_b_idx]
                        print(f"  image[{_b_idx}]: kept_instance_ids={_kid.tolist() if torch.is_tensor(_kid) else _kid}", flush=True)
                # Instance visual vs text alignment check
                if isinstance(_inst_vis_input, list) and isinstance(_i_text, list):
                    _n_vis_total = sum(f.shape[0] for f in _inst_vis_input if f is not None)
                    _n_text_total = sum(f.shape[0] for f in _i_text if f is not None)
                    print(f"  instance_visual_total_N={_n_vis_total}  instance_text_total_N={_n_text_total}", flush=True)
                    if _n_vis_total != _n_text_total:
                        print(f"  [WARNING] instance_visual_total_N ({_n_vis_total}) != "
                              f"instance_text_total_N ({_n_text_total}) — alignment will fail!", flush=True)
                    # Per-image breakdown
                    for _b_idx in range(len(_inst_vis_input)):
                        _v_n = _inst_vis_input[_b_idx].shape[0] if _inst_vis_input[_b_idx] is not None else 0
                        _t_n = _i_text[_b_idx].shape[0] if _i_text[_b_idx] is not None else 0
                        _tag = " [OK]" if _v_n == _t_n else " [MISMATCH]"
                        print(f"    image[{_b_idx}]: vis_N={_v_n}  text_N={_t_n}{_tag}", flush=True)
                elif isinstance(_inst_vis_input, torch.Tensor) and isinstance(_i_text, torch.Tensor):
                    print(f"  instance_vis.shape={tuple(_inst_vis_input.shape)}  "
                          f"instance_text.shape={tuple(_i_text.shape)}", flush=True)
                # Show raw instance counts from InstanceMorphologyHead
                _inst_raw_counts = multilevel_attr_logits.get("instance_raw_counts", None)
                if _inst_raw_counts is not None:
                    print(f"  raw_instance_counts={_inst_raw_counts}", flush=True)
                _inst_drop_info = multilevel_attr_logits.get("instance_drop_info", None)
                if _inst_drop_info is not None:
                    print(f"  drop_info={_inst_drop_info}", flush=True)
                print("", flush=True)

            # 4. Compute alignment loss
            _align_results = self._compute_attr_text_alignment_loss(
                struct_vis_feat=_s_vis,
                bound_vis_feat=_b_vis,
                inst_vis_feat=_inst_vis_input,
                struct_text_embed=_s_text,
                bound_text_embed=_b_text,
                inst_text_embed=_i_text,
            )

            # [PHASE_C_ALIGN] Guarantee _align_results is never None
            if _align_results is None:
                _s_labels_none = _s_labels is None
                _b_labels_none = _b_labels is None
                _i_labels_none = _i_labels is None
                _s_vis_none = _s_vis is None
                _b_vis_none = _b_vis is None
                _i_vis_none = _inst_vis_input is None
                _s_text_none = _s_text is None
                _b_text_none = _b_text is None
                _i_text_none = _i_text is None
                raise RuntimeError(
                    "[PHASE_C_ALIGN] _compute_attr_text_alignment_loss returned None. "
                    "This indicates the function body exited without returning a dict. "
                    "Check that _compute_attr_text_alignment_loss() ends with 'return result'.\n"
                    f"  structure_visual_feat is None: {_s_vis_none}\n"
                    f"  boundary_visual_feat is None: {_b_vis_none}\n"
                    f"  instance_visual_feat is None: {_i_vis_none}\n"
                    f"  structure_text_embed is None: {_s_text_none}\n"
                    f"  boundary_text_embed is None: {_b_text_none}\n"
                    f"  instance_text_embed is None: {_i_text_none}\n"
                    f"  structure_labels is None: {_s_labels_none}\n"
                    f"  boundary_labels is None: {_b_labels_none}\n"
                    f"  instance_labels is None: {_i_labels_none}\n"
                    f"  enable_attr_text_alignment={self.enable_attr_text_alignment}"
                )

            attr_text_align_loss = _align_results["total_align_loss"]

            # ----------------------------------------------------------
            # Phase C gradient audit: verify projection outputs carry gradients
            # ----------------------------------------------------------
            if self.debug_phase_c_audit:
                _s_v_proj = _align_results.get("s_loss", None)
                _b_v_proj = _align_results.get("b_loss", None)
                _i_v_proj = _align_results.get("i_loss", None)
                print(
                    "\n[PHASE_C_GRAD_AUDIT] "
                    f"attr_text_align_loss.requires_grad={attr_text_align_loss.requires_grad} "
                    f"attr_text_align_loss.grad_fn={attr_text_align_loss.grad_fn}",
                    flush=True,
                )
                if self.attr_align_vis_proj_structure is not None:
                    print(
                        "  structure_v_proj.weight.requires_grad="
                        f"{self.attr_align_vis_proj_structure.weight.requires_grad}",
                        flush=True,
                    )
                if self.attr_align_text_proj is not None:
                    print(
                        "  text_proj.weight.requires_grad="
                        f"{self.attr_align_text_proj.weight.requires_grad}",
                        flush=True,
                    )
                if _s_v_proj is not None:
                    print(f"  s_loss.requires_grad={_s_v_proj.requires_grad}", flush=True)
                if _b_v_proj is not None:
                    print(f"  b_loss.requires_grad={_b_v_proj.requires_grad}", flush=True)
                if _i_v_proj is not None:
                    print(f"  i_loss.requires_grad={_i_v_proj.requires_grad}", flush=True)
                # Guard: if any projection loss is gradient-broken, raise immediately
                # Distinguish train (grad-enabled) vs validation (no-grad) contexts
                if torch.is_grad_enabled():
                    for _name, _t in [("s_loss", _s_v_proj), ("b_loss", _b_v_proj), ("i_loss", _i_v_proj)]:
                        if _t is not None and (not _t.requires_grad or _t.grad_fn is None):
                            raise RuntimeError(
                                f"[PHASE_C_GRAD_AUDIT][FATAL] {_name}.requires_grad={_t.requires_grad}, "
                                f"{_name}.grad_fn={_t.grad_fn}. "
                                "Alignment loss detached from autograd graph. "
                                "Check for stray .detach() or torch.no_grad() in Phase C path."
                            )
                    print("[PHASE_C_GRAD_AUDIT] All projection outputs carry gradients. OK.\n", flush=True)
                else:
                    # Validation (no_grad): log non-fatal info, do NOT raise
                    _any_val_issue = False
                    for _name, _t in [("s_loss", _s_v_proj), ("b_loss", _b_v_proj), ("i_loss", _i_v_proj)]:
                        if _t is not None and (not _t.requires_grad or _t.grad_fn is None):
                            if not _any_val_issue:
                                print(
                                    "[PHASE_C_GRAD_AUDIT][VAL_NO_GRAD] "
                                    "Validation no_grad context detected — requires_grad=False is expected. "
                                    "Skipping fatal audit. Details below:",
                                    flush=True,
                                )
                                _any_val_issue = True
                            print(
                                f"  {_name}.requires_grad={_t.requires_grad}, "
                                f"{_name}.grad_fn={_t.grad_fn} (expected under no_grad)",
                                flush=True,
                            )
                    if not _any_val_issue:
                        print(
                            "[PHASE_C_GRAD_AUDIT][VAL_NO_GRAD] "
                            "All projection outputs are None or OK (no_grad context).\n",
                            flush=True,
                        )

            # Store per-pair metrics in debug
            for _k in ["s_sim", "b_sim", "i_sim", "s_loss", "b_loss", "i_loss"]:
                if _align_results.get(_k) is not None:
                    attr_text_align_debug[_k] = _align_results[_k]

            # Store valid_instance_count in debug
            attr_text_align_debug["valid_instance_count"] = _align_results.get("valid_instance_count", 0)

            # Store audit_norms entries (text_norm_mean, visual_norm_mean, etc.) in debug
            _audit_norms = _align_results.get("audit_norms", {})
            for _k, _v in _audit_norms.items():
                attr_text_align_debug[_k] = _v

            # 5. First-batch norm audit (Issue 1) — print aggregated text_norm_mean / visual_norm_mean
            _audit_norms = _align_results.get("audit_norms", None)
            if _audit_norms and self.debug_phase_c_audit:
                print("\n[PHASE_C_AUDIT] First-batch norm audit:", flush=True)
                # Also log visual feature sources for traceability
                print(
                    "  [PHASE_C_AUDIT] structure_visual_source=structure_head_feature "
                    "(pre-logit GAP-pooled from StructureBoundaryAttrHeads)",
                    flush=True,
                )
                print(
                    "  [PHASE_C_AUDIT] boundary_visual_source=dense_boundary_feature "
                    "(GAP-pooled dense boundary maps from DenseBoundaryHead)",
                    flush=True,
                )
                print(
                    "  [PHASE_C_AUDIT] instance_visual_source=instance_morphology_pre_mlp "
                    "(per-instance masked_avg_pool before MLP from InstanceMorphologyHead)",
                    flush=True,
                )
                for _k, _v in _audit_norms.items():
                    print(f"  {_k}={_v:.6f}", flush=True)
                # Check for zero-norm: text_norm_mean > 0 and visual_norm_mean > 0
                _vis_mean = _audit_norms.get("visual_norm_mean", None)
                _txt_mean = _audit_norms.get("text_norm_mean", None)
                if _vis_mean is not None and _vis_mean <= 0.0:
                    raise RuntimeError(
                        f"[PHASE_C][FATAL] visual_norm_mean={_vis_mean:.6f} <= 0. "
                        "Visual features have zero norm. Check feature extraction."
                    )
                if _txt_mean is not None and _txt_mean <= 0.0:
                    raise RuntimeError(
                        f"[PHASE_C][FATAL] text_norm_mean={_txt_mean:.6f} <= 0. "
                        "Text embeddings have zero norm. Check CONCH embedding cache."
                    )
                print("[PHASE_C_AUDIT] Norm audit passed (all norms > 0).\n", flush=True)

            # 6. debug_phase_c_audit prompt printing (Issue 2)
            if self.debug_phase_c_audit:
                # Print first-sample prompts for structure, boundary, instance
                print("\n[PHASE_C_AUDIT] First-sample prompt audit:", flush=True)
                # -- Structure prompts --
                if _s_labels is not None and _s_labels.shape[0] > 0:
                    _s0 = _s_labels[0]  # [5]
                    _s_prompts = []
                    for _j, _label in enumerate(_s0.tolist()):
                        _level_name = SB_LEVEL_NAMES.get(int(_label), "unknown")
                        _key = f"{STRUCTURE_ATTR_NAMES[_j]}_{_level_name}"
                        _text = self._sb_structure_prompt_texts.get(_key, "N/A")
                        _s_prompts.append(_text)
                    print(f"  structure_labels (sample 0): {_s0.tolist()}", flush=True)
                    print(f"  structure_prompt (sample 0): {_s_prompts}", flush=True)
                # -- Boundary prompts --
                if _b_labels is not None and _b_labels.shape[0] > 0:
                    _b0 = _b_labels[0]  # [4]
                    _b_prompts = []
                    for _j, _label in enumerate(_b0.tolist()):
                        _level_name = SB_LEVEL_NAMES.get(int(_label), "unknown")
                        _key = f"{BOUNDARY_ATTR_NAMES[_j]}_{_level_name}"
                        _text = self._sb_boundary_prompt_texts.get(_key, "N/A")
                        _b_prompts.append(_text)
                    print(f"  boundary_labels (sample 0): {_b0.tolist()}", flush=True)
                    print(f"  boundary_prompt (sample 0): {_b_prompts}", flush=True)
                # -- Instance prompts (first valid instance of sample 0) --
                if _i_labels is not None and _i_labels.shape[0] > 0:
                    _i0 = _i_labels[0]  # [max_Ni, 6]
                    _valid_i0 = _i0[_i0[:, 0] >= 0]
                    print(f"  instance_labels (sample 0, {_valid_i0.shape[0]} valid):", flush=True)
                    if _valid_i0.shape[0] > 0:
                        _first_inst = _valid_i0[0].tolist()  # [6] — first valid instance
                        _i_prompts = []
                        _inst_attr_names = list(self._instance_attr_text_templates.keys())
                        for _j, _label in enumerate(_first_inst):
                            _level = max(0, min(int(_label), 2))
                            _level_name = SB_LEVEL_NAMES[_level]
                            _key = f"{_inst_attr_names[_j]}_{_level_name}"
                            _text = self._attr_text_instance_prompt_texts.get(_key, "N/A")
                            _i_prompts.append(_text)
                        print(f"  instance_prompt (sample 0, first inst): {_i_prompts}", flush=True)
                    print(f"    {_valid_i0.tolist()}", flush=True)
                print("", flush=True)

            # 7. debug_phase_c_audit: print [ATTR_TEXT_AUDIT] summary for text feature aggregation
            if self.debug_phase_c_audit:
                print("\n[ATTR_TEXT_AUDIT]", flush=True)
                # Structure prompt examples (first sample)
                if _s_labels is not None and _s_labels.shape[0] > 0:
                    _s0 = _s_labels[0]
                    _s_prompts_debug = []
                    for _j, _label in enumerate(_s0.tolist()):
                        _level_name = SB_LEVEL_NAMES.get(int(_label), "unknown")
                        _key = f"{STRUCTURE_ATTR_NAMES[_j]}_{_level_name}"
                        _text = self._sb_structure_prompt_texts.get(_key, "N/A")
                        _s_prompts_debug.append(f"{STRUCTURE_ATTR_NAMES[_j]}={int(_label)}({_level_name})")
                    print(f"  structure_prompt_examples={_s_prompts_debug}", flush=True)
                # Boundary prompt examples (first sample)
                if _b_labels is not None and _b_labels.shape[0] > 0:
                    _b0 = _b_labels[0]
                    _b_prompts_debug = []
                    for _j, _label in enumerate(_b0.tolist()):
                        _level_name = SB_LEVEL_NAMES.get(int(_label), "unknown")
                        _key = f"{BOUNDARY_ATTR_NAMES[_j]}_{_level_name}"
                        _text = self._sb_boundary_prompt_texts.get(_key, "N/A")
                        _b_prompts_debug.append(f"{BOUNDARY_ATTR_NAMES[_j]}={int(_label)}({_level_name})")
                    print(f"  boundary_prompt_examples={_b_prompts_debug}", flush=True)
                # Instance prompt examples (first sample, first valid instance)
                if _i_labels is not None and _i_labels.shape[0] > 0:
                    _i0 = _i_labels[0]
                    _valid_i0 = _i0[_i0[:, 0] >= 0]
                    if _valid_i0.shape[0] > 0:
                        _first_inst = _valid_i0[0].tolist()
                        _i_prompts_debug = []
                        _inst_attr_names = list(self._instance_attr_text_templates.keys())
                        for _j, _label in enumerate(_first_inst):
                            _level = max(0, min(int(_label), 2))
                            _level_name = SB_LEVEL_NAMES[_level]
                            _key = f"{_inst_attr_names[_j]}_{_level_name}"
                            _text = self._attr_text_instance_prompt_texts.get(_key, "N/A")
                            _i_prompts_debug.append(f"{_inst_attr_names[_j]}={int(_label)}({_level_name})")
                        print(f"  instance_prompt_examples={_i_prompts_debug}", flush=True)
                print(f"  structure_text_pooling=mean", flush=True)
                print(f"  boundary_text_pooling=mean", flush=True)
                print(f"  instance_text_pooling=mean", flush=True)
                print("", flush=True)

        feat_half, feat_s1, feat_s2 = None, None, None

        if self.use_asr:
            with torch.autocast("cuda", enabled=input_images.is_cuda):
                x_cnn = input_images

                for i in range(3):
                    x_cnn = self.cnn_stage0[i](x_cnn)

                feat_half = x_cnn
                feat_s0 = self.cnn_stage0[3](feat_half)
                feat_s1 = self.cnn_stage1(feat_s0)
                feat_s2 = self.cnn_stage2(feat_s1)

        if self.clip_model is not None and next(self.clip_model.parameters()).device != device:
            self.clip_model = self.clip_model.to(device)

        # ==============================================================
        # PNuRL routing: only model config attribute determines enablement
        # ==============================================================
        _pnurl_enabled = bool(getattr(self, "use_pnurl_config", False))
        _has_attr_text_fields = any("attribute_text" in x for x in batched_input)
        _has_txt_prompt_fields = any("text_prompt" in x for x in batched_input)

        organ_indices_list = []
        attribute_texts = []
        base_texts = []

        if _pnurl_enabled:
            # PNuRL active → extract real text fields from DataLoader
            for x in batched_input:
                organ_indices_list.append(self._get_int_value(x.get("organ_id", 20), default=20))
                if self.asr_regression:
                    attribute_texts.append("Cell nuclei")
                    base_texts.append("Cell nuclei")
                else:
                    attribute_texts.append(self._safe_text(x.get("attribute_text", "Cell nuclei"), "Cell nuclei"))
                    base_texts.append(self._safe_text(x.get("text_prompt", "Cell nuclei"), "Cell nuclei"))
        else:
            # PNuRL disabled → use base text; legacy DataLoader fields silently ignored
            for x in batched_input:
                organ_indices_list.append(self._get_int_value(x.get("organ_id", 20), default=20))
                attribute_texts.append("Cell nuclei")
                base_texts.append("Cell nuclei")

        organ_indices = torch.tensor(organ_indices_list, dtype=torch.long, device=device)

        attribute_labels_list = []
        if _pnurl_enabled:
            for x in batched_input:
                attr_labels = x.get("attr_labels", None)
                if attr_labels is not None:
                    if not torch.is_tensor(attr_labels):
                        attr_labels = torch.tensor(attr_labels, dtype=torch.long)
                    attribute_labels_list.append(attr_labels.to(device=device, dtype=torch.long))
                else:
                    attribute_labels_list.append(
                        torch.tensor([0, 0, 0, 1, 1], dtype=torch.long, device=device)
                    )
        else:
            # placeholder labels (unused when PNuRL is disabled)
            for _ in batched_input:
                attribute_labels_list.append(
                    torch.tensor([0, 0, 0, 1, 1], dtype=torch.long, device=device)
                )

        attribute_labels = None
        if len(attribute_labels_list) > 0:
            attr_labels_batch = torch.stack(attribute_labels_list, dim=0).to(device=device, dtype=torch.long)
            attribute_labels = [attr_labels_batch[:, i] for i in range(5)]

        # diagnostics defaults — overwritten if semantic injection path executes
        channel_gate_mean = torch.tensor(0.0, device=device)
        channel_gate_std = torch.tensor(0.0, device=device)
        channel_gate_min = torch.tensor(0.0, device=device)
        channel_gate_max = torch.tensor(0.0, device=device)
        semantic_delta_norm = torch.tensor(0.0, device=device)
        base_feat_norm = image_embeddings.detach().float().norm(dim=1).mean()
        injected_delta_norm = torch.tensor(0.0, device=device)
        injection_ratio = torch.tensor(0.0, device=device)
        semantic_delta_reg_loss = torch.tensor(0.0, device=device)
        semantic_delta_ratio = torch.tensor(0.0, device=device)
        semantic_delta_raw_norm = torch.tensor(0.0, device=device)
        semantic_delta_direction_norm = torch.tensor(0.0, device=device)
        # Diagnostics for PromptNu-guided v3 (always initialized here so the unconditional
        # merge block at diagnostics-build time never hits UnboundLocalError when
        # self.use_pnurl=False, e.g. Stage D PNuDP dense train).
        promptnu_guided_v3_debug: Dict[str, Any] = {}

        # ==============================================================
        # PNURL_ROUTE_GUARD_AUDIT: routing guard (batch0 only)
        # ==============================================================
        global _PNURL_ROUTE_GUARD_COUNTER
        if _PNURL_ROUTE_GUARD_COUNTER == 0:
            _pnurl_self_use = bool(getattr(self, "_use_pnurl_constructor", False))
            _pnurl_config = bool(getattr(self, "use_pnurl_config", False))
            _pnurl_runtime = bool(getattr(self, "use_pnurl", False))
            _pnurl_mutated = (_pnurl_runtime != _pnurl_config)
            _pnurl_local = _pnurl_enabled
            _pnurl_path_active = _pnurl_enabled and self.clip_model is not None
            _pnurl_fields_ignored = _has_attr_text_fields or _has_txt_prompt_fields
            if _pnurl_enabled:
                _pnurl_reason = "self_use_pnurl_true"
            else:
                _pnurl_reason = "self_use_pnurl_false_ignore_legacy_text_fields"
            print(
                f"\n[PNURL_ROUTE_GUARD_AUDIT]\n"
                f"  self_use_pnurl_config={_pnurl_config}\n"
                f"  self_use_pnurl_runtime={_pnurl_runtime}\n"
                f"  use_pnurl_mutated={_pnurl_mutated}\n"
                f"  local_pnurl_enabled={_pnurl_local}\n"
                f"  enable_conch_text_encoder={self.enable_conch_text_encoder}\n"
                f"  has_attribute_text_field={_has_attr_text_fields}\n"
                f"  has_text_prompt_field={_has_txt_prompt_fields}\n"
                f"  pnurl_text_path_active={_pnurl_path_active}\n"
                f"  pnurl_text_fields_ignored={_pnurl_fields_ignored}\n"
                f"  reason={_pnurl_reason}\n",
                flush=True,
            )
            _PNURL_ROUTE_GUARD_COUNTER += 1

        # ==============================================================
        # PromptNu-guided v3.2: Cosine Alignment Loss (training only)
        # Move initialization OUTSIDE `if _pnurl_enabled:` block so that
        # it's always defined even when PNuRL is disabled (e.g. CONCHLESS mode).
        # The v3 alignment logic itself (lines 4789+) stays inside PNuRL block.
        # ==============================================================
        promptnu_guided_v3_align_loss = torch.tensor(0.0, device=device)
        _v3_align_target_mode = "none"

        if _pnurl_enabled:
            # ── CONCHLESS mode: PNuRL runs without CONCH text encoding ──
            # PNuRL's MGST-based attribute classifiers and semantic_delta_adapter
            # work on image_features alone; text_embed=None is handled by
            # PNuRL._prepare_text_embed → zeros. Only text-context fusion in
            # attribute_prompt_bank degrades (no external text context available),
            # but semantic_delta and channel gate still produce valid output.
            _pnurl_conchless = (self.clip_model is None and self.use_checkpoint_text_bank_without_conch)
            if self.clip_model is None and not _pnurl_conchless:
                raise RuntimeError(
                    "PNuRL requires CONCH text encoder, but enable_conch_text_encoder=False "
                    "and use_checkpoint_text_bank_without_conch is not set. "
                    "Cannot compute attribute text embeddings for PNuRL. "
                    "Either enable CONCH, set --use_checkpoint_text_bank_without_conch, "
                    "or set --use_pnurl=False."
                )

            if next(self.pnurl.parameters()).device != device:
                self.pnurl = self.pnurl.to(device)

            if _pnurl_conchless:
                # CONCHLESS: skip CONCH tokenization/encoding, use None text_embed
                attr_text_embed = None
                _prompt_modes = [x.get("prompt_mode", "unknown") for x in batched_input]
                if _PNURL_ROUTE_GUARD_COUNTER == 1:
                    print(
                        "[CONCHLESS_PNURL_FORWARD] CONCHLESS PNuRL forward: "
                        "text_embed=None → PNuRL uses zeros; "
                        "semantic_delta_adapter + semantic_channel_gate active. "
                        "PromptNu-guided v3 uses text_bank from checkpoint.",
                        flush=True,
                    )
            else:
                # Normal path: CONCH available → encode attribute texts
                with torch.no_grad():
                    attr_tokens = self._tokenize_to_input_ids(attribute_texts, device)
                    attr_text_embed = self.clip_model.encode_text(attr_tokens).float()
                    attr_text_embed = F.normalize(attr_text_embed, dim=-1, eps=1e-6)

                    # ==============================================================
                    # PNURL_AUDIT: CLIP text embedding comparison (Item 2)
                    # ==============================================================
                    global _PNURL_AUDIT_SAM_COUNTER
                    if _PNURL_AUDIT and _PNURL_AUDIT_SAM_COUNTER < 6:
                        _sc = _PNURL_AUDIT_SAM_COUNTER
                        print(f"\n[PNURL_AUDIT_CLIP_TEXT] call={_sc}", flush=True)
                        print(f"  attribute_texts={attribute_texts}", flush=True)
                        print(f"  base_texts={base_texts}", flush=True)
                        print(f"  attr_text_embed_norm={attr_text_embed.norm(dim=-1).tolist()}", flush=True)
                        # Also encode base_texts (text_prompt) to compare with attribute_texts
                        _base_tokens = self._tokenize_to_input_ids(base_texts, device)
                        _base_text_embed = self.clip_model.encode_text(_base_tokens).float()
                        _base_text_embed = F.normalize(_base_text_embed, dim=-1, eps=1e-6)
                        _base_norm = _base_text_embed.norm(dim=-1)
                        print(f"  base_text_embed_norm={_base_norm.tolist()}", flush=True)
                        # Compute cosine similarity between attribute_text and base_text embeddings
                        _cos_sim = (attr_text_embed * _base_text_embed).sum(dim=-1)
                        print(f"  attr_vs_base_cosine_sim={_cos_sim.tolist()}", flush=True)

                    # Extract prompt_mode from batched_input for debugging
                    _prompt_modes = [x.get("prompt_mode", "unknown") for x in batched_input]

            pnurl_out = self.pnurl(
                image_features=image_embeddings,
                text_embed=attr_text_embed,
                attribute_labels=attribute_labels,
                return_loss=True,
                prompt_mode=_prompt_modes[0] if _prompt_modes else None,
            )

            if not isinstance(pnurl_out, dict):
                raise TypeError(
                    "PNuRL.forward must return a dict with keys: "
                    "semantic_delta, attr_logits, density_map, "
                    "low_freq_prompt, high_freq_prompt, pnurl_loss. "
                    "The old tuple return protocol is no longer supported."
                )

            required_keys = ("semantic_delta", "low_freq_prompt", "high_freq_prompt")
            missing_keys = [key for key in required_keys if key not in pnurl_out]
            if missing_keys:
                raise KeyError(f"PNuRL output missing required keys: {missing_keys}")

            semantic_delta = pnurl_out["semantic_delta"].to(dtype=image_embeddings.dtype)

            if getattr(self, "semantic_injection_enabled", False):
                semantic_delta = self._rescale_semantic_delta(
                    semantic_delta=semantic_delta,
                    image_embeddings=image_embeddings,
                    target_ratio=min(float(self.max_delta_ratio), 0.02),
                    max_scale=10000.0,
                )

            attr_logits = pnurl_out.get("attr_logits", {})
            density_map = pnurl_out.get("density_map", None)

            low_freq_prompt = pnurl_out["low_freq_prompt"]
            high_freq_prompt = pnurl_out["high_freq_prompt"]

            pnurl_loss = pnurl_out.get("pnurl_loss", torch.tensor(0.0, device=device))
            semantic_delta_reg_loss = pnurl_out.get(
                "semantic_delta_reg_loss",
                torch.tensor(0.0, device=device),
            )
            semantic_delta_ratio = pnurl_out.get("semantic_delta_ratio", None)
            semantic_delta_raw_norm = pnurl_out.get("semantic_delta_raw_norm", None)
            semantic_delta_direction_norm = pnurl_out.get("semantic_delta_direction_norm", None)

            # ==============================================================
            # PromptNu-guided v3: Predicted-Attribute Semantic Guidance
            # ==============================================================
            # Modulate semantic_delta using predicted structure/boundary attr logits.
            # Uses scale-based formula:
            #   guided_semantic_delta = semantic_delta * (1.0 + text_weight * tanh(text_scale))
            # When text_weight=0 or ablate_pred_attr_guidance=True, this is a no-op.
            # ==============================================================
            promptnu_guided_v3_debug.clear()
            # CRITICAL: save pre-guidance semantic_delta for alignment loss.
            # Using post-guidance semantic_delta as visual target creates circular
            # self-supervision (the guidance has already moved delta toward text).
            semantic_delta_before_v3 = semantic_delta.clone()  # [B, C, H, W] pre-modulation
            if (
                getattr(self, "enable_promptnu_guided_v3", False)
                and self.promptnu_guided_adapter is not None
                and not getattr(self, "ablate_pred_attr_guidance", False)
            ):
                _s_logits = structure_attr_logits  # [B,5,3] from line 2702-2705
                _b_logits = boundary_attr_logits   # [B,4,3]

                if _s_logits is not None and _b_logits is not None:
                    # v3.3: pass scale + additive guidance params
                    _base_feat_norm = image_embeddings.detach().float().norm(dim=1).mean().item()
                    _v3_prompt_source = str(getattr(self, "promptnu_guided_v3_prompt_source", "pred_attr"))
                    _v3_kwargs = dict(
                        structure_attr_logits=_s_logits,
                        boundary_attr_logits=_b_logits,
                        semantic_delta=semantic_delta,
                        text_weight=self.promptnu_guided_v3_text_weight,
                        scale_weight=self.promptnu_guided_v3_scale_weight,
                        delta_weight=self.promptnu_guided_v3_delta_weight,
                        struct_weight=self.promptnu_guided_v3_struct_weight,
                        boundary_weight=self.promptnu_guided_v3_boundary_weight,
                        guidance_mode=self.promptnu_guided_v3_guidance_mode,
                        max_guided_delta_ratio=self.promptnu_guided_v3_max_guided_delta_ratio,
                        base_feat_norm=_base_feat_norm,
                        # ── Prompt source diagnostic ──
                        prompt_source_override=_v3_prompt_source,
                    )
                    # ── oracle_gt_attr: pass GT struct/boundary labels if available ──
                    if _v3_prompt_source == "oracle_gt_attr":
                        _gt_struct = batched_input[0].get("attr_labels", {}).get("structure", None) if isinstance(batched_input[0].get("attr_labels"), dict) else None
                        _gt_bound = batched_input[0].get("attr_labels", {}).get("boundary", None) if isinstance(batched_input[0].get("attr_labels"), dict) else None
                        if _gt_struct is not None and _gt_bound is not None:
                            # Stack batch-wise: assume all samples in batch have same labels for now,
                            # or that attr_labels is a dict of tensors
                            if torch.is_tensor(_gt_struct):
                                _gt_struct = _gt_struct.unsqueeze(0) if _gt_struct.dim() == 1 else _gt_struct
                            else:
                                _gt_struct = torch.tensor(_gt_struct, device=device).unsqueeze(0)
                            if torch.is_tensor(_gt_bound):
                                _gt_bound = _gt_bound.unsqueeze(0) if _gt_bound.dim() == 1 else _gt_bound
                            else:
                                _gt_bound = torch.tensor(_gt_bound, device=device).unsqueeze(0)
                            # Expand to full batch size
                            _v3_kwargs["gt_struct_labels"] = _gt_struct.expand(B, -1).to(device=device, dtype=torch.long)
                            _v3_kwargs["gt_bound_labels"] = _gt_bound.expand(B, -1).to(device=device, dtype=torch.long)
                            # Flag effect audit that oracle GT is being used
                            promptnu_guided_v3_debug["v3_oracle_gt_found"] = 1
                        else:
                            # GT not available - fall through to predicted logits (graceful)
                            promptnu_guided_v3_debug["v3_oracle_gt_found"] = 0
                            promptnu_guided_v3_debug["v3_oracle_gt_fallback"] = 1
                    # ── fixed_global: pre-compute CONCH embedding if not cached ──
                    if _v3_prompt_source == "fixed_global":
                        _fixed_global_text = getattr(self.promptnu_guided_adapter, "fixed_global_text",
                                                      "cell nuclei with irregular nuclear morphology and dense chromatin")
                        _cached = getattr(self.promptnu_guided_adapter, "_fixed_global_embedding", None)
                        if _cached is not None:
                            _v3_kwargs["fixed_global_embedding"] = _cached
                        elif self.clip_model is not None:
                            with torch.no_grad():
                                _fg_tokens = self._tokenize_to_input_ids([_fixed_global_text], device)
                                _fg_embed = self.clip_model.encode_text(_fg_tokens).float()
                                _fg_embed = F.normalize(_fg_embed, dim=-1, eps=1e-6).to(dtype=semantic_delta.dtype)
                            # Cache for reuse
                            self.promptnu_guided_adapter._fixed_global_embedding = _fg_embed
                            _v3_kwargs["fixed_global_embedding"] = _fg_embed
                    if getattr(self, "promptnu_guided_v3_use_text_bank", False):
                        _v3_kwargs["structure_text_bank"] = self._get_sb_text_bank("structure", device)
                        _v3_kwargs["boundary_text_bank"] = self._get_sb_text_bank("boundary", device)
                    guided_semantic_delta, v3_debug_out = self.promptnu_guided_adapter(
                        **_v3_kwargs
                    )
                    # Tag debug with active prompt_source
                    promptnu_guided_v3_debug["prompt_source"] = _v3_prompt_source
                    promptnu_guided_v3_debug["v3_oracle_gt_found"] = promptnu_guided_v3_debug.get("v3_oracle_gt_found", -1)
                    promptnu_guided_v3_debug["v3_oracle_gt_fallback"] = promptnu_guided_v3_debug.get("v3_oracle_gt_fallback", -1)
                    # Compute guided delta ratio BEFORE reassigning semantic_delta
                    _pre_delta_norm = semantic_delta.detach().float().norm(dim=1).mean()
                    _guided_delta_norm = guided_semantic_delta.detach().float().norm(dim=1).mean()
                    _delta_ratio_val = (_guided_delta_norm / (_pre_delta_norm + 1e-8)).item()
                    semantic_delta = guided_semantic_delta
                    promptnu_guided_v3_debug.update(v3_debug_out)
                    # Additional v3 scalar diagnostics from text_scale
                    if "text_scale" in v3_debug_out:
                        _ts = v3_debug_out["text_scale"]
                        promptnu_guided_v3_debug["v3_text_scale_mean"] = _ts.mean().item()
                        promptnu_guided_v3_debug["v3_text_scale_std"] = _ts.std().item()
                        promptnu_guided_v3_debug["v3_text_scale_min"] = _ts.min().item()
                        promptnu_guided_v3_debug["v3_text_scale_max"] = _ts.max().item()
                    # Additional v3.3 additive diagnostics from text_delta
                    if "text_delta" in v3_debug_out:
                        _td = v3_debug_out["text_delta"]
                        promptnu_guided_v3_debug["v3_text_delta_mean"] = _td.mean().item()
                        promptnu_guided_v3_debug["v3_text_delta_std"] = _td.std().item()
                        promptnu_guided_v3_debug["v3_text_delta_min"] = _td.min().item()
                        promptnu_guided_v3_debug["v3_text_delta_max"] = _td.max().item()
                    promptnu_guided_v3_debug["v3_guided_delta_ratio"] = _delta_ratio_val
                    promptnu_guided_v3_debug["v3_active"] = 1
                    promptnu_guided_v3_debug["v3_skipped"] = 0
                    def _debug_float(d, key, default=float("nan")):
                        v = d.get(key, default)
                        if torch.is_tensor(v):
                            return float(v.detach().mean().cpu())
                        try:
                            return float(v)
                        except Exception:
                            return default
                    if self.training and getattr(self, "_v3_audit_count", 0) < 2:
                        self._v3_audit_count = getattr(self, "_v3_audit_count", 0) + 1
                        _gm = getattr(self, "promptnu_guided_v3_guidance_mode", "scale_add")
                        audit_print(
                            "PROMPTNU_GUIDED_V3_FWD",
                            f"[PROMPTNU_GUIDED_V3_FWD] "
                            f"guidance_mode={_gm} | "
                            f"use_text_bank={getattr(self, 'promptnu_guided_v3_use_text_bank', False)} | "
                            f"text_scale_mean="
                            f"{_debug_float(v3_debug_out, 'text_scale', 0.0):.6f} | "
                            f"text_scale_std="
                            f"{_debug_float(v3_debug_out, 'text_scale_std', 0.0):.6f} | "
                            f"text_delta_mean="
                            f"{_debug_float(v3_debug_out, 'text_delta', 0.0):.6f} | "
                            f"text_delta_std="
                            f"{_debug_float(v3_debug_out, 'text_delta_std', 0.0):.6f} | "
                            f"additive_delta_norm="
                            f"{_debug_float(v3_debug_out, 'promptnu_guided_v3_additive_delta_norm', 0.0):.6e} | "
                            f"scale_factor_mean="
                            f"{_debug_float(v3_debug_out, 'scale_factor', 0.0):.6f} | "
                            f"s_feat_norm="
                            f"{_debug_float(v3_debug_out, 's_feat_norm'):.6f} | "
                            f"b_feat_norm="
                            f"{_debug_float(v3_debug_out, 'b_feat_norm'):.6f}",
                            flush=True,
                        )
                else:
                    # structure/boundary attr logits not available — cannot run v3 guidance
                    _skip_reason = (
                        f"structure_attr_logits={'present' if _s_logits is not None else 'None'}, "
                        f"boundary_attr_logits={'present' if _b_logits is not None else 'None'}"
                    )
                    if getattr(self, "promptnu_guided_v3_strict_audit", False):
                        raise RuntimeError(
                            f"[PROMPTNU_GUIDED_V3_STRICT_AUDIT] v3 guidance skipped — {_skip_reason}. "
                            f"Set --promptnu_guided_v3_strict_audit=False to demote to warning."
                        )
                    if self.training and getattr(self, "_v3_audit_count", 0) < 2:
                        self._v3_audit_count = getattr(self, "_v3_audit_count", 0) + 1
                        audit_print(
                            "PROMPTNU_GUIDED_V3_FWD",
                            f"[PROMPTNU_GUIDED_V3_FWD] SKIP — {_skip_reason}",
                            flush=True,
                        )
                    promptnu_guided_v3_debug["v3_active"] = 0
                    promptnu_guided_v3_debug["v3_skipped"] = 1
                    promptnu_guided_v3_debug["v3_skip_reason"] = _skip_reason
                    # Fill nan for all v3 scalar diagnostics to ensure key consistency
                    promptnu_guided_v3_debug["v3_text_scale_mean"] = float("nan")
                    promptnu_guided_v3_debug["v3_text_scale_std"] = float("nan")
                    promptnu_guided_v3_debug["v3_text_scale_min"] = float("nan")
                    promptnu_guided_v3_debug["v3_text_scale_max"] = float("nan")
                    promptnu_guided_v3_debug["v3_text_delta_mean"] = float("nan")
                    promptnu_guided_v3_debug["v3_text_delta_std"] = float("nan")
                    promptnu_guided_v3_debug["v3_text_delta_min"] = float("nan")
                    promptnu_guided_v3_debug["v3_text_delta_max"] = float("nan")
                    promptnu_guided_v3_debug["v3_guided_delta_ratio"] = float("nan")
                    promptnu_guided_v3_debug["s_feat_norm"] = float("nan")
                    promptnu_guided_v3_debug["b_feat_norm"] = float("nan")
                    promptnu_guided_v3_debug["text_prompt_norm"] = float("nan")

            # ==============================================================
            # [PROMPTNU_GUIDED_V3_EFFECT_AUDIT] Direct tensor norm audit
            # Records real tensor norms at v3 modulation boundaries.
            # NOTE: This captures the state AFTER the v3 block above resolved.
            #   - If v3 was ACTIVE: semantic_delta is now guided_semantic_delta,
            #     and semantic_delta_before_v3 is the pre-modulation clone.
            #   - If v3 was SKIPPED: semantic_delta == semantic_delta_before_v3,
            #     and guided_delta_abs_change should be ~0.
            # ==============================================================
            if self.training and getattr(self, "_v3_effect_audit_count", 0) < 2:
                self._v3_effect_audit_count = getattr(self, "_v3_effect_audit_count", 0) + 1
                with torch.no_grad():
                    _sd_before = semantic_delta_before_v3.detach().float()  # [B,C,H,W] pre-v3
                    _sd_after = semantic_delta.detach().float()             # [B,C,H,W] post-v3
                    _delta_before_norm = _sd_before.norm(dim=1).mean().item()
                    _delta_after_norm = _sd_after.norm(dim=1).mean().item()
                    _guided_abs_change = (_sd_after - _sd_before).abs().mean().item()
                    _guided_delta_ratio = _delta_after_norm / (_delta_before_norm + 1e-8)

                    _ts_tensor = promptnu_guided_v3_debug.get("text_scale", None)
                    if torch.is_tensor(_ts_tensor) and _ts_tensor.numel() > 0:
                        _ts_f = _ts_tensor.detach().float()
                        _ts_mean = _ts_f.mean().item()
                        _ts_std = _ts_f.std().item() if _ts_f.numel() > 1 else 0.0
                        _ts_min = _ts_f.min().item()
                        _ts_max = _ts_f.max().item()
                    else:
                        _ts_mean = _ts_std = _ts_min = _ts_max = 0.0

                    # v3.3: text_delta diagnostics
                    _td_tensor = promptnu_guided_v3_debug.get("text_delta", None)
                    if torch.is_tensor(_td_tensor) and _td_tensor.numel() > 0:
                        _td_f = _td_tensor.detach().float()
                        _td_mean = _td_f.mean().item()
                        _td_std = _td_f.std().item() if _td_f.numel() > 1 else 0.0
                        _td_min = _td_f.min().item()
                        _td_max = _td_f.max().item()
                    else:
                        _td_mean = _td_std = _td_min = _td_max = 0.0

                    _sf_tensor = promptnu_guided_v3_debug.get("scale_factor", None)
                    if torch.is_tensor(_sf_tensor) and _sf_tensor.numel() > 0:
                        _sf_f = _sf_tensor.detach().float()
                        _sf_mean = _sf_f.mean().item()
                        _sf_std = _sf_f.std().item() if _sf_f.numel() > 1 else 0.0
                    else:
                        _sf_mean = 1.0
                        _sf_std = 0.0

                    # v3.3: additive delta norm
                    _add_norm = float(promptnu_guided_v3_debug.get(
                        "promptnu_guided_v3_additive_delta_norm", 0.0))
                    _add_amp = float(promptnu_guided_v3_debug.get(
                        "promptnu_guided_v3_additive_amp_scale", 1.0))

                    # Gate / injection stats (captured later in the same forward,
                    # but we log them here for a consolidated audit block).
                    # NOTE: channel_gate in locals() at this point is just the default
                    # torch.tensor(0.0) from line 3681 — the actual _get_semantic_channel_gate()
                    # call happens AFTER this audit block at line ~4130.  To get the real gate,
                    # check promptnu_guided_v3_debug first, then fall back to future channel_gate.
                    _gate_t = promptnu_guided_v3_debug.get("channel_gate", None)
                    if _gate_t is None:
                        _gate_t = locals().get("channel_gate", None)
                    _inj_t = promptnu_guided_v3_debug.get("injected_delta", None)
                    if _inj_t is None:
                        _inj_t = locals().get("injected_delta", None)
                    if torch.is_tensor(_gate_t):
                        _gate_mean = _gate_t.detach().float().mean().item()
                    else:
                        _gate_mean = 0.0
                    if torch.is_tensor(_inj_t):
                        _inj_norm = _inj_t.detach().float().norm(dim=1).mean().item()
                    else:
                        _inj_norm = 0.0
                    _inj_ratio = _inj_norm / (_delta_after_norm + 1e-8)

                    audit_print(
                        "PROMPTNU_GUIDED_V3_EFFECT_AUDIT",
                        f"\n[PROMPTNU_GUIDED_V3_EFFECT_AUDIT] "
                        f"guidance_mode={getattr(self, 'promptnu_guided_v3_guidance_mode', 'scale_add')} | "
                        f"semantic_delta_before_v3_norm={_delta_before_norm:.8e} | "
                        f"semantic_delta_after_v3_norm={_delta_after_norm:.8e} | "
                        f"guided_delta_abs_change={_guided_abs_change:.8e} | "
                        f"guided_delta_ratio={_guided_delta_ratio:.8e} | "
                        f"text_scale_mean={_ts_mean:.8e} | "
                        f"text_scale_std={_ts_std:.8e} | "
                        f"text_delta_mean={_td_mean:.8e} | "
                        f"text_delta_std={_td_std:.8e} | "
                        f"additive_delta_norm={_add_norm:.8e} | "
                        f"additive_amp_scale={_add_amp:.6f} | "
                        f"scale_factor_mean={_sf_mean:.8e} | "
                        f"scale_factor_std={_sf_std:.8e} | "
                        f"gate_mean={_gate_mean:.8e} | "
                        f"injected_delta_norm={_inj_norm:.8e} | "
                        f"injection_ratio={_inj_ratio:.8e}",
                        flush=True,
                    )
            # ==============================================================
            # PromptNu-guided v3.2: Cosine Alignment Loss (training only)
            # ==============================================================
            # FIXED v3.2 design (was v3.1):
            #   (1) Visual target = PRE-guidance semantic_delta_before_v3 (not post-guidance).
            #       Using post-guidance delta creates circular self-supervision because
            #       the v3 guidance has already moved semantic_delta toward the text.
            #   (2) Text target = separate structure/boundary projections (not concatenated).
            #       Separate projections enable independent struct/bound alignment losses,
            #       avoiding the information mixing problem of the old [B,1024] concat.
            #   (3) Loss = struct_weight * struct_loss + bound_weight * bound_loss.
            #       Each type gets its own cosine alignment, summed with type weights.
            # ==============================================================
            promptnu_guided_v3_align_loss = torch.tensor(0.0, device=device)
            _v3_align_target_mode = "none"
            if (
                self.training
                and getattr(self, "enable_promptnu_guided_v3", False)
                and self.promptnu_guided_adapter is not None
                and structure_attr_logits is not None
                and boundary_attr_logits is not None
            ):
                # Determine alignment target: GT labels (v3.1) or predicted argmax (v3)
                _use_gt = getattr(self, "promptnu_guided_v3_use_gt_align_target", False)
                if _use_gt:
                    # Extract GT labels from batched_input
                    _s_gt_list = [x.get("structure_attr_labels", None) for x in batched_input]
                    _b_gt_list = [x.get("boundary_attr_labels", None) for x in batched_input]
                    _s_gt: Optional[torch.Tensor] = None
                    _b_gt: Optional[torch.Tensor] = None
                    if all(l is not None for l in _s_gt_list):
                        _s_gt = torch.stack(_s_gt_list, dim=0).to(device=device, dtype=torch.long)
                    if all(l is not None for l in _b_gt_list):
                        _b_gt = torch.stack(_b_gt_list, dim=0).to(device=device, dtype=torch.long)

                if _use_gt and _s_gt is not None and _b_gt is not None:
                    # v3.1: Use GT labels for CONCH lookup
                    _s_pred = _s_gt  # [B, 5]
                    _b_pred = _b_gt  # [B, 4]
                    _v3_align_target_mode = "gt"
                else:
                    # v3 (default): Predicted attr levels via argmax
                    _s_pred = structure_attr_logits.argmax(dim=-1)  # [B, 5]
                    _b_pred = boundary_attr_logits.argmax(dim=-1)   # [B, 4]
                    _v3_align_target_mode = "predicted"

                # --- v3.1: Build text target via CONCH text bank ---
                # _get_sb_text_bank returns [num_attrs, num_levels, D]:
                #   structure: [5, 3, 512], boundary: [4, 3, 512]
                _structure_text_bank = self._get_sb_text_bank("structure", device)
                _boundary_text_bank = self._get_sb_text_bank("boundary", device)

                if _v3_align_target_mode == "gt":
                    # GT path: index text bank with GT labels per attribute, then mean → [B, D]
                    # _s_pred == _s_gt: [B, 5] with values 0/1/2 (level indices)
                    _s_gt_idx = _s_pred.long().clamp(0, 2)  # [B, 5]
                    _b_gt_idx = _b_pred.long().clamp(0, 2)  # [B, 4]
                    _s_emb_list: List[torch.Tensor] = []
                    for j in range(5):
                        # _structure_text_bank[j]: [3, 512], index with _s_gt_idx[:, j]: [B]
                        _s_emb_list.append(_structure_text_bank[j][_s_gt_idx[:, j]])  # [B, 512]
                    _s_text = torch.stack(_s_emb_list, dim=0).mean(dim=0)  # [B, 512]
                    _b_emb_list: List[torch.Tensor] = []
                    for j in range(4):
                        _b_emb_list.append(_boundary_text_bank[j][_b_gt_idx[:, j]])  # [B, 512]
                    _b_text = torch.stack(_b_emb_list, dim=0).mean(dim=0)  # [B, 512]
                else:
                    # Fallback: softmax-weighted sum over levels → mean over attrs → [B, D]
                    # Same pattern as PromptNuGuidedAdapter.forward() guidance path
                    _s_probs = torch.softmax(structure_attr_logits, dim=-1)  # [B, 5, 3]
                    _b_probs = torch.softmax(boundary_attr_logits, dim=-1)   # [B, 4, 3]
                    # _structure_text_bank.unsqueeze(0): [1, 5, 3, 512]
                    # _s_probs.unsqueeze(-1): [B, 5, 3, 1]
                    # .sum(dim=2) → [B, 5, 512] (weighted over levels)
                    # .mean(dim=1) → [B, 512] (mean over attrs)
                    _s_text = (_s_probs.unsqueeze(-1) * _structure_text_bank.unsqueeze(0)).sum(dim=2).mean(dim=1)  # [B, 512]
                    _b_text = (_b_probs.unsqueeze(-1) * _boundary_text_bank.unsqueeze(0)).sum(dim=2).mean(dim=1)  # [B, 512]

                # ── Shape audit for separate projections ──
                print(
                    f"[PROMPTNU_GUIDED_V3_ALIGN_SHAPE] "
                    f"_s_text={tuple(_s_text.shape)} _b_text={tuple(_b_text.shape)} "
                    f"struct_text_proj.in_features={self.promptnu_guided_v3_struct_text_proj.in_features} "
                    f"bound_text_proj.in_features={self.promptnu_guided_v3_boundary_text_proj.in_features}"
                )

                # ── Visual projection from PRE-guidance semantic_delta ──
                # semantic_delta_before_v3 is saved before v3 modulation (line ~3791),
                # so this alignment loss does NOT use post-guidance semantic_delta,
                # avoiding circular self-supervision.

                # ── Stability: eps-guarded RMS with warmup gate ──
                _align_eps = self.promptnu_guided_v3_align_eps
                _cosine_eps = self.promptnu_guided_v3_cosine_eps
                _min_norm = self.promptnu_guided_v3_min_align_delta_norm
                _low_norm_mode = self.promptnu_guided_v3_align_low_norm_mode

                # Measure raw spatial norm for warmup gate
                _raw_vis_norm = semantic_delta_before_v3.detach().norm(dim=1).mean().item()

                # ── Warmup gate: when semantic_delta norm is too low, use detached fallback ──
                # This prevents gradient explosion through sqrt(rms) ~ 1/x when x → 0
                # and cosine_similarity(0, text) = 0/0 → NaN.
                if _min_norm > 0.0 and _raw_vis_norm < _min_norm:
                    if _low_norm_mode == "detach_guided":
                        # Option B (recommended): use guided_semantic_delta.detach() as visual source.
                        # The guided delta carries text-semantic content (via additive text delta)
                        # but is detached to prevent circular self-supervision.
                        # Fallback to detach_semantic if guided_semantic_delta is unavailable.
                        _guided_delta = locals().get("guided_semantic_delta", None)
                        if _guided_delta is not None:
                            _vis_source = _guided_delta.detach()
                        else:
                            _vis_source = semantic_delta_before_v3.detach()
                    else:
                        # Option A: detach semantic_delta_before_v3, no gradient flows through visual branch
                        _vis_source = semantic_delta_before_v3.detach()
                    _v3_align_target_mode = f"warmup_{_low_norm_mode}"
                else:
                    _vis_source = semantic_delta_before_v3
                    # _v3_align_target_mode stays as "gt" or "predicted" (set above)

                # Stable RMS: add eps^2 inside sqrt for stable gradient when input is near-zero.
                # Gradient of sqrt(x) ~ 1/(2*sqrt(x)), so at x=0 the gradient diverges to inf.
                # Adding eps^2 ensures the gradient is bounded.
                _vis_rms = torch.sqrt(
                    (_vis_source ** 2).mean(dim=(2, 3), keepdim=True) + _align_eps ** 2
                )
                _vis_rms = _vis_rms.flatten(1)  # [B, C=256]
                _vis_proj = self.promptnu_guided_v3_vis_proj(_vis_rms)  # [B, proj_dim]

                # ── Separate text projections for structure and boundary ──
                _s_text_proj = self.promptnu_guided_v3_struct_text_proj(_s_text)    # [B, proj_dim]
                _b_text_proj = self.promptnu_guided_v3_boundary_text_proj(_b_text)  # [B, proj_dim]

                # ── Separate cosine alignment losses with explicit eps ──
                # Without eps, cosine_similarity(0, x) = 0/0 = NaN, producing ~1e11 gradients.
                _struct_cos = F.cosine_similarity(_vis_proj, _s_text_proj, dim=-1, eps=_cosine_eps)  # [B]
                _bound_cos = F.cosine_similarity(_vis_proj, _b_text_proj, dim=-1, eps=_cosine_eps)  # [B]

                # Scale each by the user-configurable type weight, then multiply by align_loss_weight
                struct_loss = (1.0 - _struct_cos.mean()) * self.promptnu_guided_v3_align_loss_weight
                bound_loss = (1.0 - _bound_cos.mean()) * self.promptnu_guided_v3_align_loss_weight

                # Combined loss with type-specific weights
                promptnu_guided_v3_align_loss = (
                    self.promptnu_guided_v3_struct_weight * struct_loss
                    + self.promptnu_guided_v3_boundary_weight * bound_loss
                )

                # ── Nonfinite guard: zero out loss if non-finite to prevent NaN propagation ──
                _align_loss_is_finite = torch.isfinite(promptnu_guided_v3_align_loss).all()
                if not _align_loss_is_finite:
                    print(
                        f"[PROMPTNU_GUIDED_V3_ALIGN_NONFINITE] WARNING: "
                        f"PG3 align loss is non-finite (value={promptnu_guided_v3_align_loss.detach().item():.8e}). "
                        f"Zeroing loss to prevent NaN propagation. "
                        f"raw_vis_norm={_raw_vis_norm:.8e} "
                        f"vis_proj_norm={_vis_proj.detach().norm(dim=-1).mean().item():.8e}",
                        flush=True,
                    )
                    promptnu_guided_v3_align_loss = torch.zeros_like(promptnu_guided_v3_align_loss)
                    # Keep connected to graph but zero-valued
                    promptnu_guided_v3_align_loss = promptnu_guided_v3_align_loss + 0.0

                # ── Diagnostics ──
                promptnu_guided_v3_debug["v3_align_loss"] = promptnu_guided_v3_align_loss.detach()
                promptnu_guided_v3_debug["v3_struct_loss"] = struct_loss.detach()
                promptnu_guided_v3_debug["v3_bound_loss"] = bound_loss.detach()
                promptnu_guided_v3_debug["v3_align_target_mode"] = _v3_align_target_mode
                promptnu_guided_v3_debug["v3_s_sim"] = _struct_cos.detach().mean()
                promptnu_guided_v3_debug["v3_b_sim"] = _bound_cos.detach().mean()
                promptnu_guided_v3_debug["v3_text_proj_norm"] = _s_text_proj.detach().norm(dim=-1).mean()
                promptnu_guided_v3_debug["v3_vis_proj_norm"] = _vis_proj.detach().norm(dim=-1).mean()
                # ── Stability diagnostics ──
                promptnu_guided_v3_debug["v3_raw_vis_norm"] = float(_raw_vis_norm)
                promptnu_guided_v3_debug["v3_align_is_finite"] = bool(_align_loss_is_finite)
                promptnu_guided_v3_debug["v3_align_eps"] = float(_align_eps)
                promptnu_guided_v3_debug["v3_cosine_eps"] = float(_cosine_eps)
                promptnu_guided_v3_debug["v3_min_align_delta_norm"] = float(_min_norm)
                promptnu_guided_v3_debug["v3_align_low_norm_mode"] = str(_low_norm_mode)

                # ==============================================================
                # [PROMPTNU_GUIDED_V3_GRAPH_AUDIT][loss] Graph wiring audit
                # Audits PG3 loss tensor properties and intermediate tensor
                # statistics to verify autograd connectivity.
                # ==============================================================
                if self.training and getattr(self, "_v3_graph_audit_count", 0) < 2:
                    self._v3_graph_audit_count = getattr(self, "_v3_graph_audit_count", 0) + 1
                    _pg3 = promptnu_guided_v3_align_loss
                    _rms_stats = f"rms:mean={_vis_rms.detach().mean().item():.8e} " \
                                 f"std={_vis_rms.detach().std().item():.8e} " \
                                 f"min={_vis_rms.detach().min().item():.8e} " \
                                 f"max={_vis_rms.detach().max().item():.8e}"
                    _vp = _vis_proj
                    audit_print(
                        "PROMPTNU_GUIDED_V3_GRAPH_AUDIT",
                        f"\n[PROMPTNU_GUIDED_V3_GRAPH_AUDIT][loss] "
                        f"align_loss:requires_grad={_pg3.requires_grad} "
                        f"grad_fn={_pg3.grad_fn} "
                        f"shape={list(_pg3.shape)} "
                        f"dtype={_pg3.dtype} | "
                        f"vis_rms:{_rms_stats} | "
                        f"vis_proj:requires_grad={_vp.requires_grad} "
                        f"grad_fn={_vp.grad_fn} "
                        f"vis_proj_norm={_vp.detach().norm(dim=-1).mean().item():.6e} | "
                        f"s_text_proj:requires_grad={_s_text_proj.requires_grad} "
                        f"grad_fn={_s_text_proj.grad_fn} | "
                        f"b_text_proj:requires_grad={_b_text_proj.requires_grad} "
                        f"grad_fn={_b_text_proj.grad_fn} | "
                        f"struct_weight={self.promptnu_guided_v3_struct_weight} "
                        f"boundary_weight={self.promptnu_guided_v3_boundary_weight} "
                        f"align_loss_weight={self.promptnu_guided_v3_align_loss_weight}",
                        flush=True,
                    )
                    # ── [PROMPTNU_GUIDED_V3_GRAPH_AUDIT][loss] explicit boolean audit ──
                    audit_print(
                        "PROMPTNU_GUIDED_V3_GRAPH_AUDIT",
                        f"[PROMPTNU_GUIDED_V3_GRAPH_AUDIT][loss] "
                        f"vis_proj_requires_grad={_vp.requires_grad} | "
                        f"s_text_proj_requires_grad={_s_text_proj.requires_grad} | "
                        f"b_text_proj_requires_grad={_b_text_proj.requires_grad} | "
                        f"align_loss_requires_grad={_pg3.requires_grad}",
                        flush=True,
                    )
                    # ── [PROMPTNU_GUIDED_V3_ALIGN_STABILITY_AUDIT] ──
                    audit_print(
                        "PROMPTNU_GUIDED_V3_ALIGN_STABILITY_AUDIT",
                        f"[PROMPTNU_GUIDED_V3_ALIGN_STABILITY_AUDIT] "
                        f"raw_vis_norm={_raw_vis_norm:.8e} | "
                        f"align_eps={_align_eps:.2e} | "
                        f"cosine_eps={_cosine_eps:.2e} | "
                        f"min_align_delta_norm={_min_norm:.2e} | "
                        f"low_norm_mode={_low_norm_mode} | "
                        f"align_target_mode={_v3_align_target_mode} | "
                        f"align_loss_is_finite={_align_loss_is_finite}",
                        flush=True,
                    )
                    # ── retain_grad for intermediate PG3 path tensors ──
                    # Save as model attributes so train.py retain_grad audit can find them.
                    # SAFETY: guard each retain_grad() with requires_grad check to prevent
                    # RuntimeError: "can't retain_grad on Tensor that has requires_grad=False"
                    def _safe_retain_grad(t, name, store_target=None):
                        if t is not None and torch.is_tensor(t) and t.requires_grad:
                            t.retain_grad()
                            if store_target is not None:
                                store_target.append(t)
                            return True
                        else:
                            audit_print(
                                "PROMPTNU_GUIDED_V3_RETAIN_GRAD_SKIP",
                                f"[PROMPTNU_GUIDED_V3_RETAIN_GRAD_SKIP] {name}: "
                                f"requires_grad={t.requires_grad if torch.is_tensor(t) else 'N/A'} "
                                f"(skipped retain_grad, no crash)",
                                flush=True,
                            )
                            return False

                    _safe_retain_grad(_vis_rms, "_vis_rms")
                    self._v3_vis_rms = _vis_rms
                    _safe_retain_grad(_vis_proj, "_vis_proj")
                    self._v3_vis_proj = _vis_proj
                    _safe_retain_grad(_s_text_proj, "_s_text_proj")
                    self._v3_struct_text_proj = _s_text_proj
                    _safe_retain_grad(_b_text_proj, "_b_text_proj")
                    self._v3_boundary_text_proj = _b_text_proj
                    _safe_retain_grad(_struct_cos, "_struct_cos")
                    self._v3_struct_cos = _struct_cos
                    _safe_retain_grad(_bound_cos, "_bound_cos")
                    self._v3_bound_cos = _bound_cos
                    _safe_retain_grad(struct_loss, "struct_loss")
                    self._v3_struct_loss = struct_loss
                    _safe_retain_grad(bound_loss, "bound_loss")
                    self._v3_bound_loss = bound_loss
                    _safe_retain_grad(promptnu_guided_v3_align_loss, "promptnu_guided_v3_align_loss")
                    self._v3_align_loss = promptnu_guided_v3_align_loss
            # ==============================================================
            # Ablation: ablate_semantic_injection disables the channel-gate
            # injection entirely, so refined = base (no semantic residual).
            # ==============================================================
            _skip_injection = getattr(self, "ablate_semantic_injection", False)
            _ablation_mode = getattr(self, "promptnu_guided_v3_injection_ablation", "default")
            _ablation_alpha = getattr(self, "promptnu_guided_v3_post_gate_alpha", 1.0)

            channel_gate = self._get_semantic_channel_gate(
                semantic_delta=semantic_delta,
                device=device,
                dtype=image_embeddings.dtype,
            )

            # Compute default injected delta for reference (used by audit regardless of mode)
            _default_injected_for_audit = channel_gate * semantic_delta * self.semantic_injection_scale

            if _skip_injection:
                # Ablation: skip semantic injection entirely
                refined_image_embeddings = image_embeddings
                injected_delta = torch.zeros_like(semantic_delta)
                injected_delta_norm = torch.tensor(0.0, device=device)
                injection_ratio = torch.tensor(0.0, device=device)
            elif _ablation_mode == "bypass_gate":
                # v3 delta bypasses semantic_channel_gate entirely
                injected_delta = semantic_delta * self.semantic_injection_scale
                refined_image_embeddings = image_embeddings + injected_delta
                injected_delta_norm = injected_delta.detach().float().norm(dim=1).mean()
                injection_ratio = injected_delta_norm / (
                    image_embeddings.detach().float().norm(dim=1).mean() + 1e-6
                )
            elif _ablation_mode == "post_gate_add":
                # Keep original gated delta + add v3 additive delta post-gate
                _orig_sd = semantic_delta_before_v3.clone()
                _v3_add = semantic_delta - semantic_delta_before_v3  # additive component from v3 guidance
                _original_gated = channel_gate * _orig_sd * self.semantic_injection_scale
                injected_delta = _original_gated + _ablation_alpha * _v3_add
                refined_image_embeddings = image_embeddings + injected_delta
                injected_delta_norm = injected_delta.detach().float().norm(dim=1).mean()
                injection_ratio = injected_delta_norm / (
                    image_embeddings.detach().float().norm(dim=1).mean() + 1e-6
                )
            elif _ablation_mode == "replace_semantic_delta":
                # Same as default — print explanatory note
                if getattr(self, "_v3_test_diag_count", 0) < 2:
                    print(
                        f"[V3_INJECTION_ABLATION] replace_semantic_delta: "
                        f"current 'default' already uses guided_semantic_delta via "
                        f"semantic_delta=guided_semantic_delta assignment (line ~4053). "
                        f"Equivalent to 'default'. Falling through to default injection."
                    )
                (
                    refined_image_embeddings,
                    injected_delta,
                    injected_delta_norm,
                    injection_ratio,
                ) = self._controlled_residual_injection(
                    image_embeddings=image_embeddings,
                    semantic_delta=semantic_delta,
                    channel_gate=channel_gate,
                    semantic_injection_scale=self.semantic_injection_scale,
                )
            else:  # default
                (
                    refined_image_embeddings,
                    injected_delta,
                    injected_delta_norm,
                    injection_ratio,
                ) = self._controlled_residual_injection(
                    image_embeddings=image_embeddings,
                    semantic_delta=semantic_delta,
                    channel_gate=channel_gate,
                    semantic_injection_scale=self.semantic_injection_scale,
                )

            semantic_delta_norm = semantic_delta.detach().float().norm(dim=1).mean()
            base_feat_norm = image_embeddings.detach().float().norm(dim=1).mean()

            # ==================================================================
            # PNURL_AUDIT: Injection comparison debug (Item 4 continued)
            # ==================================================================
            if _PNURL_AUDIT and _PNURL_AUDIT_SAM_COUNTER < 6:
                print(f"\n[PNURL_AUDIT_INJECTION] call={_PNURL_AUDIT_SAM_COUNTER}", flush=True)
                print(f"  semantic_delta_norm={semantic_delta_norm.item():.6e}", flush=True)
                print(f"  channel_gate_mean={channel_gate.mean().item():.6e}  "
                      f"min={channel_gate.min().item():.6e}  "
                      f"max={channel_gate.max().item():.6e}", flush=True)
                print(f"  injected_delta_norm={injected_delta_norm.item():.6e}", flush=True)
                print(f"  base_feat_norm={base_feat_norm.item():.6f}", flush=True)
                print(f"  injection_ratio={injection_ratio.item():.6e}  "
                      f"(={injected_delta_norm.item():.6e}/{base_feat_norm.item():.6f})", flush=True)
                _PNURL_AUDIT_SAM_COUNTER += 1

            # ==================================================================
            # [PROMPTNU_GUIDED_V3_INJECTION_AUDIT] Verify guided delta → injection
            # This block runs AFTER _get_semantic_channel_gate() and
            # _controlled_residual_injection(), so channel_gate and injected_delta
            # are the REAL values (not placeholders).
            # ==================================================================
            if self.training and getattr(self, "_v3_injection_audit_count", 0) < 2:
                self._v3_injection_audit_count = getattr(self, "_v3_injection_audit_count", 0) + 1
                with torch.no_grad():
                    _before_v3_norm = semantic_delta_before_v3.detach().float().norm(dim=1).mean().item()
                    _after_v3_norm = semantic_delta.detach().float().norm(dim=1).mean().item()
                    _delta_for_gate = semantic_delta  # the delta passed to _get_semantic_channel_gate
                    _delta_for_gate_norm = _delta_for_gate.detach().float().norm(dim=1).mean().item()
                    _raw_gate = channel_gate  # from _get_semantic_channel_gate
                    _raw_gate_mean = _raw_gate.detach().float().mean().item()
                    _raw_gate_norm = _raw_gate.detach().float().norm().item()
                    _inj_delta_norm = injected_delta.detach().float().norm(dim=1).mean().item()
                    # Expected injected norm if gate were all-ones: semantic_delta * semantic_injection_scale
                    _expected_norm = _after_v3_norm * abs(self.semantic_injection_scale)
                    # Determine whether guided delta is used for injection
                    _uses_guided = bool(_delta_for_gate_norm == _after_v3_norm)
                    # Debug why injected_delta_norm may be 0
                    _zero_reason = "none"
                    if _inj_delta_norm < 1e-12:
                        if getattr(self, "ablate_semantic_injection", False):
                            _zero_reason = "ablated"
                        elif _raw_gate_mean < 1e-12:
                            _zero_reason = "gate_zero"
                        elif abs(self.semantic_injection_scale) < 1e-12:
                            _zero_reason = "scale_zero"
                        elif _delta_for_gate_norm < 1e-12:
                            _zero_reason = "delta_zero"
                        elif _delta_for_gate_norm != _after_v3_norm:
                            _zero_reason = "old_delta_used"
                        else:
                            _zero_reason = "unknown"
                    print(
                        f"\n[PROMPTNU_GUIDED_V3_INJECTION_AUDIT] "
                        f"guidance_mode={getattr(self, 'promptnu_guided_v3_guidance_mode', 'scale_add')} | "
                        f"before_v3_norm={_before_v3_norm:.8e} | "
                        f"after_v3_norm={_after_v3_norm:.8e} | "
                        f"delta_used_for_gate_norm={_delta_for_gate_norm:.8e} | "
                        f"channel_gate_mean={_raw_gate_mean:.8e} | "
                        f"channel_gate_norm={_raw_gate_norm:.8e} | "
                        f"injected_delta_norm={_inj_delta_norm:.8e} | "
                        f"expected_injected_norm_from_after_v3={_expected_norm:.8e} | "
                        f"uses_guided_delta_for_injection={_uses_guided} | "
                        f"max_semantic_gate={self.max_semantic_gate} | "
                        f"semantic_injection_scale={self.semantic_injection_scale} | "
                        f"ablate_semantic_injection={getattr(self, 'ablate_semantic_injection', False)} | "
                        f"zero_reason={_zero_reason}",
                        flush=True,
                    )

            # ==============================================================
            # [TEST_FORWARD_AUDIT][v3_runtime] Test-time v3 runtime diagnostics
            # This block prints dynamic v3 runtime values during eval/test,
            # NOT gated by self.training. Limited to first 2 forward calls.
            # ==============================================================
            _v3_test_diag_count = getattr(self, "_v3_test_diag_count", 0)
            if _v3_test_diag_count < 2:
                self._v3_test_diag_count = _v3_test_diag_count + 1
                with torch.no_grad():
                    _v3_enabled = getattr(self, "enable_promptnu_guided_v3", False)
                    _v3_adapter = getattr(self, "promptnu_guided_adapter", None)
                    _v3_prompt_source = str(getattr(self, "promptnu_guided_v3_prompt_source", "pred_attr"))
                    _v3_guidance_mode = str(getattr(self, "promptnu_guided_v3_guidance_mode", "scale_add"))
                    _v3_use_text_bank = getattr(self, "promptnu_guided_v3_use_text_bank", False)
                    _v3_debug = promptnu_guided_v3_debug

                    _v3_active = _v3_debug.get("v3_active", 0)
                    _v3_skipped = _v3_debug.get("v3_skipped", 0)
                    _v3_skip_reason = _v3_debug.get("v3_skip_reason", "N/A")

                    _debug_float = lambda k, d=float("nan"): float(_v3_debug.get(k, d)) if not isinstance(_v3_debug.get(k, d), str) else float("nan")
                    _debug_str = lambda k, d="N/A": str(_v3_debug.get(k, d))

                    _ts_mean = _debug_float("promptnu_guided_v3_text_scale_mean", 0.0)
                    _ts_std = _debug_float("promptnu_guided_v3_text_scale_std", 0.0)
                    _td_mean = _debug_float("promptnu_guided_v3_text_delta_mean", 0.0)
                    _td_std = _debug_float("promptnu_guided_v3_text_delta_std", 0.0)
                    _add_norm = _debug_float("promptnu_guided_v3_additive_delta_norm", 0.0)
                    _sd_before_norm = semantic_delta_before_v3.detach().float().norm(dim=1).mean().item()
                    _sd_after_norm = semantic_delta.detach().float().norm(dim=1).mean().item()
                    _delta_for_gate_norm = semantic_delta.detach().float().norm(dim=1).mean().item()
                    _gate_mean_val = channel_gate.detach().float().mean().item()
                    _gate_norm_val = channel_gate.detach().float().norm().item()
                    _inj_norm_val = injected_delta.detach().float().norm(dim=1).mean().item()
                    _inj_ratio_val = _inj_norm_val / (_sd_after_norm + 1e-8)
                    _uses_guided = bool(_delta_for_gate_norm == _sd_after_norm)

                    print("[TEST_FORWARD_AUDIT][v3_runtime]", flush=True)
                    print(f"  enable_promptnu_guided_v3={_v3_enabled}", flush=True)
                    print(f"  prompt_source={_v3_prompt_source}", flush=True)
                    print(f"  guidance_mode={_v3_guidance_mode}", flush=True)
                    print(f"  v3_active={_v3_active}", flush=True)
                    print(f"  v3_skipped={_v3_skipped}", flush=True)
                    print(f"  v3_skip_reason={_v3_skip_reason}", flush=True)
                    print(f"  use_text_bank={_v3_use_text_bank}", flush=True)
                    print(f"  text_scale_mean={_ts_mean:.8e}", flush=True)
                    print(f"  text_scale_std={_ts_std:.8e}", flush=True)
                    print(f"  text_delta_mean={_td_mean:.8e}", flush=True)
                    print(f"  text_delta_std={_td_std:.8e}", flush=True)
                    print(f"  additive_delta_norm={_add_norm:.8e}", flush=True)
                    print(f"  semantic_delta_before_v3_norm={_sd_before_norm:.8e}", flush=True)
                    print(f"  semantic_delta_after_v3_norm={_sd_after_norm:.8e}", flush=True)
                    print(f"  delta_used_for_gate_norm={_delta_for_gate_norm:.8e}", flush=True)
                    print(f"  channel_gate_mean={_gate_mean_val:.8e}", flush=True)
                    print(f"  channel_gate_norm={_gate_norm_val:.8e}", flush=True)
                    print(f"  injected_delta_norm={_inj_norm_val:.8e}", flush=True)
                    print(f"  injection_ratio={_inj_ratio_val:.8e}", flush=True)
                    print(f"  uses_guided_delta_for_injection={_uses_guided}", flush=True)

                # Store v3 runtime norms in promptnu_guided_v3_debug so they appear in diagnostics dict
                promptnu_guided_v3_debug["semantic_delta_before_v3_norm"] = _sd_before_norm
                promptnu_guided_v3_debug["semantic_delta_after_v3_norm"] = _sd_after_norm
                promptnu_guided_v3_debug["uses_guided_delta_for_injection"] = 1.0 if _uses_guided else 0.0

            # ==============================================================
            # [V3_INJECTION_ABLATION_AUDIT] Ablation-specific runtime audit
            # Prints detailed per-sample injection path metrics for the first
            # 2 forward calls. Shows how each ablation mode transforms the
            # injected delta vs the default (gated) behavior.
            # ==============================================================
            _v3_ablation_diag_count = getattr(self, "_v3_ablation_diag_count", 0)
            if _v3_ablation_diag_count < 2:
                self._v3_ablation_diag_count = _v3_ablation_diag_count + 1
                with torch.no_grad():
                    _ablation_mode = getattr(self, "promptnu_guided_v3_injection_ablation", "default")
                    _ablation_alpha_val = getattr(self, "promptnu_guided_v3_post_gate_alpha", 1.0)
                    _orig_sd_norm = semantic_delta_before_v3.detach().float().norm(dim=1).mean().item()
                    _v3_add_norm = (semantic_delta - semantic_delta_before_v3).detach().float().norm(dim=1).mean().item()
                    _guided_sd_norm = semantic_delta.detach().float().norm(dim=1).mean().item()
                    _gate_mean_val2 = channel_gate.detach().float().mean().item()
                    _default_inj_norm = _default_injected_for_audit.detach().float().norm(dim=1).mean().item()
                    _actual_inj_norm = injected_delta.detach().float().norm(dim=1).mean().item()
                    _actual_to_default_ratio = _actual_inj_norm / (_default_inj_norm + 1e-12)
                    _uses_gate = 0.0 if _ablation_mode == "bypass_gate" else 1.0
                    _uses_post_gate_add = 1.0 if _ablation_mode == "post_gate_add" else 0.0

                    print("[V3_INJECTION_ABLATION_AUDIT]", flush=True)
                    print(f"  mode={_ablation_mode}", flush=True)
                    print(f"  post_gate_alpha={_ablation_alpha_val:.4f}", flush=True)
                    print(f"  original_semantic_delta_norm={_orig_sd_norm:.8e}", flush=True)
                    print(f"  v3_additive_delta_norm={_v3_add_norm:.8e}", flush=True)
                    print(f"  guided_semantic_delta_norm={_guided_sd_norm:.8e}", flush=True)
                    print(f"  semantic_channel_gate_mean={_gate_mean_val2:.8e}", flush=True)
                    print(f"  default_injected_delta_norm={_default_inj_norm:.8e}", flush=True)
                    print(f"  actual_injected_delta_norm={_actual_inj_norm:.8e}", flush=True)
                    print(f"  actual_to_default_ratio={_actual_to_default_ratio:.8e}", flush=True)
                    print(f"  uses_gate={_uses_gate}", flush=True)
                    print(f"  uses_post_gate_add={_uses_post_gate_add}", flush=True)

                # Store ablation diagnostics in promptnu_guided_v3_debug for compare script
                promptnu_guided_v3_debug["v3_ablation_mode"] = _ablation_mode
                promptnu_guided_v3_debug["v3_ablation_original_sd_norm"] = _orig_sd_norm
                promptnu_guided_v3_debug["v3_ablation_v3_additive_delta_norm"] = _v3_add_norm
                promptnu_guided_v3_debug["v3_ablation_guided_sd_norm"] = _guided_sd_norm
                promptnu_guided_v3_debug["v3_ablation_gate_mean"] = _gate_mean_val2
                promptnu_guided_v3_debug["v3_ablation_default_inj_norm"] = _default_inj_norm
                promptnu_guided_v3_debug["v3_ablation_actual_inj_norm"] = _actual_inj_norm
                promptnu_guided_v3_debug["v3_ablation_actual_to_default_ratio"] = _actual_to_default_ratio
                promptnu_guided_v3_debug["v3_ablation_uses_gate"] = _uses_gate
                promptnu_guided_v3_debug["v3_ablation_uses_post_gate_add"] = _uses_post_gate_add

            base_feat_norm = image_embeddings.detach().float().norm(dim=1).mean()
            channel_gate_mean = channel_gate.detach().float().mean()
            channel_gate_min = channel_gate.detach().float().min()
            channel_gate_max = channel_gate.detach().float().max()
            channel_gate_std = channel_gate.detach().float().std()
        else:
            semantic_delta = torch.zeros_like(image_embeddings)
            channel_gate = torch.zeros(
                image_embeddings.shape[0],
                image_embeddings.shape[1],
                1,
                1,
                device=device,
                dtype=image_embeddings.dtype,
            )
            injected_delta = torch.zeros_like(image_embeddings)
            refined_image_embeddings = image_embeddings

            pnurl_loss = torch.tensor(0.0, device=device)

            attr_logits = {}
            density_map = None
            low_freq_prompt = None
            high_freq_prompt = None

        if self.clip_model is not None:
            pos_tokens = self._tokenize_to_input_ids(base_texts, device)
            neg_tokens = self._tokenize_to_input_ids(["Background"] * len(base_texts), device)

            if self.use_coop and self.prompt_learner is not None:
                if next(self.prompt_learner.parameters()).device != device:
                    self.prompt_learner = self.prompt_learner.to(device)

                pos_feats = self.prompt_learner(organ_indices, pos_tokens, density_features=None)
                neg_feats = self.prompt_learner(organ_indices, neg_tokens, density_features=None)
            else:
                with torch.no_grad():
                    pos_feats = self.clip_model.encode_text(pos_tokens).float()
                    neg_feats = self.clip_model.encode_text(neg_tokens).float()

            pos_feats = F.normalize(pos_feats.float(), dim=-1, eps=1e-6)
            neg_feats = F.normalize(neg_feats.float(), dim=-1, eps=1e-6)
        else:
            # CONCH text encoder disabled — use dummy text features (safe for phases
            # where semantic text conditioning is not needed, e.g. Phase B).
            _dummy = torch.zeros(len(base_texts), 512, device=device)
            pos_feats = _dummy
            neg_feats = _dummy

        text_features = torch.stack([pos_feats, neg_feats], dim=1).float()

        # ------------------------------------------------------------------
        # SB GT-CONCH guidance injection
        # ------------------------------------------------------------------
        sb_guidance_debug: Dict[str, Any] = {}
        if self.sb_guidance_mode == "gt_conch" and self.sb_conch_adapter is not None:
            # 1. Extract SB labels from batched_input (list[dict], per-sample)
            sb_struct_labels_list: List[torch.Tensor] = []
            sb_bound_labels_list: List[torch.Tensor] = []
            for x in batched_input:
                _sl = x.get("structure_attr_labels", None)
                if _sl is not None:
                    if not torch.is_tensor(_sl):
                        _sl = torch.tensor(_sl, dtype=torch.long)
                    sb_struct_labels_list.append(_sl.to(device=device, dtype=torch.long))
                _bl = x.get("boundary_attr_labels", None)
                if _bl is not None:
                    if not torch.is_tensor(_bl):
                        _bl = torch.tensor(_bl, dtype=torch.long)
                    sb_bound_labels_list.append(_bl.to(device=device, dtype=torch.long))

            sb_struct_labels: Optional[torch.Tensor] = None
            sb_bound_labels: Optional[torch.Tensor] = None
            if len(sb_struct_labels_list) > 0:
                sb_struct_labels = torch.stack(sb_struct_labels_list, dim=0)  # [B, 5]
            if len(sb_bound_labels_list) > 0:
                sb_bound_labels = torch.stack(sb_bound_labels_list, dim=0)    # [B, 4]

            # 2. Get CONCH text embeddings (cached lookup + mean aggregation)
            _struct_te, _bound_te, _sb_debug = self._get_sb_conch_embeddings(
                sb_struct_labels, sb_bound_labels
            )
            sb_guidance_debug.update(_sb_debug)

            # 3. Run through zero-init adapter → guidance deltas
            _low_delta: Optional[torch.Tensor] = None
            _high_delta: Optional[torch.Tensor] = None
            if _struct_te is not None and _bound_te is not None:
                _low_delta, _high_delta = self.sb_conch_adapter(_struct_te, _bound_te)
            elif _struct_te is not None:
                # Only structure available → inject into low branch only
                _low_delta, _ = self.sb_conch_adapter(_struct_te, torch.zeros_like(_struct_te))
            elif _bound_te is not None:
                # Only boundary available → inject into high branch only
                _, _high_delta = self.sb_conch_adapter(torch.zeros_like(_bound_te), _bound_te)

            # 4. Apply weight and merge into existing low_freq_prompt / high_freq_prompt
            w = self.sb_guidance_weight
            if _low_delta is not None:
                _low_delta_w = _low_delta * w
                if low_freq_prompt is not None:
                    low_freq_prompt = low_freq_prompt + _low_delta_w.to(dtype=low_freq_prompt.dtype)
                else:
                    low_freq_prompt = _low_delta_w.float()
                sb_guidance_debug["low_guidance_norm"] = _low_delta_w.detach().float().norm(dim=-1).mean().item()

            if _high_delta is not None:
                _high_delta_w = _high_delta * w
                if high_freq_prompt is not None:
                    high_freq_prompt = high_freq_prompt + _high_delta_w.to(dtype=high_freq_prompt.dtype)
                else:
                    high_freq_prompt = _high_delta_w.float()
                sb_guidance_debug["high_guidance_norm"] = _high_delta_w.detach().float().norm(dim=-1).mean().item()

            # Adapter zero-init verification: parameter norms
            if self.sb_conch_adapter is not None:
                sb_guidance_debug["adapter_low_weight_norm"] = (
                    self.sb_conch_adapter.low_adapter.weight.detach().float().norm().item()
                )
                sb_guidance_debug["adapter_high_weight_norm"] = (
                    self.sb_conch_adapter.high_adapter.weight.detach().float().norm().item()
                )
                sb_guidance_debug["adapter_low_bias_norm"] = (
                    self.sb_conch_adapter.low_adapter.bias.detach().float().norm().item()
                )
                sb_guidance_debug["adapter_high_bias_norm"] = (
                    self.sb_conch_adapter.high_adapter.bias.detach().float().norm().item()
                )

            sb_guidance_debug["guidance_mode"] = self.sb_guidance_mode
            sb_guidance_debug["guidance_weight"] = w
            sb_guidance_debug["low_delta_is_none"] = float(_low_delta is None)
            sb_guidance_debug["high_delta_is_none"] = float(_high_delta is None)

        # ------------------------------------------------------------------
        # SB GT-DIRECT guidance injection (GT labels → one-hot → MLP → deltas)
        # ------------------------------------------------------------------
        if self.sb_guidance_mode == "gt_direct" and self.sb_direct_adapter is not None:
            # 1. Extract SB labels from batched_input (list[dict], per-sample)
            sb_struct_labels_list = []
            sb_bound_labels_list = []
            for x in batched_input:
                _sl = x.get("structure_attr_labels", None)
                if _sl is not None:
                    if not torch.is_tensor(_sl):
                        _sl = torch.tensor(_sl, dtype=torch.long)
                    sb_struct_labels_list.append(_sl.to(device=device, dtype=torch.long))
                _bl = x.get("boundary_attr_labels", None)
                if _bl is not None:
                    if not torch.is_tensor(_bl):
                        _bl = torch.tensor(_bl, dtype=torch.long)
                    sb_bound_labels_list.append(_bl.to(device=device, dtype=torch.long))

            sb_struct_labels = None
            sb_bound_labels = None
            if len(sb_struct_labels_list) > 0:
                sb_struct_labels = torch.stack(sb_struct_labels_list, dim=0)  # [B, 5]
            if len(sb_bound_labels_list) > 0:
                sb_bound_labels = torch.stack(sb_bound_labels_list, dim=0)    # [B, 4]

            # 2. Run through zero-init direct adapter → guidance deltas
            _low_delta = None
            _high_delta = None
            if sb_struct_labels is not None and sb_bound_labels is not None:
                _low_delta, _high_delta = self.sb_direct_adapter(
                    sb_struct_labels, sb_bound_labels
                )
            elif sb_struct_labels is not None:
                # Only structure available → inject into low branch only
                _dummy_bound = torch.zeros_like(sb_struct_labels[:, :4])
                _low_delta, _ = self.sb_direct_adapter(sb_struct_labels, _dummy_bound)
            elif sb_bound_labels is not None:
                # Only boundary available → inject into high branch only
                _dummy_struct = torch.zeros_like(sb_bound_labels[:, :5])
                _, _high_delta = self.sb_direct_adapter(_dummy_struct, sb_bound_labels)

            # 3. Apply weight and merge into existing low_freq_prompt / high_freq_prompt
            w = self.sb_guidance_weight
            if _low_delta is not None:
                _low_delta_w = _low_delta * w
                if low_freq_prompt is not None:
                    low_freq_prompt = low_freq_prompt + _low_delta_w.to(dtype=low_freq_prompt.dtype)
                else:
                    low_freq_prompt = _low_delta_w.float()
                sb_guidance_debug["low_guidance_norm"] = _low_delta_w.detach().float().norm(dim=-1).mean().item()

            if _high_delta is not None:
                _high_delta_w = _high_delta * w
                if high_freq_prompt is not None:
                    high_freq_prompt = high_freq_prompt + _high_delta_w.to(dtype=high_freq_prompt.dtype)
                else:
                    high_freq_prompt = _high_delta_w.float()
                sb_guidance_debug["high_guidance_norm"] = _high_delta_w.detach().float().norm(dim=-1).mean().item()

            # Adapter zero-init verification: parameter norms
            if self.sb_direct_adapter is not None:
                sb_guidance_debug["direct_struct_out_weight_norm"] = (
                    self.sb_direct_adapter.structure_out.weight.detach().float().norm().item()
                )
                sb_guidance_debug["direct_bound_out_weight_norm"] = (
                    self.sb_direct_adapter.boundary_out.weight.detach().float().norm().item()
                )
                sb_guidance_debug["direct_struct_out_bias_norm"] = (
                    self.sb_direct_adapter.structure_out.bias.detach().float().norm().item()
                )
                sb_guidance_debug["direct_bound_out_bias_norm"] = (
                    self.sb_direct_adapter.boundary_out.bias.detach().float().norm().item()
                )

            sb_guidance_debug["guidance_mode"] = self.sb_guidance_mode
            sb_guidance_debug["guidance_weight"] = w
            sb_guidance_debug["low_delta_is_none"] = float(_low_delta is None)
            sb_guidance_debug["high_delta_is_none"] = float(_high_delta is None)

        # ------------------------------------------------------------------
        # SB PRED-DIRECT guidance injection
        # (predicted structure/boundary logits → argmax labels → MLP → deltas)
        # 不读取 GT labels，不访问 structure_boundary_attr_path，无 test leakage。
        # ------------------------------------------------------------------
        if self.sb_guidance_mode == "pred_direct" and self.sb_direct_adapter is not None:
            # 1. Use predicted structure/boundary logits from attr heads (already computed at top of forward)
            if structure_attr_logits is not None and boundary_attr_logits is not None:
                # Argmax → discrete labels [B, 5] / [B, 4]
                pred_struct_labels = torch.argmax(structure_attr_logits, dim=-1)  # [B, 5]
                pred_bound_labels = torch.argmax(boundary_attr_logits, dim=-1)    # [B, 4]

                # 2. Run through zero-init direct adapter → guidance deltas
                _low_delta, _high_delta = self.sb_direct_adapter(
                    pred_struct_labels, pred_bound_labels
                )

                # 3. Apply weight and merge into existing low_freq_prompt / high_freq_prompt
                w = self.sb_guidance_weight
                if _low_delta is not None:
                    _low_delta_w = _low_delta * w
                    if low_freq_prompt is not None:
                        low_freq_prompt = low_freq_prompt + _low_delta_w.to(dtype=low_freq_prompt.dtype)
                    else:
                        low_freq_prompt = _low_delta_w.float()
                    sb_guidance_debug["low_guidance_norm"] = _low_delta_w.detach().float().norm(dim=-1).mean().item()

                if _high_delta is not None:
                    _high_delta_w = _high_delta * w
                    if high_freq_prompt is not None:
                        high_freq_prompt = high_freq_prompt + _high_delta_w.to(dtype=high_freq_prompt.dtype)
                    else:
                        high_freq_prompt = _high_delta_w.float()
                    sb_guidance_debug["high_guidance_norm"] = _high_delta_w.detach().float().norm(dim=-1).mean().item()

                # 4. Adapter zero-init verification: parameter norms
                if self.sb_direct_adapter is not None:
                    sb_guidance_debug["direct_struct_out_weight_norm"] = (
                        self.sb_direct_adapter.structure_out.weight.detach().float().norm().item()
                    )
                    sb_guidance_debug["direct_bound_out_weight_norm"] = (
                        self.sb_direct_adapter.boundary_out.weight.detach().float().norm().item()
                    )

                # 5. Predicted label diagnostics
                sb_guidance_debug["guidance_mode"] = self.sb_guidance_mode
                sb_guidance_debug["guidance_weight"] = w
                sb_guidance_debug["low_delta_is_none"] = float(_low_delta is None)
                sb_guidance_debug["high_delta_is_none"] = float(_high_delta is None)

                # Structure logits shape and label distributions
                sb_guidance_debug["structure_logits_shape"] = str(list(structure_attr_logits.shape))
                sb_guidance_debug["boundary_logits_shape"] = str(list(boundary_attr_logits.shape))
                # Predicted label distributions (per-attribute, across batch)
                _struct_dist = torch.stack([torch.bincount(pred_struct_labels[:, i], minlength=3) for i in range(5)], dim=0)  # [5, 3]
                _bound_dist = torch.stack([torch.bincount(pred_bound_labels[:, i], minlength=3) for i in range(4)], dim=0)  # [4, 3]
                sb_guidance_debug["pred_struct_labels_dist"] = _struct_dist.detach().cpu()  # [5, 3]
                sb_guidance_debug["pred_bound_labels_dist"] = _bound_dist.detach().cpu()    # [4, 3]
            else:
                sb_guidance_debug["guidance_mode"] = self.sb_guidance_mode
                sb_guidance_debug["warning"] = "structure_attr_logits or boundary_attr_logits is None"
                print(
                    f"⚠️ [SB_PRED_DIRECT] structure_boundary_attr_heads returned None logits. "
                    f"Check --enable_structure_boundary_attr_heads."
                )

        # (Numeric Attribute → FreqPath injection relocated to inner chunk loop,
        #  immediately before FREQPATH_ROUTE_CONFIG; see below.)
        _numeric_guidance_triggered = False

        # ==============================================================
        # PromptNu-lite v2: Residual-Coupled Semantic Alignment
        # ==============================================================
        # When enabled, applies structure/boundary text alignment loss to
        # GAP-pooled semantic residual features (semantic_delta, injected_delta,
        # or refined_image_embeddings). Gradients flow back through the chosen
        # target and into semantic_delta_adapter (and optionally semantic_channel_gate).
        promptnu_lite_align_loss = torch.tensor(0.0, device=device)
        promptnu_lite_align_debug: Dict[str, Any] = {}

        # Debug: print why PromptNu-lite v2 is (not) activated
        if self.enable_promptnu_lite_align:
            _pnl_reasons = []
            if not self.use_pnurl:
                _pnl_reasons.append("use_pnurl=False")
            if not self.enable_attr_text_alignment:
                _pnl_reasons.append("enable_attr_text_alignment=False")
            if not (self.promptnu_lite_struct_weight > 0.0 or self.promptnu_lite_boundary_weight > 0.0):
                _pnl_reasons.append(
                    f"struct_weight={self.promptnu_lite_struct_weight}, "
                    f"boundary_weight={self.promptnu_lite_boundary_weight} (both <= 0)"
                )
            if _pnl_reasons:
                self._pnurl_lite_log(
                    f"[PROMPTNU_LITE_V2_SKIP] enable_promptnu_lite_align=True but "
                    f"forward is SKIPPED due to: {'; '.join(_pnl_reasons)}. "
                    f"Set --promptnu_lite_struct_weight>0 or --promptnu_lite_boundary_weight>0, "
                    f"ensure --use_pnurl=True and --enable_attr_text_alignment=True."
                )

        if (
            self.enable_promptnu_lite_align
            and self.use_pnurl
            and self.enable_attr_text_alignment
            and (self.promptnu_lite_struct_weight > 0.0 or self.promptnu_lite_boundary_weight > 0.0)
        ):
            # 1. Select target feature based on promptnu_lite_target
            _target = self.promptnu_lite_target
            _target_feat: Optional[torch.Tensor] = None
            if _target == "semantic_delta":
                _target_feat = semantic_delta  # [B, C, H, W]
            elif _target == "injected_delta":
                _target_feat = injected_delta  # [B, C, H, W]
            elif _target == "refined_feature":
                _target_feat = refined_image_embeddings  # [B, C, H, W]
            else:
                if self._pnurl_lite_audit_count < 2:
                    print(
                        f"[PROMPTNU_LITE_V2] Unknown target={_target}, falling back to semantic_delta",
                        flush=True,
                    )
                _target_feat = semantic_delta

            if _target_feat is not None and _target_feat.numel() > 0:
                # Pool target feature by selected mode: [B, C, H, W] -> [B, C]
                _pool_mode = self.promptnu_lite_pool_mode
                if _pool_mode == "absmean":
                    _target_pooled = _target_feat.abs().mean(dim=[-2, -1])
                elif _pool_mode == "rms":
                    _target_pooled = torch.sqrt((_target_feat ** 2).mean(dim=[-2, -1]) + 1e-6)
                else:  # "gap" (default) or unknown fallback
                    _target_pooled = _target_feat.mean(dim=[-2, -1])

                # 2. Extract GT structure/boundary labels from batched_input
                _s_labels_list = [x.get("structure_attr_labels", None) for x in batched_input]
                _b_labels_list = [x.get("boundary_attr_labels", None) for x in batched_input]

                _s_labels: Optional[torch.Tensor] = None
                _b_labels: Optional[torch.Tensor] = None
                if all(l is not None for l in _s_labels_list):
                    _s_labels = torch.stack(_s_labels_list, dim=0).to(device=device, dtype=torch.long)
                if all(l is not None for l in _b_labels_list):
                    _b_labels = torch.stack(_b_labels_list, dim=0).to(device=device, dtype=torch.long)

                # Only compute if at least one of structure/boundary labels is available
                if _s_labels is not None or _b_labels is not None:
                    # 3. Get text embeddings from CONCH cache (reuse existing method)
                    _s_text, _b_text, _i_text, _text_align_debug = self._get_attr_text_embeddings(
                        structure_attr_labels=_s_labels,
                        boundary_attr_labels=_b_labels,
                        per_instance_attr_labels=None,
                        kept_positions=None,
                        return_per_instance_text=False,
                        per_instance_ids=None,
                        kept_instance_ids=None,
                    )

                    # 4. Project visual features using existing projection heads
                    _vis_proj = _target_pooled
                    if self.promptnu_lite_detach_visual:
                        _vis_proj = _vis_proj.detach()

                    _proj_s_vis: Optional[torch.Tensor] = None
                    _proj_b_vis: Optional[torch.Tensor] = None
                    if self.attr_align_vis_proj_structure is not None:
                        _proj_s_vis = self.attr_align_vis_proj_structure(_vis_proj)
                    if self.attr_align_vis_proj_boundary is not None:
                        _proj_b_vis = self.attr_align_vis_proj_boundary(_vis_proj)

                    # 5. Project text embeddings
                    _s_text_proj: Optional[torch.Tensor] = None
                    _b_text_proj: Optional[torch.Tensor] = None
                    _eps = 1e-6

                    if _s_text is not None and self.attr_align_text_proj is not None:
                        _s_t = _s_text.detach() if self.promptnu_lite_detach_text else _s_text
                        _s_text_proj = self.attr_align_text_proj(_s_t)

                    if _b_text is not None and self.attr_align_text_proj is not None:
                        _b_t = _b_text.detach() if self.promptnu_lite_detach_text else _b_text
                        _b_text_proj = self.attr_align_text_proj(_b_t)

                    # 6. Compute cosine alignment loss: 1 - cosine(vis_proj, text_proj)
                    _s_loss_val = torch.tensor(0.0, device=device)
                    _b_loss_val = torch.tensor(0.0, device=device)

                    if _proj_s_vis is not None and _s_text_proj is not None:
                        _s_vn = F.normalize(_proj_s_vis, dim=-1, eps=_eps)
                        _s_tn = F.normalize(_s_text_proj, dim=-1, eps=_eps)
                        _s_sim = (_s_vn * _s_tn).sum(dim=-1).mean()
                        _s_loss_val = 1.0 - _s_sim
                        promptnu_lite_align_debug["pnurl_s_sim"] = _s_sim.detach()
                        promptnu_lite_align_debug["pnurl_s_loss"] = _s_loss_val.detach()

                    if _proj_b_vis is not None and _b_text_proj is not None:
                        _b_vn = F.normalize(_proj_b_vis, dim=-1, eps=_eps)
                        _b_tn = F.normalize(_b_text_proj, dim=-1, eps=_eps)
                        _b_sim = (_b_vn * _b_tn).sum(dim=-1).mean()
                        _b_loss_val = 1.0 - _b_sim
                        promptnu_lite_align_debug["pnurl_b_sim"] = _b_sim.detach()
                        promptnu_lite_align_debug["pnurl_b_loss"] = _b_loss_val.detach()

                    # 7. Weighted sum
                    promptnu_lite_align_loss = (
                        self.promptnu_lite_struct_weight * _s_loss_val
                        + self.promptnu_lite_boundary_weight * _b_loss_val
                    )

                    # 8. Debug audit (first 2 batches, training mode)
                    if self.training and self._pnurl_lite_audit_count < 2:
                        self._pnurl_lite_audit_count += 1
                        _ac = self._pnurl_lite_audit_count

                        # ── Target feature norms ──
                        _target_gap_norm = _target_feat.mean(dim=[-2, -1]).norm(dim=-1).mean().detach().item()
                        _target_absmean_norm = _target_feat.abs().mean(dim=[-2, -1]).norm(dim=-1).mean().detach().item()
                        _target_rms_norm = torch.sqrt((_target_feat ** 2).mean(dim=[-2, -1]) + 1e-6).norm(dim=-1).mean().detach().item()
                        if self.promptnu_lite_pool_mode == "absmean":
                            _used_target_norm = _target_absmean_norm
                        elif self.promptnu_lite_pool_mode == "rms":
                            _used_target_norm = _target_rms_norm
                        else:
                            _used_target_norm = _target_gap_norm
                        _text_struct_norm = _s_text.norm(dim=-1).mean().detach().item() if _s_text is not None else float('nan')
                        _text_bound_norm = _b_text.norm(dim=-1).mean().detach().item() if _b_text is not None else float('nan')

                        # ── Similarities ──
                        _struct_sim = _s_sim.detach().item() if _proj_s_vis is not None and _s_text_proj is not None else float('nan')
                        _bound_sim = _b_sim.detach().item() if _proj_b_vis is not None and _b_text_proj is not None else float('nan')

                        self._pnurl_lite_log(
                            f"\n[PROMPTNU_LITE_AUDIT][enter] count={_ac}"
                        )
                        self._pnurl_lite_log(
                            f"  [PROMPTNU_LITE_CONFIG] target={_target} | "
                            f"pool_mode={self.promptnu_lite_pool_mode} | "
                            f"detach_text={self.promptnu_lite_detach_text} | "
                            f"detach_visual={self.promptnu_lite_detach_visual}"
                        )
                        self._pnurl_lite_log(
                            f"  [PROMPTNU_LITE_MODEL_CONFIG] target_feat.shape={tuple(_target_feat.shape)} | "
                            f"target_pooled.shape={tuple(_target_pooled.shape)}"
                        )
                        self._pnurl_lite_log(
                            f"  has_s_labels={_s_labels is not None} | has_b_labels={_b_labels is not None}"
                        )
                        if _s_text is not None:
                            self._pnurl_lite_log(f"  s_text.shape={tuple(_s_text.shape)}")
                        if _b_text is not None:
                            self._pnurl_lite_log(f"  b_text.shape={tuple(_b_text.shape)}")

                        # ── [PROMPTNU_LITE_AUDIT][loss] ──
                        self._pnurl_lite_log(
                            f"  [PROMPTNU_LITE_AUDIT][loss] "
                            f"PromptNuStructLoss={_s_loss_val.item():.6f} | "
                            f"PromptNuBoundLoss={_b_loss_val.item():.6f} | "
                            f"PromptNuAlignLoss={promptnu_lite_align_loss.item():.6f} | "
                            f"StructSim={_struct_sim:.6f} | "
                            f"BoundSim={_bound_sim:.6f} | "
                            f"pool_mode={self.promptnu_lite_pool_mode} | "
                            f"TargetGapNorm={_target_gap_norm:.6f} | "
                            f"TargetAbsMeanNorm={_target_absmean_norm:.6f} | "
                            f"TargetRMSNorm={_target_rms_norm:.6f} | "
                            f"UsedTargetNorm={_used_target_norm:.6f} | "
                            f"TextStructNorm={_text_struct_norm:.6f} | "
                            f"TextBoundNorm={_text_bound_norm:.6f} | "
                            f"struct_weight={self.promptnu_lite_struct_weight} | "
                            f"boundary_weight={self.promptnu_lite_boundary_weight} | "
                            f"target={_target} | "
                            f"detach_text={self.promptnu_lite_detach_text} | "
                            f"detach_visual={self.promptnu_lite_detach_visual}"
                        )

                        # ── [PROMPTNU_LITE_AUDIT][total_loss] (seg_loss_before & total_after logged from train.py) ──
                        self._pnurl_lite_log(
                            f"  [PROMPTNU_LITE_AUDIT][total_loss] "
                            f"promptnu_lite_align_loss={promptnu_lite_align_loss.item():.6f}"
                        )

                        # ── Grad path audit ──
                        if _proj_s_vis is not None:
                            self._pnurl_lite_log(
                                f"  s_vis_proj.requires_grad={_proj_s_vis.requires_grad} "
                                f"grad_fn={_proj_s_vis.grad_fn}"
                            )
                        if _proj_b_vis is not None:
                            self._pnurl_lite_log(
                                f"  b_vis_proj.requires_grad={_proj_b_vis.requires_grad} "
                                f"grad_fn={_proj_b_vis.grad_fn}"
                            )
                        self._pnurl_lite_log(
                            f"  [GRAD_PATH] {_target} -> pool({self.promptnu_lite_pool_mode}) -> vis_proj -> cosine -> loss -> "
                            f"semantic_delta_adapter{' -> channel_gate' if _target in ('injected_delta', 'refined_feature') else ''}"
                        )

        diagnostics = {
            "semantic_channel_gate_mean": channel_gate_mean.detach().float(),
            "semantic_channel_gate_min": channel_gate_min.detach().float(),
            "semantic_channel_gate_max": channel_gate_max.detach().float(),
            "semantic_channel_gate_std": channel_gate_std.detach().float(),
            "semantic_delta_norm": semantic_delta_norm.detach().float(),
            "base_feat_norm": base_feat_norm.detach().float(),
            "injected_delta_norm": injected_delta_norm.detach().float(),
            "injection_ratio": injection_ratio.detach().float(),
            "semantic_delta_reg_loss": self._safe_scalar(semantic_delta_reg_loss, device),
            "semantic_delta_ratio": self._safe_scalar(semantic_delta_ratio, device),
            "semantic_delta_raw_norm": self._safe_scalar(semantic_delta_raw_norm, device),
            "semantic_delta_direction_norm": self._safe_scalar(semantic_delta_direction_norm, device),
            "pos_text_norm": pos_feats.detach().float().norm(dim=-1).mean(),
            "neg_text_norm": neg_feats.detach().float().norm(dim=-1).mean(),
            "use_pnurl": torch.tensor(float(self.use_pnurl), device=device),
            "use_coop": torch.tensor(float(self.use_coop), device=device),
            "use_ot": torch.tensor(0.0, device=device),
            "asr_variant_legacy": torch.tensor(float(self.asr_variant == "legacy"), device=device),
            "asr_variant_freqpath": torch.tensor(float(self.asr_variant == "freqpath"), device=device),
            "asr_regression": torch.tensor(float(self.asr_regression), device=device),
            # SB GT-CONCH guidance diagnostics
            "sb_guidance_mode": self.sb_guidance_mode,
            "sb_guidance_weight": float(self.sb_guidance_weight),
            # Semantic injection ablation config
            "semantic_injection_scale": torch.tensor(float(self.semantic_injection_scale), device=device),
            "semantic_gate_bias_init": torch.tensor(float(self.semantic_gate_bias_init), device=device) if self.semantic_gate_bias_init is not None else torch.tensor(-4.0, device=device),
            # PromptNu-guided v3 config flags
            "enable_promptnu_guided_v3": torch.tensor(float(getattr(self, "enable_promptnu_guided_v3", False)), device=device),
            "promptnu_guided_v3_text_weight": torch.tensor(float(getattr(self, "promptnu_guided_v3_text_weight", 0.01)), device=device),
            "promptnu_guided_v3_align_loss_weight": torch.tensor(float(getattr(self, "promptnu_guided_v3_align_loss_weight", 0.1)), device=device),
            "ablate_semantic_injection": torch.tensor(float(getattr(self, "ablate_semantic_injection", False)), device=device),
            "ablate_pred_attr_guidance": torch.tensor(float(getattr(self, "ablate_pred_attr_guidance", False)), device=device),
            # --- PromptNu-guided v3.1: CONCH text bank & GT align target ---
            "promptnu_guided_v3_use_text_bank": torch.tensor(float(getattr(self, "promptnu_guided_v3_use_text_bank", False)), device=device),
            "promptnu_guided_v3_use_gt_align_target": torch.tensor(float(getattr(self, "promptnu_guided_v3_use_gt_align_target", False)), device=device),
            "promptnu_guided_v3_semantic_dim": torch.tensor(float(getattr(self, "promptnu_guided_v3_semantic_dim", 256)), device=device),
            "promptnu_guided_v3_text_dim": torch.tensor(float(getattr(self, "promptnu_guided_v3_text_dim", 512)), device=device),
        }
        # Ingest PNuDP diagnostic data
        for _k, _v in _pnudp_diag_data.items():
            if isinstance(_v, float) or isinstance(_v, int):
                diagnostics[_k] = torch.tensor(float(_v), device=device)
            elif isinstance(_v, str):
                diagnostics[_k] = _v
            elif isinstance(_v, torch.Tensor):
                diagnostics[_k] = _v.detach().float().to(device)

        # Ingest sb_guidance_debug entries
        for _k, _v in sb_guidance_debug.items():
            if isinstance(_v, float) or isinstance(_v, int):
                diagnostics[_k] = torch.tensor(float(_v), device=device)
            elif isinstance(_v, str):
                diagnostics[_k] = _v
            elif isinstance(_v, torch.Tensor):
                diagnostics[_k] = _v.detach().float().to(device)

        # ==============================================================
        # Phase C: Attribute-Text Alignment Diagnostics
        # ==============================================================
        # Attach alignment loss (scalar, may be None if Phase C disabled)
        # NOTE: DO NOT detach here — train.py reads this key directly for backward.
        #       The detach() would break autograd and cause:
        #       "RuntimeError: element 0 of tensors does not require grad and does not have a grad_fn"
        #       Diagnostics logging in train.py does its own .detach() at line 4428.
        diagnostics["attr_text_align_loss"] = (
            attr_text_align_loss.float()
            if attr_text_align_loss is not None
            else torch.tensor(0.0, device=device, requires_grad=True)
        )
        # Ingest attr_text_align_debug entries (s_sim, b_sim, i_sim, s_loss, b_loss, i_loss, invalid/valid counts)
        for _k, _v in attr_text_align_debug.items():
            if isinstance(_v, float) or isinstance(_v, int):
                diagnostics[_k] = torch.tensor(float(_v), device=device)
            elif isinstance(_v, str):
                diagnostics[_k] = _v
            elif isinstance(_v, torch.Tensor):
                diagnostics[_k] = _v.detach().float().to(device)

        # ==============================================================
        # PromptNu-lite v2: Residual-Coupled Semantic Alignment Diagnostics
        # ==============================================================
        # Attach alignment loss for train.py consumption (do NOT detach — train.py
        # reads this key directly for backward and detaches for logging).
        diagnostics["promptnu_lite_align_loss"] = (
            promptnu_lite_align_loss.float()
            if self.enable_promptnu_lite_align
            else torch.tensor(0.0, device=device, requires_grad=False)
        )
        # Ingest promptnu_lite_align_debug entries (pnurl_s_sim, pnurl_b_sim, pnurl_s_loss, pnurl_b_loss)
        for _k, _v in promptnu_lite_align_debug.items():
            if isinstance(_v, float) or isinstance(_v, int):
                diagnostics[_k] = torch.tensor(float(_v), device=device)
            elif isinstance(_v, str):
                diagnostics[_k] = _v
            elif isinstance(_v, torch.Tensor):
                diagnostics[_k] = _v.detach().float().to(device)

        # ==============================================================
        # PromptNu-guided v3: Predicted-Attribute Guidance Diagnostics
        # ==============================================================
        # Attach alignment loss for train.py consumption (do NOT detach).
        diagnostics["promptnu_guided_v3_align_loss"] = (
            promptnu_guided_v3_align_loss.float()
            if getattr(self, "enable_promptnu_guided_v3", False)
            else torch.tensor(0.0, device=device, requires_grad=False)
        )
        # Ingest promptnu_guided_v3_debug entries (text_scale, scale_factor, pred levels, etc.)
        for _k, _v in (promptnu_guided_v3_debug or {}).items():
            if isinstance(_v, float) or isinstance(_v, int):
                diagnostics[_k] = torch.tensor(float(_v), device=device)
            elif isinstance(_v, str):
                diagnostics[_k] = _v
            elif isinstance(_v, torch.Tensor):
                diagnostics[_k] = _v.detach().float().to(device)

        # When v3 is disabled, write explicit indicator fields so train.py / audit scripts
        # can distinguish "v3 never ran" from "v3 ran but with zero effect".
        if not getattr(self, "enable_promptnu_guided_v3", False):
            diagnostics.setdefault("v3_active", torch.tensor(0.0, device=device))
            diagnostics.setdefault("v3_skipped", torch.tensor(1.0, device=device))
            diagnostics.setdefault("v3_skip_reason", "disabled")
        # FreqPath prompt-routing diagnostics.
        # These counters are kept outside autograd and are used only to verify
        # whether low/high PNuRL prompts really enter MaskDecoder/FreqPathASRBlock.
        freqpath_debug_chunk_count = 0
        freqpath_debug_low_input_count = 0
        freqpath_debug_high_input_count = 0
        freqpath_debug_low_passed_count = 0
        freqpath_debug_high_passed_count = 0
        freqpath_debug_low_norm_sum = 0.0
        freqpath_debug_high_norm_sum = 0.0

        # Internal FreqPathASRBlock diagnostics exported by MaskDecoder.
        # Values are averaged across adaptive-prompt chunks.
        freqpath_internal_debug_sums: Dict[str, float] = {}
        freqpath_internal_debug_count = 0

        fused_image_embeddings = refined_image_embeddings
        # ── SGA-SB v1 CORRECTION: Apply gamma-scaling to spatial deltas ──
        # structure_delta and boundary_delta use the decoder's explicit channel contract.
        # computed in the forward head section (lines ~4132-4156).
        # Here we multiply by learnable gamma BEFORE passing to FreqPathASRBlock.
        # This implements: low_feature += gamma_structure * adapter(structure_prob)
        # In guidance mode, these are passed to MaskDecoder → FreqPathASRBlock.
        # In supervision_only mode, they remain None and are not injected.
        gamma_structure = getattr(self, "gamma_structure", None)
        gamma_boundary = getattr(self, "gamma_boundary", None)
        if structure_delta is not None and gamma_structure is not None:
            _g_struct = gamma_structure.to(device=structure_delta.device, dtype=structure_delta.dtype)
            structure_delta = structure_delta * _g_struct
        if boundary_delta is not None and gamma_boundary is not None:
            _g_bound = gamma_boundary.to(device=boundary_delta.device, dtype=boundary_delta.dtype)
            boundary_delta = boundary_delta * _g_bound

        heatmap_logits_coarse = self.prompt_generator(refined_image_embeddings, text_features)
        hv_logits_coarse = self.basic_hv_head(refined_image_embeddings)

        if self.use_asr:
            hv_logits_out, heatmap_logits_out = self.global_asr_upsampler(
                fused_image_embeddings,
                hv_logits_coarse,
                heatmap_logits_coarse,
                feat_s2,
                feat_s1,
                feat_half,
            )
        else:
            hv_logits_out = hv_logits_coarse
            heatmap_logits_out = heatmap_logits_coarse

        size_logits = attr_logits.get("size", None)
        if size_logits is not None and size_logits.numel() > 0:
            pred_size_class = torch.argmax(size_logits, dim=1)
            size_threshold_map = torch.tensor([10.0, 15.0, 20.0], device=device)
            adaptive_thresh = size_threshold_map[pred_size_class]
        else:
            adaptive_thresh = torch.tensor(15.0, device=device).expand(image_embeddings.shape[0])

        prompts_list = self.prompt_generator.generate_adaptive_prompts(
            heatmap_logits_coarse,
            threshold=0.3,
            k_neighbors=3,
            dense_dist_thresh=adaptive_thresh,
            pred_density=density_map if self.use_pnurl else None,
        )

        feat_size = image_embeddings.shape[-1]
        input_size = self.image_encoder.img_size
        scale_factor = input_size / feat_size

        outputs = []

        for i in range(len(batched_input)):
            prompt_data = prompts_list[i]

            target_h, target_w = batched_input[i]["original_size"]
            input_h, input_w = batched_input[i]["image"].shape[-2:]

            if self.use_asr:
                hv_out_i = hv_logits_out[i:i + 1, :, :input_h, :input_w]
                hm_out_i = heatmap_logits_out[i:i + 1, :, :input_h, :input_w]

                if (input_h, input_w) != (target_h, target_w):
                    hv_out_i = F.interpolate(
                        hv_out_i,
                        size=(target_h, target_w),
                        mode="nearest",
                    )
                    hm_out_i = F.interpolate(
                        hm_out_i,
                        size=(target_h, target_w),
                        mode="bilinear",
                        align_corners=False,
                    )
            else:
                hv_out_i = hv_logits_out[i].unsqueeze(0) if hv_logits_out is not None else None
                hm_out_i = heatmap_logits_out[i].unsqueeze(0)

            density_map_i = None
            if density_map is not None:
                density_map_raw = density_map[i]
                if density_map_raw.shape[-2:] != (target_h, target_w):
                    density_map_i = F.interpolate(
                        density_map_raw.unsqueeze(0),
                        size=(target_h, target_w),
                        mode="bilinear",
                        align_corners=False,
                    ).squeeze(0)
                else:
                    density_map_i = density_map_raw

            common_output = {
                "heatmap_logits": hm_out_i,
                "hv_logits": hv_out_i,
                "attr_logits": attr_logits,
                "density_map": density_map_i,
                "pnurl_loss": pnurl_loss,
                "semantic_delta": semantic_delta[i:i + 1],
                "semantic_channel_gate": channel_gate[i:i + 1],
                "injected_delta": injected_delta[i:i + 1],
                "base_feat": image_embeddings[i:i + 1],
                "semantic_delta_norm": semantic_delta_norm,
                "base_feat_norm": base_feat_norm,
                "injected_delta_norm": injected_delta_norm,
                "injection_ratio": injection_ratio,
                "semantic_delta_reg_loss": semantic_delta_reg_loss,
                "semantic_delta_ratio": diagnostics["semantic_delta_ratio"],
                "semantic_delta_raw_norm": diagnostics["semantic_delta_raw_norm"],
                "semantic_delta_direction_norm": diagnostics["semantic_delta_direction_norm"],
                # Phase C: Attribute-Text Alignment top-level keys (for train.py/validate_one_epoch consumption)
                "attr_text_align_loss": diagnostics.get("attr_text_align_loss"),
                # PromptNu-lite v2: Residual-Coupled Semantic Alignment
                "promptnu_lite_align_loss": diagnostics.get("promptnu_lite_align_loss"),
                "s_sim": diagnostics.get("s_sim", None),
                "b_sim": diagnostics.get("b_sim", None),
                "i_sim": diagnostics.get("i_sim", None),
                "text_norm_mean": diagnostics.get("text_norm_mean", None),
                "visual_norm_mean": diagnostics.get("visual_norm_mean", None),
                "valid_instance_count": diagnostics.get("valid_instance_count", None),
                "diagnostics": diagnostics,
                "organ_cls_loss": getattr(self, "organ_cls_loss_cache", torch.tensor(0.0, device=device)),
                # Structure & Boundary Attribute Heads outputs (GT-derived)
                "structure_attr_logits": structure_attr_logits,  # [B,5,3] or None
                "boundary_attr_logits": boundary_attr_logits,    # [B,4,3] or None
                # MultiLevel Attribute Heads outputs (Phase B)
                "multilevel_attr_logits": multilevel_attr_logits,  # Dict or None
                # SGA-SB v1 CORRECTION: Spatial Structure/Boundary Guidance (train.py consumes for loss)
                "structure_logits": structure_logits[i] if structure_logits is not None else None,
                "boundary_logits": boundary_logits[i] if boundary_logits is not None else None,
                "structure_delta": structure_delta[i:i + 1] if structure_delta is not None else None,
                "boundary_delta": boundary_delta[i:i + 1] if boundary_delta is not None else None,
                "structure_guidance_map": structure_guidance_map[i:i + 1] if structure_guidance_map is not None else None,
                "boundary_guidance_map": boundary_guidance_map[i:i + 1] if boundary_guidance_map is not None else None,
                "gamma_structure": getattr(self, "gamma_structure", None),
                "gamma_boundary": getattr(self, "gamma_boundary", None),
                "spatial_structure_logit_norm": structure_logits[i].detach().float().norm() if structure_logits is not None else None,
                "spatial_boundary_logit_norm": boundary_logits[i].detach().float().norm() if boundary_logits is not None else None,
                "spatial_structure_prob_mean": structure_guidance_map[i].detach().float().mean() if structure_guidance_map is not None else None,
                "spatial_boundary_prob_mean": boundary_guidance_map[i].detach().float().mean() if boundary_guidance_map is not None else None,
                "spatial_structure_delta_norm": structure_delta[i].detach().float().norm() if structure_delta is not None else None,
                "spatial_boundary_delta_norm": boundary_delta[i].detach().float().norm() if boundary_delta is not None else None,
                # Legacy spatial_instance_attr_mode (ablation)
                "spatial_attr_logits": spatial_attr_logits,          # [B, 18, 64, 64] or None
                "spatial_guidance_map": spatial_guidance_map,        # [B, 1, 64, 64] or None
            }

            if not prompt_data["has_points"]:
                dummy = fused_image_embeddings[i].sum() * 0.0

                if density_map_i is not None:
                    common_output["density_map"] = density_map_i + dummy

                common_output.update(
                    {
                        "masks": (
                            torch.zeros((1, 1, target_h, target_w), device=device, dtype=torch.float32) - 100.0
                        ) + dummy,
                        "iou_predictions": torch.zeros((1, 1), device=device) + dummy,
                        "low_res_logits": (
                            torch.zeros((1, 1, 256, 256), device=device, dtype=torch.float32) - 100.0
                        ) + dummy,
                        "heatmap_logits": hm_out_i + dummy,
                        "hv_logits": hv_out_i + dummy if hv_out_i is not None else None,
                    }
                )
                outputs.append(common_output)
                continue

            point_coords = prompt_data["point_coords"]
            point_labels = prompt_data["point_labels"]

            point_coords = (point_coords * scale_factor) + (scale_factor * 0.5)

            if self.training:
                max_points = 512
                if point_coords.shape[0] > max_points:
                    indices = torch.randperm(point_coords.shape[0], device=device)[:max_points]
                    point_coords = point_coords[indices]
                    point_labels = point_labels[indices]

            num_cells = point_coords.shape[0]
            chunk_size = 16

            chunk_masks = []
            chunk_ious = []

            curr_low_freq_prompt = low_freq_prompt[i:i + 1] if low_freq_prompt is not None else None
            curr_high_freq_prompt = high_freq_prompt[i:i + 1] if high_freq_prompt is not None else None

            for start_idx in range(0, num_cells, chunk_size):
                end_idx = min(start_idx + chunk_size, num_cells)

                sub_coords = point_coords[start_idx:end_idx]
                sub_labels = point_labels[start_idx:end_idx]
                current_batch = sub_coords.shape[0]

                sub_img_embed = fused_image_embeddings[i].unsqueeze(0).expand(current_batch, -1, -1, -1)

                sub_cnn_s1 = (
                    feat_s1[i].unsqueeze(0).expand(current_batch, -1, -1, -1).contiguous()
                    if self.use_asr and feat_s1 is not None
                    else None
                )

                sub_cnn_s2 = (
                    feat_s2[i].unsqueeze(0).expand(current_batch, -1, -1, -1).contiguous()
                    if self.use_asr and feat_s2 is not None
                    else None
                )

                sparse, dense = self.prompt_encoder(
                    points=(sub_coords, sub_labels),
                    boxes=None,
                    masks=None,
                )

                sub_low_freq_prompt = None
                sub_high_freq_prompt = None

                if self.asr_variant == "freqpath":
                    if curr_low_freq_prompt is not None:
                        if curr_low_freq_prompt.dim() == 2:
                            sub_low_freq_prompt = curr_low_freq_prompt.expand(current_batch, -1).contiguous()
                        elif curr_low_freq_prompt.dim() == 3:
                            sub_low_freq_prompt = curr_low_freq_prompt.expand(current_batch, -1, -1).contiguous()

                    if curr_high_freq_prompt is not None:
                        if curr_high_freq_prompt.dim() == 2:
                            sub_high_freq_prompt = curr_high_freq_prompt.expand(current_batch, -1).contiguous()
                        elif curr_high_freq_prompt.dim() == 3:
                            sub_high_freq_prompt = curr_high_freq_prompt.expand(current_batch, -1, -1).contiguous()

                freqpath_ablation = os.environ.get("FREQPATH_ABLATION", "both").lower().strip()

                low_prompt_enabled = self.asr_variant == "freqpath" and freqpath_ablation in (
                "low",
                "low_only",
                "both",
                "full",
                )
                high_prompt_enabled = self.asr_variant == "freqpath" and freqpath_ablation in (
                "high",
                "high_only",
                "both",
                "full",
                )

                if self.asr_variant == "freqpath":
                    if freqpath_ablation in ("low", "low_only"):
                        # Low-frequency structure prompt only: low_freq_prompt -> attr_prompt.
                        sub_high_freq_prompt = None
                    elif freqpath_ablation in ("high", "high_only"):
                        # High-frequency morphology/boundary prompt only: high_freq_prompt -> morph_feat.
                        sub_low_freq_prompt = None
                    elif freqpath_ablation in ("none", "off"):
                        # Keep the FreqPath architecture but disable PNuRL low/high prompts.
                        sub_low_freq_prompt = None
                        sub_high_freq_prompt = None
                    elif freqpath_ablation in ("both", "full"):
                        pass
                    else:
                        raise ValueError(
                            f"Unknown FREQPATH_ABLATION={freqpath_ablation}. "
                            "Use one of: low, high, both, none."
                        )

                # Update FreqPath prompt-routing debug counters after ablation filtering.
                # low/high_input means PNuRL produced a prompt for the sample.
                # low/high_passed means the prompt survived asr_variant + FREQPATH_ABLATION
                # and was actually passed into MaskDecoder.
                freqpath_debug_chunk_count += 1
                freqpath_debug_low_input_count += int(curr_low_freq_prompt is not None)
                freqpath_debug_high_input_count += int(curr_high_freq_prompt is not None)
                freqpath_debug_low_passed_count += int(sub_low_freq_prompt is not None)
                freqpath_debug_high_passed_count += int(sub_high_freq_prompt is not None)

                if sub_low_freq_prompt is not None:
                    freqpath_debug_low_norm_sum += float(
                        sub_low_freq_prompt.detach().float().norm(dim=-1).mean().cpu()
                    )
                if sub_high_freq_prompt is not None:
                    freqpath_debug_high_norm_sum += float(
                        sub_high_freq_prompt.detach().float().norm(dim=-1).mean().cpu()
                    )

                diagnostics["freqpath_low_prompt_enabled"] = torch.tensor(
                    float(low_prompt_enabled),
                    device=device,
                )
                diagnostics["freqpath_high_prompt_enabled"] = torch.tensor(
                    float(high_prompt_enabled),
                    device=device,
                )

                # ============================================================
                # Exp5: Numeric Attribute → FreqPath route injection
                # ============================================================
                # Uses the SAME structure_attr_logits / boundary_attr_logits
                # variables as FREQPATH_ROUTE_CONFIG below. Runs per-chunk so
                # that FREQPATH_ROUTE_CONFIG and mask_decoder see the same values.

                # ── Candidate logits audit (one-time) ──
                _na_candidate_printed = getattr(self, "_freqpath_numeric_candidate_printed", False)
                _na_audit_flag = os.environ.get("FREQPATH_AUDIT_ENABLED", "0") == "1"
                if _na_audit_flag and not _na_candidate_printed:
                    _cand_info: Dict[str, Tuple[bool, Optional[tuple]]] = {}
                    for _cn in [
                        "structure_attr_logits", "boundary_attr_logits",
                        "structure_logits", "boundary_logits",
                        "sb_structure_logits", "sb_boundary_logits",
                    ]:
                        _cv = locals().get(_cn, None)
                        if isinstance(_cv, torch.Tensor):
                            _cand_info[_cn] = (True, tuple(_cv.shape))
                        else:
                            _cand_info[_cn] = (False, None)
                    print(f"\n[NUMERIC_ATTR_LOGITS_CANDIDATE_AUDIT]")
                    for _cn, (_exists, _shape) in _cand_info.items():
                        print(f"  {_cn}: exists={_exists} shape={_shape}", flush=True)
                    self._freqpath_numeric_candidate_printed = True

                # ── Use use_pnurl_config (immutable) for PNuRL gating ──
                _pnurl_enabled_config = bool(getattr(self, "use_pnurl_config", False))
                _numeric_pnurl_blocked = _pnurl_enabled_config

                # ── Safe defaults for numeric route variables ──
                # Initialized BEFORE trigger logic so that downstream audit
                # (FREQPATH_NUMERIC_ATTR_GUIDANCE_AUDIT) can safely read them
                # even when the numeric route is not triggered (e.g. Exp6 with
                # use_pnurl_config=True, CONCH + PromptNu-v3).
                _num_attr = None
                _num_morph = None

                # ── Trigger logic ──
                _numeric_guidance_reason = "disabled"
                if self.enable_numeric_attr_freqpath_guidance:
                    if _pnurl_enabled_config:
                        _numeric_guidance_reason = "use_pnurl_true"
                    elif self.enable_conch_text_encoder:
                        _numeric_guidance_reason = "conch_enabled"
                    elif self.enable_promptnu_guided_v3:
                        _numeric_guidance_reason = "v3_enabled"
                    elif self.sb_guidance_mode not in ("none",):
                        _numeric_guidance_reason = f"sb_guidance_mode_not_none:{self.sb_guidance_mode}"
                    elif self.numeric_attr_freqpath_proj is None:
                        _numeric_guidance_reason = "missing_proj"
                    elif not isinstance(structure_attr_logits, torch.Tensor):
                        _numeric_guidance_reason = "missing_structure_attr_logits"
                    elif not isinstance(boundary_attr_logits, torch.Tensor):
                        _numeric_guidance_reason = "missing_boundary_attr_logits"
                    elif structure_attr_logits.shape[-1] != 3 or structure_attr_logits.ndim < 2:
                        _numeric_guidance_reason = "shape_invalid"
                    else:
                        _numeric_guidance_reason = "ok"
                        # Per-batch-item slice: [1, 5, 3] / [1, 4, 3]
                        _n_struct = structure_attr_logits[i:i + 1].contiguous()
                        _n_bound = boundary_attr_logits[i:i + 1].contiguous()
                        _num_attr, _num_morph = self.numeric_attr_freqpath_proj(
                            _n_struct, _n_bound
                        )  # both [1, 512]
                        # Assign to ALL variables consumed by mask_decoder + FREQPATH_ROUTE_CONFIG
                        sub_low_freq_prompt = _num_attr.float()
                        sub_high_freq_prompt = _num_morph.float()
                        curr_low_freq_prompt = _num_attr.float()
                        curr_high_freq_prompt = _num_morph.float()
                        _numeric_guidance_triggered = True

                        # ── Backward chain audit: safe retain_grad on numeric route tensors ──
                        _freqpath_debug_enabled = os.environ.get("FREQPATH_AUDIT_ENABLED", "0") == "1"
                        if _freqpath_debug_enabled and self.training:
                            def _safe_retain_grad(t):
                                if isinstance(t, torch.Tensor) and t.requires_grad:
                                    t.retain_grad()
                                    return True
                                return False
                            _ns_rg = _safe_retain_grad(_n_struct)
                            _nb_rg = _safe_retain_grad(_n_bound)
                            _na_rg = _safe_retain_grad(_num_attr)
                            _nm_rg = _safe_retain_grad(_num_morph)
                            self._numeric_attr_freqpath_debug_tensors = {
                                "attr_prompt": _num_attr,
                                "morph_feat": _num_morph,
                                "structure_logits_i": _n_struct,
                                "boundary_logits_i": _n_bound,
                                "attr_prompt_requires_grad": bool(_num_attr.requires_grad),
                                "morph_feat_requires_grad": bool(_num_morph.requires_grad),
                                "structure_logits_i_requires_grad": bool(_n_struct.requires_grad),
                                "boundary_logits_i_requires_grad": bool(_n_bound.requires_grad),
                                "attr_prompt_retain_grad": _na_rg,
                                "morph_feat_retain_grad": _nm_rg,
                                "structure_logits_i_retain_grad": _ns_rg,
                                "boundary_logits_i_retain_grad": _nb_rg,
                            }

                # ── NUMERIC_ATTR_GUIDANCE_AUDIT (one-time) ──
                if _na_audit_flag:
                    _na_audit_printed = getattr(self, "_freqpath_numeric_audit_printed", False)
                    if not _na_audit_printed:
                        # Structure/boundary logits availability
                        _s_is_tensor = isinstance(structure_attr_logits, torch.Tensor)
                        _b_is_tensor = isinstance(boundary_attr_logits, torch.Tensor)
                        _s_shape = tuple(structure_attr_logits.shape) if _s_is_tensor else None
                        _b_shape = tuple(boundary_attr_logits.shape) if _b_is_tensor else None
                        _s_src = "structure_attr_logits (forward local)" if _s_is_tensor else "not_found"
                        _b_src = "boundary_attr_logits (forward local)" if _b_is_tensor else "not_found"
                        # Projection outputs (triggered branch only)
                        _na_v = _num_attr if _numeric_guidance_triggered else None
                        _nm_v = _num_morph if _numeric_guidance_triggered else None
                        _na_shape = tuple(_na_v.shape) if _na_v is not None else None
                        _nm_shape = tuple(_nm_v.shape) if _nm_v is not None else None
                        _na_norm = float(_na_v.detach().float().norm(dim=-1).mean().cpu()) if _na_v is not None else 0.0
                        _nm_norm = float(_nm_v.detach().float().norm(dim=-1).mean().cpu()) if _nm_v is not None else 0.0
                        # legacy local use_pnurl — check if any local variable shadows
                        _legacy_local_use_pnurl = locals().get("use_pnurl", "NOT_IN_SCOPE")
                        # mutation audit: runtime vs config
                        _pnurl_runtime = bool(getattr(self, "use_pnurl", False))
                        _pnurl_config = bool(getattr(self, "use_pnurl_config", False))
                        _pnurl_mutated = (_pnurl_runtime != _pnurl_config)
                        # ── FreqPath numeric proj requires_grad stats ──
                        _np_proj = getattr(self, "numeric_attr_freqpath_proj", None)
                        if _np_proj is not None:
                            _np_all = list(_np_proj.parameters())
                            _np_total = len(_np_all)
                            _np_req = sum(1 for p in _np_all if p.requires_grad)
                        else:
                            _np_total = 0
                            _np_req = 0
                        # ── Forward output tensor requires_grad + grad_fn ──
                        _ap_req = bool(_num_attr.requires_grad) if isinstance(_num_attr, torch.Tensor) else None
                        _mf_req = bool(_num_morph.requires_grad) if isinstance(_num_morph, torch.Tensor) else None
                        _ap_grad_fn = str(type(_num_attr.grad_fn)) if isinstance(_num_attr, torch.Tensor) and _num_attr.grad_fn is not None else None
                        _mf_grad_fn = str(type(_num_morph.grad_fn)) if isinstance(_num_morph, torch.Tensor) and _num_morph.grad_fn is not None else None
                        print(
                            f"\n[FREQPATH_NUMERIC_ATTR_GUIDANCE_AUDIT]\n"
                            f"  self_use_pnurl_config={_pnurl_config}\n"
                            f"  self_use_pnurl_runtime={_pnurl_runtime}\n"
                            f"  use_pnurl_mutated={_pnurl_mutated}\n"
                            f"  legacy_local_use_pnurl={_legacy_local_use_pnurl}\n"
                            f"  enable_numeric_attr_freqpath_guidance={self.enable_numeric_attr_freqpath_guidance}\n"
                            f"  triggered={_numeric_guidance_triggered}\n"
                            f"  reason={_numeric_guidance_reason}\n"
                            f"  enable_conch_text_encoder={self.enable_conch_text_encoder}\n"
                            f"  enable_promptnu_guided_v3={getattr(self, 'enable_promptnu_guided_v3', False)}\n"
                            f"  sb_guidance_mode={self.sb_guidance_mode}\n"
                            f"  structure_attr_logits_available={_s_is_tensor}\n"
                            f"  boundary_attr_logits_available={_b_is_tensor}\n"
                            f"  structure_attr_logits_shape={_s_shape}\n"
                            f"  boundary_attr_logits_shape={_b_shape}\n"
                            f"  structure_attr_logits_source={_s_src}\n"
                            f"  boundary_attr_logits_source={_b_src}\n"
                            f"  attr_prompt_from_numeric_shape={_na_shape}\n"
                            f"  morph_feat_from_numeric_shape={_nm_shape}\n"
                            f"  attr_prompt_norm={_na_norm:.6f}\n"
                            f"  morph_feat_norm={_nm_norm:.6f}\n"
                            f"  numeric_proj_requires_grad_param_count={_np_req}\n"
                            f"  numeric_proj_total_param_count={_np_total}\n"
                            f"  attr_prompt_requires_grad={_ap_req}\n"
                            f"  morph_feat_requires_grad={_mf_req}\n"
                            f"  attr_prompt_grad_fn={_ap_grad_fn}\n"
                            f"  morph_feat_grad_fn={_mf_grad_fn}\n",
                            flush=True,
                        )
                        self._freqpath_numeric_audit_printed = True

                # ── FREQPATH_ROUTE_CONFIG audit (one-time) ──
                global _FREQPATH_ROUTE_COUNTER
                _freqpath_audit_enabled = os.environ.get("FREQPATH_AUDIT_ENABLED", "0") == "1"
                if _freqpath_audit_enabled and _FREQPATH_ROUTE_COUNTER == 0:
                    _phase_str = "train" if self.training else "eval"
                    _low_route = sub_low_freq_prompt is not None
                    _high_route = sub_high_freq_prompt is not None
                    # Determine attr_prompt_source
                    if curr_low_freq_prompt is not None:
                        if _pnurl_enabled:
                            _attr_source = "pnurl"
                        elif _numeric_guidance_triggered:
                            _attr_source = "numeric_structure_attr_logits"
                        elif self.sb_guidance_mode in ("gt_direct", "pred_direct") and structure_attr_logits is not None:
                            _attr_source = f"sb_guidance_{self.sb_guidance_mode}"
                        else:
                            _attr_source = "unknown_non_none"
                    else:
                        _attr_source = "none"
                    # Determine morph_feat_source
                    if curr_high_freq_prompt is not None:
                        if _pnurl_enabled:
                            _morph_source = "pnurl"
                        elif _numeric_guidance_triggered:
                            _morph_source = "numeric_boundary_attr_logits"
                        elif self.sb_guidance_mode in ("gt_direct", "pred_direct") and boundary_attr_logits is not None:
                            _morph_source = f"sb_guidance_{self.sb_guidance_mode}"
                        else:
                            _morph_source = "unknown_non_none"
                    else:
                        _morph_source = "none"
                    # GT labels may not be defined if enable_attr_text_alignment=False
                    _s_labels_local = locals().get("_s_labels", None)
                    _b_labels_local = locals().get("_b_labels", None)
                    _struct_labels_avail = _s_labels_local is not None
                    _bound_labels_avail = _b_labels_local is not None
                    _struct_logits_avail = structure_attr_logits is not None
                    _bound_logits_avail = boundary_attr_logits is not None
                    print(
                        f"\n[FREQPATH_ROUTE_CONFIG]\n"
                        f"  phase={_phase_str}\n"
                        f"  FREQPATH_ABLATION={freqpath_ablation}\n"
                        f"  use_asr={self.use_asr}\n"
                        f"  asr_variant={self.asr_variant}\n"
                        f"  use_pnurl_config={_pnurl_config}\n"
                        f"  use_pnurl_runtime={_pnurl_runtime}\n"
                        f"  use_pnurl_mutated={_pnurl_mutated}\n"
                        f"  enable_numeric_attr_freqpath_guidance={self.enable_numeric_attr_freqpath_guidance}\n"
                        f"  numeric_guidance_triggered={_numeric_guidance_triggered}\n"
                        f"  enable_conch_text_encoder={self.enable_conch_text_encoder}\n"
                        f"  enable_attr_text_alignment={self.enable_attr_text_alignment}\n"
                        f"  enable_promptnu_guided_v3={getattr(self, 'enable_promptnu_guided_v3', False)}\n"
                        f"  low_route_enabled={_low_route}\n"
                        f"  high_route_enabled={_high_route}\n"
                        f"  attr_prompt_is_none={not _low_route}\n"
                        f"  morph_feat_is_none={not _high_route}\n"
                        f"  attr_prompt_source={_attr_source}\n"
                        f"  morph_feat_source={_morph_source}\n"
                        f"  structure_attr_labels_available={_struct_labels_avail}\n"
                        f"  boundary_attr_labels_available={_bound_labels_avail}\n"
                        f"  structure_attr_logits_available={_struct_logits_avail}\n"
                        f"  boundary_attr_logits_available={_bound_logits_avail}\n",
                        flush=True,
                    )
                    _FREQPATH_ROUTE_COUNTER += 1

                # ── [NUMERIC_ATTR_ROUTE_FORWARD_AUDIT] one-shot per forward (eval) ──
                _numeric_fwd_audit_printed = getattr(self, "_numeric_route_fwd_audit_printed", False)
                if not _numeric_fwd_audit_printed and not self.training:
                    _s_is_t = isinstance(structure_attr_logits, torch.Tensor)
                    _b_is_t = isinstance(boundary_attr_logits, torch.Tensor)
                    _sb_delta_norm = 0.0
                    if self.sb_guidance_mode in ("gt_direct", "pred_direct") and self.sb_direct_adapter is not None:
                        _sb_delta_norm = (
                            self.sb_direct_adapter.structure_out.weight.detach().float().norm().item()
                            + self.sb_direct_adapter.boundary_out.weight.detach().float().norm().item()
                        )
                    _freqpath_abl = os.environ.get("FREQPATH_ABLATION", "both")
                    print(
                        f"\n[NUMERIC_ATTR_ROUTE_FORWARD_AUDIT]\n"
                        f"  numeric_attr_route_active={_numeric_guidance_triggered}\n"
                        f"  structure_attrs_available={_s_is_t}\n"
                        f"  boundary_attrs_available={_b_is_t}\n"
                        f"  sb_guidance_delta_norm={_sb_delta_norm:.8f}\n"
                        f"  sb_guidance_weight={self.sb_guidance_weight:.4f}\n"
                        f"  FREQPATH_ABLATION={_freqpath_abl}",
                        flush=True,
                    )
                    self._numeric_route_fwd_audit_printed = True

                # ── SGA-SB v1 CORRECTION: Pass gamma-scaled spatial deltas ──
                # Deltas retain their branch-specific channels.  Match the
                # existing per-prompt batch expansion used by sub_img_embed
                # and sub_cnn_s1/s2; no channel is repeated or sliced.
                _sd_i = (
                    structure_delta[i].unsqueeze(0)
                    .expand(current_batch, -1, -1, -1)
                    .contiguous()
                    if structure_delta is not None
                    else None
                )
                _bd_i = (
                    boundary_delta[i].unsqueeze(0)
                    .expand(current_batch, -1, -1, -1)
                    .contiguous()
                    if boundary_delta is not None
                    else None
                )

                sub_mask, sub_iou = self.mask_decoder(
                    image_embeddings=sub_img_embed,
                    image_pe=self.prompt_encoder.get_dense_pe(),
                    sparse_prompt_embeddings=sparse,
                    dense_prompt_embeddings=dense,
                    multimask_output=multimask_output,
                    cnn_feat_s1=sub_cnn_s1,
                    cnn_feat_s2=sub_cnn_s2,
                    attr_prompt=sub_low_freq_prompt,
                    morph_feat=sub_high_freq_prompt,
                    structure_delta=_sd_i,
                    boundary_delta=_bd_i,
                )

                # Collect internal diagnostics from MaskDecoder/FreqPathASRBlock.
                md_debug = getattr(self.mask_decoder, "last_freqpath_debug", None)
                if isinstance(md_debug, dict) and len(md_debug) > 0:
                    freqpath_internal_debug_count += 1
                    for debug_key, debug_value in md_debug.items():
                        if debug_value is None:
                            continue
                        try:
                            if torch.is_tensor(debug_value):
                                value = float(debug_value.detach().float().mean().cpu())
                            else:
                                value = float(debug_value)
                        except Exception:
                            continue
                        freqpath_internal_debug_sums[debug_key] = (
                            freqpath_internal_debug_sums.get(debug_key, 0.0) + value
                        )

                chunk_masks.append(sub_mask)
                chunk_ious.append(sub_iou)

            low_res_masks = torch.cat(chunk_masks, dim=0)
            iou_predictions = torch.cat(chunk_ious, dim=0)

            merged_logits, _ = torch.max(low_res_masks, dim=0, keepdim=True)
            merged_iou = torch.mean(iou_predictions, dim=0, keepdim=True)

            # ── PNuDP Dense Training (Stage D): fuse pnudp_bias into low_res_logits ──
            _pnudp_dense_debug: Dict[str, Any] = {}
            _base_low_res_logits = merged_logits  # store before fusion for audit
            if (self.training or getattr(self, "pnudp_dense_apply_in_eval", False)) and getattr(self, "enable_pnudp_dense_train", False):
                _pnudp_mod = getattr(self, "pnudp_dense_train", None)
                if _pnudp_mod is not None:
                    with torch.no_grad():
                        # Build text bank from cached CONCH embeddings
                        _s_bank = self._get_sb_text_bank("structure", device)   # [5, 3, D]
                        _b_bank = self._get_sb_text_bank("boundary", device)     # [4, 3, D]
                        _s_bank_flat = _s_bank.reshape(-1, _s_bank.shape[-1])    # [15, D]
                        _b_bank_flat = _b_bank.reshape(-1, _b_bank.shape[-1])    # [12, D]
                        _text_bank = torch.cat([_s_bank_flat, _b_bank_flat], dim=0)  # [27, D]

                    # Compute dense text logits and bias (trainable)
                    _dense_text_logits, _pnudp_bias = _pnudp_mod(
                        spatial_feat=image_embeddings[i:i + 1],
                        text_bank=_text_bank,
                    )

                    # ── Dynamic bias resize: align pnudp_bias spatial size to merged_logits ──
                    _target_hw = merged_logits.shape[-2:]  # [H, W]
                    _bias = _pnudp_bias
                    _bias_shape_before_resize = tuple(_bias.shape)

                    if _bias.shape[-2:] != _target_hw:
                        _bias = F.interpolate(
                            _bias,
                            size=_target_hw,
                            mode="bilinear",
                            align_corners=False,
                        )

                    # Device/dtype alignment
                    _bias = _bias.to(device=merged_logits.device, dtype=merged_logits.dtype)

                    # Channel broadcast check:
                    #   broadcast_bias=True  → bias has 1 channel, broadcast to all logits channels
                    #   channel_specific=True → bias has same channels as logits (C>1), per-channel
                    _bias_ch = _bias.shape[1]
                    _logits_ch = merged_logits.shape[1]
                    _broadcast_bias = (_bias_ch == 1)
                    _channel_specific = (_bias_ch == _logits_ch and _logits_ch > 1)
                    if _bias_ch not in (1, _logits_ch):
                        _err_msg = (
                            f"[PNUDP_DENSE_SHAPE_ERROR] Channel mismatch: "
                            f"bias channels={_bias_ch}, logits channels={_logits_ch}. "
                            f"Expected bias channels=1 or bias channels==logits channels."
                        )
                        print(_err_msg, flush=True)
                        raise RuntimeError(_err_msg)

                    # Fusion formula: fused = base + effective_alpha * bias
                    # where effective_alpha = alpha * pnudp_dense_eval_scale (if set)
                    # CRITICAL: Force FP32 arithmetic to prevent alpha*bias being swallowed
                    # by low-precision (bfloat16/float16) logits under AMP.
                    _alpha_raw = _pnudp_mod.dense_alpha
                    # ── Eval scale: amplify alpha for test-time scale sweep ──
                    _pnudp_dense_eval_scale = getattr(self, "pnudp_dense_eval_scale", None)
                    # ── Convert to FP32 for arithmetic; compute effective alpha ──
                    _merged_fp32 = merged_logits.float()
                    _bias_fp32 = _bias.float()
                    _alpha_raw_fp32 = _alpha_raw.float()
                    if _pnudp_dense_eval_scale is not None:
                        _eval_scale_fp32 = torch.tensor(float(_pnudp_dense_eval_scale), device=merged_logits.device, dtype=torch.float32)
                    else:
                        # Training mode: no eval scale → eval_scale=1.0, alpha_effective=alpha_raw
                        _eval_scale_fp32 = torch.tensor(1.0, device=merged_logits.device, dtype=torch.float32)
                    _alpha_eff_fp32 = _alpha_raw_fp32 * _eval_scale_fp32
                    _fused_logits_fp32 = _merged_fp32 + _alpha_eff_fp32 * _bias_fp32
                    _fused_logits = _fused_logits_fp32

                    # ── PNuDP Fusion Consistency Diagnostics ──
                    # WARNING: _pnudp_bias is the ORIGINAL (pre-resize) bias from the module;
                    #          _bias is the resized version actually used in fusion.
                    #          If these differ, the expected diff must use _bias (resized).
                    with torch.no_grad():
                        _alpha_val = float(_alpha_raw.detach().item())
                        _eval_scale_val = float(_pnudp_dense_eval_scale) if _pnudp_dense_eval_scale is not None else 1.0
                        _alpha_effective_val = _alpha_val * _eval_scale_val
                        _bias_abs_mean_resized = float(_bias.detach().float().abs().mean().item())
                        _bias_abs_max_resized = float(_bias.detach().float().abs().max().item())
                        _alpha_x_bias_abs_mean = _alpha_val * _bias_abs_mean_resized
                        _effective_alpha_x_bias_abs_mean = _alpha_effective_val * _bias_abs_mean_resized

                        # direct diff on fused vs base logits (the actual arithmetic)
                        _direct_fused_minus_base_l1 = float(
                            (_fused_logits.detach() - _base_low_res_logits.detach()).abs().mean().item()
                        )
                        _direct_fused_minus_base_max = float(
                            (_fused_logits.detach() - _base_low_res_logits.detach()).abs().max().item()
                        )
                        _ratio_direct_to_expected = _direct_fused_minus_base_l1 / (_alpha_x_bias_abs_mean + 1e-12)

                        audit_print(
                            "PNUDP_DENSE_FUSION_CONSISTENCY",
                            f"\n[PNUDP_DENSE_FUSION_CONSISTENCY] "
                            f"merged_logits_shape={tuple(merged_logits.shape)} | "
                            f"bias_shape_resized={tuple(_bias.shape)} | "
                            f"fused_logits_shape={tuple(_fused_logits.shape)} | "
                            f"alpha={_alpha_val:.12e} | "
                            f"bias_abs_mean_resized={_bias_abs_mean_resized:.12e} | "
                            f"bias_abs_max_resized={_bias_abs_max_resized:.12e} | "
                            f"alpha_x_bias_abs_mean={_alpha_x_bias_abs_mean:.12e} | "
                            f"direct_fused_minus_base_l1={_direct_fused_minus_base_l1:.12e} | "
                            f"direct_fused_minus_base_max={_direct_fused_minus_base_max:.12e} | "
                            f"expected_minus_l1={_alpha_x_bias_abs_mean:.12e} | "
                            f"ratio_direct_to_expected={_ratio_direct_to_expected:.6e}",
                            flush=True,
                        )
                        # ── Dtype audit for fusion precision debugging ──
                        _dtype_audit_amp = torch.is_autocast_enabled("cuda")
                        _dtype_audit_merged_before = str(merged_logits.dtype)
                        _dtype_audit_bias_after_cast = str(_bias.dtype)
                        _dtype_audit_alpha_src = str(_alpha_raw.dtype) if torch.is_tensor(_alpha_raw) else str(type(_alpha_raw))
                        _dtype_audit_merged_fp32 = str(_merged_fp32.dtype)
                        _dtype_audit_bias_fp32 = str(_bias_fp32.dtype)
                        _dtype_audit_alpha_raw_fp32 = str(_alpha_raw_fp32.dtype)
                        _dtype_audit_eval_scale_fp32 = str(_eval_scale_fp32.dtype)
                        _dtype_audit_alpha_eff_fp32 = str(_alpha_eff_fp32.dtype)
                        _dtype_audit_fused_fp32 = str(_fused_logits_fp32.dtype)
                        # FP32 audit: recompute fused_minus_base using FP32 base for verification
                        _base_low_res_logits_fp32 = _base_low_res_logits.detach().float()
                        _direct_fused_minus_base_l1_fp32 = float(
                            (_fused_logits_fp32.detach() - _base_low_res_logits_fp32).abs().mean().item()
                        )
                        _ratio_fp32_to_expected = _direct_fused_minus_base_l1_fp32 / (_alpha_x_bias_abs_mean + 1e-12)
                        audit_print(
                            "PNUDP_DENSE_FUSION_DTYPE_AUDIT",
                            f"[PNUDP_DENSE_FUSION_DTYPE_AUDIT] "
                            f"amp_autocast_enabled={_dtype_audit_amp} | "
                            f"merged_logits_dtype_before={_dtype_audit_merged_before} | "
                            f"bias_dtype_after_cast={_dtype_audit_bias_after_cast} | "
                            f"alpha_src_dtype={_dtype_audit_alpha_src} | "
                            f"merged_fp32_dtype={_dtype_audit_merged_fp32} | "
                            f"bias_fp32_dtype={_dtype_audit_bias_fp32} | "
                            f"alpha_raw_dtype={_dtype_audit_alpha_raw_fp32} | "
                            f"eval_scale_dtype={_dtype_audit_eval_scale_fp32} | "
                            f"alpha_effective_dtype={_dtype_audit_alpha_eff_fp32} | "
                            f"fused_fp32_dtype={_dtype_audit_fused_fp32} | "
                            f"direct_fused_minus_base_l1_fp32={_direct_fused_minus_base_l1_fp32:.12e} | "
                            f"ratio_fp32_to_expected={_ratio_fp32_to_expected:.6e}",
                            flush=True,
                        )
                        # ── PNuDP Dense Eval Scale Audit ──
                        audit_print(
                            "PNUDP_DENSE_EVAL_SCALE_AUDIT",
                            f"[PNUDP_DENSE_EVAL_SCALE_AUDIT] "
                            f"alpha_raw={_alpha_val:.12e} | "
                            f"eval_scale={_eval_scale_val} | "
                            f"alpha_effective={_alpha_effective_val:.12e} | "
                            f"bias_abs_mean={_bias_abs_mean_resized:.12e} | "
                            f"effective_alpha_x_bias_abs_mean={_effective_alpha_x_bias_abs_mean:.12e} | "
                            f"fused_minus_base_l1={_direct_fused_minus_base_l1:.12e}",
                            flush=True,
                        )
                        if _ratio_direct_to_expected < 0.1 or _ratio_direct_to_expected > 10.0:
                            audit_print(
                                "PNUDP_FUSION_INCONSISTENT",
                                f"[PNUDP_FUSION_INCONSISTENT] "
                                f"ratio={_ratio_direct_to_expected:.6e} << 0.1 or >> 10. "
                                f"fused_logits may not reflect alpha*bias correctly.",
                                flush=True,
                            )

                    # Debug stats (detached for audit)
                    with torch.no_grad():
                        _pnudp_dense_debug["pnudp_bias_norm"] = (
                            _pnudp_bias.detach().float().norm().item() / max(_pnudp_bias.numel(), 1)
                        )
                        _pnudp_dense_debug["pnudp_bias_std"] = float(_pnudp_bias.detach().float().std().item())
                        _pnudp_dense_debug["pnudp_bias_abs_mean"] = float(_pnudp_bias.detach().float().abs().mean().item())
                        _pnudp_dense_debug["pnudp_bias_abs_max"] = float(_pnudp_bias.detach().float().abs().max().item())
                        # Also store resized-bias stats for cross-check
                        _pnudp_dense_debug["pnudp_bias_abs_mean_resized"] = _bias_abs_mean_resized
                        _pnudp_dense_debug["pnudp_bias_abs_max_resized"] = _bias_abs_max_resized
                        _pnudp_dense_debug["dense_alpha_value"] = _alpha_val
                        _pnudp_dense_debug["alpha_effective"] = _alpha_effective_val
                        _pnudp_dense_debug["effective_alpha_x_bias_abs_mean"] = _effective_alpha_x_bias_abs_mean
                        _pnudp_dense_debug["pnudp_dense_eval_scale"] = _eval_scale_val
                        # fused_minus_base_l1: logits-level diff = mean(abs(fused - base))
                        # This MUST be on raw logits, NOT sigmoid probabilities.
                        _pnudp_dense_debug["fused_minus_base_l1"] = _direct_fused_minus_base_l1
                        _pnudp_dense_debug["fused_minus_base_l1_max"] = _direct_fused_minus_base_max
                        # Expected value: alpha * mean(abs(bias_resized))
                        _pnudp_dense_debug["alpha_x_bias_abs_mean"] = _alpha_x_bias_abs_mean
                        _pnudp_dense_debug["fused_minus_base_ratio"] = _ratio_direct_to_expected
                        # Shape audit fields
                        _pnudp_dense_debug["merged_logits_shape"] = tuple(merged_logits.shape)
                        _pnudp_dense_debug["pnudp_bias_shape_before_resize"] = _bias_shape_before_resize
                        _pnudp_dense_debug["pnudp_bias_shape_after_resize"] = tuple(_bias.shape)
                        _pnudp_dense_debug["target_hw"] = tuple(_target_hw)
                        _pnudp_dense_debug["bias_channel"] = _bias_ch
                        _pnudp_dense_debug["logits_channel"] = _logits_ch
                        _pnudp_dense_debug["broadcast_bias"] = _broadcast_bias
                        _pnudp_dense_debug["channel_specific"] = _channel_specific

                        # Print shape audit
                        audit_print(
                            "PNUDP_DENSE_TRAIN_SHAPE_AUDIT",
                            f"\n[PNUDP_DENSE_TRAIN_SHAPE_AUDIT] "
                            f"merged_logits_shape={tuple(merged_logits.shape)} | "
                            f"pnudp_bias_shape_before_resize={_bias_shape_before_resize} | "
                            f"pnudp_bias_shape_after_resize={tuple(_bias.shape)} | "
                            f"alpha={_alpha_val:.6f} | "
                            f"target_hw={tuple(_target_hw)} | "
                            f"bias_channel={_bias_ch} | "
                            f"logits_channel={_logits_ch} | "
                            f"broadcast_bias={_broadcast_bias} | "
                            f"channel_specific={_channel_specific}",
                            flush=True,
                        )

                    # Replace merged_logits with fused version
                    merged_logits = _fused_logits

                    # ── PNuDP Dense Per-Channel Audit ──
                    with torch.no_grad():
                        _num_audit_ch = _fused_logits.shape[1]
                        _per_ch_str_parts = []
                        for _c in range(_num_audit_ch):
                            if _broadcast_bias:
                                _bias_ch_slice = _bias[:, 0:1]  # same bias broadcast to all channels
                            else:
                                _bias_ch_slice = _bias[:, _c:_c + 1] if _bias.shape[1] > 1 else _bias[:, 0:1]
                            _bias_ch_abs_mean = float(_bias_ch_slice.detach().float().abs().mean().item())
                            _bias_ch_abs_max = float(_bias_ch_slice.detach().float().abs().max().item())
                            _ch_fused = _fused_logits[:, _c:_c + 1]
                            _ch_base = _base_low_res_logits[:, _c:_c + 1]
                            _ch_fmb_l1 = float((_ch_fused.detach() - _ch_base.detach()).abs().mean().item())
                            _ch_fmb_max = float((_ch_fused.detach() - _ch_base.detach()).abs().max().item())
                            _per_ch_str_parts.append(
                                f"ch{_c}:bias_abs_m={_bias_ch_abs_mean:.6e}"
                                f"|ch_abs_max={_bias_ch_abs_max:.6e}"
                                f"|fmb_l1={_ch_fmb_l1:.6e}"
                                f"|fmb_max={_ch_fmb_max:.6e}"
                            )
                        _per_ch_str = " | ".join(_per_ch_str_parts)
                        audit_print(
                            "PNUDP_DENSE_PER_CHANNEL_AUDIT",
                            f"[PNUDP_DENSE_PER_CHANNEL_AUDIT] "
                            f"num_channels={_num_audit_ch} | "
                            f"broadcast_bias={_broadcast_bias} | "
                            f"channel_specific={_channel_specific} | "
                            f"{_per_ch_str}",
                            flush=True,
                        )

            # Store PNuDP dense debug in common_output for train.py audit
            if _pnudp_dense_debug:
                common_output["pnudp_dense_debug"] = _pnudp_dense_debug
                # Also store the unfused low_res_logits for seg_loss_base computation
                # Store as FP32 to ensure loss computation has full precision
                common_output["low_res_logits_base"] = _base_low_res_logits.detach().float()

            mask_post = self.postprocess_masks(
                merged_logits,
                input_size=batched_input[i]["image"].shape[-2:],
                original_size=batched_input[i]["original_size"],
            )

            common_output.update(
                {
                    "masks": mask_post,
                    "iou_predictions": merged_iou,
                    "low_res_logits": merged_logits,
                }
            )

            # ── PNuDP Dense Output Key Audit ──
            if (self.training or getattr(self, "pnudp_dense_apply_in_eval", False)) and getattr(self, "enable_pnudp_dense_train", False) and _pnudp_dense_debug:
                with torch.no_grad():
                    _lr_base = common_output.get("low_res_logits_base")
                    _lr_fused = common_output.get("low_res_logits")
                    if _lr_base is not None and _lr_fused is not None:
                        _lr_base_dtype = str(_lr_base.dtype)
                        _lr_fused_dtype = str(_lr_fused.dtype)
                        _base_vs_fused_l1 = float((_lr_fused.detach() - _lr_base.detach()).abs().mean().item())
                        _output_uses_fused = (_lr_fused is merged_logits)  # True if merged_logits replaced
                        audit_print(
                            "PNUDP_DENSE_OUTPUT_KEY_AUDIT",
                            f"[PNUDP_DENSE_OUTPUT_KEY_AUDIT] "
                            f"low_res_logits_base_shape={tuple(_lr_base.shape)} | "
                            f"low_res_logits_shape={tuple(_lr_fused.shape)} | "
                            f"low_res_logits_base_dtype={_lr_base_dtype} | "
                            f"low_res_logits_dtype={_lr_fused_dtype} | "
                            f"low_res_logits_vs_base_l1={_base_vs_fused_l1:.12e} | "
                            f"output_uses_fused_logits={_output_uses_fused}",
                            flush=True,
                        )

            outputs.append(common_output)

        # Finalize FreqPath prompt-routing diagnostics. These fields are meant to be
        # consumed by train.py/test.py logs:
        #   true low-only  freqpath run -> LowInput≈1, LowPass≈1, HighPass≈0, LowNorm≈1
        #   true high-only freqpath run -> HighInput≈1, HighPass≈1, LowPass≈0, HighNorm≈1
        #   legacy run                 -> Input may be 1, Pass must be 0
        if freqpath_debug_chunk_count > 0:
            denom = float(max(1, freqpath_debug_chunk_count))
            low_norm_denom = float(max(1, freqpath_debug_low_passed_count))
            high_norm_denom = float(max(1, freqpath_debug_high_passed_count))

            diagnostics["freqpath_debug_chunk_count"] = torch.tensor(
                float(freqpath_debug_chunk_count), device=device
            )
            diagnostics["freqpath_low_prompt_input_rate"] = torch.tensor(
                float(freqpath_debug_low_input_count) / denom, device=device
            )
            diagnostics["freqpath_high_prompt_input_rate"] = torch.tensor(
                float(freqpath_debug_high_input_count) / denom, device=device
            )
            diagnostics["freqpath_low_prompt_passed_rate"] = torch.tensor(
                float(freqpath_debug_low_passed_count) / denom, device=device
            )
            diagnostics["freqpath_high_prompt_passed_rate"] = torch.tensor(
                float(freqpath_debug_high_passed_count) / denom, device=device
            )
            diagnostics["freqpath_low_prompt_passed_norm"] = torch.tensor(
                float(freqpath_debug_low_norm_sum) / low_norm_denom
                if freqpath_debug_low_passed_count > 0 else 0.0,
                device=device,
            )
            diagnostics["freqpath_high_prompt_passed_norm"] = torch.tensor(
                float(freqpath_debug_high_norm_sum) / high_norm_denom
                if freqpath_debug_high_passed_count > 0 else 0.0,
                device=device,
            )
        else:
            diagnostics["freqpath_debug_chunk_count"] = torch.tensor(0.0, device=device)
            diagnostics["freqpath_low_prompt_input_rate"] = torch.tensor(0.0, device=device)
            diagnostics["freqpath_high_prompt_input_rate"] = torch.tensor(0.0, device=device)
            diagnostics["freqpath_low_prompt_passed_rate"] = torch.tensor(0.0, device=device)
            diagnostics["freqpath_high_prompt_passed_rate"] = torch.tensor(0.0, device=device)
            diagnostics["freqpath_low_prompt_passed_norm"] = torch.tensor(0.0, device=device)
            diagnostics["freqpath_high_prompt_passed_norm"] = torch.tensor(0.0, device=device)

        # Attach averaged internal FreqPathASRBlock diagnostics.
        # Keys look like:
        #   freqpath_b1_low_gamma_abs_mean
        #   freqpath_b1_low_delta_norm
        #   freqpath_b2_scaled_detail_norm
        # These diagnose whether prompt routing actually changes decoder features.
        if freqpath_internal_debug_count > 0:
            denom_internal = float(max(1, freqpath_internal_debug_count))
            for debug_key, debug_sum in freqpath_internal_debug_sums.items():
                diagnostics[debug_key] = torch.tensor(
                    float(debug_sum) / denom_internal,
                    device=device,
                )

        if self.training and len(outputs) > 0:
            dummy = torch.tensor(0.0, device=device)

            for p in self.parameters():
                if p.requires_grad:
                    dummy = dummy + p.sum() * 0.0

            outputs[0]["heatmap_logits"] = outputs[0]["heatmap_logits"] + dummy

        # Attach diagnostics to every output item so train.py/test.py can collect them.
        # Without this, train.py will report FreqPath diagnostics as nan even when
        # prompts are correctly routed inside TextSam.forward.
        if isinstance(outputs, list) and len(outputs) > 0:
            for out in outputs:
                if isinstance(out, dict):
                    for k, v in diagnostics.items():
                        out[k] = v

        return outputs
