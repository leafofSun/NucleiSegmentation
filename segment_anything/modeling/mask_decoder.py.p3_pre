from typing import Dict, List, Tuple, Type, Optional

import torch
from torch import nn
from torch.nn import functional as F
import os
from .common import LayerNorm2d

# FREQPATH_BLOCK_AUDIT: debug print gating (enabled via FREQPATH_AUDIT_ENABLED=1 env var)
_FREQPATH_BLOCK_COUNTER = 0
# FREQPATH_MODULATOR_PARAM_AUDIT + FREQPATH_INTERNAL_CHAIN_AUDIT: one-shot counters
_FREQPATH_MODULATOR_COUNTER = 0
_FREQPATH_INTERNAL_COUNTER = 0


class MorphologyEncoder(nn.Module):
    """
    形态学提示编码器。

    仅用于 freqpath ASR。
    legacy ASR 不使用该模块，避免语义/形态提示干扰纯视觉回归实验。
    """

    def __init__(self, text_dim: int = 512, cnn_dims: List[int] = [512, 256]):
        super().__init__()
        self.text_dim = text_dim
        self.cnn_dims = cnn_dims

        self.joint_fusion = nn.Sequential(
            nn.Linear(text_dim, text_dim),
            nn.LayerNorm(text_dim),
            nn.GELU(),
            nn.Linear(text_dim, text_dim),
        )

        self.scale_projections = nn.ModuleList(
            [nn.Linear(text_dim, dim) for dim in cnn_dims]
        )

    def forward(self, morph_feat: torch.Tensor) -> List[torch.Tensor]:
        if morph_feat.dim() == 3:
            morph_feat = morph_feat.mean(dim=1)

        if morph_feat.dim() != 2:
            raise ValueError(
                f"morph_feat must be [B, C] or [B, N, C], got {morph_feat.shape}"
            )

        dtype = self.joint_fusion[0].weight.dtype
        device = self.joint_fusion[0].weight.device
        morph_feat = morph_feat.to(device=device, dtype=dtype)

        joint_morph = self.joint_fusion(morph_feat)
        layer_prompts = [proj(joint_morph) for proj in self.scale_projections]
        return layer_prompts


class LegacyASRBlock(nn.Module):
    """
    旧版纯视觉 ASR。

    目标：
    1. 只验证 ResNet 高频细节分支 + SAM 上采样是否能复现旧结果。
    2. 不接收 attr_prompt。
    3. 不接收 morph_feat。
    4. 不做语义高频/低频调制。
    5. residual_scale 初始化为 0.1，降低 CNN 高频分支破坏 SAM 表征的风险。

    论文主线中的低频/高频语义约束不在这里做；
    这里是 baseline recovery / regression check。
    """

    def __init__(
        self,
        in_dim: int,
        out_dim: int,
        cnn_dim: Optional[int] = None,
        text_dim: int = 512,  # 保留参数，只为和 FreqPathASRBlock 构造接口兼容
        activation: Type[nn.Module] = nn.GELU,
    ):
        super().__init__()

        self.in_dim = in_dim
        self.out_dim = out_dim
        self.cnn_dim = cnn_dim
        self.has_cnn = cnn_dim is not None

        self.structure_upsample = nn.Sequential(
            nn.ConvTranspose2d(in_dim, out_dim, kernel_size=2, stride=2),
            LayerNorm2d(out_dim),
            activation(),
        )

        if self.has_cnn:
            self.cnn_proj = nn.Sequential(
                nn.Conv2d(cnn_dim, out_dim, kernel_size=1, bias=False),
                LayerNorm2d(out_dim),
                activation(),
            )

            self.cnn_fusion = nn.Sequential(
                nn.Conv2d(out_dim * 2, out_dim, kernel_size=3, padding=1, bias=False),
                LayerNorm2d(out_dim),
                activation(),
                nn.Conv2d(out_dim, out_dim, kernel_size=1, bias=False),
            )

            # 初始 detail = 0，保证刚接入 CNN 分支时不破坏原始 SAM 上采样。
            nn.init.zeros_(self.cnn_fusion[-1].weight)

            # 旧版 ASR 更保守，先让 CNN 高频细节小幅进入。
            self.residual_scale = nn.Parameter(torch.tensor(0.1))

    def forward(
        self,
        x: torch.Tensor,
        cnn_feat: Optional[torch.Tensor] = None,
        attr_prompt: Optional[torch.Tensor] = None,
        layer_morph_prompt: Optional[torch.Tensor] = None,
    ) -> torch.Tensor:
        # attr_prompt / layer_morph_prompt 故意不使用。
        x_up = self.structure_upsample(x)

        if self.has_cnn and cnn_feat is not None:
            cnn_feat = cnn_feat.to(device=x_up.device, dtype=x_up.dtype)
            c = self.cnn_proj(cnn_feat)

            if c.shape[-2:] != x_up.shape[-2:]:
                c = F.interpolate(
                    c,
                    size=x_up.shape[-2:],
                    mode="bilinear",
                    align_corners=False,
                )

            detail = self.cnn_fusion(torch.cat([x_up, c], dim=1))
            scale = self.residual_scale.to(device=x_up.device, dtype=x_up.dtype)
            x_up = x_up + detail * scale

        return x_up


class FreqPathASRBlock(nn.Module):
    """
    论文主线 ASR：低频语义结构约束 + 高频形态/边界约束。

    这个模块保留给后续突破实验：
    1. 低频语义流：attr_prompt 调制 SAM structure upsample。
    2. 高频形态流：morph_feat 调制 CNN 高频边界特征。
    3. 再融合低频结构与高频边界。

    注意：
    只有当 legacy ASR 能复现旧 mAJI 后，才应该启用该模式。
    """

    def __init__(
        self,
        in_dim: int,
        out_dim: int,
        cnn_dim: Optional[int] = None,
        text_dim: int = 512,
        activation: Type[nn.Module] = nn.GELU,
    ):
        super().__init__()

        self.in_dim = in_dim
        self.out_dim = out_dim
        self.cnn_dim = cnn_dim
        self.text_dim = text_dim
        self.has_cnn = cnn_dim is not None

        self.structure_upsample = nn.Sequential(
            nn.ConvTranspose2d(in_dim, out_dim, kernel_size=2, stride=2),
            LayerNorm2d(out_dim),
            activation(),
        )

        self.attr_modulator = nn.Sequential(
            nn.Linear(text_dim, out_dim),
            nn.LayerNorm(out_dim),
            activation(),
            nn.Linear(out_dim, out_dim),
        )
        nn.init.normal_(self.attr_modulator[-1].weight, std=1e-4)
        nn.init.zeros_(self.attr_modulator[-1].bias)

        # Spatially gated low-frequency semantic residual.
        #
        # The previous design applied attr_prompt as global channel scaling:
        #     x_up = x_up * (1 + gamma)
        # That perturbed all spatial locations equally and empirically hurt test
        # performance. The new design keeps attr_prompt as a channel direction,
        # but lets the current visual feature decide where the residual is allowed
        # to enter through a low-resolution spatial gate.
        spatial_hidden = max(8, out_dim // 4)
        self.low_spatial_gate = nn.Sequential(
            nn.Conv2d(out_dim, spatial_hidden, kernel_size=3, padding=1, bias=False),
            LayerNorm2d(spatial_hidden),
            activation(),
            nn.Conv2d(spatial_hidden, 1, kernel_size=1, bias=True),
        )
        nn.init.zeros_(self.low_spatial_gate[-1].weight)
        nn.init.constant_(self.low_spatial_gate[-1].bias, -3.0)

        # Learnable global strength for low-frequency semantic residual.
        # It is intentionally conservative; the spatial gate starts almost closed.
        self.low_strength = nn.Parameter(torch.tensor(2.0))

        if self.has_cnn:
            self.morphology_modulator = nn.Sequential(
                nn.Linear(cnn_dim, cnn_dim),
                nn.LayerNorm(cnn_dim),
                activation(),
                nn.Linear(cnn_dim, cnn_dim),
            )
            nn.init.normal_(self.morphology_modulator[-1].weight, std=1e-4)
            nn.init.zeros_(self.morphology_modulator[-1].bias)

            self.cnn_proj = nn.Sequential(
                nn.Conv2d(cnn_dim, out_dim, kernel_size=1, bias=False),
                LayerNorm2d(out_dim),
                activation(),
            )

            self.cnn_fusion = nn.Sequential(
                nn.Conv2d(out_dim * 2, out_dim, kernel_size=3, padding=1, bias=False),
                LayerNorm2d(out_dim),
                activation(),
                nn.Conv2d(out_dim, out_dim, kernel_size=1, bias=False),
            )
            nn.init.zeros_(self.cnn_fusion[-1].weight)

            # 这里也先改成 0.1，避免 freqpath 一启用就过强。
            self.residual_scale = nn.Parameter(torch.tensor(0.1))

        # Last-forward diagnostics. This is not a buffer and will not be saved in checkpoints.
        # MaskDecoder reads this immediately after each FreqPathASRBlock call.
        self.last_debug: Dict[str, torch.Tensor] = {}

        # ── FREQPATH_MODULATOR_PARAM_AUDIT (one-shot) ──
        global _FREQPATH_MODULATOR_COUNTER
        _fmp_audit_enabled = os.environ.get("FREQPATH_AUDIT_ENABLED", "0") == "1"
        if _fmp_audit_enabled and _FREQPATH_MODULATOR_COUNTER == 0:
            _attr_w = self.attr_modulator[-1].weight
            _attr_b = self.attr_modulator[-1].bias
            _attr_w_norm = _attr_w.detach().float().norm().item()
            _attr_b_norm = _attr_b.detach().float().norm().item()
            _attr_w_requires_grad = _attr_w.requires_grad
            _attr_w_shape = tuple(_attr_w.shape)
            _morph_has = self.has_cnn
            if _morph_has:
                _morph_w = self.morphology_modulator[-1].weight
                _morph_b = self.morphology_modulator[-1].bias
                _morph_w_norm = _morph_w.detach().float().norm().item()
                _morph_b_norm = _morph_b.detach().float().norm().item()
                _morph_w_requires_grad = _morph_w.requires_grad
                _morph_w_shape = tuple(_morph_w.shape)
            _low_strength_val = self.low_strength.detach().float().item()
            _spatial_gate_w_norm = self.low_spatial_gate[-1].weight.detach().float().norm().item()
            _spatial_gate_bias = self.low_spatial_gate[-1].bias.detach().float().item()
            print(
                f"\n[FREQPATH_MODULATOR_PARAM_AUDIT]\n"
                f"  attr_modulator[-1].weight:\n"
                f"    shape={_attr_w_shape}, norm={_attr_w_norm:.8f}, requires_grad={_attr_w_requires_grad}\n"
                f"  attr_modulator[-1].bias: norm={_attr_b_norm:.8f}\n"
                f"  morphology_modulator present={_morph_has}\n",
                end="" if _morph_has else "\n",
                flush=True,
            )
            if _morph_has:
                print(
                    f"  morphology_modulator[-1].weight:\n"
                    f"    shape={_morph_w_shape}, norm={_morph_w_norm:.8f}, requires_grad={_morph_w_requires_grad}\n"
                    f"  morphology_modulator[-1].bias: norm={_morph_b_norm:.8f}\n"
                    f"  low_strength={_low_strength_val:.6f}\n"
                    f"  low_spatial_gate[-1].weight_norm={_spatial_gate_w_norm:.8f}\n"
                    f"  low_spatial_gate[-1].bias={_spatial_gate_bias:.4f}\n",
                    flush=True,
                )
            _FREQPATH_MODULATOR_COUNTER += 1

    @staticmethod
    def _debug_zero_like(x: torch.Tensor) -> torch.Tensor:
        return torch.tensor(0.0, device=x.device, dtype=torch.float32)

    @staticmethod
    def _debug_one_like(x: torch.Tensor) -> torch.Tensor:
        return torch.tensor(1.0, device=x.device, dtype=torch.float32)

    @staticmethod
    def _debug_norm(x: torch.Tensor) -> torch.Tensor:
        return x.detach().float().flatten(1).norm(dim=1).mean()

    @staticmethod
    def _debug_abs_mean(x: torch.Tensor) -> torch.Tensor:
        return x.detach().float().abs().mean()

    @staticmethod
    def _to_prompt_vector(prompt: torch.Tensor, target_batch: int) -> torch.Tensor:
        if prompt.dim() == 3:
            prompt = prompt.mean(dim=1)

        if prompt.dim() != 2:
            raise ValueError(
                f"Prompt must be [B, C] or [B, N, C], got {prompt.shape}"
            )

        if prompt.shape[0] == 1 and target_batch > 1:
            prompt = prompt.expand(target_batch, -1).contiguous()

        if prompt.shape[0] != target_batch:
            raise ValueError(
                f"Prompt batch size mismatch: "
                f"prompt batch={prompt.shape[0]}, target batch={target_batch}"
            )

        return prompt

    def forward(
        self,
        x: torch.Tensor,
        cnn_feat: Optional[torch.Tensor] = None,
        attr_prompt: Optional[torch.Tensor] = None,
        layer_morph_prompt: Optional[torch.Tensor] = None,
        structure_delta: Optional[torch.Tensor] = None,
        boundary_delta: Optional[torch.Tensor] = None,
    ) -> torch.Tensor:
        x_up = self.structure_upsample(x)
        batch_size = x_up.shape[0]

        debug: Dict[str, torch.Tensor] = {
            "input_norm": self._debug_norm(x),
            "structure_norm": self._debug_norm(x_up),
            "low_prompt_used": self._debug_zero_like(x_up),
            "low_gamma_norm": self._debug_zero_like(x_up),
            "low_gamma_abs_mean": self._debug_zero_like(x_up),
            "low_strength": self._debug_zero_like(x_up),
            "low_spatial_gate_mean": self._debug_zero_like(x_up),
            "low_spatial_gate_max": self._debug_zero_like(x_up),
            "low_delta_norm": self._debug_zero_like(x_up),
            "high_prompt_used": self._debug_zero_like(x_up),
            "high_gamma_norm": self._debug_zero_like(x_up),
            "high_gamma_abs_mean": self._debug_zero_like(x_up),
            "high_delta_norm": self._debug_zero_like(x_up),
            "cnn_projected_norm": self._debug_zero_like(x_up),
            "detail_norm": self._debug_zero_like(x_up),
            "scaled_detail_norm": self._debug_zero_like(x_up),
            "residual_scale": self._debug_zero_like(x_up),
        }

        # 低频语义结构调制。
        x_before_low = x_up
        if attr_prompt is not None:
            attr_prompt = self._to_prompt_vector(attr_prompt, batch_size)
            attr_prompt = attr_prompt.to(
                device=x_up.device,
                dtype=self.attr_modulator[0].weight.dtype,
            )
            gamma_low_raw = self.attr_modulator(attr_prompt).to(dtype=x_up.dtype)
            gamma_low = torch.tanh(gamma_low_raw).unsqueeze(-1).unsqueeze(-1)

            # Spatially gated semantic residual:
            #   channel direction comes from attr_prompt;
            #   spatial support comes from the current visual feature.
            # This is safer than applying a global channel scaling everywhere.
            spatial_gate = torch.sigmoid(self.low_spatial_gate(x_before_low))
            low_strength = self.low_strength.to(device=x_up.device, dtype=x_up.dtype)
            low_delta = x_before_low * (low_strength * gamma_low) * spatial_gate
            x_up = x_before_low + low_delta

            debug["low_prompt_used"] = self._debug_one_like(x_up)
            debug["low_gamma_norm"] = self._debug_norm(gamma_low_raw)
            debug["low_gamma_abs_mean"] = self._debug_abs_mean(gamma_low)
            debug["low_strength"] = low_strength.detach().float().mean()
            debug["low_spatial_gate_mean"] = self._debug_abs_mean(spatial_gate)
            debug["low_spatial_gate_max"] = spatial_gate.detach().float().amax()
            debug["low_delta_norm"] = self._debug_norm(low_delta)

        # ── SGA-SB v1 CORRECTION: Spatial Structure Guidance (low-path injection) ──
        # structure_delta is the gamma-scaled adapter output from SpatialStructureAdapter,
        # pre-multiplied by gamma_structure in TextSam.forward.
        if structure_delta is not None:
            _sd = structure_delta.to(dtype=x_up.dtype, device=x_up.device)
            if _sd.shape[-2:] != x_up.shape[-2:]:
                _sd = F.interpolate(_sd, size=x_up.shape[-2:], mode="bilinear", align_corners=False)
            if _sd.ndim != x_up.ndim or _sd.shape[0] != x_up.shape[0] or _sd.shape[1] != x_up.shape[1] or _sd.shape[-2:] != x_up.shape[-2:]:
                raise RuntimeError(
                    "[SGA_SB_SHAPE_ERROR] "
                    f"branch=structure structure_delta={tuple(_sd.shape)} "
                    f"low_feature={tuple(x_up.shape)} "
                    f"delta_dtype={_sd.dtype} feature_dtype={x_up.dtype} "
                    f"delta_device={_sd.device} feature_device={x_up.device}"
                )
            print(
                "[SGA_SB_SHAPE_AUDIT]\n"
                "branch=structure\n"
                f"structure_delta_shape={tuple(_sd.shape)}\n"
                f"low_feature_shape={tuple(x_up.shape)}\n"
                "channel_match=true\n"
                "spatial_match=true",
                flush=True,
            )
            x_up = x_up + _sd
            debug["low_spatial_sb_delta_norm"] = self._debug_norm(_sd)

        # 高频 CNN 边界/形态调制。
        if self.has_cnn and cnn_feat is not None:
            cnn_feat = cnn_feat.to(device=x_up.device, dtype=x_up.dtype)

            cnn_feat_before_high = cnn_feat
            if layer_morph_prompt is not None:
                layer_morph_prompt = self._to_prompt_vector(
                    layer_morph_prompt,
                    cnn_feat.shape[0],
                )
                layer_morph_prompt = layer_morph_prompt.to(
                    device=cnn_feat.device,
                    dtype=self.morphology_modulator[0].weight.dtype,
                )
                gamma_high_raw = self.morphology_modulator(layer_morph_prompt).to(
                    dtype=cnn_feat.dtype
                )
                gamma_high = torch.tanh(gamma_high_raw).unsqueeze(-1).unsqueeze(-1)
                cnn_feat = cnn_feat * (1.0 + gamma_high)

                debug["high_prompt_used"] = self._debug_one_like(x_up)
                debug["high_gamma_norm"] = self._debug_norm(gamma_high_raw)
                debug["high_gamma_abs_mean"] = self._debug_abs_mean(gamma_high)
                debug["high_delta_norm"] = self._debug_norm(cnn_feat - cnn_feat_before_high)

            # ── SGA-SB v1 CORRECTION: Spatial Boundary Guidance (high-path injection) ──
            # boundary_delta is the gamma-scaled adapter output from SpatialBoundaryAdapter,
            # pre-multiplied by gamma_boundary in TextSam.forward.
            if boundary_delta is not None:
                _bd = boundary_delta.to(dtype=cnn_feat.dtype, device=cnn_feat.device)
                if _bd.shape[-2:] != cnn_feat.shape[-2:]:
                    _bd = F.interpolate(_bd, size=cnn_feat.shape[-2:], mode="bilinear", align_corners=False)
                if _bd.ndim != cnn_feat.ndim or _bd.shape[0] != cnn_feat.shape[0] or _bd.shape[1] != cnn_feat.shape[1] or _bd.shape[-2:] != cnn_feat.shape[-2:]:
                    raise RuntimeError(
                        "[SGA_SB_SHAPE_ERROR] "
                        f"branch=boundary boundary_delta={tuple(_bd.shape)} "
                        f"high_feature={tuple(cnn_feat.shape)} "
                        f"delta_dtype={_bd.dtype} feature_dtype={cnn_feat.dtype} "
                        f"delta_device={_bd.device} feature_device={cnn_feat.device}"
                    )
                print(
                    "[SGA_SB_SHAPE_AUDIT]\n"
                    "branch=boundary\n"
                    f"boundary_delta_shape={tuple(_bd.shape)}\n"
                    f"high_feature_shape={tuple(cnn_feat.shape)}\n"
                    "channel_match=true\n"
                    "spatial_match=true",
                    flush=True,
                )
                cnn_feat = cnn_feat + _bd
                debug["high_spatial_sb_delta_norm"] = self._debug_norm(_bd)

            c = self.cnn_proj(cnn_feat)

            if c.shape[-2:] != x_up.shape[-2:]:
                c = F.interpolate(
                    c,
                    size=x_up.shape[-2:],
                    mode="bilinear",
                    align_corners=False,
                )

            debug["cnn_projected_norm"] = self._debug_norm(c)

            detail = self.cnn_fusion(torch.cat([x_up, c], dim=1))
            scale = self.residual_scale.to(device=x_up.device, dtype=x_up.dtype)
            scaled_detail = detail * scale
            x_up = x_up + scaled_detail

            debug["detail_norm"] = self._debug_norm(detail)
            debug["scaled_detail_norm"] = self._debug_norm(scaled_detail)
            debug["residual_scale"] = scale.detach().float().mean()

        debug["output_norm"] = self._debug_norm(x_up)

        # ── Save internal tensors for backward chain audit (FREQPATH_AUDIT_ENABLED=1 + training) ──
        _freqpath_debug_enabled = os.environ.get("FREQPATH_AUDIT_ENABLED", "0") == "1"
        self._freqpath_debug_tensors: Dict[str, torch.Tensor] = {}
        if _freqpath_debug_enabled and self.training:
            # Collect available intermediate tensors (some may not exist if paths inactive)
            _tensor_dict: Dict[str, torch.Tensor] = {}
            # attr_prompt after _to_prompt_vector (if path active)
            if attr_prompt is not None:
                _tensor_dict["attr_prompt_vec"] = attr_prompt
            # morph prompt after _to_prompt_vector (if path active)
            _mp = locals().get("layer_morph_prompt", None)
            if _mp is not None:
                _tensor_dict["morph_feat_vec"] = _mp
            # low modulator raw (if computed)
            _lmr = locals().get("gamma_low_raw", None)
            if _lmr is not None:
                _tensor_dict["low_modulator_raw"] = _lmr
            # high modulator raw (if computed)
            _hmr = locals().get("gamma_high_raw", None)
            if _hmr is not None:
                _tensor_dict["high_modulator_raw"] = _hmr
            # low delta (if computed)
            _ld = locals().get("low_delta", None)
            if _ld is not None:
                _tensor_dict["low_delta"] = _ld
            # high delta (cnn_feat - cnn_feat_before_high, if computed)
            _hd = locals().get("cnn_feat_before_high", None)
            _hdx = locals().get("cnn_feat", None)
            if _hd is not None and _hdx is not None:
                _tensor_dict["high_delta"] = _hdx - _hd
            # final output
            _tensor_dict["output"] = x_up
            # retain_grad on all collected tensors
            for _k, _t in _tensor_dict.items():
                if isinstance(_t, torch.Tensor) and _t.dtype.is_floating_point and _t.requires_grad:
                    _t.retain_grad()
            self._freqpath_debug_tensors = _tensor_dict

        # ── FREQPATH_BLOCK_AUDIT (one-time) ──
        global _FREQPATH_BLOCK_COUNTER
        _freqpath_block_audit_enabled = os.environ.get("FREQPATH_AUDIT_ENABLED", "0") == "1"
        if _freqpath_block_audit_enabled and _FREQPATH_BLOCK_COUNTER == 0:
            _ablation_mode = os.environ.get("FREQPATH_ABLATION", "both").lower().strip()
            _low_path_active = attr_prompt is not None
            _high_path_active = layer_morph_prompt is not None
            _struct_shape = tuple(x_up.shape)
            _cnn_shape = tuple(cnn_feat.shape) if cnn_feat is not None else None
            _attr_shape = tuple(attr_prompt.shape) if attr_prompt is not None else None
            _morph_shape = tuple(layer_morph_prompt.shape) if layer_morph_prompt is not None else None
            _low_mod_norm = float(debug.get("low_gamma_norm", torch.tensor(0.0)).detach().float().mean().cpu())
            _high_mod_norm = float(debug.get("high_gamma_norm", torch.tensor(0.0)).detach().float().mean().cpu())
            _low_delta = float(debug.get("low_delta_norm", torch.tensor(0.0)).detach().float().mean().cpu())
            _high_delta = float(debug.get("high_delta_norm", torch.tensor(0.0)).detach().float().mean().cpu())
            print(
                f"\n[FREQPATH_BLOCK_AUDIT]\n"
                f"  ablation_mode={_ablation_mode}\n"
                f"  low_path_active={_low_path_active}\n"
                f"  high_path_active={_high_path_active}\n"
                f"  structure_upsample_shape={_struct_shape}\n"
                f"  cnn_features_shape={_cnn_shape}\n"
                f"  attr_prompt_shape={_attr_shape}\n"
                f"  morph_feat_shape={_morph_shape}\n"
                f"  low_modulation_norm={_low_mod_norm:.6f}\n"
                f"  high_modulation_norm={_high_mod_norm:.6f}\n"
                f"  low_delta_norm={_low_delta:.6f}\n"
                f"  high_delta_norm={_high_delta:.6f}\n",
                flush=True,
            )
            _FREQPATH_BLOCK_COUNTER += 1

        # ── FREQPATH_INTERNAL_CHAIN_AUDIT (one-shot, expanded with requires_grad & grad_fn) ──
        global _FREQPATH_INTERNAL_COUNTER
        _freqpath_internal_audit_enabled = os.environ.get("FREQPATH_AUDIT_ENABLED", "0") == "1"
        if _freqpath_internal_audit_enabled and _FREQPATH_INTERNAL_COUNTER == 0:
            _attr_prompt_norm = float(attr_prompt.detach().float().norm(dim=1).mean().cpu()) if attr_prompt is not None else -1.0
            _attr_prompt_rg = attr_prompt.requires_grad if attr_prompt is not None else False
            _attr_prompt_grad_fn = str(type(attr_prompt.grad_fn)) if attr_prompt is not None and attr_prompt.grad_fn is not None else "None"
            _low_mod_raw = float(debug.get("low_gamma_norm", torch.tensor(0.0)).detach().float().mean().cpu())
            _low_mod_tanh = float(debug.get("low_gamma_abs_mean", torch.tensor(0.0)).detach().float().mean().cpu())
            _low_gate_mean = float(debug.get("low_spatial_gate_mean", torch.tensor(0.0)).detach().float().mean().cpu())
            _low_gate_max = float(debug.get("low_spatial_gate_max", torch.tensor(0.0)).detach().float().mean().cpu())
            _low_str = float(debug.get("low_strength", torch.tensor(0.0)).detach().float().mean().cpu())
            _low_delta = float(debug.get("low_delta_norm", torch.tensor(0.0)).detach().float().mean().cpu())
            _high_mod_raw = float(debug.get("high_gamma_norm", torch.tensor(0.0)).detach().float().mean().cpu())
            _high_delta = float(debug.get("high_delta_norm", torch.tensor(0.0)).detach().float().mean().cpu())
            _high_prompt_norm = float(layer_morph_prompt.detach().float().norm(dim=1).mean().cpu()) if layer_morph_prompt is not None else -1.0
            _high_prompt_rg = layer_morph_prompt.requires_grad if layer_morph_prompt is not None else False
            _high_prompt_grad_fn = str(type(layer_morph_prompt.grad_fn)) if layer_morph_prompt is not None and layer_morph_prompt.grad_fn is not None else "None"
            # Grad fn for key internal tensors
            _lmr = locals().get("gamma_low_raw", None)
            _low_mod_grad_fn = str(type(_lmr.grad_fn)) if _lmr is not None and _lmr.grad_fn is not None else "None"
            _hmr = locals().get("gamma_high_raw", None)
            _high_mod_grad_fn = str(type(_hmr.grad_fn)) if _hmr is not None and _hmr.grad_fn is not None else "None"
            _ld = locals().get("low_delta", None)
            _low_delta_grad_fn = str(type(_ld.grad_fn)) if _ld is not None and _ld.grad_fn is not None else "None"
            _hdx = locals().get("cnn_feat", None)
            _hdb = locals().get("cnn_feat_before_high", None)
            _high_delta_t = (_hdx - _hdb) if _hdx is not None and _hdb is not None else None
            _high_delta_grad_fn = str(type(_high_delta_t.grad_fn)) if _high_delta_t is not None and _high_delta_t.grad_fn is not None else "None"
            _out_rg = x_up.requires_grad
            _out_grad_fn = str(type(x_up.grad_fn)) if x_up.grad_fn is not None else "None"
            print(
                f"\n[FREQPATH_INTERNAL_CHAIN_AUDIT]\n"
                f"  attr_prompt_requires_grad={_attr_prompt_rg}\n"
                f"  morph_feat_requires_grad={_high_prompt_rg}\n"
                f"  attr_prompt_vec_requires_grad={_attr_prompt_rg}\n"
                f"  morph_feat_vec_requires_grad={_high_prompt_rg}\n"
                f"  low_modulator_raw_requires_grad={_lmr is not None and _lmr.requires_grad if _lmr is not None else False}\n"
                f"  high_modulator_raw_requires_grad={_hmr is not None and _hmr.requires_grad if _hmr is not None else False}\n"
                f"  low_delta_requires_grad={_ld is not None and _ld.requires_grad if _ld is not None else False}\n"
                f"  high_delta_requires_grad={_high_delta_t is not None and _high_delta_t.requires_grad if _high_delta_t is not None else False}\n"
                f"  output_requires_grad={_out_rg}\n"
                f"  attr_prompt_grad_fn={_attr_prompt_grad_fn}\n"
                f"  morph_feat_grad_fn={_high_prompt_grad_fn}\n"
                f"  low_delta_grad_fn={_low_delta_grad_fn}\n"
                f"  high_delta_grad_fn={_high_delta_grad_fn}\n"
                f"  attr_prompt:\n"
                f"    norm={_attr_prompt_norm:.6f}, requires_grad={_attr_prompt_rg}, grad_fn_exists={_attr_prompt_grad_fn != 'None'}\n"
                f"  low_path:\n"
                f"    modulator_raw_norm={_low_mod_raw:.8f}, grad_fn={_low_mod_grad_fn}\n"
                f"    modulator_post_tanh_absmean={_low_mod_tanh:.8f}\n"
                f"    spatial_gate_mean={_low_gate_mean:.6f}, spatial_gate_max={_low_gate_max:.6f}\n"
                f"    low_strength={_low_str:.6f}\n"
                f"    delta_norm={_low_delta:.8f}, grad_fn={_low_delta_grad_fn}\n"
                f"  high_path:\n"
                f"    morph_prompt_norm={_high_prompt_norm:.6f}, requires_grad={_high_prompt_rg}, grad_fn={_high_prompt_grad_fn}\n"
                f"    modulator_raw_norm={_high_mod_raw:.8f}, grad_fn={_high_mod_grad_fn}\n"
                f"    delta_norm={_high_delta:.8f}, grad_fn={_high_delta_grad_fn}\n"
                f"  output:\n"
                f"    requires_grad={_out_rg}, grad_fn={_out_grad_fn}\n",
                flush=True,
            )
            _FREQPATH_INTERNAL_COUNTER += 1

        self.last_debug = debug

        return x_up


class MaskDecoder(nn.Module):
    def __init__(
        self,
        *,
        transformer_dim: int,
        transformer: nn.Module,
        num_multimask_outputs: int = 3,
        activation: Type[nn.Module] = nn.GELU,
        iou_head_depth: int = 3,
        iou_head_hidden_dim: int = 256,
        use_asr: bool = True,
        asr_variant: str = "legacy",
    ) -> None:
        super().__init__()

        if asr_variant not in ("legacy", "freqpath"):
            raise ValueError(
                f"asr_variant must be 'legacy' or 'freqpath', got {asr_variant}"
            )

        self.transformer_dim = transformer_dim
        self.transformer = transformer
        self.num_multimask_outputs = num_multimask_outputs
        self.use_asr = use_asr
        self.asr_variant = asr_variant
        self.last_freqpath_debug: Dict[str, torch.Tensor] = {}

        self.iou_token = nn.Embedding(1, transformer_dim)

        self.num_mask_tokens = num_multimask_outputs + 1
        self.mask_tokens = nn.Embedding(self.num_mask_tokens, transformer_dim)

        if self.use_asr:
            block_cls = LegacyASRBlock if asr_variant == "legacy" else FreqPathASRBlock

            self.asr_upscale_1 = block_cls(
                in_dim=transformer_dim,
                out_dim=transformer_dim // 4,
                cnn_dim=512,
                text_dim=512,
                activation=activation,
            )

            self.asr_upscale_2 = block_cls(
                in_dim=transformer_dim // 4,
                out_dim=transformer_dim // 8,
                cnn_dim=256,
                text_dim=512,
                activation=activation,
            )

            # Read-only SGA-SB channel contract.  These values come from the
            # actual injection modules instead of duplicating 64/256 literals
            # in TextSam or the entry points.
            self.structure_guidance_channels = self.asr_upscale_1.out_dim
            self.boundary_guidance_channels = self.asr_upscale_2.cnn_dim

            if asr_variant == "freqpath":
                self.morph_encoder = MorphologyEncoder(
                    text_dim=512,
                    cnn_dims=[512, 256],
                )
            else:
                self.morph_encoder = None

        else:
            self.output_upscaling = nn.Sequential(
                nn.ConvTranspose2d(
                    transformer_dim,
                    transformer_dim // 4,
                    kernel_size=2,
                    stride=2,
                ),
                LayerNorm2d(transformer_dim // 4),
                activation(),
                nn.ConvTranspose2d(
                    transformer_dim // 4,
                    transformer_dim // 8,
                    kernel_size=2,
                    stride=2,
                ),
                activation(),
            )

        self.output_hypernetworks_mlps = nn.ModuleList(
            [
                MLP(transformer_dim, transformer_dim, transformer_dim // 8, 3)
                for _ in range(self.num_mask_tokens)
            ]
        )

        self.iou_prediction_head = MLP(
            transformer_dim,
            iou_head_hidden_dim,
            self.num_mask_tokens,
            iou_head_depth,
        )

    @staticmethod
    def _prefix_debug(
        debug: Dict[str, torch.Tensor],
        prefix: str,
    ) -> Dict[str, torch.Tensor]:
        return {f"{prefix}_{k}": v for k, v in debug.items()}

    def forward(
        self,
        image_embeddings: torch.Tensor,
        image_pe: torch.Tensor,
        sparse_prompt_embeddings: torch.Tensor,
        dense_prompt_embeddings: torch.Tensor,
        multimask_output: bool,
        cnn_feat_s1: Optional[torch.Tensor] = None,
        cnn_feat_s2: Optional[torch.Tensor] = None,
        attr_prompt: Optional[torch.Tensor] = None,
        morph_feat: Optional[torch.Tensor] = None,
        structure_delta: Optional[torch.Tensor] = None,
        boundary_delta: Optional[torch.Tensor] = None,
        **kwargs,
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        masks, iou_pred = self.predict_masks(
            image_embeddings=image_embeddings,
            image_pe=image_pe,
            sparse_prompt_embeddings=sparse_prompt_embeddings,
            dense_prompt_embeddings=dense_prompt_embeddings,
            cnn_feat_s1=cnn_feat_s1,
            cnn_feat_s2=cnn_feat_s2,
            attr_prompt=attr_prompt,
            morph_feat=morph_feat,
            structure_delta=structure_delta,
            boundary_delta=boundary_delta,
        )

        if multimask_output:
            mask_slice = slice(1, None)
        else:
            mask_slice = slice(0, 1)

        masks = masks[:, mask_slice, :, :]
        iou_pred = iou_pred[:, mask_slice]

        return masks, iou_pred

    def predict_masks(
        self,
        image_embeddings: torch.Tensor,
        image_pe: torch.Tensor,
        sparse_prompt_embeddings: torch.Tensor,
        dense_prompt_embeddings: torch.Tensor,
        cnn_feat_s1: Optional[torch.Tensor] = None,
        cnn_feat_s2: Optional[torch.Tensor] = None,
        attr_prompt: Optional[torch.Tensor] = None,
        morph_feat: Optional[torch.Tensor] = None,
        structure_delta: Optional[torch.Tensor] = None,
        boundary_delta: Optional[torch.Tensor] = None,
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        self.last_freqpath_debug = {}

        output_tokens = torch.cat(
            [self.iou_token.weight, self.mask_tokens.weight],
            dim=0,
        )

        output_tokens = output_tokens.unsqueeze(0).expand(
            sparse_prompt_embeddings.size(0),
            -1,
            -1,
        )

        tokens = torch.cat((output_tokens, sparse_prompt_embeddings), dim=1)

        src = image_embeddings + dense_prompt_embeddings
        pos_src = torch.repeat_interleave(image_pe, tokens.shape[0], dim=0)

        b, c, h, w = src.shape

        hs, src = self.transformer(src, pos_src, tokens)

        iou_token_out = hs[:, 0, :]
        mask_tokens_out = hs[:, 1 : (1 + self.num_mask_tokens), :]

        src = src.transpose(1, 2).view(b, c, h, w)

        if self.use_asr:
            if self.asr_variant == "legacy":
                # 纯视觉 ASR：只接 SAM 特征 + CNN 高频细节。
                upscaled_embedding = self.asr_upscale_1(
                    src,
                    cnn_feat=cnn_feat_s2,
                    attr_prompt=None,
                    layer_morph_prompt=None,
                )
                upscaled_embedding = self.asr_upscale_2(
                    upscaled_embedding,
                    cnn_feat=cnn_feat_s1,
                    attr_prompt=None,
                    layer_morph_prompt=None,
                )

            else:
                # 论文主线：低频语义 + 高频形态。
                layer_morph_prompts = [None, None]

                if morph_feat is not None and self.morph_encoder is not None:
                    layer_morph_prompts = self.morph_encoder(morph_feat)

                # ── SGA-SB v1 CORRECTION: Spatial guidance deltas ──
                # structure_delta / boundary_delta are pre-multiplied by
                # gamma_structure / gamma_boundary.  Structure is injected
                # into the first low path (64 channels); boundary is injected
                # into the second high/CNN path before cnn_proj (256 channels).
                # FreqPathASRBlock performs spatial resizing only.
                _sd_b1 = structure_delta
                _sd_b2 = None
                _bd_b1 = None
                _bd_b2 = boundary_delta

                upscaled_embedding = self.asr_upscale_1(
                    src,
                    cnn_feat=cnn_feat_s2,
                    attr_prompt=attr_prompt,
                    layer_morph_prompt=layer_morph_prompts[0],
                    structure_delta=_sd_b1,
                    boundary_delta=_bd_b1,
                )
                upscaled_embedding = self.asr_upscale_2(
                    upscaled_embedding,
                    cnn_feat=cnn_feat_s1,
                    attr_prompt=attr_prompt,
                    layer_morph_prompt=layer_morph_prompts[1],
                    structure_delta=_sd_b2,
                    boundary_delta=_bd_b2,
                )

                # Expose internal FreqPath diagnostics to TextSam.forward.
                # TextSam can attach these values to per-sample outputs for train.py logging.
                self.last_freqpath_debug = {}
                if hasattr(self.asr_upscale_1, "last_debug"):
                    self.last_freqpath_debug.update(
                        self._prefix_debug(self.asr_upscale_1.last_debug, "freqpath_b1")
                    )
                if hasattr(self.asr_upscale_2, "last_debug"):
                    self.last_freqpath_debug.update(
                        self._prefix_debug(self.asr_upscale_2.last_debug, "freqpath_b2")
                    )

        else:
            upscaled_embedding = self.output_upscaling(src)

        hyper_in_list: List[torch.Tensor] = []

        for i in range(self.num_mask_tokens):
            hyper_in_list.append(
                self.output_hypernetworks_mlps[i](mask_tokens_out[:, i, :])
            )

        hyper_in = torch.stack(hyper_in_list, dim=1)

        b, c, h, w = upscaled_embedding.shape

        masks = (
            hyper_in @ upscaled_embedding.view(b, c, h * w)
        ).view(b, -1, h, w)

        iou_pred = self.iou_prediction_head(iou_token_out)

        return masks, iou_pred


class MLP(nn.Module):
    def __init__(
        self,
        input_dim: int,
        hidden_dim: int,
        output_dim: int,
        num_layers: int,
        sigmoid_output: bool = False,
    ) -> None:
        super().__init__()

        self.num_layers = num_layers
        self.sigmoid_output = sigmoid_output

        h = [hidden_dim] * (num_layers - 1)

        self.layers = nn.ModuleList(
            nn.Linear(n, k)
            for n, k in zip([input_dim] + h, h + [output_dim])
        )

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        for i, layer in enumerate(self.layers):
            if i < self.num_layers - 1:
                x = F.relu(layer(x), inplace=False)
            else:
                x = layer(x)

        if self.sigmoid_output:
            x = torch.sigmoid(x)

        return x
