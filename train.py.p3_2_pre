    # ── PNuDP Dense Training (Stage D) ─────────────────────────────────
    parser.add_argument(
        "--enable_pnudp_dense_train",
        type=str2bool,
        default=False,
        help="Enable PNuDP dense training (Stage D). Trains pnudp_dense_proj + pnudp_logit_proj + alpha.",
