    parser.add_argument(
        "--promptnu_guided_v3_align_low_norm_mode",
        type=str,
        default="detach_guided",
        choices=["detach_semantic", "detach_guided"],
        help="PG3 alignment low-norm fallback mode: 'detach_semantic' (detach semantic_delta_before_v3, no visual gradient), 'detach_guided' (use guided_semantic_delta.detach() as visual source, richer signal). Default: detach_guided.",
    )
    parser.add_argument(
        "--debug_promptnu_guided_v3_audit",
