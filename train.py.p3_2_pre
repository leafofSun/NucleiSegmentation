    parser.add_argument(
        "--promptnu_guided_v3_delta_weight",
        type=float,
        default=0.001,
        help="Weight for v3.3 additive text-delta branch. Formula: guided = sd * (1 + w_scale*tanh(scale)) + w_delta*tanh(delta). Default: 0.001.",
    )
    parser.add_argument(
