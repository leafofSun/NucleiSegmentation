    )
    # ── PromptNu-guided v3.3 alignment stability ──
    parser.add_argument(
        "--promptnu_guided_v3_align_eps",
        type=float,
        default=1e-8,
        help="Epsilon for PG3 alignment loss RMS computation (added inside sqrt as eps^2). Prevents gradient explosion when semantic_delta ≈ 0. Default: 1e-8.",
    )
    parser.add_argument(
        "--promptnu_guided_v3_cosine_eps",
        type=float,
        default=1e-8,
        help="Epsilon for PG3 cosine_similarity to prevent 0/0 → NaN when projections are near-zero. Default: 1e-8.",
