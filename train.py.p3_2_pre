            "Filter out checkpoint tensors whose shapes do not match the current model before load_state_dict. "
            "This avoids RuntimeError from size-mismatched PNuRL-v3 modules."
        ),
    )

    parser.add_argument("--cnn_lr_ratio", type=float, default=None, help="LR ratio for ResNet/CNN high-frequency branch")
    parser.add_argument("--prompt_generator_lr_mult", type=float, default=None, help="LR multiplier for prompt generator")
    parser.add_argument("--adapter_lr_ratio", type=float, default=None, help="LR ratio for image encoder adapters")
    parser.add_argument("--asr_lr_ratio", type=float, default=1.0, help="LR ratio for GlobalASRUpsampler")

    parser.add_argument("--semantic_gate_open_value", type=float, default=-3.0, help="Open bias value for semantic gate in Phase D (semantic_injection). Replaces hardcoded -3.0.")
    parser.add_argument("--max_semantic_gate", type=float, default=0.10, help="Upper bound for SemanticChannelGate output")
    parser.add_argument("--max_delta_ratio", type=float, default=0.10, help="Upper bound for semantic_delta/base feature RMS ratio")
    parser.add_argument("--init_delta_ratio", type=float, default=0.02, help="Initial semantic_delta/base feature RMS ratio")
    parser.add_argument("--semantic_delta_reg_weight", type=float, default=1.0, help="Weight for semantic_delta relative-scale regularization")
    parser.add_argument("--injection_ratio_weight", type=float, default=10.0, help="Weight for injection_ratio hinge regularization")
    parser.add_argument("--max_injection_ratio", type=float, default=0.02, help="Soft upper bound for injected_delta_norm/base_feat_norm")
    parser.add_argument(
        "--debug_phase_d_gate_audit",
        action="store_true",
        default=False,
        help="Print detailed gate/grad/delta audit for Phase D first 2 batches (rank0 only).",
    )
    parser.add_argument(
        "--debug_instance_align_audit",
        action="store_true",
        default=False,
        help="Print detailed PHASE_D_INSTANCE_ALIGN_AUDIT logs (rank0 only, limited freq).",
    )
    parser.add_argument(
        "--stage_c_train_image_adapter",
        action="store_true",
        default=False,
        help="Unfreeze image encoder adapters during Stage C. Disabled by default for stable semantic injection.",
    )

    # ── PromptNu-lite v2: Residual-Coupled Semantic Alignment ──────────
    parser.add_argument(
        "--enable_promptnu_lite_align",
        action="store_true",
        default=False,
        help="Enable PromptNu-lite v2 residual-coupled semantic alignment. "
             "Gradients from structure/boundary alignment loss reach semantic_delta_adapter "
             "(and optionally semantic_channel_gate). Default: False (no-op).",
    )
    parser.add_argument(
        "--disable_promptnu_lite_align",
        action="store_true",
        default=False,
        help="Explicitly disable PromptNu-lite align. Highest priority over --enable_promptnu_lite_align.",
    )
    parser.add_argument(
        "--promptnu_lite_target",
        type=str,
        default="semantic_delta",
        choices=["semantic_delta", "injected_delta", "refined_feature"],
        help="PromptNu-lite v2 visual feature target for alignment: "
             "semantic_delta (PNuRL adapter output, default), "
             "injected_delta (channel_gate*semantic_delta, includes gate grad), "
             "refined_feature (image_embeddings+injected_delta).",
    )
    parser.add_argument(
        "--promptnu_lite_struct_weight",
        type=float,
        default=0.0,
        help="Weight for structure-text alignment loss in PromptNu-lite v2. Default: 0.0 (disabled).",
    )
    parser.add_argument(
        "--promptnu_lite_boundary_weight",
        type=float,
        default=0.0,
        help="Weight for boundary-text alignment loss in PromptNu-lite v2. Default: 0.0 (disabled).",
    )
    parser.add_argument(
        "--promptnu_lite_instance_weight",
        type=float,
        default=0.0,
        help="Instance alignment weight for PromptNu-lite v2. WARNING: Not implemented in v2. "
             "If > 0.0, a warning is printed and weight is treated as 0.0.",
    )
    parser.add_argument(
        "--promptnu_lite_detach_text",
        action="store_true",
        default=True,
        help="Detach text embeddings from gradient graph in PromptNu-lite v2 alignment. "
             "Default: True (text embeddings are constant).",
    )
    parser.add_argument(
        "--promptnu_lite_detach_visual",
        action="store_true",
        default=False,
        help="Detach visual features from gradient graph in PromptNu-lite v2 alignment. "
             "Default: False (gradients flow to feature target). "
             "Set to True to test projection head only — WARNING: disables residual coupling.",
    )
    parser.add_argument(
        "--promptnu_lite_proj_lr_mult",
        type=float,
        default=0.5,
        help="LR multiplier for attr_align projection heads when PromptNu-lite v2 is enabled. "
             "Applied on top of Phase D base LR. Default: 0.5.",
    )
    parser.add_argument(
        "--promptnu_lite_pool_mode",
        type=str,
        default="gap",
        choices=["gap", "absmean", "rms"],
        help="Pooling mode for PromptNu-lite v2 target feature. "
             "gap: target.mean(dim=[2,3]) (default, current behavior). "
             "absmean: target.abs().mean(dim=[2,3]). "
             "rms: sqrt((target**2).mean(dim=[2,3]) + eps). "
             "Default: gap (preserves reproducibility of old experiments).",
    )

    parser.add_argument(
        "--enable_promptnu_guided_v3",
        action="store_true",
        default=False,
        help="Enable PromptNu-guided v3: predict attr levels from StructureBoundaryAttrHeads, modulate semantic_delta scale, and compute cosine alignment loss.",
    )
    parser.add_argument(
        "--disable_promptnu_guided_v3",
        action="store_true",
        default=False,
        help="Explicitly disable PromptNu-guided v3. Also disables v3_use_text_bank. Highest priority over --enable_promptnu_guided_v3.",
    )
    parser.add_argument(
        "--promptnu_guided_v3_struct_weight",
        type=float,
        default=1.0,
        help="Weight multiplier for structure attr projections in PromptNuGuidedAdapter. Default: 1.0.",
    )
    parser.add_argument(
