    parser.add_argument(
        "--promptnu_guided_v3_text_weight",
        type=float,
        default=0.01,
        help="Scale factor for text-guided modulation. Formula: guided_sd = sd * (1.0 + text_weight * tanh(text_scale)). Default: 0.01.",
    )
    parser.add_argument(
