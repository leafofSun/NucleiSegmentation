    # ── PromptNu-guided v3.1: CONCH text bank & GT align target ──
    parser.add_argument(
        "--promptnu_guided_v3_use_text_bank",
        action="store_true",
        default=False,
        help="Enable CONCH text bank for v3.1: use CONCH-encoded structure/boundary attribute text embeddings as soft prompt to guide semantic_delta. Default: False (use legacy attr-logit gating).",
    )
    parser.add_argument(
        "--promptnu_guided_v3_use_gt_align_target",
        action="store_true",
