    )
    parser.add_argument(
        "--pnudp_dense_project_mode",
        type=str,
        default="zero_conv",
        choices=("zero_conv", "mean", "zscore_mean", "top1_margin", "zscore_top1_margin"),
        help="Projection mode for dense text logits -> bias (default: zero_conv = learnable Conv2d).",
    )
    parser.add_argument(
        "--pnudp_dense_alpha_init",
        type=float,
        default=0.05,
        help="Initial value for learnable alpha scalar (default: 0.05 for Stage D convergence).",
    )
    parser.add_argument(
        "--pnudp_dense_lr",
        type=float,
        default=1e-4,
        help="Learning rate for PNuDP dense trainable modules (default: 1e-4).",
    )
    parser.add_argument(
        "--pnudp_dense_loss_weight",
        type=float,
        default=1.0,
        help="Weight for PNuDP dense loss term.",
    )
    parser.add_argument(
        "--freeze_backbone_for_pnudp_dense",
        type=str2bool,
        default=True,
        help="Freeze all backbone params (image_encoder, mask_decoder, etc.) for PNuDP dense training.",
    )
    parser.add_argument(
        "--train_pnudp_dense_only",
        type=str2bool,
        default=True,
        help="Train only PNuDP dense modules (proj, logit_proj, alpha). All else frozen.",
    )
    # Per-parameter learning rates for PNuDP dense training (Stage D convergence defaults)
    parser.add_argument(
        "--pnudp_dense_proj_lr",
        type=float,
        default=1e-4,
