    parser.add_argument(
        "--pnudp_dense_alpha_lr",
        type=float,
        default=1e-3,
        help="Learning rate for pnudp_dense_train.dense_alpha (default: 1e-3 for Stage D convergence).",
    )
    parser.add_argument(
        "--pnudp_dense_logit_proj_init",
        type=str,
        default="normal",
        choices=["zero", "normal", "mean"],
        help="Initialization mode for logit_proj.weight: zero / normal(N(0,init_std)) / mean(all=1/K*init_std). Default: normal (Stage D convergence).",
    )
    parser.add_argument(
        "--pnudp_dense_logit_proj_init_std",
        type=float,
        default=1e-3,
        help="Standard deviation for logit_proj init modes (normal/mean). For 'mean': init_value = 1/num_prompts * init_std. Default: 1e-3 (Stage D convergence).",
    )
    parser.add_argument(
        "--pnudp_dense_num_mask_channels",
        type=int,
        default=3,
        help="Number of output channels for PNuDP dense logit_proj. "
             "When >1 (e.g., 3), produces channel-specific bias that directly matches "
             "merged_logits channels without broadcasting. Default: 3 (Stage D convergence).",
    )
    parser.add_argument(
        "--pnudp_dense_apply_in_eval",
        type=str2bool,
        default=True,
        help="Apply PNuDP dense fusion during eval() mode (default: True for Stage D convergence). "
             "When True, low_res_logits will contain fused logits even in model.eval().",
    )
    # ── SGA-SB v1 CORRECTION: Spatial Granularity-Aligned Structure/Boundary Guidance ──
    parser.add_argument(
        "--spatial_sb_mode",
        type=str,
        default="none",
        choices=["none", "supervision_only", "guidance"],
        help="SGA-SB spatial guidance mode. 'none' = disabled. "
             "'supervision_only' = predict structure/boundary maps + compute losses, NO feature injection. "
             "'guidance' = predict + losses + inject gamma-scaled deltas into FreqPathASRBlock. Default: none.",
    )
    parser.add_argument(
        "--spatial_sb_branch",
        type=str,
        default="both",
        choices=["structure", "boundary", "both"],
        help="Which spatial SB branch to enable. 'structure' = structure head only, "
             "'boundary' = boundary head only, 'both' = both heads. Default: both.",
    )
    parser.add_argument(
        "--spatial_structure_loss_weight",
        type=float,
        default=0.1,
        help="Loss weight for structure occupancy map (SmoothL1). Default: 0.1.",
    )
    parser.add_argument(
        "--spatial_boundary_loss_weight",
        type=float,
        default=0.1,
        help="Loss weight for instance boundary map (BCE+Dice). Default: 0.1.",
    )
    parser.add_argument(
        "--spatial_structure_guidance_init",
        type=float,
        default=0.05,
        help="Initial value for gamma_structure parameter (guidance strength). Default: 0.05.",
    )
    parser.add_argument(
        "--spatial_boundary_guidance_init",
        type=float,
        default=0.05,
        help="Initial value for gamma_boundary parameter (guidance strength). Default: 0.05.",
    )
    parser.add_argument(
        "--spatial_instance_attr_mode",
        type=str,
        default="none",
        choices=["none", "v1"],
        help="(Legacy ablation) Enable old SpatialInstanceAttrHead 18ch morphology attribute mode. "
             "'none' = disabled, 'v1' = use legacy SpatialAttrHead (6 attrs × 3 classes). Default: none.",
    )
    # ── Audit / Logging Control ──────────────────────────────────────────
    parser.add_argument(
        "--audit_mode",
        type=str,
        default="basic",
        choices=["off", "basic", "debug"],
        help="Audit log verbosity for Stage D training. "
             "'off' = silent (errors only), 'basic' = essential startup/metrics only, "
             "'debug' = full debug/audit output (default: basic).",
    )
    parser.add_argument(
        "--pnudp_audit_interval",
        type=int,
        default=0,
        help="Batch interval for debug audit prints in PNuDP dense training. "
             "0 = only batch 0; N = every N-th batch (default: 0). "
             "Only effective when --audit_mode debug.",
    )
    parser.add_argument(
        "--numeric_attr_audit_interval",
        type=int,
        default=5,
        help="Batch interval for NUMERIC_ATTR_FREQPATH_TRAIN_AUDIT prints. "
             "0 = only batch 0; N = every N-th batch (default: 5). "
             "Only effective when --enable_numeric_attr_freqpath_guidance is set.",
    )

    args = parser.parse_args()

    if args.attr_weight is not None:
        args.pnurl_weight = args.attr_weight
    if args.pnurl_loss_weight is not None:
        args.pnurl_weight = args.pnurl_loss_weight
    if args.density_loss_weight is not None:
        args.density_map_weight = args.density_loss_weight


    if args.asr_regression:
        if args.phase != "vision":
            raise ValueError("--asr_regression can only be used with --phase vision.")
        args.use_asr = True
        args.use_pnurl = False
        args.use_coop = False
        args.prompt_mode = "base"
        args.eval_prompt_mode = "base"
        # 先排除 bf16/AMP 对 HV/heatmap 回归的干扰。
        args.use_amp = False

    if args.cnn_lr_ratio is None:
        args.cnn_lr_ratio = 0.1 if args.asr_regression else 0.5
    if args.prompt_generator_lr_mult is None:
        args.prompt_generator_lr_mult = 5.0 if args.asr_regression else 1.0
    if args.adapter_lr_ratio is None:
        args.adapter_lr_ratio = 1.0 if args.asr_regression else 0.1

    args.architecture_version = ARCHITECTURE_VERSION
    return args


# ==================================================================================================
# 2. Generic utilities and post-processing
# ==================================================================================================
def setup_seed(seed):
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    np.random.seed(seed)
    random.seed(seed)
    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = True


def to_device(batch_input, device):
    device_input = {}
    for key, value in batch_input.items():
        if value is None:
            device_input[key] = value
        elif isinstance(value, torch.Tensor):
            device_input[key] = value.to(device, non_blocking=True)
        elif isinstance(value, list):
            device_input[key] = value
        else:
            device_input[key] = value
    return device_input


def resize_pos_embed(state_dict, model_state_dict):
    new_state_dict = {}
    for k, v in state_dict.items():
        if k in model_state_dict:
            if v.shape != model_state_dict[k].shape:
                if "pos_embed" in k:
                    v = v.permute(0, 3, 1, 2)
                    v = F.interpolate(v, size=model_state_dict[k].shape[1:3], mode="bicubic", align_corners=False)
                    v = v.permute(0, 2, 3, 1)
                elif "rel_pos" in k:
                    v = v.unsqueeze(0).permute(0, 2, 1)
                    target_len = model_state_dict[k].shape[0]
                    v = F.interpolate(v, size=target_len, mode="linear", align_corners=False)
                    v = v.permute(0, 2, 1).squeeze(0)
            new_state_dict[k] = v
        else:
            new_state_dict[k] = v
    return new_state_dict



def filter_checkpoint_state_dict_for_model(
    state_dict: Dict[str, torch.Tensor],
    model_state_dict: Dict[str, torch.Tensor],
    skip_prefixes: Tuple[str, ...] = (),
    filter_mismatch: bool = True,
) -> Tuple[Dict[str, torch.Tensor], Dict[str, int], List[Tuple[str, Tuple[int, ...], Tuple[int, ...]]]]:
    """Filter checkpoint tensors before load_state_dict.

    Why this is needed:
        load_state_dict(strict=False) ignores missing/unexpected keys, but shape-mismatched keys
        can still raise RuntimeError. PNuRL-v3 changes several parameter shapes, so old PNuRL
        checkpoints must be filtered before loading.

    Returns:
        filtered_state_dict:
            Tensor dict safe to pass to model.load_state_dict(..., strict=False).

        stats:
            loaded / skipped_prefix / skipped_mismatch / skipped_missing counts.

        mismatch_examples:
            Up to 20 examples of shape-mismatched keys for logging.
    """
    filtered = {}
    stats = {
        "loaded": 0,
        "skipped_prefix": 0,
        "skipped_mismatch": 0,
        "skipped_missing": 0,
    }
    mismatch_examples = []

    for k, v in state_dict.items():
        if skip_prefixes and any(k.startswith(prefix) for prefix in skip_prefixes):
            stats["skipped_prefix"] += 1
            continue

        if k not in model_state_dict:
            # Missing-from-current-model is fine under strict=False.
            filtered[k] = v
            stats["skipped_missing"] += 1
            continue

        target = model_state_dict[k]

        if filter_mismatch and hasattr(v, "shape") and hasattr(target, "shape"):
            if tuple(v.shape) != tuple(target.shape):
                stats["skipped_mismatch"] += 1
                if len(mismatch_examples) < 20:
                    mismatch_examples.append((k, tuple(v.shape), tuple(target.shape)))
                continue

        filtered[k] = v
        stats["loaded"] += 1

    return filtered, stats, mismatch_examples


def hover_post_process(prob_map, hv_map, prob_thresh=0.45, marker_thresh=0.4, min_marker_size=10):
    mask = prob_map > prob_thresh
    if not np.any(mask):
        return np.zeros_like(mask, dtype=np.int32)

    v_map = hv_map[0].astype(np.float32)
    h_map = hv_map[1].astype(np.float32)
    diff_v = np.gradient(v_map, axis=0)
    diff_h = np.gradient(h_map, axis=1)
    sobel_mag = np.sqrt(diff_v ** 2 + diff_h ** 2)

    marker_map = prob_map - sobel_mag
    marker_map = (marker_map > marker_thresh) & mask
    marker_map = remove_small_objects(marker_map, min_size=min_marker_size)
    markers = skimage_label(marker_map).astype(np.int32)
    inst_map = watershed(-prob_map, markers, mask=mask)
    return inst_map.astype(np.int32)


def unwrap_model(model):
    return model.module if hasattr(model, "module") else model


def set_requires_grad(module: Optional[nn.Module], flag: bool):
    if module is None:
        return
    for p in module.parameters():
        p.requires_grad = flag


def set_named_requires_grad(module: Optional[nn.Module], flag: bool, include_keywords: Iterable[str]):
    if module is None:
        return
    include_keywords = tuple(include_keywords)
    for name, p in module.named_parameters():
        if any(key in name for key in include_keywords):
            p.requires_grad = flag


def set_semantic_gate_state(raw_model: nn.Module, stage: str, open_value: float = -3.0):
    close_value = -12.0
    warm_value = -10.0
    gate_trainable = stage == "semantic_injection"

    pnurl = getattr(raw_model, "pnurl", None)

    if pnurl is not None and hasattr(pnurl, "residual_gate"):
        gate = pnurl.residual_gate
        if isinstance(gate, torch.nn.Parameter):
            with torch.no_grad():
                if stage == "vision":
                    gate.fill_(close_value)
                elif stage == "pnurl_warmup":
                    gate.fill_(warm_value)
                elif stage == "semantic_injection":
                    gate.fill_(open_value)
            gate.requires_grad = gate_trainable

    gate_modules = []
    if pnurl is not None and hasattr(pnurl, "semantic_channel_gate"):
        gate_modules.append(pnurl.semantic_channel_gate)

    for module_name in (
        "semantic_channel_gate",
        "channel_gate",
        "semantic_gate",
        "semantic_injection_gate",
    ):
        gate_module = getattr(raw_model, module_name, None)
        if gate_module is not None:
            gate_modules.append(gate_module)

    seen_gate_ids = set()
    for gate_module in gate_modules:
        if id(gate_module) in seen_gate_ids:
            continue
        seen_gate_ids.add(id(gate_module))

        set_requires_grad(gate_module, gate_trainable)

        if hasattr(gate_module, "reset_to_closed") and stage in ("vision", "pnurl_warmup"):
            gate_module.reset_to_closed()

        if hasattr(gate_module, "gate"):
            try:
                final_layer = gate_module.gate[-1]
                if hasattr(final_layer, "bias") and final_layer.bias is not None:
                    with torch.no_grad():
                        if stage == "vision":
                            final_layer.bias.fill_(close_value)
                        elif stage == "pnurl_warmup":
                            final_layer.bias.fill_(warm_value)
                        elif stage == "semantic_injection":
                            final_layer.bias.fill_(open_value)
            except Exception:
                pass

    raw_model.training_stage = stage
    raw_model.semantic_injection_enabled = gate_trainable


# ==================================================================================================
# 3. Stage policy and optimizer routing
# ==================================================================================================
def apply_stage_policy(model: nn.Module, stage: str, args=None, logger=None, rank: int = 0):
    if stage not in VALID_STAGES:
        raise ValueError(f"Invalid stage: {stage}. Expected one of {VALID_STAGES}.")

    raw_model = unwrap_model(model)

    set_requires_grad(raw_model, False)
    set_requires_grad(getattr(raw_model, "clip_model", None), False)
    set_requires_grad(getattr(raw_model, "prompt_encoder", None), False)

    if getattr(args, "asr_regression", False):
        if hasattr(raw_model, "use_pnurl"):
            raw_model.use_pnurl = False
        if hasattr(raw_model, "use_coop"):
            raw_model.use_coop = False
    else:
        # ── PNuRL: respect constructor config, do NOT auto-enable based on stage ──
        if hasattr(raw_model, "use_pnurl"):
            _pnurl_config = bool(getattr(raw_model, "use_pnurl_config", getattr(args, "use_pnurl", False)))
            _has_pnurl_module = hasattr(raw_model, "pnurl")
            _old_runtime = bool(getattr(raw_model, "use_pnurl", False))
            raw_model.use_pnurl = bool(_pnurl_config and _has_pnurl_module)
            # One-time audit
            global _PNURL_STAGE_POLICY_PRINTED
            if not _PNURL_STAGE_POLICY_PRINTED:
                print(
                    f"\n[PNURL_STAGE_POLICY]\n"
                    f"  phase={stage}\n"
                    f"  args_use_pnurl={bool(getattr(args, 'use_pnurl', False))}\n"
                    f"  has_pnurl_module={_has_pnurl_module}\n"
                    f"  old_runtime_use_pnurl={_old_runtime}\n"
                    f"  new_runtime_use_pnurl={raw_model.use_pnurl}\n"
                    f"  use_pnurl_config={_pnurl_config}\n"
                    f"  stage_auto_override=False\n"
                    f"  reason=respect_constructor_config\n",
                    flush=True,
                )
                _PNURL_STAGE_POLICY_PRINTED = True
        if hasattr(raw_model, "use_coop"):
            raw_model.use_coop = stage == "semantic_injection" and hasattr(raw_model, "prompt_learner")
        # Phase B / C: disable PNuRL/CoOp — only multilevel attribute or alignment heads train
        if stage in ("multilevel_attr_warmup", "semantic_alignment"):
            if hasattr(raw_model, "use_pnurl"):
                raw_model.use_pnurl = False
            if hasattr(raw_model, "use_coop"):
                raw_model.use_coop = False

    if stage == "vision":
        freeze_decoder = (
            args is not None
            and getattr(args, "asr_regression", False)
            and getattr(args, "asr_regression_stage", "finetune_decoder") == "freeze_decoder"
        )

        set_requires_grad(getattr(raw_model, "mask_decoder", None), not freeze_decoder)
        set_requires_grad(getattr(raw_model, "prompt_generator", None), True)
        set_requires_grad(getattr(raw_model, "basic_hv_head", None), True)

        if getattr(raw_model, "use_asr", False):
            set_requires_grad(getattr(raw_model, "cnn_stage0", None), True)
            set_requires_grad(getattr(raw_model, "cnn_stage1", None), True)
            set_requires_grad(getattr(raw_model, "cnn_stage2", None), True)
            set_requires_grad(getattr(raw_model, "global_asr_upsampler", None), True)

        if args is not None and getattr(args, "encoder_adapter", False):
            set_named_requires_grad(getattr(raw_model, "image_encoder", None), True, include_keywords=("Adapter", "adapter"))

        set_semantic_gate_state(raw_model, stage)
        if args is not None and getattr(args, "asr_regression", False):
            msg = (
                f"[ASR regression: {getattr(args, 'asr_regression_stage', 'finetune_decoder')}] "
                "Pure-visual legacy ASR. PNuRL/CoOp/OT disabled. "
                "Use base prompt and recover SamMed2D+ResNet+ASR baseline first."
            )
        else:
            msg = "[Stage A: vision] Train mask decoder / prompt generator / HV-ASR / image adapters. Freeze PNuRL and CoOp."

    elif stage == "pnurl_warmup":
        set_requires_grad(getattr(raw_model, "pnurl", None), True)
        set_requires_grad(getattr(raw_model, "prompt_learner", None), False)
        set_semantic_gate_state(raw_model, stage)
        msg = "[Stage B: pnurl_warmup] Train PNuRL only. No segmentation loss is routed to PNuRL. Gate remains closed."

    elif stage == "multilevel_attr_warmup":
        # Phase B: train MultiLevelAttributeHeads (3 submodules) and StructureBoundaryAttrHeads
        set_requires_grad(getattr(raw_model, "multilevel_attr_heads", None), True)
        set_requires_grad(getattr(raw_model, "structure_boundary_attr_heads", None), True)
        set_semantic_gate_state(raw_model, stage)
        msg = (
            "[Phase B: multilevel_attr_warmup] Train MultiLevelAttributeHeads + "
            "StructureBoundaryAttrHeads. All other params frozen."
        )

    elif stage == "semantic_injection":
        set_requires_grad(getattr(raw_model, "pnurl", None), True)
        set_requires_grad(getattr(raw_model, "prompt_learner", None), True)
        set_requires_grad(getattr(raw_model, "prompt_generator", None), True)
        set_requires_grad(getattr(raw_model, "mask_decoder", None), True)
        set_requires_grad(getattr(raw_model, "basic_hv_head", None), True)

        if getattr(raw_model, "use_asr", False):
            set_requires_grad(getattr(raw_model, "global_asr_upsampler", None), True)
            set_requires_grad(getattr(raw_model, "cnn_stage0", None), True)
            set_requires_grad(getattr(raw_model, "cnn_stage1", None), True)
            set_requires_grad(getattr(raw_model, "cnn_stage2", None), True)

        if (
            args is not None
            and getattr(args, "encoder_adapter", False)
            and getattr(args, "stage_c_train_image_adapter", False)
        ):
            set_named_requires_grad(getattr(raw_model, "image_encoder", None), True, include_keywords=("Adapter", "adapter"))

        set_semantic_gate_state(raw_model, stage, open_value=args.semantic_gate_open_value)

        # ── PromptNu-lite v2: unfreeze attr_align projection heads ──
        if args is not None and getattr(args, "enable_promptnu_lite_align", False):
            _pnl_aa_names = (
                "attr_align_vis_proj_structure",
                "attr_align_vis_proj_boundary",
                "attr_align_vis_proj_instance",
                "attr_align_text_proj",
            )
            for _name in _pnl_aa_names:
                _mod = getattr(raw_model, _name, None)
                if _mod is not None:
                    set_requires_grad(_mod, True)
            if rank == 0:
                print(
                    "[PHASE_D_PROMPTNU_LITE] attr_align projection heads unfrozen "
                    "for PromptNu-lite v2 residual-coupled alignment.",
                    flush=True,
                )

        # ── Phase D: PromptNu-guided v3 modules (adapter + projection heads) ──
        if args is not None and getattr(args, "enable_promptnu_guided_v3", False):
            _v3_phase_d_names = (
                "promptnu_guided_adapter",
                "promptnu_guided_v3_vis_proj",
                "promptnu_guided_v3_struct_text_proj",
                "promptnu_guided_v3_boundary_text_proj",
            )
            _v3_n_unfrozen = 0
            for _v3_name in _v3_phase_d_names:
                _v3_mod = getattr(raw_model, _v3_name, None)
                if _v3_mod is not None:
                    set_requires_grad(_v3_mod, True)
                    _v3_n_unfrozen += 1
            if rank == 0:
                print(
                    f"[PHASE_D_PROMPTNU_GUIDED_V3] unfrozen {_v3_n_unfrozen}/{len(_v3_phase_d_names)} "
                    f"v3 modules for Phase D training.",
                    flush=True,
                )

        # ── Phase D trainable audit ──
        if rank == 0:
            _trainable_d = [(n, p) for n, p in raw_model.named_parameters() if p.requires_grad]
            _trainable_numel_d = sum(p.numel() for _, p in _trainable_d)
            _sample_names_d = [n for n, _ in _trainable_d[:10]]
            print(
                f"[PHASE_D_TRAINABLE_AUDIT] trainable_numel={_trainable_numel_d}",
                flush=True,
            )
            print(
                f"[PHASE_D_TRAINABLE_AUDIT] sample_trainable_names={_sample_names_d}",
                flush=True,
            )
            # ── [PROMPTNU_GUIDED_V3_GRAPH_AUDIT][params] detailed PG3 param audit ──
            if getattr(args, "enable_promptnu_guided_v3", False):
                _v3_audit_module_names = (
                    "promptnu_guided_adapter",
                    "promptnu_guided_v3_vis_proj",
                    "promptnu_guided_v3_struct_text_proj",
                    "promptnu_guided_v3_boundary_text_proj",
                )
                print(f"\n[PROMPTNU_GUIDED_V3_GRAPH_AUDIT][params]", flush=True)
                for _mod_name in _v3_audit_module_names:
                    _mod = getattr(raw_model, _mod_name, None)
                    if _mod is None:
                        print(f"  {_mod_name}: module=None", flush=True)
                        continue
                    _all_params = list(_mod.named_parameters())
                    _req_grad = sum(1 for _, p in _all_params if p.requires_grad)
                    _total = len(_all_params)
                    _n_params = sum(p.numel() for _, p in _all_params)
                    print(
                        f"  {_mod_name} requires_grad_params={_req_grad}/{_total} "
                        f"total_params={_n_params}",
                        flush=True,
                    )

        # ── Numeric Attr → FreqPath Proj (Exp5): unfreeze after all freeze logic ──
        if args is not None and getattr(args, "enable_numeric_attr_freqpath_guidance", False):
            _numeric_proj = getattr(raw_model, "numeric_attr_freqpath_proj", None)
            if _numeric_proj is not None:
                for p in _numeric_proj.parameters():
                    p.requires_grad_(True)
                if rank == 0:
                    _n_tensors = sum(1 for _ in _numeric_proj.parameters())
                    print(
                        f"[PHASE_D_NUMERIC_ATTR_FREQPATH] numeric_attr_freqpath_proj unfrozen "
                        f"({_n_tensors} param tensors).",
                        flush=True,
                    )

        # ── NUMERIC_ATTR_FREQPATH_REQUIRES_GRAD_AUDIT ──
        if rank == 0 and args is not None and getattr(args, "enable_numeric_attr_freqpath_guidance", False):
            _na_proj = getattr(raw_model, "numeric_attr_freqpath_proj", None)
            if _na_proj is not None:
                _na_all_params = list(_na_proj.named_parameters())
                _na_req_grad = [(n, p) for n, p in _na_all_params if p.requires_grad]
                _na_total_tensors = len(_na_all_params)
                _na_req_tensors = len(_na_req_grad)
                _na_total_numel = sum(p.numel() for _, p in _na_all_params)
                _na_req_numel = sum(p.numel() for _, p in _na_req_grad)
                _na_preview = [
                    f"{n}, requires_grad={p.requires_grad}, shape={list(p.shape)}"
                    for n, p in _na_all_params[:6]
                ]
                print(
                    f"\n[NUMERIC_ATTR_FREQPATH_REQUIRES_GRAD_AUDIT]\n"
                    f"  phase={stage}\n"
                    f"  enabled={getattr(args, 'enable_numeric_attr_freqpath_guidance', False)}\n"
                    f"  module_exists={_na_proj is not None}\n"
                    f"  total_param_tensors={_na_total_tensors}\n"
                    f"  requires_grad_param_tensors={_na_req_tensors}\n"
                    f"  total_numel={_na_total_numel}\n"
                    f"  requires_grad_numel={_na_req_numel}\n"
                    f"  param_names_preview={_na_preview}",
                    flush=True,
                )

        # Build msg suffix — reflect PromptNu-lite v2 status in the policy log message
        _msg_suffix = ""
        if args is not None and getattr(args, "enable_promptnu_lite_align", False):
            _msg_suffix = " attr_align projection heads trainable (PromptNu-lite v2)."
        if args is not None and getattr(args, "enable_promptnu_guided_v3", False):
            if _msg_suffix:
                _msg_suffix += " | "
            _msg_suffix += "PG3 adapter + 3 proj heads trainable."
        msg = (
            "[Phase D: semantic_injection] Segmentation + semantic injection. "
            "Gate open, PNuRL/CoOp/decoder/HV/all trainable."
            f"{_msg_suffix} "
            "Image adapters stay frozen unless --stage_c_train_image_adapter is set."
        )

    elif stage == "semantic_alignment":
        # Phase C semantic_alignment: only 4 attr_align projection heads are trainable.
        _attr_align_names = (
            "attr_align_vis_proj_structure",
            "attr_align_vis_proj_boundary",
            "attr_align_vis_proj_instance",
            "attr_align_text_proj",
        )
        _n_unfrozen = 0
        for _name in _attr_align_names:
            _mod = getattr(raw_model, _name, None)
            if _mod is not None:
                set_requires_grad(_mod, True)
                _n_unfrozen += 1
        set_semantic_gate_state(raw_model, stage)

        # Audit: verify at least one attr_align head was unfrozen
        _trainable_align = [
            n for n, p in raw_model.named_parameters()
            if p.requires_grad and any(a in n for a in _attr_align_names)
        ]
        _trainable_numel = sum(p.numel() for n, p in raw_model.named_parameters()
                              if p.requires_grad and any(a in n for a in _attr_align_names))
        if _trainable_numel == 0:
            raise RuntimeError(
                "[PHASE_C_TRAINABLE_ERROR] semantic_alignment expected attr_align projection heads, "
                "but none were found trainable. Check that:\n"
                "  1. TextSam.__init__() created self.attr_align_vis_proj_{structure,boundary,instance}\n"
                "     and self.attr_align_text_proj (gated by enable_attr_text_alignment).\n"
                "  2. --enable_attr_text_alignment is True (auto-enabled for semantic_alignment phase).\n"
                "  3. The model's named_parameters() contains 'attr_align_vis_proj_*.weight' etc.\n"
                f"  unfrozen_heads={_n_unfrozen} | trainable_align_numel={_trainable_numel}"
            )
        if rank == 0:
            print(
                f"[PHASE_C_TRAINABLE_AUDIT] trainable_align_heads={_n_unfrozen}/4 | "
                f"trainable_numel={_trainable_numel}",
                flush=True,
            )
            print(
                f"[PHASE_C_TRAINABLE_AUDIT] sample_trainable_names={_trainable_align[:8]}",
                flush=True,
            )

        msg = (
            "[Phase C: semantic_alignment] Only 4 attr_align projection heads trainable. "
            f"Unfrozen {_n_unfrozen}/4 heads ({_trainable_numel:,} params). "
            "All other parameters frozen. Use --attr_text_lr to set LR."
        )

    elif stage == "pnudp_dense_train":
        # Stage D PNuDP dense training: only pnudp_dense_train module is trainable.
        # Freeze everything first (already done above), then unfreeze pnudp_dense_train.
        _pnudp_mod = getattr(raw_model, "pnudp_dense_train", None)
        if _pnudp_mod is not None:
            set_requires_grad(_pnudp_mod, True)
            _n_trainable = sum(p.numel() for p in _pnudp_mod.parameters() if p.requires_grad)
            if rank == 0:
                print(
                    f"[PNUDP_DENSE_TRAIN_POLICY] pnudp_dense_train unfrozen | "
                    f"trainable_params={_n_trainable}",
                    flush=True,
                )
        else:
            if rank == 0:
                print(
                    "[PNUDP_DENSE_TRAIN_POLICY] WARNING: pnudp_dense_train module is None. "
                    "Check that --enable_pnudp_dense_train=True was passed to model builder.",
                    flush=True,
                )

        msg = (
            "[Stage D: pnudp_dense_train] Train only PNuDP dense modules "
            "(pnudp_dense_proj, pnudp_logit_proj, dense_alpha). "
            "All other parameters frozen. Use --pnudp_dense_lr to set LR."
        )

    # SGA-SB is an opt-in auxiliary segmentation path layered onto the selected
    # existing stage. mode=none leaves the historical trainable set untouched.
    _sga_mode = str(getattr(args, "spatial_sb_mode", "none")) if args is not None else "none"
    _sga_branch = str(getattr(args, "spatial_sb_branch", "both")) if args is not None else "both"
    _sga_active_names = []
    if _sga_mode != "none":
        _use_structure = _sga_branch in ("structure", "both")
        _use_boundary = _sga_branch in ("boundary", "both")
        if _use_structure:
            set_requires_grad(getattr(raw_model, "spatial_structure_head", None), True)
            _sga_active_names.append("spatial_structure_head")
        if _use_boundary:
            set_requires_grad(getattr(raw_model, "spatial_boundary_head", None), True)
            _sga_active_names.append("spatial_boundary_head")
        if _sga_mode == "guidance":
            if _use_structure:
                set_requires_grad(getattr(raw_model, "spatial_structure_adapter", None), True)
                _gamma_structure = getattr(raw_model, "gamma_structure", None)
                if _gamma_structure is not None:
                    _gamma_structure.requires_grad_(True)
                _sga_active_names.extend(("spatial_structure_adapter", "gamma_structure"))
            if _use_boundary:
                set_requires_grad(getattr(raw_model, "spatial_boundary_adapter", None), True)
                _gamma_boundary = getattr(raw_model, "gamma_boundary", None)
                if _gamma_boundary is not None:
                    _gamma_boundary.requires_grad_(True)
                _sga_active_names.extend(("spatial_boundary_adapter", "gamma_boundary"))

        _sga_trainable = [
            (name, param) for name, param in raw_model.named_parameters()
            if param.requires_grad and (
                name.startswith("spatial_structure_head.")
                or name.startswith("spatial_boundary_head.")
                or name.startswith("spatial_structure_adapter.")
                or name.startswith("spatial_boundary_adapter.")
                or name in ("gamma_structure", "gamma_boundary")
            )
        ]
        _sga_all = [
            (name, param) for name, param in raw_model.named_parameters()
            if name.startswith("spatial_structure_head.")
            or name.startswith("spatial_boundary_head.")
            or name.startswith("spatial_structure_adapter.")
            or name.startswith("spatial_boundary_adapter.")
            or name in ("gamma_structure", "gamma_boundary")
        ]
        _sga_frozen_inactive = sum(param.numel() for _, param in _sga_all if not param.requires_grad)
        _sga_trainable_numel = sum(param.numel() for _, param in _sga_trainable)
        _sga_msg = (
            f"[SGA_SB_STAGE_POLICY] mode={_sga_mode} | branch={_sga_branch} | "
            f"trainable_module={_sga_active_names} | trainable_param_count={_sga_trainable_numel} | "
            f"frozen_inactive_param_count={_sga_frozen_inactive}"
        )
        if rank == 0:
            if logger is not None:
                logger.info(_sga_msg)
            else:
                print(_sga_msg, flush=True)

    if rank == 0 and logger is not None:
        logger.info(f"FREQPATH_ABLATION={os.environ.get('FREQPATH_ABLATION', 'both')}")

    if rank == 0 and logger is not None:
        trainable = sum(p.numel() for p in raw_model.parameters() if p.requires_grad)
        total = sum(p.numel() for p in raw_model.parameters())
        logger.info(msg)
        logger.info(f"Trainable parameters: {trainable:,} / {total:,} ({trainable / max(total, 1):.2%})")

    return raw_model


ATTRIBUTE_LOGIT_KEYS = ("color", "shape", "arrange", "size", "density")
ATTRIBUTE_LOG_DISPLAY = {
    "color": "C",
    "shape": "Sh",
    "arrange": "Ar",
    "size": "Sz",
    "density": "De",
}


ATTRIBUTE_LOSS_KEYS = {
    "color": ("pnurl_loss_color", "pnurl_attr_loss_color", "loss_color"),
    "shape": ("pnurl_loss_shape", "pnurl_attr_loss_shape", "loss_shape"),
    "arrange": ("pnurl_loss_arrange", "pnurl_attr_loss_arrange", "loss_arrange", "pnurl_loss_arrangement"),
    "size": ("pnurl_loss_size", "pnurl_attr_loss_size", "loss_size"),
    "density": ("pnurl_loss_density", "pnurl_attr_loss_density", "loss_density"),
}


def _get_pnurl_submodule(model: nn.Module) -> Optional[nn.Module]:
    raw_model = unwrap_model(model)
    return getattr(raw_model, "pnurl", None)


def _infer_attr_class_counts_from_knowledge(knowledge_path: str, split: str = "train", silent: bool = False) -> Optional[Dict[str, List[float]]]:
    """
    Infer per-attribute class counts from medical_knowledge_v2.json.

    Expected label order:
        [color, shape, arrangement/arrange, size, density]
    
    When silent=True, [DEBUG] prints are suppressed (used in Stage D to avoid
    polluting mainline output).
    """
    def _dbg(msg: str):
        if not silent:
            print(msg, flush=True)

    if not knowledge_path:
        _dbg("[DEBUG] attr count failed: empty knowledge_path")
        return None

    knowledge_path = os.path.expanduser(str(knowledge_path))

    if not os.path.exists(knowledge_path):
        _dbg(f"[DEBUG] attr count failed: path does not exist: {knowledge_path}")
        return None

    try:
        with open(knowledge_path, "r", encoding="utf-8") as f:
            db = json.load(f)
    except Exception as exc:
        _dbg(f"[DEBUG] attr count failed: json load error: {exc}")
        return None

    attr_names = ["color", "shape", "arrange", "size", "density"]

    counts = {
        "color": [0.0, 0.0],
        "shape": [0.0, 0.0, 0.0],
        "arrange": [0.0, 0.0],
        "size": [0.0, 0.0, 0.0],
        "density": [0.0, 0.0, 0.0],
    }

    desired_split = None if split is None else str(split).lower().strip()

    scanned = 0
    split_hit = 0
    label_hit = 0
    bad_label = 0

    split_counter = {}

    for sample_key, entry in db.items():
        if sample_key == "__meta__" or not isinstance(entry, dict):
            continue

        scanned += 1

        entry_split = entry.get("split", None)
        if entry_split is None:
            entry_split = str(sample_key).replace("\\", "/").split("/")[0]

        entry_split = str(entry_split).lower().strip()
        split_counter[entry_split] = split_counter.get(entry_split, 0) + 1

        if desired_split is not None and entry_split != desired_split:
            continue

        split_hit += 1

        labels = entry.get("attr_labels", None)
        if labels is None:
            labels = entry.get("labels", None)

        if labels is None:
            bad_label += 1
            continue

        if isinstance(labels, dict):
            labels = [
                labels.get("color", None),
                labels.get("shape", None),
                labels.get("arrange", labels.get("arrangement", None)),
                labels.get("size", None),
                labels.get("density", None),
            ]

        try:
            labels = list(labels)
        except Exception:
            bad_label += 1
            continue

        if len(labels) < 5:
            bad_label += 1
            continue

        clean_labels = []
        ok = True

        for x in labels[:5]:
            try:
                clean_labels.append(int(x))
            except Exception:
                ok = False
                break

        if not ok:
            bad_label += 1
            continue

        label_hit += 1

        for idx, attr_name in enumerate(attr_names):
            cls = int(clean_labels[idx])

            if cls == 255 or cls < 0:
                continue

            if cls >= len(counts[attr_name]):
                counts[attr_name].extend([0.0] * (cls + 1 - len(counts[attr_name])))

            counts[attr_name][cls] += 1.0

    if label_hit <= 0:
        _dbg(
            "[DEBUG] attr count failed | "
            f"path={knowledge_path} | "
            f"desired_split={desired_split} | "
            f"scanned={scanned} | "
            f"split_counter={split_counter} | "
            f"split_hit={split_hit} | "
            f"label_hit={label_hit} | "
            f"bad_label={bad_label}"
        )
        return None

    for attr_name in counts:
        counts[attr_name] = [max(1.0, float(x)) for x in counts[attr_name]]

    _dbg(
        "[DEBUG] attr count success | "
        f"path={knowledge_path} | "
        f"desired_split={desired_split} | "
        f"scanned={scanned} | "
        f"split_counter={split_counter} | "
        f"split_hit={split_hit} | "
        f"label_hit={label_hit} | "
        f"bad_label={bad_label}"
    )

    return counts


def configure_pnurl_class_counts(model: nn.Module, args, logger=None, rank: int = 0, phase: str = ""):
    """Pass true train-split attr class counts to PNuRL-v3 if supported.
    
    In Stage D (pnudp_dense_train), medical_knowledge attr class count logging
    is silenced to avoid polluting mainline output.
    """
    pnurl = _get_pnurl_submodule(model)
    _is_stage_d = (phase == "pnudp_dense_train")

    if pnurl is None:
        if rank == 0 and logger is not None and not _is_stage_d:
            logger.info("PNuRL attr class counts: skipped because model has no pnurl module.")
        return

    if not hasattr(pnurl, "set_attr_class_counts"):
        if rank == 0 and logger is not None and not _is_stage_d:
            logger.info("PNuRL attr class counts: module does not expose set_attr_class_counts(); using defaults.")
        return

    knowledge_path = getattr(args, "knowledge_path", "")

    counts = _infer_attr_class_counts_from_knowledge(knowledge_path, split="train", silent=_is_stage_d)

    if counts is None:
        if rank == 0 and logger is not None and not _is_stage_d:
            logger.info(f"PNuRL attr class counts: not found in {knowledge_path}; using module defaults.")
        return

    try:
        pnurl.set_attr_class_counts(counts)

        if rank == 0 and logger is not None and not _is_stage_d:
            logger.info(f"PNuRL attr class counts loaded from knowledge file: {counts}")

    except Exception as exc:
        if rank == 0 and logger is not None and not _is_stage_d:
            logger.warning(f"Failed to configure PNuRL attr class counts with dict counts: {exc}")

        try:
            ordered_counts = [
                counts["color"],
                counts["shape"],
                counts["arrange"],
                counts["size"],
                counts["density"],
            ]

            pnurl.set_attr_class_counts(ordered_counts)

            if rank == 0 and logger is not None:
                logger.info(f"PNuRL attr class counts loaded as ordered list: {ordered_counts}")

        except Exception as exc2:
            if rank == 0 and logger is not None:
                logger.warning(f"Failed to configure PNuRL attr class counts with ordered list: {exc2}")

def _get_output_scalar(out: Dict, candidates: Tuple[str, ...], device: torch.device) -> torch.Tensor:
    for key in candidates:
        value = out.get(key, None)
        if value is None:
            continue
        if torch.is_tensor(value):
            return value.to(device=device).float().mean()
        try:
            return torch.tensor(float(value), device=device)
        except Exception:
            continue
    return torch.tensor(float("nan"), device=device)


def _compute_attr_ce_loss_for_logging(
    out: Dict,
    attr_label,
    attr_key: str,
    attr_index: int,
    device: torch.device,
) -> torch.Tensor:
    """Fallback per-attribute CE loss for logging.

    TextSam may not propagate PNuRL-v3's pnurl_loss_shape / pnurl_loss_size fields.
    This helper computes a diagnostic CE directly from out["attr_logits"] and the
    sample's attr_labels so AttrLoss no longer becomes nan.
    """
    attr_logits = out.get("attr_logits", None)
    if not isinstance(attr_logits, dict):
        return torch.tensor(float("nan"), device=device)

    logits = attr_logits.get(attr_key, None)
    if logits is None or not torch.is_tensor(logits):
        return torch.tensor(float("nan"), device=device)

    label = _as_attr_label_tensor(attr_label, device=device)
    if label is None or label.numel() <= attr_index:
        return torch.tensor(float("nan"), device=device)

    if logits.dim() == 1:
        logits = logits.unsqueeze(0)
    if logits.dim() < 2 or logits.shape[0] < 1:
        return torch.tensor(float("nan"), device=device)

    target = int(label[attr_index].item())
    if target < 0 or target == 255 or target >= logits.shape[1]:
        return torch.tensor(float("nan"), device=device)

    target_tensor = torch.tensor([target], device=device, dtype=torch.long)
    return F.cross_entropy(logits[:1].float(), target_tensor)


def _format_attr_loss(stats: Dict[str, float]) -> str:
    parts = []
    valid_values = []
    for key in ATTRIBUTE_LOGIT_KEYS:
        value = stats.get(f"attr_loss_{key}", float("nan"))
        if value is not None and not np.isnan(value):
            valid_values.append(float(value))
            parts.append(f"{ATTRIBUTE_LOG_DISPLAY[key]}:{value:.3f}")
        else:
            parts.append(f"{ATTRIBUTE_LOG_DISPLAY[key]}:nan")
    mean_value = float(np.mean(valid_values)) if valid_values else float("nan")
    if np.isnan(mean_value):
        return "Mean:nan, " + ", ".join(parts)
    return f"Mean:{mean_value:.3f}, " + ", ".join(parts)


def _pnurl_named_params_by_keywords(
    pnurl: Optional[nn.Module],
    keywords: Tuple[str, ...],
    exclude_keywords: Tuple[str, ...] = (),
):
    if pnurl is None:
        return []

    selected = []
    for name, p in pnurl.named_parameters():
        if exclude_keywords and any(k in name for k in exclude_keywords):
            continue
        if any(k in name for k in keywords):
            selected.append((name, p))
    return selected


def _add_pnurl_v2_param_groups(
    add_named_params,
    pnurl: Optional[nn.Module],
    base_lr: float,
    args,
):
    """Split PNuRL into diagnostic optimizer groups.

    Main goal:
        - attribute_classifiers learn faster;
        - attribute_prompt_bank uses base LR;
        - density_decoder and semantic_delta_adapter are conservative;
        - any remaining PNuRL parameters are still optimized but at a low LR.

    PyTorch AdamW accepts per-parameter-group learning rates, so this is safer
    than forcing all PNuRL submodules to share a single LR.
    """
    if pnurl is None:
        return

    attr_lr = base_lr * float(getattr(args, "pnurl_attr_lr_mult", 1.7))
    bank_lr = base_lr * float(getattr(args, "pnurl_prompt_bank_lr_mult", 1.0))
    density_lr = base_lr * float(getattr(args, "pnurl_density_lr_mult", 0.3))
    delta_lr = base_lr * float(getattr(args, "pnurl_delta_lr_mult", 0.1))
    other_lr = base_lr * float(getattr(args, "pnurl_other_lr_mult", 0.3))

    add_named_params(
        "pnurl_attribute_classifiers",
        _pnurl_named_params_by_keywords(pnurl, ("attribute_classifiers",)),
        attr_lr,
    )
    add_named_params(
        "pnurl_attribute_prompt_bank",
        _pnurl_named_params_by_keywords(pnurl, ("attribute_prompt_bank",)),
        bank_lr,
    )
    add_named_params(
        "pnurl_density_decoder",
        _pnurl_named_params_by_keywords(pnurl, ("density_decoder",)),
        density_lr,
    )
    add_named_params(
        "pnurl_semantic_delta_adapter",
        _pnurl_named_params_by_keywords(
            pnurl,
            (
                "semantic_delta_adapter",
                "delta_adapter",
                "semantic_delta",
            ),
            exclude_keywords=("semantic_channel_gate", "channel_gate", "semantic_gate", "residual_gate"),
        ),
        delta_lr,
    )

    # Keep remaining trainable PNuRL parameters. Previously added parameters are
    # skipped by the add_named_params/seen mechanism.
    add_named_params("pnurl_other", list(pnurl.named_parameters()), other_lr)


def build_optimizer_by_stage(model: nn.Module, stage: str, args, logger=None, rank: int = 0, audit=None):
    raw_model = unwrap_model(model)
    seen = set()
    param_groups = []

    def add_named_params(name: str, named_params: Iterable[Tuple[str, torch.nn.Parameter]], lr: float, weight_decay=None):
        params = []
        for _, p in named_params:
            if not p.requires_grad:
                continue
            if id(p) in seen:
                continue
            seen.add(id(p))
            params.append(p)
        if params:
            group = {"params": params, "lr": lr, "name": name}
            if weight_decay is not None:
                group["weight_decay"] = weight_decay
            param_groups.append(group)

    def module_named_params(module: Optional[nn.Module]):
        if module is None:
            return []
        return list(module.named_parameters())

    base_lr = args.lr

    if stage == "vision":
        add_named_params("mask_decoder", module_named_params(getattr(raw_model, "mask_decoder", None)), base_lr)
        add_named_params(
            "prompt_generator",
            module_named_params(getattr(raw_model, "prompt_generator", None)),
            base_lr * float(getattr(args, "prompt_generator_lr_mult", 1.0)),
        )
        add_named_params("basic_hv_head", module_named_params(getattr(raw_model, "basic_hv_head", None)), base_lr)
        add_named_params(
            "global_asr_upsampler",
            module_named_params(getattr(raw_model, "global_asr_upsampler", None)),
            base_lr * float(getattr(args, "asr_lr_ratio", 1.0)),
        )

        cnn_lr = base_lr * float(getattr(args, "cnn_lr_ratio", 0.1))
        add_named_params("cnn_stage0", module_named_params(getattr(raw_model, "cnn_stage0", None)), cnn_lr)
        add_named_params("cnn_stage1", module_named_params(getattr(raw_model, "cnn_stage1", None)), cnn_lr)
        add_named_params("cnn_stage2", module_named_params(getattr(raw_model, "cnn_stage2", None)), cnn_lr)

        adapter_params = []
        image_encoder = getattr(raw_model, "image_encoder", None)
        if image_encoder is not None:
            adapter_params = [
                (n, p)
                for n, p in image_encoder.named_parameters()
                if ("Adapter" in n or "adapter" in n) and p.requires_grad
            ]
        add_named_params(
            "image_encoder_adapter",
            adapter_params,
            base_lr * float(getattr(args, "adapter_lr_ratio", 0.1)),
        )

    elif stage == "pnurl_warmup":
        _add_pnurl_v2_param_groups(
            add_named_params=add_named_params,
            pnurl=getattr(raw_model, "pnurl", None),
            base_lr=base_lr,
            args=args,
        )

    elif stage == "multilevel_attr_warmup":
        # Phase B: multilevel_attr_heads (3 submodules) + structure_boundary_attr_heads
        _phase_b_lr = base_lr * float(getattr(args, "phase_b_lr_ratio", 1.0))
        add_named_params(
            "multilevel_attr_heads",
            module_named_params(getattr(raw_model, "multilevel_attr_heads", None)),
            _phase_b_lr,
        )
        add_named_params(
            "structure_boundary_attr_heads",
            module_named_params(getattr(raw_model, "structure_boundary_attr_heads", None)),
            _phase_b_lr,
        )
        # ── Numeric Attribute → FreqPath Proj (Exp5) ──
        _numeric_freqpath_proj = getattr(raw_model, "numeric_attr_freqpath_proj", None)
        if _numeric_freqpath_proj is not None:
            _numeric_freqpath_lr = float(getattr(args, "numeric_attr_freqpath_lr", None) or _phase_b_lr)
            _numeric_freqpath_params = list(_numeric_freqpath_proj.named_parameters())
            add_named_params("numeric_attr_freqpath_proj", _numeric_freqpath_params, _numeric_freqpath_lr)
            if audit is not None:
                audit.logger_basic(logger, rank,
                    f"[NUMERIC_ATTR_FREQPATH_OPTIMIZER] "
                    f"params={len(_numeric_freqpath_params)} | lr={_numeric_freqpath_lr:.3e}"
                )

    elif stage == "semantic_injection":
        add_named_params(
            "semantic_gate",
            _select_params_by_keywords(
                raw_model,
                (
                    "pnurl.semantic_channel_gate",
                    "semantic_channel_gate",
                    "channel_gate",
                    "semantic_gate",
                    "residual_gate",
                ),
            ),
            base_lr * 0.5,
        )
        _add_pnurl_v2_param_groups(
            add_named_params=add_named_params,
            pnurl=getattr(raw_model, "pnurl", None),
            base_lr=base_lr,
            args=args,
        )
        add_named_params("prompt_learner", module_named_params(getattr(raw_model, "prompt_learner", None)), base_lr * 0.5)
        add_named_params("prompt_generator", module_named_params(getattr(raw_model, "prompt_generator", None)), base_lr * 0.1)

        decoder_new, decoder_old = _split_decoder_params(getattr(raw_model, "mask_decoder", None))
        add_named_params("mask_decoder_new_semantic", decoder_new, base_lr * 0.3)
        add_named_params("mask_decoder_pretrained", decoder_old, base_lr * 0.05)

        add_named_params("basic_hv_head", module_named_params(getattr(raw_model, "basic_hv_head", None)), base_lr * 0.05)
        add_named_params("global_asr_upsampler", module_named_params(getattr(raw_model, "global_asr_upsampler", None)), base_lr * 0.05)
        add_named_params("cnn_stage0", module_named_params(getattr(raw_model, "cnn_stage0", None)), base_lr * 0.02)
        add_named_params("cnn_stage1", module_named_params(getattr(raw_model, "cnn_stage1", None)), base_lr * 0.02)
        add_named_params("cnn_stage2", module_named_params(getattr(raw_model, "cnn_stage2", None)), base_lr * 0.02)

        image_encoder = getattr(raw_model, "image_encoder", None)
        adapter_params = []
        if image_encoder is not None:
            adapter_params = [
                (n, p)
                for n, p in image_encoder.named_parameters()
                if ("Adapter" in n or "adapter" in n) and p.requires_grad
            ]
        add_named_params("image_encoder_adapter", adapter_params, base_lr * 0.01)

        # ── PromptNu-lite v2: attr_align projection heads (Phase D) ──
        if args is not None and getattr(args, "enable_promptnu_lite_align", False):
            _lite_lr = base_lr * float(getattr(args, "promptnu_lite_proj_lr_mult", 0.5))
            _lite_align_names = (
                "attr_align_vis_proj_structure",
                "attr_align_vis_proj_boundary",
                "attr_align_vis_proj_instance",
                "attr_align_text_proj",
            )
            _lite_n_groups = 0
            for _name in _lite_align_names:
                _mod = getattr(raw_model, _name, None)
                if _mod is not None:
                    _params = list(_mod.named_parameters())
                    add_named_params(_name, _params, _lite_lr)
                    _lite_n_groups += 1
            if audit is not None:
                audit.logger_debug(logger, rank,
                    f"[PHASE_D_OPTIMIZER_AUDIT] promptnu_lite_align groups={_lite_n_groups} "
                    f"lr={_lite_lr:.3e}"
                )

        # ---- PromptNu-guided v3: adapter + projection heads ----
        if args is not None and getattr(args, "enable_promptnu_guided_v3", False):
            _v3_lr = base_lr * 0.5
            _v3_groups_added = 0
            _v3_module_names = (
                "promptnu_guided_adapter",
                "promptnu_guided_v3_vis_proj",
                "promptnu_guided_v3_struct_text_proj",
                "promptnu_guided_v3_boundary_text_proj",
            )
            for _v3_name in _v3_module_names:
                _v3_mod = getattr(raw_model, _v3_name, None)
                if _v3_mod is not None:
                    _v3_params = list(_v3_mod.named_parameters())
                    add_named_params(f"v3_{_v3_name}", _v3_params, _v3_lr)
                    _v3_groups_added += 1
            if audit is not None:
                audit.logger_debug(logger, rank,
                    f"[PROMPTNU_GUIDED_V3_OPTIMIZER] v3 modules={_v3_groups_added} "
                    f"lr={_v3_lr:.3e}"
                )

        # ── Numeric Attribute → FreqPath Proj (Exp5, semantic_injection phase) ──
        _numeric_freqpath_proj = getattr(raw_model, "numeric_attr_freqpath_proj", None)
        if args is not None and getattr(args, "enable_numeric_attr_freqpath_guidance", False) and _numeric_freqpath_proj is not None:
            _numeric_freqpath_lr = float(getattr(args, "numeric_attr_freqpath_lr", None) or args.lr)
            _numeric_freqpath_params = list(_numeric_freqpath_proj.named_parameters())
            _numeric_trainable = [(n, p) for n, p in _numeric_freqpath_params if p.requires_grad]
            add_named_params("numeric_attr_freqpath_proj", _numeric_freqpath_params, _numeric_freqpath_lr)
            _param_names_preview = [n for n, p in _numeric_trainable[:6]]
            if audit is not None:
                # -- Enhanced optimizer audit: verify param identity and optimizer registration --
                _na_req_tensors = sum(1 for _, p in _numeric_freqpath_params if p.requires_grad)
                _na_opt_tensors = _na_req_tensors  # should match: all requires_grad go into optimizer
                _na_opt_numel = sum(p.numel() for _, p in _numeric_freqpath_params if p.requires_grad)
                _na_param_ids = [id(p) for _, p in _numeric_freqpath_params if p.requires_grad]
                _na_all_in_seen = all(_pid in seen for _pid in _na_param_ids) if _na_param_ids else False
                audit.logger_basic(logger, rank,
                    f"[NUMERIC_ATTR_FREQPATH_OPTIMIZER]\n"
                    f"  phase=semantic_injection\n"
                    f"  enabled={getattr(args, 'enable_numeric_attr_freqpath_guidance', False)}\n"
                    f"  total_params={len(_numeric_freqpath_params)} | "
                    f"trainable_params={len(_numeric_trainable)}\n"
                    f"  lr={_numeric_freqpath_lr:.3e}\n"
                    f"  requires_grad_param_tensors={_na_req_tensors}\n"
                    f"  optimizer_param_tensors={_na_opt_tensors}\n"
                    f"  optimizer_param_numel={_na_opt_numel}\n"
                    f"  param_id_match={_na_all_in_seen}\n"
                    f"  param_names_preview={_param_names_preview}"
                )

    elif stage == "pnudp_dense_train":
        # Stage D PNuDP dense training: split into 3 keyword-matched groups
        #   proj.weight       → pnudp_dense_proj_lr (fallback: pnudp_dense_lr)
        #   logit_proj.weight  → pnudp_dense_logit_proj_lr (fallback: pnudp_dense_lr)
        #   dense_alpha        → pnudp_dense_alpha_lr (fallback: pnudp_dense_lr)
        _base_lr = float(getattr(args, "pnudp_dense_lr", 1e-4))
        _proj_lr = float(getattr(args, "pnudp_dense_proj_lr", _base_lr))
        _logit_lr = float(getattr(args, "pnudp_dense_logit_proj_lr", _base_lr))
        _alpha_lr = float(getattr(args, "pnudp_dense_alpha_lr", _base_lr))
        _pnudp_mod = getattr(raw_model, "pnudp_dense_train", None)
        if _pnudp_mod is not None:
            _pnudp_params = list(_pnudp_mod.named_parameters())
            # Split into 3 groups by keyword matching
            _proj_params = [(n, p) for n, p in _pnudp_params if "proj." in n and "logit" not in n]
            _logit_params = [(n, p) for n, p in _pnudp_params if "logit_proj" in n]
            _alpha_params = [(n, p) for n, p in _pnudp_params if "dense_alpha" in n]
            _n_proj = len(_proj_params)
            _n_logit = len(_logit_params)
            _n_alpha = len(_alpha_params)
            if _proj_params:
                add_named_params("pnudp_dense_proj", _proj_params, _proj_lr)
            if _logit_params:
                add_named_params("pnudp_dense_logit_proj", _logit_params, _logit_lr)
            if _alpha_params:
                add_named_params("pnudp_dense_alpha", _alpha_params, _alpha_lr)
            if audit is not None:
                audit.logger_debug(logger, rank,
                    f"[PNUDP_DENSE_TRAIN_OPTIMIZER_GROUPS] "
                    f"proj={_n_proj} params lr={_proj_lr:.3e} | "
                    f"logit_proj={_n_logit} params lr={_logit_lr:.3e} | "
                    f"dense_alpha={_n_alpha} params lr={_alpha_lr:.3e}"
                )
        else:
            if rank == 0 and logger is not None:
                logger.warning(
                    "[PNUDP_DENSE_TRAIN_OPTIMIZER] pnudp_dense_train module is None. "
                    "Check that --enable_pnudp_dense_train=True was passed."
                )

    elif stage == "semantic_alignment":
        # Phase C semantic_alignment: only the 4 attr_align projection heads
        attr_align_lr = float(getattr(args, "attr_text_lr", 1e-4))
        _align_names = (
            "attr_align_vis_proj_structure",
            "attr_align_vis_proj_boundary",
            "attr_align_vis_proj_instance",
            "attr_align_text_proj",
        )
        _align_collected = 0
        for _name in _align_names:
            _mod = getattr(raw_model, _name, None)
            if _mod is not None:
                _params = list(_mod.named_parameters())
                add_named_params(
                    _name,
                    _params,
                    attr_align_lr,
                )
                _align_collected += len(_params)

        # Phase C optimizer audit
        if rank == 0:
            logger.info(
                f"[PHASE_C_OPTIMIZER_AUDIT] group=attr_align | "
                f"collected_params={_align_collected} | lr={attr_align_lr:.3e}"
            )
            if _align_collected == 0:
                raise RuntimeError(
                    "[PHASE_C_OPTIMIZER_ERROR] semantic_alignment collected 0 params for optimizer. "
                    "Expected 4 attr_align projection heads (each with weight+bias = 2 params = 8 total). "
                    "Check that TextSam.__init__() created attr_align modules and they are not None. "
                    "Use --enable_attr_text_alignment (auto-enabled for semantic_alignment phase)."
                )

    # Explicit SGA-SB groups are added after the existing stage groups so the
    # feature is orthogonal to phase selection. No new learning-rate knob is
    # introduced: heads use the existing attr-head ratio; adapters/gamma use base LR.
    _sga_mode = str(getattr(args, "spatial_sb_mode", "none"))
    _sga_branch = str(getattr(args, "spatial_sb_branch", "both"))
    if _sga_mode != "none":
        _sga_head_lr = base_lr * float(getattr(args, "phase_b_lr_ratio", 1.0))
        _use_structure = _sga_branch in ("structure", "both")
        _use_boundary = _sga_branch in ("boundary", "both")
        if _use_structure:
            add_named_params(
                "spatial_structure_head",
                module_named_params(getattr(raw_model, "spatial_structure_head", None)),
                _sga_head_lr,
            )
        if _use_boundary:
            add_named_params(
                "spatial_boundary_head",
                module_named_params(getattr(raw_model, "spatial_boundary_head", None)),
                _sga_head_lr,
            )
        if _sga_mode == "guidance":
            if _use_structure:
                add_named_params(
                    "spatial_structure_adapter",
                    module_named_params(getattr(raw_model, "spatial_structure_adapter", None)),
                    base_lr,
                )
            if _use_boundary:
                add_named_params(
                    "spatial_boundary_adapter",
                    module_named_params(getattr(raw_model, "spatial_boundary_adapter", None)),
                    base_lr,
                )
            _gamma_params = []
            for _gamma_name in ("gamma_structure", "gamma_boundary"):
                if ((_gamma_name == "gamma_structure" and _use_structure)
                        or (_gamma_name == "gamma_boundary" and _use_boundary)):
                    _gamma = getattr(raw_model, _gamma_name, None)
                    if _gamma is not None:
                        _gamma_params.append((_gamma_name, _gamma))
            add_named_params("spatial_sb_gamma", _gamma_params, base_lr)

        if rank == 0 and logger is not None:
            for _group in param_groups:
                if str(_group.get("name", "")).startswith("spatial_"):
                    logger.info(
                        f"[OPTIMIZER_GROUP] name={_group['name']} | "
                        f"params={sum(p.numel() for p in _group['params'])} | lr={_group['lr']:.6e}"
                    )

    _optimizer_ids = [id(param) for group in param_groups for param in group["params"]]
    _duplicate_optimizer_count = len(_optimizer_ids) - len(set(_optimizer_ids))
    _trainable_missing = [
        name for name, param in raw_model.named_parameters()
        if param.requires_grad and id(param) not in set(_optimizer_ids)
    ]
    if _duplicate_optimizer_count != 0 or _trainable_missing:
        raise RuntimeError(
            "Optimizer parameter coverage failed: "
            f"duplicate_optimizer_parameter_count={_duplicate_optimizer_count} | "
            f"trainable_missing_optimizer_count={len(_trainable_missing)} | "
            f"missing_preview={_trainable_missing[:20]}"
        )
    if rank == 0 and logger is not None:
        logger.info(
            f"[OPTIMIZER_COVERAGE] duplicate_optimizer_parameter_count={_duplicate_optimizer_count} | "
            f"trainable_missing_optimizer_count={len(_trainable_missing)}"
        )

    if len(param_groups) == 0:
        raise RuntimeError(
            f"No trainable parameters were collected for stage={stage}. "
            "Check use_pnurl/use_coop/use_asr and module names."
        )

    if rank == 0 and logger is not None:
        if stage == "semantic_injection":
            # Phase D optimizer audit with expected group names
            for group in param_groups:
                group_name = group.get("name", "unnamed")
                n_params = sum(p.numel() for p in group["params"])
                logger.info(
                    f"[PHASE_D_OPTIMIZER_AUDIT] group={group_name} | "
                    f"params={n_params:,} | lr={group['lr']:.3e}"
                )
        else:
            logger.info("Optimizer parameter groups:")
            for group in param_groups:
                n_params = sum(p.numel() for p in group["params"])
                logger.info(f"  - {group.get('name', 'unnamed')}: lr={group['lr']:.3e}, params={n_params:,}")

    return optim.AdamW(param_groups, lr=base_lr, weight_decay=args.weight_decay)


def _select_params_by_keywords(module: nn.Module, keywords: Tuple[str, ...]):
    selected = []
    for name, p in module.named_parameters():
        if any(key in name for key in keywords):
            selected.append((name, p))
    return selected


def _split_decoder_params(mask_decoder: Optional[nn.Module]):
    if mask_decoder is None:
        return [], []

    decoder_new_keywords = (
        "low_freq_modulator",
        "high_freq_modulator",
        "high_freq_prompt_encoder",
        "cnn_residual_fusion",
        "low_freq_residual_scale",
        "high_freq_residual_scale",
        "residual_scale",
        "attr_modulator",
        "morphology_modulator",
        "morph_encoder",
        "asr_upscale",
    )

    new_params, old_params = [], []
    for name, p in mask_decoder.named_parameters():
        if any(key in name for key in decoder_new_keywords):
            new_params.append((name, p))
        else:
            old_params.append((name, p))
    return new_params, old_params


def _trainable_param_signature(model: nn.Module) -> Tuple[List[Tuple[str, Tuple[int, ...], int]], int, str]:
    """
    Return a deterministic signature of trainable parameters.

    DDP only synchronizes parameters that require gradients. If one rank freezes everything
    while another rank opens Stage C modules, DDP will fail with a vague "same model" error.
    This signature makes that failure explicit before wrapping the model with DDP.
    """
    raw_model = unwrap_model(model)
    signature: List[Tuple[str, Tuple[int, ...], int]] = []
    total_numel = 0

    for name, param in raw_model.named_parameters():
        if not param.requires_grad:
            continue
        shape = tuple(int(x) for x in param.shape)
        numel = int(param.numel())
        signature.append((name, shape, numel))
        total_numel += numel

    digest_src = "\n".join(f"{name}|{shape}|{numel}" for name, shape, numel in signature)
    digest = hashlib.sha256(digest_src.encode("utf-8")).hexdigest()[:16]
    return signature, total_numel, digest


def debug_trainable_signature(
    model: nn.Module,
    rank: int,
    logger=None,
    tag: str = "before_ddp",
    max_items: int = 40,
):
    signature, total_numel, digest = _trainable_param_signature(model)
    msg = (
        f"[DDP DEBUG][rank={rank}][{tag}] "
        f"trainable_param_tensors={len(signature)}, "
        f"trainable_numel={total_numel:,}, "
        f"digest={digest}"
    )

    if logger is not None:
        logger.info(msg)
        for name, shape, numel in signature[:max_items]:
            logger.info(f"[DDP DEBUG][rank={rank}] trainable: {name} | shape={shape} | numel={numel:,}")
        if len(signature) > max_items:
            logger.info(f"[DDP DEBUG][rank={rank}] ... {len(signature) - max_items} more trainable tensors")
    else:
        print(msg, flush=True)
        for name, shape, numel in signature[:max_items]:
            print(f"[DDP DEBUG][rank={rank}] trainable: {name} | shape={shape} | numel={numel}", flush=True)
        if len(signature) > max_items:
            print(f"[DDP DEBUG][rank={rank}] ... {len(signature) - max_items} more trainable tensors", flush=True)


def assert_same_trainable_across_ranks(
    model: nn.Module,
    device: torch.device,
    logger=None,
    tag: str = "before_ddp",
):
    """
    Fail early if different ranks have different trainable parameter sets.

    This directly catches the previous failure mode:
    rank0 opened Stage C modules, while rank1 had zero trainable parameters.
    """
    signature, total_numel, digest = _trainable_param_signature(model)

    if len(signature) == 0:
        raise RuntimeError(
            f"No trainable parameters on this process at {tag}. "
            "Check apply_stage_policy(), phase/use_pnurl/use_coop/use_asr, and rank-gated freeze/unfreeze logic."
        )

    if not (dist.is_available() and dist.is_initialized()):
        return

    rank = dist.get_rank()
    world_size = dist.get_world_size()

    local_summary = {
        "rank": rank,
        "trainable_tensors": len(signature),
        "trainable_numel": int(total_numel),
        "digest": digest,
        "first_names": [name for name, _, _ in signature[:8]],
        "last_names": [name for name, _, _ in signature[-8:]],
    }
    gathered: List[Optional[Dict]] = [None for _ in range(world_size)]
    dist.all_gather_object(gathered, local_summary)

    if rank == 0 and logger is not None:
        logger.info(f"[DDP CHECK][{tag}] trainable signatures across ranks:")
        for item in gathered:
            logger.info(
                f"  rank={item['rank']} | tensors={item['trainable_tensors']} | "
                f"numel={item['trainable_numel']:,} | digest={item['digest']}"
            )

    base = gathered[0]
    mismatches = [
        item for item in gathered
        if (
            item["trainable_tensors"] != base["trainable_tensors"]
            or item["trainable_numel"] != base["trainable_numel"]
            or item["digest"] != base["digest"]
        )
    ]

    if mismatches:
        local_detail = (
            f"[DDP CHECK][rank={rank}][{tag}] local first_names={local_summary['first_names']} "
            f"local last_names={local_summary['last_names']}"
        )
        if logger is not None:
            logger.error(local_detail)
            logger.error(f"[DDP CHECK][{tag}] gathered={gathered}")
        else:
            print(local_detail, flush=True)
            print(f"[DDP CHECK][{tag}] gathered={gathered}", flush=True)

        raise RuntimeError(
            f"DDP trainable parameter mismatch before DDP wrapping at {tag}. "
            f"rank0=(tensors={base['trainable_tensors']}, numel={base['trainable_numel']}, digest={base['digest']}), "
            f"local_rank{rank}=(tensors={local_summary['trainable_tensors']}, "
            f"numel={local_summary['trainable_numel']}, digest={local_summary['digest']}). "
            "This usually means model freeze/unfreeze, module creation, checkpoint loading, or ablation logic "
            "ran differently across ranks."
        )


# ==================================================================================================
# 4. Loss helpers and diagnostics
# ==================================================================================================
def _zero_like_loss(device):
    return torch.tensor(0.0, device=device)


def _get_best_mask_and_iou(out: Dict, labels_i: torch.Tensor):
    iou_preds = out["iou_predictions"]
    if iou_preds.ndim == 2:
        iou_preds = iou_preds.squeeze(0)
    best_idx = torch.argmax(iou_preds).item()

    if out["masks"].ndim == 3:
        pred_mask = out["masks"][best_idx, :, :]
    else:
        pred_mask = out["masks"][0, best_idx]
    pred_iou = iou_preds[best_idx]

    gt_mask = labels_i.squeeze(0).float()
    gt_mask = (gt_mask > 0).float()
    if pred_mask.shape != gt_mask.shape:
        gt_mask = F.interpolate(
            gt_mask.unsqueeze(0).unsqueeze(0),
            size=pred_mask.shape,
            mode="nearest",
        ).squeeze()
    return pred_mask, pred_iou, gt_mask


def _compute_mask_loss(criterion, pred_mask, pred_iou, gt_mask):
    loss_m, _ = criterion(
        pred_mask.unsqueeze(0).unsqueeze(0),
        gt_mask.unsqueeze(0).unsqueeze(0),
        pred_iou.unsqueeze(0),
    )
    return loss_m


def _compute_heatmap_loss(out: Dict, labels_i: torch.Tensor):
    pred_heatmap = out.get("heatmap_logits", None)
    if pred_heatmap is None:
        return _zero_like_loss(labels_i.device)

    with torch.no_grad():
        target_mask = labels_i.float().unsqueeze(0)
        gt_nuclei = F.interpolate(target_mask, size=pred_heatmap.shape[-2:], mode="nearest").squeeze(0)
        gt_nuclei[gt_nuclei == 255] = 0
    return point_guidance_loss(pred_heatmap, gt_nuclei.unsqueeze(0))


def _compute_hv_loss(out: Dict, labels_i: torch.Tensor, batched_input: Dict, sample_index: int):
    pred_hv = out.get("hv_logits", None)
    if pred_hv is None:
        return _zero_like_loss(labels_i.device)

    if pred_hv.dim() == 3:
        pred_hv = pred_hv.unsqueeze(0)
    pred_hv = torch.tanh(pred_hv)

    with torch.no_grad():
        inst_batch = batched_input.get("label_inst", None)
        gt_hv_map_batch = batched_input.get("gt_hv_map", None)
        gt_hv = None
        focus = None

        if gt_hv_map_batch is not None:
            gt_hv_full = gt_hv_map_batch[sample_index].to(pred_hv.device)
            if gt_hv_full.dim() == 3:
                gt_hv_full = gt_hv_full.unsqueeze(0)
            gt_hv = F.interpolate(gt_hv_full.float(), size=pred_hv.shape[-2:], mode="nearest")
        elif inst_batch is not None:
            inst_map = inst_batch[sample_index].float()
            if inst_map.dim() == 2:
                inst_map = inst_map.unsqueeze(0).unsqueeze(0)
            elif inst_map.dim() == 3:
                inst_map = inst_map.unsqueeze(0)
            inst_map_resized = F.interpolate(inst_map, size=pred_hv.shape[-2:], mode="nearest").squeeze().long()
            inst_map_resized[inst_map_resized == 255] = 0
            gt_hv = generate_hv_map_from_inst(inst_map_resized).unsqueeze(0)

        if gt_hv is not None:
            if inst_batch is not None:
                focus_full = (inst_batch[sample_index].squeeze(0) > 0).float().unsqueeze(0).unsqueeze(0)
            else:
                focus_full = (labels_i.squeeze(0) > 0).float().unsqueeze(0).unsqueeze(0)
            focus = F.interpolate(focus_full, size=pred_hv.shape[-2:], mode="nearest").squeeze(1)

    if gt_hv is None or focus is None:
        return _zero_like_loss(pred_hv.device)

    focus_exp = focus.unsqueeze(1)
    mse_map = F.mse_loss(pred_hv.float(), gt_hv.float(), reduction="none")
    loss_hv_mse = (mse_map * focus_exp).sum() / (focus_exp.sum() * pred_hv.shape[1] + 1e-8)
    loss_hv_grad = msge_loss(gt_hv, pred_hv, focus)
    return loss_hv_mse + 2.0 * loss_hv_grad


def _compute_density_loss(out: Dict, labels_i: torch.Tensor, pred_mask: torch.Tensor, stage: str, epoch: int):
    pred_density = out.get("density_map", None)
    if pred_density is None:
        return _zero_like_loss(pred_mask.device)

    if stage == "pnurl_warmup":
        density_reference = (labels_i.float() > 0).float()
        if density_reference.dim() == 2:
            density_reference = density_reference.unsqueeze(0).unsqueeze(0)
        elif density_reference.dim() == 3:
            density_reference = density_reference.unsqueeze(0)
        enable_iou = False
    else:
        density_reference = pred_mask.detach().unsqueeze(0).unsqueeze(0)
        enable_iou = epoch > 20

    loss_d, _, _ = density_map_loss(
        pred_density_map=pred_density,
        gt_mask=labels_i.float().unsqueeze(0),
        pred_mask=density_reference,
        mse_weight=1.0,
        iou_weight=0.5,
        enable_iou=enable_iou,
    )
    return loss_d


def _compute_semantic_stability_loss(out: Dict, args, device: torch.device):
    reg_loss = out.get("semantic_delta_reg_loss", None)
    if reg_loss is None:
        reg_loss = torch.tensor(0.0, device=device)
    elif not torch.is_tensor(reg_loss):
        reg_loss = torch.tensor(float(reg_loss), device=device)
    else:
        reg_loss = reg_loss.to(device=device).float().mean()

    injection_ratio = out.get("injection_ratio", None)
    if injection_ratio is None:
        injection_penalty = torch.tensor(0.0, device=device)
    elif not torch.is_tensor(injection_ratio):
        ratio_tensor = torch.tensor(float(injection_ratio), device=device)
        injection_penalty = F.relu(ratio_tensor - args.max_injection_ratio).pow(2)
    else:
        ratio_tensor = injection_ratio.to(device=device).float().mean()
        injection_penalty = F.relu(ratio_tensor - args.max_injection_ratio).pow(2)

    stability_loss = (
        args.semantic_delta_reg_weight * reg_loss
        + args.injection_ratio_weight * injection_penalty
    )
    return stability_loss, reg_loss.detach(), injection_penalty.detach()


# ==================================================================================================
# Phase D gate audit helpers (debug_phase_d_gate_audit, rank0 only, first 2 train batches)
# ==================================================================================================
_PHASE_D_GATE_AUDIT_BATCH_COUNTER = 0

# Target optimizer group names for Phase D audit
_PHASE_D_AUDIT_GROUPS = ("semantic_gate", "pnurl_semantic_delta_adapter", "mask_decoder_new_semantic")


def _phase_d_gate_audit_forward(outputs, raw_model, batch_idx, args):
    """Print gate forward diagnostics: GateMean/Min/Max/Std, DeltaNorm, BaseNorm, InjectedNorm, InjRatio."""
    global _PHASE_D_GATE_AUDIT_BATCH_COUNTER
    if not args.debug_phase_d_gate_audit:
        return
    if batch_idx >= 2:
        return
    _PHASE_D_GATE_AUDIT_BATCH_COUNTER += 1

    # Debug: print raw stat keys from first output (batch_idx == 0 only)
    if batch_idx == 0 and outputs:
        first_out = outputs[0]
        diag_keys = [k for k in first_out.keys() if k != "diagnostics"]
        print(
            f"\n[PHASE_D_GATE_AUDIT][stat_keys] batch={batch_idx} "
            f"output_keys={diag_keys}",
            flush=True,
        )
        # Also print diagnostics sub-keys if present
        sub_diag = first_out.get("diagnostics", None)
        if isinstance(sub_diag, dict):
            print(
                f"[PHASE_D_GATE_AUDIT][stat_keys] diagnostics.keys()="
                f"{list(sub_diag.keys())}",
                flush=True,
            )

    diag = collect_semantic_diagnostics(outputs)
    gm = diag.get("semantic_channel_gate_mean", float("nan"))
    gmin = diag.get("semantic_channel_gate_min", float("nan"))
    gmax = diag.get("semantic_channel_gate_max", float("nan"))
    dn = diag.get("semantic_delta_norm", float("nan"))
    bn = diag.get("base_feat_norm", float("nan"))
    ixn = diag.get("injected_delta_norm", float("nan"))
    ir = diag.get("injection_ratio", float("nan"))
    dr = diag.get("semantic_delta_ratio", float("nan"))

    # Warn if DeltaNorm=0 but DeltaRatio>0 (suggests read error or zeroed tensor)
    if dn is not None and not (isinstance(dn, float) and (dn != dn)) and dn == 0.0 and dr is not None and dr > 0:
        print(
            f"[PHASE_D_GATE_AUDIT][WARNING] DeltaNorm=0 but DeltaRatio={dr:.6e}>0: "
            f"semantic_delta may be zero in forward or read from wrong field",
            flush=True,
        )

    print(
        f"\n[PHASE_D_GATE_AUDIT][forward] batch={batch_idx} | "
        f"GateMean={gm:.6e} | GateMin={gmin:.6e} | GateMax={gmax:.6e} | "
        f"DeltaNorm={dn:.6e} | BaseNorm={bn:.6e} | InjectedNorm={ixn:.6e} | "
        f"InjRatio={ir:.6e} | DeltaRatio={dr:.6e}",
        flush=True,
    )


def _safe_grad_norm(param, norm_type=2.0):
    """Return grad norm or 'grad=None' string if grad is None. No .data usage."""
    if param.grad is None:
        return "grad=None"
    with torch.no_grad():
        gn = param.grad.detach().float().norm(norm_type).item()
    return f"{gn:.6e}"


def _safe_param_norm(param, norm_type=2.0):
    """Return param norm. No .data usage."""
    with torch.no_grad():
        pn = param.detach().float().norm(norm_type).item()
    return f"{pn:.6e}"


def _build_param_id_to_name(raw_model):
    """Build a mapping from param id to param name for cross-referencing optimizer groups."""
    mapping = {}
    for name, p in raw_model.named_parameters():
        mapping[id(p)] = name
    return mapping


def _audit_report_from_optimizer_group(optimizer, raw_model, group_name):
    """Compute grad_norm and param_norm for all params in a named optimizer group.

    Returns (group_name, param_count, grad_norm, param_norm, all_grad_none) or
    (group_name, param_count, None, None, True) if group not found.
    """
    for group in optimizer.param_groups:
        if group.get("name") == group_name:
            params = group["params"]
            param_count = len(params)
            total_grad_norm_sq = 0.0
            total_param_norm_sq = 0.0
            all_grad_none = True
            for p in params:
                if p.grad is not None:
                    with torch.no_grad():
                        gn = p.grad.detach().float().norm(2).item()
                        pn = p.detach().float().norm(2).item()
                    total_grad_norm_sq += gn * gn
                    total_param_norm_sq += pn * pn
                    all_grad_none = False
                else:
                    with torch.no_grad():
                        pn = p.detach().float().norm(2).item()
                    total_param_norm_sq += pn * pn
            if all_grad_none:
                return group_name, param_count, 0.0, total_param_norm_sq ** 0.5, True
            return group_name, param_count, total_grad_norm_sq ** 0.5, total_param_norm_sq ** 0.5, False
    return group_name, 0, None, None, True


def _phase_d_gate_audit_grad(raw_model, batch_idx, args, optimizer=None):
    """Print grad norms for semantic_gate, pnurl_semantic_delta_adapter, mask_decoder_new_semantic.

    Changed to use optimizer param groups by name instead of module path heuristic.
    Falls back to raw_model.named_parameters() scanning if optimizer is None.
    """
    if not args.debug_phase_d_gate_audit or batch_idx >= 2:
        return

    print(f"\n[PHASE_D_GATE_AUDIT][grad] batch={batch_idx} |", flush=True)

    if optimizer is not None:
        # Primary path: use optimizer param_groups by name
        for gname in _PHASE_D_AUDIT_GROUPS:
            try:
                group_name, param_count, grad_norm, param_norm, all_none = _audit_report_from_optimizer_group(
                    optimizer, raw_model, gname
                )
                if param_count == 0:
                    print(
                        f"  [{gname}] group not found in optimizer (param_count=0)",
                        flush=True,
                    )
                elif all_none:
                    print(
                        f"  [{gname}] group={gname} | params={param_count} | "
                        f"grad_norm=0.000000e+00 (all grad=None) | "
                        f"param_norm={param_norm:.6e}",
                        flush=True,
                    )
                else:
                    print(
                        f"  [{gname}] group={gname} | params={param_count} | "
                        f"grad_norm={grad_norm:.6e} | param_norm={param_norm:.6e}",
                        flush=True,
                    )
            except Exception as e:
                print(
                    f"  [{gname}] WARNING: audit exception: {e}",
                    flush=True,
                )
    else:
        # Fallback: scan raw_model.named_parameters() (legacy heuristic)
        gate_params = []
        delta_params = []
        md_new_params = []
        for name, p in raw_model.named_parameters():
            if "semantic_channel_gate" in name and "gate" in name:
                gate_params.append((name, p))
            if "semantic_delta_adapter" in name:
                delta_params.append((name, p))
            if "mask_decoder" in name and "new_semantic" in name:
                md_new_params.append((name, p))

        for tag, params in [
            ("semantic_gate", gate_params),
            ("pnurl_semantic_delta_adapter", delta_params),
            ("mask_decoder_new_semantic", md_new_params),
        ]:
            _report_legacy(tag, params)


def _report_legacy(tag, params):
    """Legacy per-name reporting fallback."""
    if not params:
        print(f"  [{tag}] module not found in model", flush=True)
        return
    total_grad_norm = 0.0
    total_param_norm = 0.0
    all_grad_none = True
    for n, p in params:
        gn = _safe_grad_norm(p)
        pn = _safe_param_norm(p)
        if "grad=" in gn:
            status = "grad=None"
        else:
            status = f"grad={gn} param={pn}"
            try:
                total_grad_norm += float(gn.split()[0]) ** 2
                total_param_norm += float(pn.split()[0]) ** 2
                all_grad_none = False
            except (ValueError, IndexError):
                pass
    if all_grad_none:
        print(f"  [{tag}] all params have grad=None", flush=True)
    else:
        print(
            f"  [{tag}] grad_norm={total_grad_norm ** 0.5:.6e} "
            f"param_norm={total_param_norm ** 0.5:.6e}",
            flush=True,
        )


def _phase_d_gate_audit_delta(raw_model, optimizer, batch_idx, args):
    """Compare param before/after optimizer.step to detect actual updates.

    Uses optimizer param_groups by name. Compares on CPU with torch.no_grad().
    """
    if not args.debug_phase_d_gate_audit or batch_idx >= 2 or not hasattr(_phase_d_gate_audit_delta, "_snapshot"):
        return

    print(f"\n[PHASE_D_GATE_AUDIT][delta] batch={batch_idx} |", flush=True)

    # Build param_id -> name mapping
    id_to_name = _build_param_id_to_name(raw_model)

    for group_name in _PHASE_D_AUDIT_GROUPS:
        try:
            group = None
            for g in optimizer.param_groups:
                if g.get("name") == group_name:
                    group = g
                    break

            if group is None:
                print(
                    f"  [{group_name}] group not found in optimizer",
                    flush=True,
                )
                continue

            group_params = group["params"]
            param_count = len(group_params)
            total_delta_sq = 0.0
            found_any = False

            for p in group_params:
                p_id = id(p)
                p_name = id_to_name.get(p_id)
                if p_name is None:
                    continue
                old_p = _phase_d_gate_audit_delta._snapshot.get(p_name)
                if old_p is None:
                    continue

                with torch.no_grad():
                    cur = p.detach().float().cpu()
                    old = old_p.detach().float().cpu()
                    if cur.shape != old.shape:
                        print(
                            f"  [WARNING] shape mismatch for {p_name}: "
                            f"cur={tuple(cur.shape)} old={tuple(old.shape)}",
                            flush=True,
                        )
                        continue
                    step_delta = (cur - old).norm().item()
                total_delta_sq += step_delta * step_delta
                found_any = True

            if found_any:
                print(
                    f"  [{group_name}] group={group_name} | params={param_count} | "
                    f"step_delta_norm={total_delta_sq ** 0.5:.6e}",
                    flush=True,
                )
            else:
                print(
                    f"  [{group_name}] group={group_name} | params={param_count} | "
                    f"step_delta_norm=0.000000e+00 (no snapshot match)",
                    flush=True,
                )
        except Exception as e:
            print(
                f"  [{group_name}] WARNING: delta audit exception: {e}",
                flush=True,
            )

    # Clean up snapshot
    del _phase_d_gate_audit_delta._snapshot


def _take_param_snapshot(raw_model):
    """Take a snapshot of param values for delta computation. CPU, no_grad, no .data."""
    snap = {}
    for name, p in raw_model.named_parameters():
        if p.requires_grad:
            with torch.no_grad():
                snap[name] = p.detach().float().clone().cpu()
    _phase_d_gate_audit_delta._snapshot = snap


def _numeric_freqpath_take_snapshot(raw_model):
    """Take a snapshot of numeric_attr_freqpath_proj params for delta_from_start computation.
    One-shot: only stores on first call (per-process lifetime)."""
    if getattr(_numeric_freqpath_take_snapshot, "_initialized", False):
        return
    snap = {}
    _proj = getattr(raw_model, "numeric_attr_freqpath_proj", None)
    if _proj is not None:
        for name, p in _proj.named_parameters():
            with torch.no_grad():
                snap[name] = p.detach().float().clone().cpu()
    _numeric_freqpath_take_snapshot._snapshot = snap
    _numeric_freqpath_take_snapshot._initialized = True
    if snap:
        print(
            f"\n[NUMERIC_FREQPATH_SNAPSHOT] captured {len(snap)} params from "
            f"numeric_attr_freqpath_proj",
            flush=True,
        )


# ==================================================================================================
# PromptNu-guided v3.2: gradient & step-delta audit
# ==================================================================================================
# Target module name patterns for v3 grad/delta audit.
_V3_AUDIT_MODULE_PATTERNS = {
    "promptnu_guided_adapter": ["promptnu_guided_adapter"],
    "promptnu_guided_v3_vis_proj": ["promptnu_guided_v3_vis_proj"],
    "promptnu_guided_v3_struct_text_proj": ["promptnu_guided_v3_struct_text_proj"],
    "promptnu_guided_v3_boundary_text_proj": ["promptnu_guided_v3_boundary_text_proj"],
    # Matches both:
    #   multilevel_attr_heads.patch_structure_head.structure_head.*
    #   structure_boundary_attr_heads.structure_head.*
    "multilevel_structure_heads": ["structure_head"],
    # Matches both:
    #   multilevel_attr_heads.patch_structure_head.boundary_head.*
    #   structure_boundary_attr_heads.boundary_head.*
    "multilevel_boundary_heads": ["boundary_head"],
    "pnurl_semantic_delta_adapter": ["semantic_delta_adapter"],
    "semantic_channel_gate": ["semantic_channel_gate"],
}


def _v3_match_module(name: str, patterns) -> bool:
    """Check if a parameter name matches a set of keyword patterns (AND within the list)."""
    return all(p in name for p in patterns)


def _v3_collect_module_params(raw_model, module_key: str) -> list:
    """Collect (name, param) pairs for a v3 audit module by name-pattern matching."""
    patterns = _V3_AUDIT_MODULE_PATTERNS.get(module_key, [])
    results = []
    for name, p in raw_model.named_parameters():
        if _v3_match_module(name, patterns):
            results.append((name, p))
    # Filter out false positives for semantic_delta_adapter (avoid promptnu_guided_adapter)
    if module_key == "pnurl_semantic_delta_adapter":
        results = [(n, p) for n, p in results if "promptnu_guided" not in n]
    return results


def debug_promptnu_guided_v3_audit(raw_model, batch_idx, args, optimizer=None):
    """Print grad norms and step-delta norms for all PromptNu-guided v3 modules.

    Called after loss.backward() (grad) and after optimizer.step() (delta).
    Only runs on rank 0, first 2 batches of semantic_injection phase.
    """
    # Gate: only run if either v3-specific audit or phase_d_gate_audit is enabled
    enable_v3_grad_audit = (
        getattr(args, "debug_promptnu_guided_v3_audit", False)
        or getattr(args, "debug_phase_d_gate_audit", False)
    )
    if not enable_v3_grad_audit:
        return
    if not getattr(args, "enable_promptnu_guided_v3", False):
        return
    if batch_idx >= 2:
        return
    if not hasattr(debug_promptnu_guided_v3_audit, "_v3_called_grad"):
        debug_promptnu_guided_v3_audit._v3_called_grad = 0
    if not hasattr(debug_promptnu_guided_v3_audit, "_v3_called_delta"):
        debug_promptnu_guided_v3_audit._v3_called_delta = 0

    # ── Grad audit ──
    print(f"\n[PROMPTNU_GUIDED_V3_GRAD_AUDIT][grad] batch={batch_idx} |", flush=True)
    for module_key in _V3_AUDIT_MODULE_PATTERNS:
        params = _v3_collect_module_params(raw_model, module_key)
        if not params:
            print(f"  [{module_key}] module not found in model", flush=True)
            continue
        total_grad_sq = 0.0
        n_with_grad = 0
        n_nonfinite = 0
        for p_name, p in params:
            if p.grad is not None:
                gn = p.grad.detach().float().norm(2).item()
                total_grad_sq += gn * gn
                n_with_grad += 1
                # ── Nonfinite grad detection (Problem 6) ──
                if not torch.isfinite(p.grad.detach().float()).all():
                    n_nonfinite += 1
                    print(
                        f"    ⚠ [{module_key}] NONFINITE grad in {p_name}: "
                        f"grad_norm={gn:.6e}",
                        flush=True,
                    )
        if n_with_grad == 0:
            print(f"  [{module_key}] params={len(params)} | grad_norm=0.000000e+00 (all grad=None)", flush=True)
        else:
            suffix = ""
            if n_nonfinite > 0:
                suffix = f" | ⚠ nonfinite={n_nonfinite}/{n_with_grad}"
            print(
                f"  [{module_key}] params={len(params)} | "
                f"grad_norm={total_grad_sq ** 0.5:.6e} | "
                f"n_with_grad={n_with_grad}/{len(params)}{suffix}",
                flush=True,
            )
    debug_promptnu_guided_v3_audit._v3_called_grad += 1

    # ── Retained grad audit (Problem 4) ──
    # Check retain_grad() tensors set in sam.py forward() for PG3 path.
    # These are model attributes that were registered with .retain_grad().
    _probe_attrs = [
        "promptnu_guided_v3_align_loss",
        "_v3_vis_rms",
        "_v3_vis_proj",
        "_v3_struct_text_proj",
        "_v3_boundary_text_proj",
        "_v3_struct_cos",
        "_v3_bound_cos",
        "_v3_struct_loss",
        "_v3_bound_loss",
    ]
    _has_retained = any(hasattr(raw_model, a) for a in _probe_attrs)
    if _has_retained:
        print(f"\n[PROMPTNU_GUIDED_V3_GRAD_AUDIT][retain_grad] batch={batch_idx} |", flush=True)
        for attr_name in _probe_attrs:
            t = getattr(raw_model, attr_name, None)
            if t is None:
                continue
            if not torch.is_tensor(t):
                continue
            if t.grad is not None:
                _gn = t.grad.detach().float().norm().item()
                _fin = torch.isfinite(t.grad.detach().float()).all().item()
                print(
                    f"  [{attr_name}] grad_norm={_gn:.6e} "
                    f"shape={list(t.shape)} "
                    f"finite={_fin} "
                    f"requires_grad={t.requires_grad}",
                    flush=True,
                )
            else:
                print(
                    f"  [{attr_name}] grad=None "
                    f"shape={list(t.shape)} "
                    f"requires_grad={t.requires_grad}",
                    flush=True,
                )

    # ── Step-delta audit (requires a snapshot taken BEFORE optimizer.step) ──
    if hasattr(debug_promptnu_guided_v3_audit, "_v3_snapshot"):
        print(f"\n[PROMPTNU_GUIDED_V3_GRAD_AUDIT][delta] batch={batch_idx} |", flush=True)
        for module_key in _V3_AUDIT_MODULE_PATTERNS:
            params = _v3_collect_module_params(raw_model, module_key)
            if not params:
                print(f"  [{module_key}] module not found in model", flush=True)
                continue
            total_delta_sq = 0.0
            found_any = False
            for p_name, p in params:
                old_p = debug_promptnu_guided_v3_audit._v3_snapshot.get(p_name)
                if old_p is None:
                    continue
                with torch.no_grad():
                    cur = p.detach().float().cpu()
                    old = old_p.detach().float().cpu()
                    if cur.shape == old.shape:
                        step_delta = (cur - old).norm().item()
                        total_delta_sq += step_delta * step_delta
                        found_any = True
            if found_any:
                print(
                    f"  [{module_key}] params={len(params)} | "
                    f"step_delta_norm={total_delta_sq ** 0.5:.6e}",
                    flush=True,
                )
            else:
                print(
                    f"  [{module_key}] params={len(params)} | "
                    f"step_delta_norm=0.000000e+00 (no snapshot match)",
                    flush=True,
                )
        debug_promptnu_guided_v3_audit._v3_called_delta += 1
        # Clean up snapshot after delta audit
        del debug_promptnu_guided_v3_audit._v3_snapshot


def debug_promptnu_guided_v3_take_snapshot(raw_model):
    """Take parameter snapshot for v3 step-delta audit.

    NOTE: Saves ALL named_parameters (not just requires_grad=True) so that
    v3 modules (promptnu_guided_adapter, v3_vis_proj, etc.) whose
    requires_grad may be False at the time of snapshot are still captured
    for step-delta comparison.  The delta audit will report delta=0 for
    frozen params, which is the correct behavior.
    """
    snap = {}
    for name, p in raw_model.named_parameters():
        with torch.no_grad():
            snap[name] = p.detach().float().clone().cpu()
    debug_promptnu_guided_v3_audit._v3_snapshot = snap


def _to_float_or_nan(value):
    if value is None:
        return float("nan")
    if torch.is_tensor(value):
        if value.numel() == 0:
            return float("nan")
        return float(value.detach().float().mean().cpu().item())
    try:
        return float(value)
    except Exception:
        return float("nan")


def _norm_or_nan(value):
    if value is None or not torch.is_tensor(value) or value.numel() == 0:
        return float("nan")
    return float(value.detach().float().norm(p=2).cpu().item())


def collect_semantic_diagnostics(outputs: List[Dict]):
    gate_vals = []
    delta_norms = []
    base_norms = []
    injected_norms = []
    injection_ratios = []
    delta_reg_losses = []
    delta_ratios = []
    raw_norms = []
    direction_norms = []
    # PromptNu-lite v2 keys (stored inside each output's "diagnostics" sub-dict)
    pnurl_s_losses = []
    pnurl_b_losses = []
    pnurl_s_sims = []
    pnurl_b_sims = []
    # PromptNu-guided v3.1 keys (stored inside each output's "diagnostics" sub-dict)
    v3_s_losses = []
    v3_b_losses = []
    v3_s_sims = []
    v3_b_sims = []
    v3_text_proj_norms = []
    v3_vis_proj_norms = []
    v3_text_scale_means = []
    v3_text_scale_stds = []
    v3_guided_delta_ratios = []

    for out in outputs:
        gate = None
        for key in ("semantic_channel_gate", "semantic_gate", "channel_gate", "gate"):
            if key in out and out[key] is not None:
                gate = out[key]
                break
        if torch.is_tensor(gate):
            gate_vals.append(gate.detach().float().reshape(-1))
        elif gate is not None:
            gate_vals.append(torch.as_tensor(gate).float().reshape(-1))

        if "semantic_delta_norm" in out:
            delta_norms.append(_to_float_or_nan(out.get("semantic_delta_norm")))
        else:
            delta_norms.append(_norm_or_nan(out.get("semantic_delta", None)))

        if "base_feat_norm" in out:
            base_norms.append(_to_float_or_nan(out.get("base_feat_norm")))
        else:
            base_feat = out.get("base_feat", None)
            if base_feat is None:
                base_feat = out.get("image_embeddings", None)
            base_norms.append(_norm_or_nan(base_feat))

        if "injected_delta_norm" in out:
            injected_norms.append(_to_float_or_nan(out.get("injected_delta_norm")))
        else:
            injected_norms.append(_norm_or_nan(out.get("injected_delta", None)))

        if "injection_ratio" in out:
            injection_ratios.append(_to_float_or_nan(out.get("injection_ratio")))

        if "semantic_delta_reg_loss" in out:
            delta_reg_losses.append(_to_float_or_nan(out.get("semantic_delta_reg_loss")))

        if "semantic_delta_ratio" in out:
            delta_ratios.append(_to_float_or_nan(out.get("semantic_delta_ratio")))

        if "semantic_delta_raw_norm" in out:
            raw_norms.append(_to_float_or_nan(out.get("semantic_delta_raw_norm")))

        if "semantic_delta_direction_norm" in out:
            direction_norms.append(_to_float_or_nan(out.get("semantic_delta_direction_norm")))

        # Extract PromptNu-lite v2 keys from per-sample diagnostics sub-dict
        _diag = out.get("diagnostics", {})
        if "pnurl_s_loss" in _diag:
            pnurl_s_losses.append(_to_float_or_nan(_diag["pnurl_s_loss"]))
        if "pnurl_b_loss" in _diag:
            pnurl_b_losses.append(_to_float_or_nan(_diag["pnurl_b_loss"]))
        if "pnurl_s_sim" in _diag:
            pnurl_s_sims.append(_to_float_or_nan(_diag["pnurl_s_sim"]))
        if "pnurl_b_sim" in _diag:
            pnurl_b_sims.append(_to_float_or_nan(_diag["pnurl_b_sim"]))
        # Extract PromptNu-guided v3.1 keys from per-sample diagnostics sub-dict
        if "v3_struct_loss" in _diag:
            v3_s_losses.append(_to_float_or_nan(_diag["v3_struct_loss"]))
        if "v3_bound_loss" in _diag:
            v3_b_losses.append(_to_float_or_nan(_diag["v3_bound_loss"]))
        if "v3_s_sim" in _diag:
            v3_s_sims.append(_to_float_or_nan(_diag["v3_s_sim"]))
        if "v3_b_sim" in _diag:
            v3_b_sims.append(_to_float_or_nan(_diag["v3_b_sim"]))
        if "v3_text_proj_norm" in _diag:
            v3_text_proj_norms.append(_to_float_or_nan(_diag["v3_text_proj_norm"]))
        if "v3_vis_proj_norm" in _diag:
            v3_vis_proj_norms.append(_to_float_or_nan(_diag["v3_vis_proj_norm"]))
        if "v3_text_scale_mean" in _diag:
            v3_text_scale_means.append(_to_float_or_nan(_diag["v3_text_scale_mean"]))
        if "v3_text_scale_std" in _diag:
            v3_text_scale_stds.append(_to_float_or_nan(_diag["v3_text_scale_std"]))
        if "v3_guided_delta_ratio" in _diag:
            v3_guided_delta_ratios.append(_to_float_or_nan(_diag["v3_guided_delta_ratio"]))

    if gate_vals:
        gate_all = torch.cat(gate_vals)
        gate_mean = float(gate_all.mean().cpu().item())
        gate_min = float(gate_all.min().cpu().item())
        gate_max = float(gate_all.max().cpu().item())
    else:
        gate_mean = gate_min = gate_max = float("nan")

    def finite_mean(values):
        values = [x for x in values if not np.isnan(x)]
        return float(np.mean(values)) if values else float("nan")

    return {
        "semantic_channel_gate_mean": gate_mean,
        "semantic_channel_gate_min": gate_min,
        "semantic_channel_gate_max": gate_max,
        "semantic_delta_norm": finite_mean(delta_norms),
        "base_feat_norm": finite_mean(base_norms),
        "injected_delta_norm": finite_mean(injected_norms),
        "injection_ratio": finite_mean(injection_ratios),
        "semantic_delta_reg_loss": finite_mean(delta_reg_losses),
        "semantic_delta_ratio": finite_mean(delta_ratios),
        "semantic_delta_raw_norm": finite_mean(raw_norms),
        "semantic_delta_direction_norm": finite_mean(direction_norms),
        # PromptNu-lite v2: Residual-Coupled Semantic Alignment (canonical keys)
        "promptnu_lite_struct_loss": finite_mean(pnurl_s_losses),
        "promptnu_lite_boundary_loss": finite_mean(pnurl_b_losses),
        "promptnu_lite_struct_sim": finite_mean(pnurl_s_sims),
        "promptnu_lite_boundary_sim": finite_mean(pnurl_b_sims),
        # PromptNu-guided v3.1: separate struct/bound alignment losses
        "v3_struct_loss": finite_mean(v3_s_losses),
        "v3_bound_loss": finite_mean(v3_b_losses),
        # PromptNu-guided v3.1: diagnostic metrics
        "v3_s_sim": finite_mean(v3_s_sims),
        "v3_b_sim": finite_mean(v3_b_sims),
        "v3_text_proj_norm": finite_mean(v3_text_proj_norms),
        "v3_vis_proj_norm": finite_mean(v3_vis_proj_norms),
        # PromptNu-guided v3.1: text-scale & delta-ratio diagnostics
        "v3_text_scale_mean": finite_mean(v3_text_scale_means),
        "v3_text_scale_std": finite_mean(v3_text_scale_stds),
        "v3_guided_delta_ratio": finite_mean(v3_guided_delta_ratios),
    }


def collect_spatial_sb_diagnostics(outputs: List[Dict]):
    """Collect detached P3 diagnostics without participating in autograd."""
    keys = {
        "spatial_structure_prob_mean": "spatial_structure_prob_mean",
        "spatial_structure_prob_std": "spatial_structure_prob_std",
        "spatial_boundary_prob_mean": "spatial_boundary_prob_mean",
        "spatial_boundary_prob_std": "spatial_boundary_prob_std",
        "spatial_structure_delta_norm": "spatial_structure_delta_norm",
        "spatial_boundary_delta_norm": "spatial_boundary_delta_norm",
        "spatial_structure_injected_ratio": "freqpath_b1_low_spatial_sb_injected_ratio",
        "spatial_boundary_injected_ratio": "freqpath_b2_high_spatial_sb_injected_ratio",
        "gamma_structure_value": "gamma_structure",
        "gamma_boundary_value": "gamma_boundary",
    }
    collected = {name: [] for name in keys}
    for out in outputs:
        nested = out.get("diagnostics", {}) or {}
        for meter_name, source_key in keys.items():
            value = out.get(source_key, nested.get(source_key))
            if value is None:
                continue
            if torch.is_tensor(value):
                if value.numel() == 0:
                    continue
                value = float(value.detach().float().mean().cpu().item())
            else:
                try:
                    value = float(value)
                except (TypeError, ValueError):
                    continue
            if np.isfinite(value):
                collected[meter_name].append(value)
    return {
        name: (float(np.mean(values)) if values else float("nan"))
        for name, values in collected.items()
    }


def collect_spatial_sb_gradient_norms(model: nn.Module):
    """Read active SGA-SB gradients after unscale and before clipping."""
    raw_model = unwrap_model(model)
    head_sq = 0.0
    adapter_sq = 0.0
    for name, param in raw_model.named_parameters():
        if param.grad is None:
            continue
        grad_norm = float(param.grad.detach().float().norm().cpu().item())
        if name.startswith(("spatial_structure_head.", "spatial_boundary_head.")):
            head_sq += grad_norm * grad_norm
        elif name.startswith(("spatial_structure_adapter.", "spatial_boundary_adapter.")):
            adapter_sq += grad_norm * grad_norm
    return {
        "spatial_head_grad_norm": head_sq ** 0.5,
        "spatial_adapter_grad_norm": adapter_sq ** 0.5,
    }


def _write_scalar_if_finite(writer, tag: str, value: float, step: int):
    if value is None:
        return
    if isinstance(value, float) and (np.isnan(value) or np.isinf(value)):
        return
    writer.add_scalar(tag, value, step)


def _as_attr_label_tensor(attr_label, device: torch.device) -> Optional[torch.Tensor]:
    if attr_label is None:
        return None

    if isinstance(attr_label, torch.Tensor):
        label = attr_label.detach().to(device=device).view(-1).long()
    else:
        try:
            label = torch.as_tensor(attr_label, device=device).view(-1).long()
        except Exception:
            return None

    if label.numel() < len(ATTRIBUTE_LOGIT_KEYS):
        return None

    return label[: len(ATTRIBUTE_LOGIT_KEYS)]


def _accumulate_attribute_accuracy(out: Dict, attr_label, correct: Dict[str, int], total: Dict[str, int], device: torch.device):
    attr_logits = out.get("attr_logits", None)
    if not isinstance(attr_logits, dict):
        return

    label = _as_attr_label_tensor(attr_label, device=device)
    if label is None:
        return

    for idx, key in enumerate(ATTRIBUTE_LOGIT_KEYS):
        logits = attr_logits.get(key, None)
        if logits is None or not torch.is_tensor(logits):
            continue

        logits = logits.detach()
        if logits.dim() == 1:
            logits = logits.unsqueeze(0)
        if logits.dim() < 2 or logits.shape[0] < 1:
            continue

        target = int(label[idx].item())
        if target < 0 or target == 255 or target >= logits.shape[1]:
            continue

        pred = int(torch.argmax(logits[0].float(), dim=-1).item())
        correct[key] += int(pred == target)
        total[key] += 1


def _format_attr_acc(stats: Dict[str, float]) -> str:
    parts = []
    valid_values = []
    for key in ATTRIBUTE_LOGIT_KEYS:
        value = stats.get(f"attr_acc_{key}", float("nan"))
        if value is not None and not np.isnan(value):
            valid_values.append(float(value))
            parts.append(f"{ATTRIBUTE_LOG_DISPLAY[key]}:{value:.3f}")
        else:
            parts.append(f"{ATTRIBUTE_LOG_DISPLAY[key]}:nan")

    mean_value = float(np.mean(valid_values)) if valid_values else float("nan")
    if np.isnan(mean_value):
        return "Mean:nan, " + ", ".join(parts)
    return f"Mean:{mean_value:.3f}, " + ", ".join(parts)


def _current_attr_acc_mean(meters: Dict[str, List[float]]) -> float:
    values = []
    for key in ATTRIBUTE_LOGIT_KEYS:
        meter_key = f"attr_acc_{key}"
        if meter_key not in meters or len(meters[meter_key]) == 0:
            continue
        value = meters[meter_key][-1]
        if value is not None and not np.isnan(value):
            values.append(float(value))
    return float(np.mean(values)) if values else float("nan")


def _autocast_context(args):
    if not torch.cuda.is_available():
        return torch.autocast(device_type="cpu", dtype=torch.bfloat16, enabled=False)
    return autocast("cuda", enabled=args.use_amp, dtype=torch.bfloat16)


# ==================================================================================================
# 5. Training logic
# ==================================================================================================
def train_one_epoch(args, model, optimizer, train_loader, epoch, criterion, scaler, writer, rank):
    model.train()
    stage = args.phase

    # Reset per-epoch warning counter for PHASE_D_INSTANCE_ALIGN_WARNING frequency limiting
    _raw_model_for_reset = unwrap_model(model)
    if hasattr(_raw_model_for_reset, "reset_instance_align_warning_count"):
        _raw_model_for_reset.reset_instance_align_warning_count()

    # ── Numeric Attr FreqPath snapshot (Exp5): one-shot at train start for delta_norm_from_start ──
    if getattr(args, "enable_numeric_attr_freqpath_guidance", False):
        _numeric_freqpath_take_snapshot(_raw_model_for_reset)

    # --- Batch limit logic: debug_max_* takes priority over max_* (Phase D) ---
    _debug_max_train = getattr(args, "debug_max_train_batches", None)
    _max_train = getattr(args, "max_train_batches", None)
    if _debug_max_train is not None and int(_debug_max_train) > 0:
        train_limit = int(_debug_max_train)
        _limit_source = "debug_max_train_batches"
    elif _max_train is not None and int(_max_train) > 0:
        train_limit = int(_max_train)
        _limit_source = "max_train_batches"
    else:
        train_limit = None
        _limit_source = "none"

    effective_total = min(len(train_loader), train_limit) if train_limit else len(train_loader)

    if rank == 0:
        if train_limit is not None:
            print(
                f"[PHASE_D_LIMIT] train_limit={train_limit} | source={_limit_source} | "
                f"effective_total={effective_total} | total_dataloader={len(train_loader)}",
                flush=True,
            )
        pbar = tqdm(train_loader, desc=f"Ep {epoch + 1} Train [{stage}]", total=effective_total)
    else:
        pbar = train_loader

    meters = {
        "total": [],
        "mask": [],
        "heatmap": [],
        "hv": [],
        "pnurl": [],
        "density": [],
        "semantic_channel_gate_mean": [],
        "semantic_channel_gate_min": [],
        "semantic_channel_gate_max": [],
        "semantic_delta_norm": [],
        "base_feat_norm": [],
        "injected_delta_norm": [],
        "injection_ratio": [],
        "semantic_delta_reg_loss": [],
        "semantic_delta_ratio": [],
        "semantic_delta_raw_norm": [],
        "semantic_delta_direction_norm": [],
        "semantic_stability": [],
        "injection_penalty": [],
        "attr_acc_color": [],
        "attr_acc_shape": [],
        "attr_acc_arrange": [],
        "attr_acc_size": [],
        "attr_acc_density": [],
        "attr_loss_color": [],
        "attr_loss_shape": [],
        "attr_loss_arrange": [],
        "attr_loss_size": [],
        "attr_loss_density": [],
        "promptnu_lite_align_loss": [],
        "promptnu_lite_struct_loss": [],
        "promptnu_guided_v3_align_loss": [],
        "promptnu_lite_boundary_loss": [],
        "promptnu_lite_struct_sim": [],
        "promptnu_lite_boundary_sim": [],
        "spatial_structure": [],
        "spatial_boundary": [],
        "spatial_sb": [],
        "spatial_structure_prob_mean": [],
        "spatial_structure_prob_std": [],
        "spatial_boundary_prob_mean": [],
        "spatial_boundary_prob_std": [],
        "spatial_structure_delta_norm": [],
        "spatial_boundary_delta_norm": [],
        "spatial_structure_injected_ratio": [],
        "spatial_boundary_injected_ratio": [],
        "gamma_structure_value": [],
        "gamma_boundary_value": [],
        "spatial_head_grad_norm": [],
        "spatial_adapter_grad_norm": [],
    }

    optimizer.zero_grad(set_to_none=True)

    for batch_idx, batched_input in enumerate(pbar):
        _spatial_grad_diag = {
            "spatial_head_grad_norm": float("nan"),
            "spatial_adapter_grad_norm": float("nan"),
        }
        if train_limit is not None and batch_idx >= train_limit:
            break
        batched_input = to_device(batched_input, args.device)
        images = batched_input["image"]
        labels = batched_input["label"]

        if images.shape[-1] != args.image_size:
            images = F.interpolate(images, size=(args.image_size, args.image_size), mode="bilinear", align_corners=False)
            labels = F.interpolate(labels.float(), size=(args.image_size, args.image_size), mode="nearest").long()

        organ_ids = batched_input.get("organ_id", None)
        attr_labels = batched_input.get("attr_labels", None)
        dynamic_text = batched_input.get("text_prompt", ["Cell nuclei"] * len(images))
        dynamic_attr_text = batched_input.get("attribute_text", ["Cell nuclei"] * len(images))

        # ── Phase D: extract attribute labels from batch if present ──
        _d_structure_attr_labels = batched_input.get("structure_attr_labels", None)
        _d_boundary_attr_labels = batched_input.get("boundary_attr_labels", None)
        _d_per_instance_attr_labels = batched_input.get("per_instance_attr_labels", None)
        _d_per_instance_ids = batched_input.get("per_instance_ids", None)
        _d_label_inst = batched_input.get("label_inst", None)

        # ── [SB_ATTR_BATCH_AUDIT]: verify SB attrs in batch (pnudp_dense_train, rank0, first batch) ──
        if batch_idx == 0 and rank == 0 and args.phase == "pnudp_dense_train":
            _audit_has_struct = _d_structure_attr_labels is not None
            _audit_has_bound = _d_boundary_attr_labels is not None
            _audit_struct_shape = tuple(_d_structure_attr_labels.shape) if _audit_has_struct else "N/A"
            _audit_bound_shape = tuple(_d_boundary_attr_labels.shape) if _audit_has_bound else "N/A"
            _audit_has_sb_flag = batched_input.get("has_structure_boundary_attrs", None)
            _audit_first_struct = _d_structure_attr_labels[0].tolist() if _audit_has_struct else "N/A"
            _audit_first_bound = _d_boundary_attr_labels[0].tolist() if _audit_has_bound else "N/A"
            _audit_first_struct_vals = batched_input.get("structure_attr_values", None)
            _audit_first_bound_vals = batched_input.get("boundary_attr_values", None)
            _audit_first_struct_val = _audit_first_struct_vals[0].tolist() if _audit_first_struct_vals is not None else "N/A"
            _audit_first_bound_val = _audit_first_bound_vals[0].tolist() if _audit_first_bound_vals is not None else "N/A"
            print(
                f"\n[SB_ATTR_BATCH_AUDIT] phase={args.phase} | "
                f"has_structure_attr_labels={_audit_has_struct} | "
                f"has_boundary_attr_labels={_audit_has_bound} | "
                f"structure_attr_labels_shape={_audit_struct_shape} | "
                f"boundary_attr_labels_shape={_audit_bound_shape} | "
                f"has_structure_boundary_attrs_flag_type={type(_audit_has_sb_flag).__name__} | "
                f"first_sample_structure_attr_labels={_audit_first_struct} | "
                f"first_sample_boundary_attr_labels={_audit_first_bound} | "
                f"first_sample_structure_attr_values={_audit_first_struct_val} | "
                f"first_sample_boundary_attr_values={_audit_first_bound_val}",
                flush=True,
            )

        if getattr(args, "asr_regression", False):
            dynamic_text = ["Cell nuclei"] * len(images)
            dynamic_attr_text = ["Cell nuclei"] * len(images)
            attr_labels = None

        model_input = []
        for i in range(len(images)):
            curr_id = 20
            if organ_ids is not None:
                val = organ_ids[i]
                curr_id = val.item() if isinstance(val, torch.Tensor) else val
            item = {
                "image": images[i],
                "original_size": (args.image_size, args.image_size),
                "organ_id": curr_id,
                "attribute_text": dynamic_attr_text[i],
                "text_prompt": dynamic_text[i],
                "attr_labels": attr_labels[i] if attr_labels is not None else None,
            }
            # Phase D attr fields (passed through to sam.py forward)
            if _d_structure_attr_labels is not None:
                item["structure_attr_labels"] = _d_structure_attr_labels[i]
            if _d_boundary_attr_labels is not None:
                item["boundary_attr_labels"] = _d_boundary_attr_labels[i]
            if _d_per_instance_attr_labels is not None:
                item["per_instance_attr_labels"] = _d_per_instance_attr_labels[i]
            if _d_per_instance_ids is not None:
                item["per_instance_ids"] = _d_per_instance_ids[i] if isinstance(_d_per_instance_ids, list) else _d_per_instance_ids
            if _d_label_inst is not None:
                item["label_inst"] = _d_label_inst[i]
            model_input.append(item)

        # ── Phase D model_input audit (rank0, first train batch only) ──
        if batch_idx == 0 and rank == 0 and args.phase == "semantic_injection":
            print(
                f"\n[PHASE_D_MODEL_INPUT_AUDIT] keys={list(model_input[0].keys()) if model_input else 'empty'}",
                flush=True,
            )
            if _d_structure_attr_labels is not None:
                print(
                    f"[PHASE_D_MODEL_INPUT_AUDIT] structure_attr_labels shape="
                    f"{tuple(_d_structure_attr_labels.shape)}",
                    flush=True,
                )
            if _d_boundary_attr_labels is not None:
                print(
                    f"[PHASE_D_MODEL_INPUT_AUDIT] boundary_attr_labels shape="
                    f"{tuple(_d_boundary_attr_labels.shape)}",
                    flush=True,
                )
            if _d_per_instance_attr_labels is not None:
                _pi_type = "list" if isinstance(_d_per_instance_attr_labels, list) else "tensor"
                _pi_shapes = (
                    [tuple(t.shape) for t in _d_per_instance_attr_labels]
                    if isinstance(_d_per_instance_attr_labels, list)
                    else tuple(_d_per_instance_attr_labels.shape)
                )
                print(
                    f"[PHASE_D_MODEL_INPUT_AUDIT] per_instance_attr_labels type={_pi_type} | "
                    f"shapes={_pi_shapes}",
                    flush=True,
                )
            if _d_label_inst is not None:
                print(
                    f"[PHASE_D_MODEL_INPUT_AUDIT] label_inst shape={tuple(_d_label_inst.shape)}",
                    flush=True,
                )

        with _autocast_context(args):
            outputs = model(model_input, multimask_output=True)

            # ── Phase D gate audit: forward diagnostics (rank0, first 2 batches) ──
            if rank == 0 and args.phase == "semantic_injection":
                _phase_d_gate_audit_forward(outputs, unwrap_model(model), batch_idx, args)

            # ── PNuDP Dense Training: per-batch audit accumulators ──
            _pnudp_dense_seg_base_batch = 0.0
            _pnudp_dense_seg_fused_lr_batch = 0.0
            _pnudp_dense_sample_count = 0

            loss_batch = torch.tensor(0.0, device=args.device)
            accum = {
                "mask": 0.0,
                "heatmap": 0.0,
                "hv": 0.0,
                "pnurl": 0.0,
                "density": 0.0,
                "semantic_stability": 0.0,
                "injection_penalty": 0.0,
                "promptnu_lite_align_loss": 0.0,
                "promptnu_guided_v3_align_loss": 0.0,
                "spatial_structure": 0.0,
                "spatial_boundary": 0.0,
                "spatial_sb": 0.0,
            }
            attr_correct = {key: 0 for key in ATTRIBUTE_LOGIT_KEYS}
            attr_total = {key: 0 for key in ATTRIBUTE_LOGIT_KEYS}
            attr_loss_accum = {key: 0.0 for key in ATTRIBUTE_LOGIT_KEYS}
            attr_loss_count = {key: 0 for key in ATTRIBUTE_LOGIT_KEYS}
            # ── PNuDP Dense Train: shape audit accumulators (for PNUDP_DENSE_TRAIN_AUDIT) ──
            _pnudp_dense_loss_shape_print = {}  # stores shape strings for audit

            # ── SGA-SB v1 CORRECTION: batch-level spatial structure/boundary targets ──
            _spatial_sb_targets = None
            if args.spatial_sb_mode != "none":
                _label_inst_items = [item.get("label_inst", None) for item in model_input]
                if not _label_inst_items or any(item is None for item in _label_inst_items):
                    raise RuntimeError("SGA-SB requires label_inst for every training sample.")
                _label_inst_batch = torch.stack(_label_inst_items, dim=0).to(
                    device=args.device, dtype=torch.float32
                )
                _use_structure = args.spatial_sb_branch in ("structure", "both")
                _use_boundary = args.spatial_sb_branch in ("boundary", "both")
                _structure_target = None
                _boundary_target = None
                if _use_structure:
                    if torch.count_nonzero(_label_inst_batch).item() == 0:
                        _structure_target = torch.zeros(
                            (_label_inst_batch.shape[0], 1, 64, 64),
                            device=args.device,
                            dtype=torch.float32,
                        )
                    else:
                        _structure_target = generate_structure_target(
                            _label_inst_batch,
                            kernel_size=31,
                            target_size=(64, 64),
                        ).to(device=args.device, dtype=torch.float32)
                    if (not torch.isfinite(_structure_target).all()
                            or _structure_target.min() < 0
                            or _structure_target.max() > 1):
                        raise RuntimeError("Invalid SGA-SB structure target: expected finite float values in [0, 1].")
                if _use_boundary:
                    _boundary_target = generate_boundary_target(
                        _label_inst_batch,
                        kernel_size=3,
                        target_size=(64, 64),
                    ).to(device=args.device, dtype=torch.float32)
                    if (not torch.isfinite(_boundary_target).all()
                            or not torch.all((_boundary_target == 0) | (_boundary_target == 1))):
                        raise RuntimeError("Invalid SGA-SB boundary target: expected finite binary float values.")
                _spatial_sb_targets = {
                    "structure_target": _structure_target,
                    "boundary_target": _boundary_target,
                }

            for i, out in enumerate(outputs):
                pred_mask, pred_iou, gt_mask = _get_best_mask_and_iou(out, labels[i])

                loss_m = _compute_mask_loss(criterion, pred_mask, pred_iou, gt_mask)

                # ── Local helper: ensure mask is [B,1,H,W] ──
                def _ensure_b1hw_mask(mask, target_hw):
                    # input possible shapes:
                    #   [H,W]
                    #   [B,H,W]
                    #   [B,1,H,W]
                    #   [B,1,1,H,W]   # accidental extra dim, should squeeze
                    #   [B,C,H,W]     # if C>1, take first channel or raise
                    if mask.dim() == 5 and mask.shape[1] == 1:
                        mask = mask.squeeze(1)  # [B,1,H,W] or [B,H,W] depending original
                    if mask.dim() == 2:
                        mask = mask.unsqueeze(0).unsqueeze(0)  # [1,1,H,W]
                    elif mask.dim() == 3:
                        mask = mask.unsqueeze(1)               # [B,1,H,W]
                    elif mask.dim() == 4:
                        if mask.shape[1] != 1:
                            mask = mask[:, :1]                 # take first channel
                    else:
                        raise RuntimeError(f"Unsupported mask dim: {mask.shape}")
                    mask = mask.float()
                    if mask.shape[-2:] != target_hw:
                        mask = F.interpolate(mask, size=target_hw, mode="nearest")
                    assert mask.dim() == 4 and mask.shape[1] == 1, \
                        f"mask must be [B,1,H,W], got {mask.shape}"
                    return mask

                # ── PNuDP Dense Training: compute seg_loss_base from low_res_logits_base ──
                _seg_base_loss_val = None
                _seg_fused_lr_loss_val = None
                if args.phase == "pnudp_dense_train" and "low_res_logits_base" in out:
                    _base_lr_raw = out["low_res_logits_base"]   # [1, 3, 128, 128] or [3, 128, 128]
                    _fused_lr_raw = out["low_res_logits"]        # [1, 3, 128, 128] or [3, 128, 128]
                    _target_mask_raw = labels[i].float()         # shape varies

                    # ── Dtype audit: raw inputs dtype before any processing ──
                    print(
                        f"\n[PNUDP_DENSE_TRAIN_DTYPE_AUDIT] "
                        f"base_logits_raw_dtype={str(_base_lr_raw.dtype)} | "
                        f"fused_logits_raw_dtype={str(_fused_lr_raw.dtype)} | "
                        f"target_mask_raw_dtype={str(_target_mask_raw.dtype)}",
                        flush=True,
                    )

                    # ── Shape audit: print raw shapes before alignment ──
                    print(
                        f"\n[PNUDP_DENSE_TRAIN_LOSS_SHAPE_AUDIT] "
                        f"base_logits_raw_shape={tuple(_base_lr_raw.shape)} | "
                        f"fused_logits_raw_shape={tuple(_fused_lr_raw.shape)} | "
                        f"target_mask_raw_shape={tuple(_target_mask_raw.shape)}",
                        flush=True,
                    )

                    # Strip batch dim if present → [3, H, W] and force FP32
                    _base_lr = _base_lr_raw.squeeze(0).float() if _base_lr_raw.dim() == 4 else _base_lr_raw.float()
                    _fused_lr = _fused_lr_raw.squeeze(0).float() if _fused_lr_raw.dim() == 4 else _fused_lr_raw.float()

                    # ── Raw fused_minus_base_l1 (before any channel selection) ──
                    # This is the true logits-level diff on the full [3, H, W] tensors.
                    _raw_fused_minus_base_l1 = float(
                        (_fused_lr.detach() - _base_lr.detach()).abs().mean().item()
                    )

                    _best_idx = torch.argmax(out["iou_predictions"][0]).item()

                    # Build 1-channel logits for loss computation
                    if _base_lr.shape[0] > 1:
                        # Multimask output: select best channel by iou_prediction
                        # CRITICAL: Use the SAME _best_idx for both base and fused
                        _base_lr_for_loss = _base_lr[_best_idx:_best_idx + 1].unsqueeze(0)   # [1, 1, H, W]
                        _fused_lr_for_loss = _fused_lr[_best_idx:_best_idx + 1].unsqueeze(0)  # [1, 1, H, W]
                        _selected_mode = "best_channel"
                    else:
                        # Single channel
                        _base_lr_for_loss = _base_lr.unsqueeze(0)   # [1, 1, H, W]
                        _fused_lr_for_loss = _fused_lr.unsqueeze(0)  # [1, 1, H, W]
                        _selected_mode = "single_channel"

                    # ── Best-channel selection audit ──
                    with torch.no_grad():
                        # Confirm both use the same channel index
                        if _selected_mode == "best_channel":
                            _sel_ch_base = _best_idx
                            _sel_ch_fused = _best_idx
                        else:
                            _sel_ch_base = 0
                            _sel_ch_fused = 0
                        print(
                            f"[PNUDP_DENSE_BEST_CHANNEL_AUDIT] "
                            f"selected_channel_base={_sel_ch_base} | "
                            f"selected_channel_fused={_sel_ch_fused} | "
                            f"selected_channel_same={_sel_ch_base == _sel_ch_fused} | "
                            f"selection_mode={_selected_mode}",
                            flush=True,
                        )

                    # ── Loss fused_minus_base_l1 (after channel selection) ──
                    _loss_fused_minus_base_l1 = float(
                        (_fused_lr_for_loss.detach() - _base_lr_for_loss.detach()).abs().mean().item()
                    )
                    # FP32 dtype assertion audit
                    _base_for_loss_dtype = str(_base_lr_for_loss.dtype)
                    _fused_for_loss_dtype = str(_fused_lr_for_loss.dtype)
                    print(
                        f"[PNUDP_DENSE_LOSS_FP32_AUDIT] "
                        f"base_lr_for_loss_dtype={_base_for_loss_dtype} | "
                        f"fused_lr_for_loss_dtype={_fused_for_loss_dtype} | "
                        f"all_fp32={_base_for_loss_dtype == 'torch.float32' and _fused_for_loss_dtype == 'torch.float32'}",
                        flush=True,
                    )

                    # Resize GT mask via helper → [B,1,H,W]
                    _logits_hw = _base_lr.shape[-2:]  # (128, 128)
                    _mask_for_loss = _ensure_b1hw_mask(_target_mask_raw, _logits_hw)
                    _mask_for_loss = (_mask_for_loss > 0).float()
                    _dummy_iou = torch.tensor([1.0], device=args.device)

                    # ── Shape match audit ──
                    _shape_match_base = (_base_lr_for_loss.shape == _mask_for_loss.shape)
                    _shape_match_fused = (_fused_lr_for_loss.shape == _mask_for_loss.shape)
                    print(
                        f"[PNUDP_DENSE_TRAIN_LOSS_SHAPE_AUDIT] "
                        f"target_mask_raw_shape={tuple(_target_mask_raw.shape)} | "
                        f"target_mask_after_squeeze_shape={tuple(_mask_for_loss.shape)} | "
                        f"mask_for_loss_shape={tuple(_mask_for_loss.shape)} | "
                        f"base_logits_for_loss_shape={tuple(_base_lr_for_loss.shape)} | "
                        f"fused_logits_for_loss_shape={tuple(_fused_lr_for_loss.shape)} | "
                        f"shape_match_base={_shape_match_base} | "
                        f"shape_match_fused={_shape_match_fused}",
                        flush=True,
                    )
                    if not _shape_match_base or not _shape_match_fused:
                        raise RuntimeError(
                            f"[PNUDP_DENSE_TRAIN_LOSS_SHAPE_AUDIT] shape mismatch: "
                            f"base={tuple(_base_lr_for_loss.shape)}, "
                            f"fused={tuple(_fused_lr_for_loss.shape)}, "
                            f"mask={tuple(_mask_for_loss.shape)}"
                        )

                    # Store shape info for PNUDP_DENSE_TRAIN_AUDIT
                    _pnudp_dense_loss_shape_print = {
                        "base_logits_for_loss_shape": str(tuple(_base_lr_for_loss.shape)),
                        "fused_logits_for_loss_shape": str(tuple(_fused_lr_for_loss.shape)),
                        "mask_for_loss_shape": str(tuple(_mask_for_loss.shape)),
                        "selected_mask_channel": _selected_mode,
                    }

                    # ── PNuDP Dense Loss Consistency Audit ──
                    # Re-compute fused_minus_base_l1 from raw logits in train.py
                    # and compare with the expected alpha * mean(abs(bias)).
                    _pnudp_debug_info = out.get("pnudp_dense_debug", {})
                    _debug_alpha = _pnudp_debug_info.get("dense_alpha_value", float("nan"))
                    # Use the RESIZED bias stats for correct comparison
                    _debug_bias_abs_mean = _pnudp_debug_info.get("pnudp_bias_abs_mean_resized",
                                            _pnudp_debug_info.get("pnudp_bias_abs_mean", float("nan")))
                    _debug_alpha_x_bias = _debug_alpha * _debug_bias_abs_mean if not (
                        isinstance(_debug_alpha, float) and math.isnan(_debug_alpha)
                    ) else float("nan")
                    _selected_channel_fused_minus_base_l1 = _loss_fused_minus_base_l1
                    _selected_channel_ratio = _loss_fused_minus_base_l1 / (abs(_debug_alpha_x_bias) + 1e-12)
                    print(
                        f"[PNUDP_DENSE_LOSS_CONSISTENCY] "
                        f"base_logits_raw_shape={tuple(_base_lr_raw.shape)} | "
                        f"fused_logits_raw_shape={tuple(_fused_lr_raw.shape)} | "
                        f"bias_shape_info={_pnudp_debug_info.get('pnudp_bias_shape_after_resize', 'N/A')} | "
                        f"alpha={_debug_alpha:.12e} | "
                        f"raw_fused_minus_base_l1={_raw_fused_minus_base_l1:.12e} | "
                        f"loss_fused_minus_base_l1={_loss_fused_minus_base_l1:.12e} | "
                        f"alpha_x_bias_abs_mean={_debug_alpha_x_bias:.12e} | "
                        f"raw_ratio={_raw_fused_minus_base_l1 / (abs(_debug_alpha_x_bias) + 1e-12):.6e} | "
                        f"loss_ratio={_loss_fused_minus_base_l1 / (abs(_debug_alpha_x_bias) + 1e-12):.6e} | "
                        f"selected_channel_fused_minus_base_l1={_selected_channel_fused_minus_base_l1:.12e} | "
                        f"selected_channel_ratio={_selected_channel_ratio:.6e}",
                        flush=True,
                    )

                    # FP32 guard: ensure criterion inputs are FP32
                    _mask_for_loss_dtype = str(_mask_for_loss.dtype)
                    _base_for_criterion_dtype = str(_base_lr_for_loss.dtype)
                    _fused_for_criterion_dtype = str(_fused_lr_for_loss.dtype)
                    print(
                        f"[PNUDP_DENSE_CRITERION_FP32_AUDIT] "
                        f"base_for_criterion_dtype={_base_for_criterion_dtype} | "
                        f"fused_for_criterion_dtype={_fused_for_criterion_dtype} | "
                        f"mask_for_criterion_dtype={_mask_for_loss_dtype} | "
                        f"all_fp32={_base_for_criterion_dtype == 'torch.float32' and _fused_for_criterion_dtype == 'torch.float32' and _mask_for_loss_dtype == 'torch.float32'}",
                        flush=True,
                    )

                    # Base loss (unfused low_res_logits) — all FP32
                    _seg_base_loss_val, _ = criterion(
                        _base_lr_for_loss.float(),
                        _mask_for_loss.float(),
                        _dummy_iou,
                    )
                    # Fused loss at low resolution for fair comparison — all FP32
                    _seg_fused_lr_loss_val, _ = criterion(
                        _fused_lr_for_loss.float(),
                        _mask_for_loss.float(),
                        _dummy_iou,
                    )
                    _pnudp_dense_seg_base_batch += float(_seg_base_loss_val.detach().item())
                    _pnudp_dense_seg_fused_lr_batch += float(_seg_fused_lr_loss_val.detach().item())
                    _pnudp_dense_sample_count += 1

                loss_h = _compute_heatmap_loss(out, labels[i])
                loss_hv = _compute_hv_loss(out, labels[i], batched_input, i)
                loss_pnurl = out.get("pnurl_loss", _zero_like_loss(args.device))
                loss_pnurl_lite = out.get("promptnu_lite_align_loss", _zero_like_loss(args.device))
                loss_pnurl_v3 = out.get("promptnu_guided_v3_align_loss", _zero_like_loss(args.device))
                loss_d = _compute_density_loss(out, labels[i], pred_mask, stage=stage, epoch=epoch)
                loss_semantic_stability, loss_delta_reg, loss_injection_penalty = _compute_semantic_stability_loss(
                    out,
                    args=args,
                    device=args.device,
                )

                # ── SGA-SB v1 CORRECTION: Spatial Structure + Boundary Loss ──
                loss_structure = torch.tensor(0.0, device=args.device)
                loss_boundary = torch.tensor(0.0, device=args.device)
                loss_spatial_sb = torch.tensor(0.0, device=args.device)
                structure_logits_i = out.get("structure_logits", None)
                boundary_logits_i = out.get("boundary_logits", None)
                if _spatial_sb_targets is not None:
                    _struct_tgt = _spatial_sb_targets.get("structure_target", None)
                    _bound_tgt = _spatial_sb_targets.get("boundary_target", None)
                    if structure_logits_i is not None and _struct_tgt is not None:
                        loss_structure = compute_structure_loss(
                            structure_logits_i.unsqueeze(0),  # [1, 1, 64, 64]
                            _struct_tgt[i:i+1].to(device=structure_logits_i.device, dtype=torch.float32),
                        ) * args.spatial_structure_loss_weight
                    if boundary_logits_i is not None and _bound_tgt is not None:
                        loss_boundary = compute_boundary_loss(
                            boundary_logits_i.unsqueeze(0),  # [1, 1, 64, 64]
                            _bound_tgt[i:i+1].to(device=boundary_logits_i.device, dtype=torch.float32),
                        ) * args.spatial_boundary_loss_weight
                    loss_spatial_sb = loss_structure + loss_boundary
                    if not torch.isfinite(loss_spatial_sb).all():
                        raise RuntimeError("SGA-SB produced NaN/Inf loss.")

                if stage == "vision":
                    if (
                        getattr(args, "asr_regression", False)
                        and getattr(args, "asr_regression_stage", "finetune_decoder") == "freeze_decoder"
                    ):
                        loss_i = args.heatmap_weight * loss_h + args.hv_weight * loss_hv
                    else:
                        loss_i = (
                            args.mask_weight * loss_m
                            + args.heatmap_weight * loss_h
                            + args.hv_weight * loss_hv
                        )
                elif stage == "pnurl_warmup":
                    loss_i = (
                        args.pnurl_weight * loss_pnurl
                        + args.density_map_weight * loss_d
                    )
                else:
                    loss_i = (
                        args.mask_weight * loss_m
                        + args.heatmap_weight * loss_h
                        + args.hv_weight * loss_hv
                        + args.pnurl_weight * loss_pnurl
                        + args.density_map_weight * loss_d
                        + loss_semantic_stability
                        + loss_pnurl_lite
                        + loss_pnurl_v3
                    )

                if args.spatial_sb_mode != "none":
                    loss_i = loss_i + loss_spatial_sb

                # ── [PROMPTNU_GUIDED_V3_GRAPH_AUDIT][total_loss] ──
                if (
                    rank == 0
                    and batch_idx < 2
                    and args.phase == "semantic_injection"
                    and getattr(args, "enable_promptnu_guided_v3", False)
                ):
                    _pg3 = loss_pnurl_v3
                    _pg3_is_tensor = torch.is_tensor(_pg3)
                    _pg3_key_found = "promptnu_guided_v3_align_loss" in out
                    _pg3_added = _pg3_key_found  # added if key exists in out dict
                    _pg3_req_grad = _pg3.requires_grad if _pg3_is_tensor else False
                    _pg3_val = float(_pg3.detach().item()) if _pg3_is_tensor else 0.0
                    _loss_i_req_grad = loss_i.requires_grad if torch.is_tensor(loss_i) else False
                    # Compute total_loss_requires_grad after loss_batch+loss_i
                    _total_loss_req_grad = (loss_batch + loss_i).requires_grad if torch.is_tensor(loss_batch) and torch.is_tensor(loss_i) else False
                    print(
                        f"\n[PROMPTNU_GUIDED_V3_GRAPH_AUDIT][total_loss] "
                        f"batch={batch_idx} sample={i} | "
                        f"pg3_key_found={_pg3_key_found} | "
                        f"pg3_added_to_total_loss={_pg3_added} | "
                        f"pg3_requires_grad={_pg3_req_grad} | "
                        f"pg3_value={_pg3_val:.8e} | "
                        f"loss_i_requires_grad={_loss_i_req_grad} | "
                        f"total_loss_requires_grad={_total_loss_req_grad}",
                        flush=True,
                    )

                loss_batch = loss_batch + loss_i
                accum["mask"] += float(loss_m.detach().item())
                accum["heatmap"] += float(loss_h.detach().item())
                accum["hv"] += float(loss_hv.detach().item())
                accum["pnurl"] += float(loss_pnurl.detach().item()) if torch.is_tensor(loss_pnurl) else float(loss_pnurl)
                accum["density"] += float(loss_d.detach().item())
                accum["semantic_stability"] += float(loss_semantic_stability.detach().item())
                accum["injection_penalty"] += float(loss_injection_penalty.detach().item())
                accum["promptnu_lite_align_loss"] += float(loss_pnurl_lite.detach().item()) if torch.is_tensor(loss_pnurl_lite) else 0.0
                accum["promptnu_guided_v3_align_loss"] += float(loss_pnurl_v3.detach().item()) if torch.is_tensor(loss_pnurl_v3) else 0.0
                accum["spatial_structure"] += float(loss_structure.detach().item())
                accum["spatial_boundary"] += float(loss_boundary.detach().item())
                accum["spatial_sb"] += float(loss_spatial_sb.detach().item())

                # ── PromptNu-lite v2 total_loss audit (rank0, first 2 train batches) ──
                if (
                    rank == 0
                    and args.phase == "semantic_injection"
                    and getattr(args, "enable_promptnu_lite_align", False)
                    and batch_idx < 2
                    and i == 0  # only once per batch (per-sample loop)
                ):
                    _seg_before = float((loss_i - loss_pnurl_lite).detach().item()) if torch.is_tensor(loss_pnurl_lite) else float(loss_i.detach().item())
                    _total_after = float(loss_i.detach().item())
                    _lite_val = float(loss_pnurl_lite.detach().item()) if torch.is_tensor(loss_pnurl_lite) else 0.0
                    print(
                        f"  [PROMPTNU_LITE_AUDIT][total_loss] "
                        f"seg_loss_before_promptnu={_seg_before:.6f} | "
                        f"promptnu_lite_align_loss={_lite_val:.6f} | "
                        f"total_loss_after_promptnu={_total_after:.6f}",
                        flush=True,
                    )

                for attr_idx, attr_key in enumerate(ATTRIBUTE_LOGIT_KEYS):
                    loss_value = _get_output_scalar(out, ATTRIBUTE_LOSS_KEYS.get(attr_key, ()), device=args.device)
                    if not (torch.is_tensor(loss_value) and torch.isfinite(loss_value).all()):
                        loss_value = _compute_attr_ce_loss_for_logging(
                            out=out,
                            attr_label=model_input[i].get("attr_labels", None),
                            attr_key=attr_key,
                            attr_index=attr_idx,
                            device=args.device,
                        )
                    if torch.is_tensor(loss_value) and torch.isfinite(loss_value).all():
                        attr_loss_accum[attr_key] += float(loss_value.detach().item())
                        attr_loss_count[attr_key] += 1

                if not getattr(args, "disable_attr_acc_logging", False):
                    _accumulate_attribute_accuracy(
                        out=out,
                        attr_label=model_input[i].get("attr_labels", None),
                        correct=attr_correct,
                        total=attr_total,
                        device=args.device,
                    )

            final_loss = loss_batch / max(len(images), 1)
            final_loss = final_loss / args.accumulation_steps

        is_accumulating = (batch_idx + 1) % args.accumulation_steps != 0 and (batch_idx + 1) != len(train_loader)

        if scaler:
            scaler.scale(final_loss).backward()
        else:
            final_loss.backward()

        if not is_accumulating:
            trainable_params = [p for g in optimizer.param_groups for p in g["params"] if p.requires_grad]

            # ── Phase D gate audit: grad norms + param snapshot (before optimizer.step) ──
            if rank == 0 and args.phase == "semantic_injection":
                _phase_d_gate_audit_grad(unwrap_model(model), batch_idx, args, optimizer=optimizer)
                # v3 grad audit: reuse the same gradient state after backward()
                debug_promptnu_guided_v3_audit(unwrap_model(model), batch_idx, args, optimizer=optimizer)
                # Take snapshots for delta audit (both existing and v3)
                _take_param_snapshot(unwrap_model(model))
                debug_promptnu_guided_v3_take_snapshot(unwrap_model(model))

            # ── PNuDP Dense Training Audit (rank0, every 10 batches) ──
            if (
                rank == 0
                and args.phase == "pnudp_dense_train"
                and batch_idx % 10 == 0
            ):
                _raw = unwrap_model(model)
                _pnudp_mod = getattr(_raw, "pnudp_dense_train", None)
                _debug_info = outputs[0].get("pnudp_dense_debug", {})
                _bias_norm = _debug_info.get("pnudp_bias_norm", float("nan"))
                _bias_std = _debug_info.get("pnudp_bias_std", float("nan"))
                _bias_abs_mean = _debug_info.get("pnudp_bias_abs_mean", float("nan"))
                _bias_abs_max = _debug_info.get("pnudp_bias_abs_max", float("nan"))
                _alpha_val = _debug_info.get("dense_alpha_value", float("nan"))
                _fused_l1 = _debug_info.get("fused_minus_base_l1", float("nan"))
                # Scaled variants of fused_minus_base_l1 for near-zero detection
                _fused_l1_x1e6 = _fused_l1 * 1e6 if not (isinstance(_fused_l1, float) and math.isnan(_fused_l1)) else float("nan")
                _fused_l1_x1e9 = _fused_l1 * 1e9 if not (isinstance(_fused_l1, float) and math.isnan(_fused_l1)) else float("nan")
                # alpha * bias_abs_mean
                _alpha_x_bias_abs_mean = _alpha_val * _bias_abs_mean if not (isinstance(_alpha_val, float) and math.isnan(_alpha_val) or isinstance(_bias_abs_mean, float) and math.isnan(_bias_abs_mean)) else float("nan")
                # Seg losses
                _seg_base_avg = _pnudp_dense_seg_base_batch / max(_pnudp_dense_sample_count, 1)
                _seg_fused_lr_avg = _pnudp_dense_seg_fused_lr_batch / max(_pnudp_dense_sample_count, 1)
                _seg_fused_hr = float(loss_m.detach().item())  # full-res fused loss from last sample
                # Grad norms (use _safe_grad_norm which returns formatted string)
                if _pnudp_mod is not None:
                    _proj_gn_str = _safe_grad_norm(_pnudp_mod.proj.weight)
                    _logit_gn_str = _safe_grad_norm(_pnudp_mod.logit_proj.weight)
                    _alpha_gn_str = _safe_grad_norm(_pnudp_mod.dense_alpha)
                    # Weight statistics for audit
                    _logit_proj_w = _pnudp_mod.logit_proj.weight.detach()
                    _logit_proj_weight_norm = _logit_proj_w.norm().item()
                    _logit_proj_weight_std = _logit_proj_w.std().item()
                    _dense_proj_weight_norm = _pnudp_mod.proj.weight.detach().norm().item()
                else:
                    _proj_gn_str = _logit_gn_str = _alpha_gn_str = "nan"
                    _logit_proj_weight_norm = float("nan")
                    _logit_proj_weight_std = float("nan")
                    _dense_proj_weight_norm = float("nan")
                _shape_base = _pnudp_dense_loss_shape_print.get("base_logits_for_loss_shape", "N/A")
                _shape_fused = _pnudp_dense_loss_shape_print.get("fused_logits_for_loss_shape", "N/A")
                _shape_mask = _pnudp_dense_loss_shape_print.get("mask_for_loss_shape", "N/A")
                _sel_ch = _pnudp_dense_loss_shape_print.get("selected_mask_channel", "N/A")
                print(
                    f"\n[PNUDP_DENSE_TRAIN_AUDIT] batch={batch_idx} | "
                    f"fused_minus_base_l1_raw={_fused_l1:.12e} | "
                    f"fused_minus_base_l1_x1e6={_fused_l1_x1e6:.6e} | "
                    f"fused_minus_base_l1_x1e9={_fused_l1_x1e9:.6e} | "
                    f"pnudp_bias_norm={_bias_norm:.6e} | "
                    f"pnudp_bias_abs_mean={_bias_abs_mean:.12e} | "
                    f"pnudp_bias_abs_max={_bias_abs_max:.12e} | "
                    f"pnudp_bias_std={_bias_std:.12e} | "
                    f"alpha={_alpha_val:.12e} | "
                    f"alpha_x_bias_abs_mean={_alpha_x_bias_abs_mean:.12e} | "
                    f"logit_proj_weight_norm={_logit_proj_weight_norm:.12e} | "
                    f"logit_proj_weight_std={_logit_proj_weight_std:.12e} | "
                    f"dense_proj_weight_norm={_dense_proj_weight_norm:.12e} | "
                    f"base_logits_for_loss_shape={_shape_base} | "
                    f"fused_logits_for_loss_shape={_shape_fused} | "
                    f"mask_for_loss_shape={_shape_mask} | "
                    f"mask_resize_mode=nearest | "
                    f"selected_mask_channel={_sel_ch} | "
                    f"seg_loss_base={_seg_base_avg:.6f} | "
                    f"seg_loss_fused_lr={_seg_fused_lr_avg:.6f} | "
                    f"seg_loss_fused_hr={_seg_fused_hr:.6f} | "
                    f"grad_norm_pnudp_dense_proj={_proj_gn_str} | "
                    f"grad_norm_pnudp_logit_proj={_logit_gn_str} | "
                    f"grad_norm_alpha={_alpha_gn_str}",
                    flush=True,
                )

            # ── Numeric Attr FreqPath Training Audit (Exp5): capture grad_norm / param_norm before optimizer.step ──
            _numeric_fap_audit = None
            if rank == 0 and getattr(args, "enable_numeric_attr_freqpath_guidance", False):
                _fap_interval = getattr(args, "numeric_attr_audit_interval", 5)
                _fap_do_audit = (batch_idx == 0) if _fap_interval == 0 else (batch_idx % _fap_interval == 0)
                if _fap_do_audit:
                    _raw_fap = unwrap_model(model)
                    _proj_fap = getattr(_raw_fap, "numeric_attr_freqpath_proj", None)
                    if _proj_fap is not None:
                        _fap_data = {}
                        # param norm (Frobenius over all params)
                        _pn_sq = 0.0
                        for _p in _proj_fap.parameters():
                            _pn_sq += _p.detach().float().norm().item() ** 2
                        _fap_data["param_norm"] = _pn_sq ** 0.5
                        # grad norm (before optimizer.step, before gradient clipping)
                        _gn_sq = 0.0
                        for _p in _proj_fap.parameters():
                            if _p.grad is not None:
                                _gn_sq += _p.grad.detach().float().norm().item() ** 2
                        _fap_data["grad_norm"] = _gn_sq ** 0.5
                        # structure/boundary last layer norms
                        _fap_data["slw_norm"] = _proj_fap.structure_mlp[-1].weight.detach().float().norm().item()
                        _fap_data["slb_norm"] = _proj_fap.structure_mlp[-1].bias.detach().float().norm().item()
                        _fap_data["blw_norm"] = _proj_fap.boundary_mlp[-1].weight.detach().float().norm().item()
                        _fap_data["blb_norm"] = _proj_fap.boundary_mlp[-1].bias.detach().float().norm().item()
                        _numeric_fap_audit = (_proj_fap, _fap_data)

            # ── BACKWARD TIMING AUDIT + retained-grad tensor audit (Exp5 backward chain debug) ──
            # Only on rank0, first batch (batch_idx==0) or every _fap_interval batch
            if rank == 0 and getattr(args, "enable_numeric_attr_freqpath_guidance", False):
                _bta_interval = getattr(args, "numeric_attr_audit_interval", 5)
                _bta_do = (batch_idx == 0) if _bta_interval == 0 else (batch_idx % _bta_interval == 0)
                if _bta_do:
                    _raw_bta = unwrap_model(model)

                    # ── BACKWARD_TIMING_AUDIT ──
                    _loss_bw_done = True  # we are after loss.backward()
                    _before_opt_step = True  # before optimizer.step
                    _before_zero_grad = True  # before optimizer.zero_grad
                    # Count non-None grads across all model params
                    _global_non_none = 0
                    _global_gn_sq = 0.0
                    for _p in _raw_bta.parameters():
                        if _p.grad is not None:
                            _global_non_none += 1
                            _global_gn_sq += _p.grad.detach().float().norm().item() ** 2
                    _global_gn = _global_gn_sq ** 0.5 if _global_non_none > 0 else 0.0

                    # Numeric proj non-None count + grad norm
                    _proj_bta = getattr(_raw_bta, "numeric_attr_freqpath_proj", None)
                    _numeric_non_none = 0
                    _numeric_gn_sq = 0.0
                    if _proj_bta is not None:
                        for _p in _proj_bta.parameters():
                            if _p.grad is not None:
                                _numeric_non_none += 1
                                _numeric_gn_sq += _p.grad.detach().float().norm().item() ** 2
                    _numeric_gn = _numeric_gn_sq ** 0.5 if _numeric_non_none > 0 else 0.0

                    print(
                        f"\n[BACKWARD_TIMING_AUDIT]\n"
                        f"  step={batch_idx}\n"
                        f"  loss_backward_done={_loss_bw_done}\n"
                        f"  before_optimizer_step={_before_opt_step}\n"
                        f"  before_zero_grad={_before_zero_grad}\n"
                        f"  global_non_none_grad_param_count={_global_non_none}\n"
                        f"  global_grad_norm={_global_gn:.6e}\n"
                        f"  numeric_non_none_grad_param_count={_numeric_non_none}\n"
                        f"  numeric_grad_norm={_numeric_gn:.6e}\n",
                        flush=True,
                    )

                    # ── NUMERIC_ATTR_BACKWARD_AUDIT: read retained grads from model ──
                    _na_debug = getattr(_raw_bta, "_numeric_attr_freqpath_debug_tensors", None)
                    if _na_debug is not None:
                        def _get_grad_norm(t, requires_grad_key, retain_grad_key):
                            """Safe helper: return grad norm or None with requires_grad context."""
                            _rg = _na_debug.get(requires_grad_key, False)
                            _ret = _na_debug.get(retain_grad_key, False)
                            if not _rg:
                                return "requires_grad=False"
                            if not _ret:
                                return "retain_grad=False"
                            if not isinstance(t, torch.Tensor):
                                return "not_tensor"
                            if t.grad is None:
                                return "grad=None"
                            return f"{t.grad.detach().float().norm().item():.6e}"

                        _ap_t = _na_debug.get("attr_prompt", None)
                        _mf_t = _na_debug.get("morph_feat", None)
                        _sl_t = _na_debug.get("structure_logits_i", None)
                        _bl_t = _na_debug.get("boundary_logits_i", None)
                        _ap_gn = _get_grad_norm(_ap_t, "attr_prompt_requires_grad", "attr_prompt_retain_grad")
                        _mf_gn = _get_grad_norm(_mf_t, "morph_feat_requires_grad", "morph_feat_retain_grad")
                        _sl_gn = _get_grad_norm(_sl_t, "structure_logits_i_requires_grad", "structure_logits_i_retain_grad")
                        _bl_gn = _get_grad_norm(_bl_t, "boundary_logits_i_requires_grad", "boundary_logits_i_retain_grad")
                        # Numeric proj param grad norm
                        _npm_gn_sq = 0.0
                        _npm_nn = 0
                        if _proj_bta is not None:
                            for _p in _proj_bta.parameters():
                                if _p.grad is not None:
                                    _npm_nn += 1
                                    _npm_gn_sq += _p.grad.detach().float().norm().item() ** 2
                        _npm_gn = _npm_gn_sq ** 0.5 if _npm_nn > 0 else 0.0
                        print(
                            f"[NUMERIC_ATTR_BACKWARD_AUDIT]\n"
                            f"  step={batch_idx}\n"
                            f"  attr_prompt_grad_norm={_ap_gn}\n"
                            f"  morph_feat_grad_norm={_mf_gn}\n"
                            f"  structure_logits_i_grad_norm={_sl_gn}\n"
                            f"  boundary_logits_i_grad_norm={_bl_gn}\n"
                            f"  numeric_proj_param_grad_norm={_npm_gn:.6e}\n"
                            f"  numeric_proj_non_none_grad_count={_npm_nn}\n",
                            flush=True,
                        )

                    # ── FREQPATH_BACKWARD_AUDIT: read retained grads from FreqPathASRBlock ──
                    _fp_blocks = []
                    for _mod in _raw_bta.modules():
                        if hasattr(_mod, "_freqpath_debug_tensors") and _mod._freqpath_debug_tensors:
                            _fp_blocks.append(_mod)
                    if _fp_blocks:
                        for _bidx, _fpb in enumerate(_fp_blocks):
                            _fpd = _fpb._freqpath_debug_tensors
                            _apv_t = _fpd.get("attr_prompt_vec", None)
                            _mfv_t = _fpd.get("morph_feat_vec", None)
                            _lmr_t = _fpd.get("low_modulator_raw", None)
                            _hmr_t = _fpd.get("high_modulator_raw", None)
                            _ld_t = _fpd.get("low_delta", None)
                            _hd_t = _fpd.get("high_delta", None)
                            _apv_gn = _apv_t.grad.detach().float().norm().item() if _apv_t is not None and _apv_t.grad is not None else None
                            _mfv_gn = _mfv_t.grad.detach().float().norm().item() if _mfv_t is not None and _mfv_t.grad is not None else None
                            _lmr_gn = _lmr_t.grad.detach().float().norm().item() if _lmr_t is not None and _lmr_t.grad is not None else None
                            _hmr_gn = _hmr_t.grad.detach().float().norm().item() if _hmr_t is not None and _hmr_t.grad is not None else None
                            _ld_gn = _ld_t.grad.detach().float().norm().item() if _ld_t is not None and _ld_t.grad is not None else None
                            _hd_gn = _hd_t.grad.detach().float().norm().item() if _hd_t is not None and _hd_t.grad is not None else None
                            # attr_modulator / morphology_modulator param grad norm
                            _am_gn_sq = 0.0
                            _mm_gn_sq = 0.0
                            if hasattr(_fpb, "attr_modulator"):
                                for _p in _fpb.attr_modulator.parameters():
                                    if _p.grad is not None:
                                        _am_gn_sq += _p.grad.detach().float().norm().item() ** 2
                            if hasattr(_fpb, "morphology_modulator"):
                                for _p in _fpb.morphology_modulator.parameters():
                                    if _p.grad is not None:
                                        _mm_gn_sq += _p.grad.detach().float().norm().item() ** 2
                            _am_gn = _am_gn_sq ** 0.5
                            _mm_gn = _mm_gn_sq ** 0.5
                            print(
                                f"\n[FREQPATH_BACKWARD_AUDIT]\n"
                                f"  step={batch_idx}\n"
                                f"  block_idx={_bidx}\n"
                                f"  attr_prompt_vec_grad_norm={_apv_gn}\n"
                                f"  morph_feat_vec_grad_norm={_mfv_gn}\n"
                                f"  low_modulator_raw_grad_norm={_lmr_gn}\n"
                                f"  high_modulator_raw_grad_norm={_hmr_gn}\n"
                                f"  low_delta_grad_norm={_ld_gn}\n"
                                f"  high_delta_grad_norm={_hd_gn}\n"
                                f"  attr_modulator_param_grad_norm={_am_gn:.6e}\n"
                                f"  morphology_modulator_param_grad_norm={_mm_gn:.6e}\n",
                                flush=True,
                            )

            if scaler:
                scaler.unscale_(optimizer)
                _spatial_grad_diag = collect_spatial_sb_gradient_norms(model)
                torch.nn.utils.clip_grad_norm_(trainable_params, max_norm=1.0)
                scaler.step(optimizer)
                scaler.update()
            else:
                _spatial_grad_diag = collect_spatial_sb_gradient_norms(model)
                torch.nn.utils.clip_grad_norm_(trainable_params, max_norm=1.0)
                optimizer.step()

            # ── Phase D gate audit: param delta (after optimizer.step) ──
            if rank == 0 and args.phase == "semantic_injection":
                _phase_d_gate_audit_delta(unwrap_model(model), optimizer, batch_idx, args)
                # v3 delta audit: uses its own snapshot
                debug_promptnu_guided_v3_audit(unwrap_model(model), batch_idx, args, optimizer=optimizer)

            # ── Numeric Attr FreqPath delta audit (after optimizer.step): compute delta_norm_from_start & print ──
            if _numeric_fap_audit is not None:
                _proj_fap, _fap_data = _numeric_fap_audit
                _delta_sq = 0.0
                _snap = getattr(_numeric_freqpath_take_snapshot, "_snapshot", None)
                if _snap:
                    for _name, _p in _proj_fap.named_parameters():
                        _sv = _snap.get(_name)
                        if _sv is not None:
                            _delta_sq += (_p.detach().float().cpu() - _sv).norm().item() ** 2
                _delta_norm = _delta_sq ** 0.5 if _snap else 0.0
                print(
                    f"\n[NUMERIC_ATTR_FREQPATH_TRAIN_AUDIT]\n"
                    f"  step={batch_idx}\n"
                    f"  param_norm={_fap_data['param_norm']:.6e}\n"
                    f"  grad_norm={_fap_data['grad_norm']:.6e}\n"
                    f"  delta_norm_from_start={_delta_norm:.6e}  (after optimizer.step)\n"
                    f"  structure_last_weight_norm={_fap_data['slw_norm']:.6e}\n"
                    f"  structure_last_bias_norm={_fap_data['slb_norm']:.6e}\n"
                    f"  boundary_last_weight_norm={_fap_data['blw_norm']:.6e}\n"
                    f"  boundary_last_bias_norm={_fap_data['blb_norm']:.6e}",
                    flush=True,
                )

            optimizer.zero_grad(set_to_none=True)

        current_loss_val = final_loss.detach().item() * args.accumulation_steps
        diag = collect_semantic_diagnostics(outputs)
        spatial_diag = collect_spatial_sb_diagnostics(outputs)
        spatial_diag.update(_spatial_grad_diag)

        n = max(len(images), 1)
        meters["total"].append(current_loss_val)

        for key in ["mask", "heatmap", "hv", "pnurl", "density", "semantic_stability", "injection_penalty", "promptnu_lite_align_loss", "promptnu_guided_v3_align_loss", "spatial_structure", "spatial_boundary", "spatial_sb"]:
            meters[key].append(accum[key] / n)

        for key, val in diag.items():
            meters.setdefault(key, []).append(val)
        for key, val in spatial_diag.items():
            meters[key].append(val)

        for key in ATTRIBUTE_LOGIT_KEYS:
            meter_key = f"attr_acc_{key}"
            if not getattr(args, "disable_attr_acc_logging", False) and attr_total.get(key, 0) > 0:
                meters[meter_key].append(attr_correct[key] / max(attr_total[key], 1))
            else:
                meters[meter_key].append(float("nan"))

            loss_meter_key = f"attr_loss_{key}"
            if attr_loss_count.get(key, 0) > 0:
                meters[loss_meter_key].append(attr_loss_accum[key] / max(attr_loss_count[key], 1))
            else:
                meters[loss_meter_key].append(float("nan"))

        if rank == 0 and writer is not None and batch_idx % 10 == 0:
            global_step = epoch * len(train_loader) + batch_idx
            writer.add_scalar("Train/Loss_Total", current_loss_val, global_step)
            writer.add_scalar("Train/Loss_Mask", meters["mask"][-1], global_step)
            writer.add_scalar("Train/Loss_Heatmap", meters["heatmap"][-1], global_step)
            writer.add_scalar("Train/Loss_HV", meters["hv"][-1], global_step)
            writer.add_scalar("Train/Loss_PNuRL", meters["pnurl"][-1], global_step)
            writer.add_scalar("Train/Loss_Density", meters["density"][-1], global_step)
            writer.add_scalar("Train/Loss_Semantic_Stability", meters["semantic_stability"][-1], global_step)
            writer.add_scalar("Train/Loss_Injection_Penalty", meters["injection_penalty"][-1], global_step)
            writer.add_scalar("Train/Loss_PromptNuLite_Align", meters["promptnu_lite_align_loss"][-1], global_step)
            writer.add_scalar("Train/Loss_PromptNuGuidedV3_Align", meters["promptnu_guided_v3_align_loss"][-1], global_step)
            writer.add_scalar("Train/SBStructLoss", meters["spatial_structure"][-1], global_step)
            writer.add_scalar("Train/SBBoundLoss", meters["spatial_boundary"][-1], global_step)
            writer.add_scalar("Train/SBLoss", meters["spatial_sb"][-1], global_step)
            writer.add_scalar("Train/Loss_SpatialSB", meters["spatial_sb"][-1], global_step)
            writer.add_scalar("Train/Loss_PromptNuLite_Struct", meters["promptnu_lite_struct_loss"][-1], global_step)
            writer.add_scalar("Train/Loss_PromptNuLite_Boundary", meters["promptnu_lite_boundary_loss"][-1], global_step)
            writer.add_scalar("Train/Sim_PromptNuLite_Struct", meters["promptnu_lite_struct_sim"][-1], global_step)
            writer.add_scalar("Train/Sim_PromptNuLite_Boundary", meters["promptnu_lite_boundary_sim"][-1], global_step)
            writer.add_scalar("Train/Sim_PromptNuGuidedV3_Struct", meters.get("v3_s_sim", [float("nan")])[-1], global_step)
            writer.add_scalar("Train/Sim_PromptNuGuidedV3_Boundary", meters.get("v3_b_sim", [float("nan")])[-1], global_step)
            writer.add_scalar("Train/Norm_PromptNuGuidedV3_TextProj", meters.get("v3_text_proj_norm", [float("nan")])[-1], global_step)
            writer.add_scalar("Train/Norm_PromptNuGuidedV3_VisProj", meters.get("v3_vis_proj_norm", [float("nan")])[-1], global_step)
            for key in ATTRIBUTE_LOGIT_KEYS:
                _write_scalar_if_finite(writer, f"Train/AttrAcc_{key}", meters[f"attr_acc_{key}"][-1], global_step)
                _write_scalar_if_finite(writer, f"Train/AttrLoss_{key}", meters[f"attr_loss_{key}"][-1], global_step)
            writer.add_scalar("Train/LR", optimizer.param_groups[0]["lr"], global_step)
            for group in optimizer.param_groups:
                group_name = group.get("name", "unnamed")
                _write_scalar_if_finite(writer, f"Train/LR_{group_name}", group.get("lr", optimizer.param_groups[0]["lr"]), global_step)

            for name in [
                "semantic_channel_gate_mean",
                "semantic_channel_gate_min",
                "semantic_channel_gate_max",
                "semantic_delta_norm",
                "base_feat_norm",
                "injected_delta_norm",
                "injection_ratio",
                "semantic_delta_reg_loss",
                "semantic_delta_ratio",
                "semantic_delta_raw_norm",
                "semantic_delta_direction_norm",
            ]:
                _write_scalar_if_finite(writer, f"Diagnostics/{name}", diag[name], global_step)

        if rank == 0:
            pbar.set_postfix(
                L=f"{current_loss_val:.3f}",
                M=f"{meters['mask'][-1]:.3f}",
                H=f"{meters['heatmap'][-1]:.3f}",
                HV=f"{meters['hv'][-1]:.3f}",
                P=f"{meters['pnurl'][-1]:.3f}",
                PL=f"{meters['promptnu_lite_align_loss'][-1]:.6f}",
                D=f"{meters['density'][-1]:.3f}",
                SBStructLoss=f"{meters['spatial_structure'][-1]:.6f}",
                SBBoundLoss=f"{meters['spatial_boundary'][-1]:.6f}",
                SBLoss=f"{meters['spatial_sb'][-1]:.6f}",
                A=f"{_current_attr_acc_mean(meters):.3f}",
                S=f"{meters['semantic_stability'][-1]:.6e}",
                G=f"{diag['semantic_channel_gate_mean']:.6e}" if not np.isnan(diag["semantic_channel_gate_mean"]) else "nan",
                IR=f"{diag['injection_ratio']:.6e}" if not np.isnan(diag["injection_ratio"]) else "nan",
            )

        del batched_input, images, labels, model_input, outputs, final_loss

    epoch_stats = {}
    for k, v in meters.items():
        if len(v) == 0:
            epoch_stats[k] = 0.0
            continue
        arr = np.asarray(v, dtype=np.float64)
        if np.all(np.isnan(arr)):
            epoch_stats[k] = float("nan")
        else:
            epoch_stats[k] = float(np.nanmean(arr))
    return epoch_stats


# ==================================================================================================
# 6. Validation logic. Kept as the original fast validation route.
# ==================================================================================================
@torch.no_grad()
def validate_one_epoch(args, model, val_loader, epoch, writer, rank):
    gc.collect()
    torch.cuda.empty_cache()
    model.eval()

    val_results = {k: [] for k in args.metrics}
    visualize_done = False

    total_val_batches = len(val_loader)

    # --- Batch limit logic: debug_max_* takes priority over hardcoded 40% ---
    _debug_max_val = getattr(args, "debug_max_val_batches", None)
    _max_val = getattr(args, "max_val_batches", None)
    if _debug_max_val is not None and int(_debug_max_val) > 0:
        limit_batches = int(_debug_max_val)
        _limit_source = "debug_max_val_batches"
    elif _max_val is not None and int(_max_val) > 0:
        limit_batches = int(_max_val)
        _limit_source = "max_val_batches"
    else:
        limit_batches = int(total_val_batches * 0.4)
        _limit_source = "40% default"
    if limit_batches < 1:
        limit_batches = 1

    if rank == 0:
        if _limit_source != "40% default":
            print(
                f"[PHASE_D_LIMIT] val_limit={limit_batches} | source={_limit_source} | "
                f"total_dataloader={total_val_batches}",
                flush=True,
            )
        pbar = tqdm(val_loader, desc=f"Ep {epoch + 1} Val ({_limit_source})", total=limit_batches)
    else:
        pbar = val_loader

    eval_model = unwrap_model(model)

    for batch, batched_input in enumerate(pbar):
        if batch >= limit_batches:
            break

        batched_input = to_device(batched_input, args.device)
        images = batched_input["image"]
        inst_labels = batched_input.get("label_inst", batched_input["label"]).cpu().numpy()
        organ_ids = batched_input.get("organ_id", None)

        dynamic_text = batched_input.get("text_prompt", ["Cell nuclei"] * len(images))
        dynamic_attr_text = batched_input.get("attribute_text", dynamic_text)
        attr_labels = batched_input.get("attr_labels", None)

        # ── Phase D: extract attribute labels from batch if present ──
        _d_structure_attr_labels = batched_input.get("structure_attr_labels", None)
        _d_boundary_attr_labels = batched_input.get("boundary_attr_labels", None)
        _d_per_instance_attr_labels = batched_input.get("per_instance_attr_labels", None)
        _d_per_instance_ids = batched_input.get("per_instance_ids", None)
        _d_label_inst = batched_input.get("label_inst", None)

        if getattr(args, "asr_regression", False):
            dynamic_text = ["Cell nuclei"] * len(images)
            dynamic_attr_text = ["Cell nuclei"] * len(images)
            attr_labels = None

        if images.shape[-1] != args.image_size:
            images = F.interpolate(images, size=(args.image_size, args.image_size), mode="bilinear", align_corners=False)

        for i in range(len(images)):
            curr_organ_id = 20
            if organ_ids is not None:
                val = organ_ids[i]
                curr_organ_id = val.item() if isinstance(val, torch.Tensor) else val

            with torch.inference_mode(), _autocast_context(args):
                item = {
                    "image": images[i],
                    "original_size": (args.image_size, args.image_size),
                    "text_prompt": dynamic_text[i],
                    "organ_id": curr_organ_id,
                    "attribute_text": dynamic_attr_text[i],
                    "attr_labels": attr_labels[i] if attr_labels is not None else None,
                }
                # Phase D attr fields (passed through to sam.py forward)
                if _d_structure_attr_labels is not None:
                    item["structure_attr_labels"] = _d_structure_attr_labels[i]
                if _d_boundary_attr_labels is not None:
                    item["boundary_attr_labels"] = _d_boundary_attr_labels[i]
                if _d_per_instance_attr_labels is not None:
                    item["per_instance_attr_labels"] = _d_per_instance_attr_labels[i]
                if _d_per_instance_ids is not None:
                    item["per_instance_ids"] = _d_per_instance_ids[i] if isinstance(_d_per_instance_ids, list) else _d_per_instance_ids
                if _d_label_inst is not None:
                    item["label_inst"] = _d_label_inst[i]
                model_input = [item]

                # ── Phase D val model_input audit (rank0, first val batch only) ──
                if batch == 0 and i == 0 and rank == 0 and args.phase == "semantic_injection":
                    print(
                        f"\n[PHASE_D_MODEL_INPUT_AUDIT][VAL] keys={list(item.keys())}",
                        flush=True,
                    )
                    if _d_structure_attr_labels is not None:
                        print(
                            f"[PHASE_D_MODEL_INPUT_AUDIT][VAL] structure_attr_labels shape="
                            f"{tuple(_d_structure_attr_labels.shape)}",
                            flush=True,
                        )
                    if _d_boundary_attr_labels is not None:
                        print(
                            f"[PHASE_D_MODEL_INPUT_AUDIT][VAL] boundary_attr_labels shape="
                            f"{tuple(_d_boundary_attr_labels.shape)}",
                            flush=True,
                        )
                    if _d_per_instance_attr_labels is not None:
                        _pi_type = "list" if isinstance(_d_per_instance_attr_labels, list) else "tensor"
                        _pi_shapes = (
                            [tuple(t.shape) for t in _d_per_instance_attr_labels]
                            if isinstance(_d_per_instance_attr_labels, list)
                            else tuple(_d_per_instance_attr_labels.shape)
                        )
                        print(
                            f"[PHASE_D_MODEL_INPUT_AUDIT][VAL] per_instance_attr_labels type={_pi_type} | "
                            f"shapes={_pi_shapes}",
                            flush=True,
                        )
                    if _d_label_inst is not None:
                        print(
                            f"[PHASE_D_MODEL_INPUT_AUDIT][VAL] label_inst shape={tuple(_d_label_inst.shape)}",
                            flush=True,
                        )
                out = eval_model(model_input, multimask_output=True)

            iou_preds = out[0]["iou_predictions"]
            if iou_preds.ndim == 2:
                iou_preds = iou_preds.squeeze(0)
            best_idx = torch.argmax(iou_preds).item()

            pred_logits = out[0]["masks"][0, best_idx]
            prob_map = torch.sigmoid(pred_logits)

            hv_logits = out[0].get("hv_logits", None)
            if hv_logits is not None:
                hv_map = torch.tanh(hv_logits)
                is_expanded = False
                if hv_map.dim() == 3:
                    hv_map = hv_map.unsqueeze(0)
                    is_expanded = True
                target_hw = prob_map.shape[-2:]
                hv_map = F.interpolate(hv_map.float(), size=target_hw, mode="bilinear", align_corners=False)
                if is_expanded:
                    hv_map = hv_map.squeeze(0)
                elif hv_map.dim() == 4 and hv_map.shape[0] == 1:
                    hv_map = hv_map.squeeze(0)
            else:
                target_hw = prob_map.shape[-2:]
                hv_map = torch.zeros((2, target_hw[0], target_hw[1]), device=args.device)

            prob_np = prob_map.float().cpu().numpy()
            hv_np = hv_map.float().cpu().numpy()

            pred_mask = hover_post_process(
                prob_np,
                hv_np,
                prob_thresh=0.45,
                marker_thresh=0.4,
                min_marker_size=10,
            )
            if pred_mask.max() == 0:
                pred_mask = skimage_label(prob_np > 0.5).astype(np.int32)

            gt = inst_labels[i]
            gt = gt[0] if gt.ndim == 3 else gt
            gt_valid = gt.copy()
            gt_valid[gt == 255] = 0

            if pred_mask.shape != gt_valid.shape:
                gt_valid = cv2.resize(
                    gt_valid,
                    (pred_mask.shape[1], pred_mask.shape[0]),
                    interpolation=cv2.INTER_NEAREST,
                )

            res = SegMetrics(pred_mask, gt_valid, args.metrics)
            for k in args.metrics:
                if k in res:
                    val_results[k].append(res[k])

            if rank == 0 and writer is not None and not visualize_done:
                img_vis = images[i].cpu().numpy().transpose(1, 2, 0)
                img_vis = (img_vis - img_vis.min()) / (img_vis.max() - img_vis.min() + 1e-5)
                writer.add_image("Val_Viz/Image", torch.tensor(img_vis.transpose(2, 0, 1)), epoch)
                writer.add_image("Val_Viz/GT", torch.tensor(gt_valid * 255).unsqueeze(0).to(torch.uint8), epoch)
                pred_binary = (pred_mask > 0).astype(np.uint8)
                writer.add_image("Val_Viz/Pred", torch.tensor(pred_binary * 255).unsqueeze(0).to(torch.uint8), epoch)
                visualize_done = True

            if rank == 0 and "mAJI" in args.metrics and len(val_results["mAJI"]) > 0:
                pbar.set_postfix(AJI=f"{val_results['mAJI'][-1]:.3f}")

    gc.collect()
    torch.cuda.empty_cache()

    avg_results = {k: np.mean(v) if len(v) > 0 else 0.0 for k, v in val_results.items()}
    if rank == 0 and writer is not None:
        for metric_name, metric_value in avg_results.items():
            writer.add_scalar(f"Val/{metric_name}", metric_value, epoch)
        writer.add_scalar(
            "Val/Weighted_Score",
            avg_results.get("mAJI", 0) * 0.6 + avg_results.get("dice", 0) * 0.4,
            epoch,
        )
    return avg_results


# ==================================================================================================
# 7. Checkpoint helpers
# ==================================================================================================
_SGA_SB_STATE_PREFIXES = (
    "spatial_structure_head.",
    "spatial_boundary_head.",
    "spatial_structure_adapter.",
    "spatial_boundary_adapter.",
    "gamma_structure",
    "gamma_boundary",
)


def _log_sga_sb_resume_audit(raw_model, checkpoint_state, missing_keys, unexpected_keys, args, logger=None, rank=0):
    if rank != 0:
        return
    _mode = str(getattr(args, "spatial_sb_mode", "none"))
    _branch = str(getattr(args, "spatial_sb_branch", "both"))
    _checkpoint_keys = set(checkpoint_state.keys()) if isinstance(checkpoint_state, dict) else set()
    _old_has_sga = any(key.startswith(_SGA_SB_STATE_PREFIXES) for key in _checkpoint_keys)
    _model_sga_keys = [
        key for key in raw_model.state_dict().keys()
        if key.startswith(_SGA_SB_STATE_PREFIXES)
    ]
    _missing_sga = [key for key in missing_keys if key.startswith(_SGA_SB_STATE_PREFIXES)]
    _expected_empty_buffers = {
        key for key in ("_structure_text_bank_buffer", "_boundary_text_bank_buffer")
        if key in raw_model.state_dict() and raw_model.state_dict()[key].numel() == 0
    }
    _missing_non_sga = [
        key for key in missing_keys
        if not key.startswith(_SGA_SB_STATE_PREFIXES) and key not in _expected_empty_buffers
    ]
    _new_initialized = bool(_mode != "none" and _model_sga_keys and not _old_has_sga)
    _message = (
        f"[SGA_SB_RESUME] mode={_mode} | branch={_branch} | "
        f"old_checkpoint_has_sga_keys={_old_has_sga} | "
        f"expected_new_missing_keys={len(_missing_sga)} | "
        f"unexpected_non_sga_missing_keys={len(_missing_non_sga)} | "
        f"unexpected_keys={len(unexpected_keys)} | "
        f"new_module_initialized={_new_initialized}"
    )
    if logger is not None:
        logger.info(_message)
    else:
        print(_message, flush=True)


def load_sam_checkpoint_with_asr_mapping(raw_model: nn.Module, args, logger=None, rank: int = 0):
    """
    兼容旧 SAM/SamMed2D checkpoint：
    将原始 output_upscaling 的部分权重映射到 legacy/freqpath ASRBlock 的 structure_upsample。
    build_sam.py 可能已经做过一次 strict=False 加载；这里再执行一次映射，保证 ASR upscaling 能吃到旧权重。
    """
    if not args.sam_checkpoint or not os.path.exists(args.sam_checkpoint):
        return

    if rank == 0 and logger is not None:
        logger.info(f"Loading SAM checkpoint with ASR mapping: {args.sam_checkpoint}")

    try:
        ckpt = torch.load(args.sam_checkpoint, map_location="cpu", weights_only=False)
        state_dict = ckpt.get("model", ckpt) if isinstance(ckpt, dict) else ckpt
        state_dict = resize_pos_embed(state_dict, raw_model.state_dict())

        key_mapping = {
            "mask_decoder.output_upscaling.0.weight": "mask_decoder.asr_upscale_1.structure_upsample.0.weight",
            "mask_decoder.output_upscaling.0.bias": "mask_decoder.asr_upscale_1.structure_upsample.0.bias",
            "mask_decoder.output_upscaling.1.weight": "mask_decoder.asr_upscale_1.structure_upsample.1.weight",
            "mask_decoder.output_upscaling.1.bias": "mask_decoder.asr_upscale_1.structure_upsample.1.bias",
            "mask_decoder.output_upscaling.3.weight": "mask_decoder.asr_upscale_2.structure_upsample.0.weight",
            "mask_decoder.output_upscaling.3.bias": "mask_decoder.asr_upscale_2.structure_upsample.0.bias",
        }
        mapped_state_dict = dict(state_dict)
        mapped_count = 0
        model_keys = raw_model.state_dict().keys()
        for old_key, new_key in key_mapping.items():
            if old_key in state_dict and new_key in model_keys:
                mapped_state_dict[new_key] = state_dict[old_key]
                mapped_count += 1

        missing_keys, unexpected_keys = raw_model.load_state_dict(mapped_state_dict, strict=False)
        _log_sga_sb_resume_audit(
            raw_model, mapped_state_dict, missing_keys, unexpected_keys,
            args=args, logger=logger, rank=rank,
        )
        if rank == 0 and logger is not None:
            logger.info(f"ASRBlock upscaling weights mapped: {mapped_count}/{len(key_mapping)}")
            logger.info(f"SAM checkpoint load: Missing keys={len(missing_keys)} | Unexpected keys={len(unexpected_keys)}")
    except Exception as e:
        if rank == 0 and logger is not None:
            logger.warning(f"SAM checkpoint mapping/loading failed: {e}")


# ==================================================================================================
# 8. Main entry
# ==================================================================================================
def main(args):
    if "RANK" in os.environ and "WORLD_SIZE" in os.environ:
        rank = int(os.environ["RANK"])
        world_size = int(os.environ["WORLD_SIZE"])
        local_rank = int(os.environ["LOCAL_RANK"])
        torch.cuda.set_device(local_rank)
        dist.init_process_group(
            backend="nccl",
            init_method="env://",
            world_size=world_size,
            rank=rank,
        )
        args.device = torch.device(f"cuda:{local_rank}")
    else:
        rank = 0
        local_rank = 0
        world_size = 1
        args.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    if world_size > 1:
        dist.barrier()

    setup_seed(args.seed + rank)

    # ── Initialise audit mode for Stage D log slim-down ──
    audit = AuditMode.from_args(args)
    set_global_audit_mode(audit)
    os.environ["SGA_SB_VERBOSE_TARGETS"] = "1" if audit.is_debug else "0"
    os.environ["SGA_SB_VERBOSE_DIAGNOSTICS"] = "1" if audit.is_debug else "0"

    platform_tb_roots = ["/home/pod", "/root/shared-nvme/tensorboard/logs"]
    platform_tb_root = None
    for tb_path in platform_tb_roots:
        if os.path.exists(tb_path):
            platform_tb_root = tb_path
            break
    if platform_tb_root is None:
        platform_tb_root = os.path.join(args.work_dir, "runs")

    if rank == 0:
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M")
        run_log_dir = os.path.join(platform_tb_root, f"{args.run_name}_{timestamp}")
        text_log_dir = os.path.join(args.work_dir, "logs")
        model_save_dir = os.path.join(args.work_dir, "models", args.run_name)
        os.makedirs(run_log_dir, exist_ok=True)
        os.makedirs(text_log_dir, exist_ok=True)
        os.makedirs(model_save_dir, exist_ok=True)

        logger = get_logger(os.path.join(text_log_dir, f"{args.run_name}_{timestamp}.log"))
        logger.info(
            f"[Start] FreqPath-SAM staged training | size={args.image_size} | "
            f"stage={args.phase} | arch={args.architecture_version}"
        )
        logger.info(f"GPUs: {world_size}, Batch/GPU: {args.batch_size}, Resume: {args.resume if args.resume else 'No'}")
        logger.info(
            f"ASR config | use_asr={args.use_asr} | asr_variant={args.asr_variant} | "
            f"asr_regression={args.asr_regression} | asr_regression_stage={args.asr_regression_stage} | "
            f"prompt_mode={args.prompt_mode} | eval_prompt_mode={args.eval_prompt_mode} | "
            f"use_amp={args.use_amp} | cnn_lr_ratio={args.cnn_lr_ratio} | "
            f"prompt_generator_lr_mult={args.prompt_generator_lr_mult} | adapter_lr_ratio={args.adapter_lr_ratio}"
        )
        logger.info(
            f"Loss weights | mask={args.mask_weight} | heatmap={args.heatmap_weight} | hv={args.hv_weight} | "
            f"pnurl={args.pnurl_weight} | density={args.density_map_weight} | "
            f"semantic_delta_reg={args.semantic_delta_reg_weight} | injection_ratio={args.injection_ratio_weight}"
        )
        writer = SummaryWriter(log_dir=run_log_dir, flush_secs=60)
    else:
        logger = None
        writer = None

    try:
        _use_sb_attrs = bool(getattr(args, "use_structure_boundary_attrs", False))
        _sb_attr_path = getattr(args, "structure_boundary_attr_path", None)

        train_dataset = UniversalDataset(
            data_root=args.data_path,
            knowledge_path=args.knowledge_path,
            image_size=args.image_size,
            crop_size=args.crop_size,
            mode="train",
            prompt_mode=args.prompt_mode,
            use_structure_boundary_attrs=_use_sb_attrs,
            structure_boundary_attr_path=_sb_attr_path,
            max_instances_per_image=args.max_instances_per_image,
            min_instance_area=args.min_instance_area,
            phase=args.phase,
        )
        val_dataset = UniversalDataset(
            data_root=args.data_path,
            knowledge_path=args.knowledge_path,
            image_size=args.image_size,
            crop_size=args.crop_size,
            mode="test",
            prompt_mode=args.eval_prompt_mode,
            use_structure_boundary_attrs=_use_sb_attrs,
            structure_boundary_attr_path=_sb_attr_path,
            max_instances_per_image=args.max_instances_per_image,
            min_instance_area=args.min_instance_area,
            phase=args.phase,
        )

        train_sampler = DistributedSampler(train_dataset, shuffle=True) if world_size > 1 else None
        val_sampler = DistributedSampler(val_dataset, shuffle=True) if world_size > 1 else None

        # ── DataLoader configuration (container-safe defaults) ──────────────
        train_num_workers = args.num_workers
        val_workers = args.val_num_workers if args.val_num_workers is not None else args.num_workers

        train_persistent = args.persistent_workers if train_num_workers > 0 else False
        val_persistent = args.persistent_workers if val_workers > 0 else False
        train_prefetch = 2 if train_num_workers > 0 else None
        val_prefetch = 2 if val_workers > 0 else None

        train_loader = DataLoader(
            train_dataset,
            batch_size=args.batch_size,
            shuffle=(train_sampler is None),
            num_workers=train_num_workers,
            collate_fn=stack_dict_batched,
            pin_memory=args.pin_memory,
            sampler=train_sampler,
            persistent_workers=train_persistent,
            prefetch_factor=train_prefetch,
        )
        val_loader = DataLoader(
            val_dataset,
            batch_size=1,
            shuffle=(val_sampler is None),
            num_workers=val_workers,
            collate_fn=stack_dict_batched,
            pin_memory=args.pin_memory,
            sampler=val_sampler,
            persistent_workers=val_persistent,
            prefetch_factor=val_prefetch,
        )

        if rank == 0:
            logger.info(f"Train Size: {len(train_dataset)} | Val Size: {len(val_dataset)}")
            logger.info(
                f"[DataLoaderConfig] train_num_workers={train_num_workers} | "
                f"val_num_workers={val_workers} | "
                f"pin_memory={args.pin_memory} | "
                f"persistent_workers(train={train_persistent},val={val_persistent}) | "
                f"prefetch_factor(train={train_prefetch},val={val_prefetch})"
            )

        # ================================================================
        # CONCH text encoder: env vars + phase-based enable/disable
        # ================================================================
        if getattr(args, "hf_hub_offline", False):
            os.environ["HF_HUB_OFFLINE"] = "1"
            os.environ["TRANSFORMERS_OFFLINE"] = "1"
            if rank == 0:
                logger.info("[CONCH_CONFIG][train.py] HF_HUB_OFFLINE=1, TRANSFORMERS_OFFLINE=1")

        _conch_cache_path = getattr(args, "conch_cache_path", None)
        if _conch_cache_path:
            _abs_cache = os.path.abspath(_conch_cache_path)
            if os.path.isdir(_abs_cache):
                os.environ["HF_HOME"] = _abs_cache
                os.environ["HUGGINGFACE_HUB_CACHE"] = _abs_cache
                if rank == 0:
                    logger.info(f"[CONCH_CONFIG][train.py] HF_HOME={_abs_cache}")

        # ── Disable/Enable CONCH text encoder ──
        # Priority: disable_conch_text_encoder > enable_conch_text_encoder > phase auto-enable > default
        if getattr(args, "disable_conch_text_encoder", False):
            args.enable_conch_text_encoder = False
        else:
            _explicit = getattr(args, "enable_conch_text_encoder", None)
            if _explicit is not None:
                args.enable_conch_text_encoder = bool(_explicit)
            else:
                # Phases that need CONCH text semantics
                _conch_phases = {"pnurl_warmup", "semantic_alignment", "semantic_injection", "pnudp_dense_train"}
                args.enable_conch_text_encoder = args.phase in _conch_phases

        # ── Disable/Enable attr_text_alignment ──
        # Priority: disable_attr_text_alignment > phase auto-enable > default
        if getattr(args, "disable_attr_text_alignment", False):
            args.enable_attr_text_alignment = False
        elif args.phase in ("semantic_alignment", "semantic_injection"):
            args.enable_attr_text_alignment = True

        # ── Disable/Enable promptnu_guided_v3 ──
        # Priority: disable_promptnu_guided_v3 > --enable_promptnu_guided_v3 / phase auto-enable > default
        if getattr(args, "disable_promptnu_guided_v3", False):
            args.enable_promptnu_guided_v3 = False
            args.promptnu_guided_v3_use_text_bank = False

        # ── Disable/Enable promptnu_lite_align ──
        # Priority: disable_promptnu_lite_align > --enable_promptnu_lite_align > default
        if getattr(args, "disable_promptnu_lite_align", False):
            args.enable_promptnu_lite_align = False

        if rank == 0:
            logger.info(
                f"[CONCH_CONFIG][train.py] phase={args.phase} | "
                f"enable_conch_text_encoder={args.enable_conch_text_encoder} | "
                f"hf_hub_offline={getattr(args, 'hf_hub_offline', False)}"
            )
            logger.info(
                f"[PHASE_C_CONFIG] enable_attr_text_alignment={getattr(args, 'enable_attr_text_alignment', False)} | "
                f"enable_multilevel_attr_heads={getattr(args, 'enable_multilevel_attr_heads', False)}"
            )

        # ── Phase identification booleans (defined early, used throughout) ──
        _phase = args.phase
        is_phase_b_multilevel = _phase == "multilevel_attr_warmup"
        is_phase_c_alignment = _phase == "semantic_alignment"
        is_phase_d_injection = _phase == "semantic_injection"
        is_pnudp_dense_train = _phase == "pnudp_dense_train"
        is_semantic_stage = _phase in ("semantic_injection", "semantic_alignment")
        is_legacy_pnurl = _phase == "pnurl_warmup"

        args.checkpoint = args.sam_checkpoint
        built_model = sam_model_registry[args.model_type](args)

        if isinstance(built_model, TextSam):
            raw_model = built_model.to(args.device)
            if rank == 0:
                logger.info(
                    f"[PROMPTNU_GUIDED_V3_CONFIG] "
                    f"model_type={getattr(args, 'model_type', 'vit_b')} | "
                    f"enable_promptnu_guided_v3={getattr(args, 'enable_promptnu_guided_v3', False)} | "
                    f"use_text_bank={getattr(args, 'promptnu_guided_v3_use_text_bank', False)} | "
                    f"use_gt_align_target={getattr(args, 'promptnu_guided_v3_use_gt_align_target', False)} | "
                    f"semantic_dim={getattr(args, 'promptnu_guided_v3_semantic_dim', 256)} | "
                    f"text_dim={getattr(args, 'promptnu_guided_v3_text_dim', 512)} | "
                    f"embed_dim={getattr(args, 'promptnu_guided_v3_embed_dim', 256)} | "
                    f"hidden_dim={getattr(args, 'promptnu_guided_v3_hidden_dim', 128)} | "
                    f"vis_proj_dim={getattr(args, 'promptnu_guided_v3_vis_proj_dim', 512)} | "
                    f"align_loss_weight={getattr(args, 'promptnu_guided_v3_align_loss_weight', 0.1)} | "
                    f"struct_weight={getattr(args, 'promptnu_guided_v3_struct_weight', 1.0)} | "
                    f"boundary_weight={getattr(args, 'promptnu_guided_v3_boundary_weight', 1.0)} | "
                    f"text_weight={getattr(args, 'promptnu_guided_v3_text_weight', 0.01)} | "
                    f"ablate_semantic_injection={getattr(args, 'ablate_semantic_injection', False)} | "
                    f"ablate_pred_attr_guidance={getattr(args, 'ablate_pred_attr_guidance', False)}"
                )
                # ── PNuDP Dense Train config log (Stage D) ──
                if getattr(args, "enable_pnudp_dense_train", False):
                    logger.info(
                        f"[PNUDP_DENSE_TRAIN_CONFIG] "
                        f"enable_pnudp_dense_train=True | "
                        f"fusion_mode={getattr(args, 'pnudp_dense_fusion_mode', 'logit_add')} | "
                        f"project_mode={getattr(args, 'pnudp_dense_project_mode', 'zero_conv')} | "
                        f"alpha_init={getattr(args, 'pnudp_dense_alpha_init', 0.0)} | "
                        f"lr={getattr(args, 'pnudp_dense_lr', 1e-4)} | "
                        f"loss_weight={getattr(args, 'pnudp_dense_loss_weight', 1.0)} | "
                        f"freeze_backbone={getattr(args, 'freeze_backbone_for_pnudp_dense', True)} | "
                        f"train_only={getattr(args, 'train_pnudp_dense_only', True)}"
                    )
        else:
            raw_model = TextSam(
                image_encoder=built_model.image_encoder,
                prompt_encoder=built_model.prompt_encoder,
                mask_decoder=built_model.mask_decoder,
                clip_model_name=args.clip_model,
                num_organs=args.num_organs,
                num_heads=args.num_heads,
                sg_epsilon=0.05,
                sg_iters=3,
                use_pnurl=True if args.phase in ("pnurl_warmup", "semantic_injection") else args.use_pnurl,
                use_coop=True if args.phase == "semantic_injection" else args.use_coop,
                use_ot=False,
                use_asr=args.use_asr,
                asr_variant=args.asr_variant,
                asr_regression=args.asr_regression,
                max_semantic_gate=args.max_semantic_gate,
                max_delta_ratio=args.max_delta_ratio,
                init_delta_ratio=args.init_delta_ratio,
                enable_conch_text_encoder=getattr(args, "enable_conch_text_encoder", True),
                # SGA-SB model structure/forward parameters (loss weights stay in train.py).
                spatial_sb_mode=str(getattr(args, "spatial_sb_mode", "none")),
                spatial_sb_branch=str(getattr(args, "spatial_sb_branch", "both")),
                spatial_structure_guidance_init=float(getattr(args, "spatial_structure_guidance_init", 0.05)),
                spatial_boundary_guidance_init=float(getattr(args, "spatial_boundary_guidance_init", 0.05)),
                spatial_instance_attr_mode=str(getattr(args, "spatial_instance_attr_mode", "none")),
                # --- PromptNu-lite v2 ---
                enable_promptnu_lite_align=bool(getattr(args, "enable_promptnu_lite_align", False)),
                promptnu_lite_target=str(getattr(args, "promptnu_lite_target", "semantic_delta")),
                promptnu_lite_struct_weight=float(getattr(args, "promptnu_lite_struct_weight", 0.0)),
                promptnu_lite_boundary_weight=float(getattr(args, "promptnu_lite_boundary_weight", 0.0)),
                promptnu_lite_instance_weight=float(getattr(args, "promptnu_lite_instance_weight", 0.0)),
                promptnu_lite_detach_text=bool(getattr(args, "promptnu_lite_detach_text", True)),
                promptnu_lite_detach_visual=bool(getattr(args, "promptnu_lite_detach_visual", False)),
                promptnu_lite_proj_lr_mult=float(getattr(args, "promptnu_lite_proj_lr_mult", 0.5)),
                promptnu_lite_pool_mode=str(getattr(args, "promptnu_lite_pool_mode", "gap")),
                # --- PNuDP Dense Training (Stage D) ---
                enable_pnudp_dense_train=bool(getattr(args, "enable_pnudp_dense_train", False)),
                pnudp_dense_alpha_init=float(getattr(args, "pnudp_dense_alpha_init", 0.0)),
                pnudp_dense_apply_in_eval=bool(getattr(args, "pnudp_dense_apply_in_eval", False)),
            ).to(args.device)

            # ── PromptNu-lite v2: Config Audit ──────────────────────────
            _pnl_enabled = bool(getattr(args, "enable_promptnu_lite_align", False))
            _pnl_struct_w = float(getattr(args, "promptnu_lite_struct_weight", 0.0))
            _pnl_boundary_w = float(getattr(args, "promptnu_lite_boundary_weight", 0.0))
            _pnl_instance_w = float(getattr(args, "promptnu_lite_instance_weight", 0.0))
            _pnl_target = str(getattr(args, "promptnu_lite_target", "semantic_delta"))
            _pnl_phase = str(getattr(args, "phase", "unknown"))
            _pnl_use_pnurl = raw_model.use_pnurl if hasattr(raw_model, "use_pnurl") else "?"
            _pnl_aa = raw_model.enable_attr_text_alignment if hasattr(raw_model, "enable_attr_text_alignment") else "?"
            _pnl_flag_use_pnurl = bool(_pnl_use_pnurl) if isinstance(_pnl_use_pnurl, bool) else False
            _pnl_flag_aa = bool(_pnl_aa) if isinstance(_pnl_aa, bool) else False
            _pnl_condition_met = (
                _pnl_enabled
                and _pnl_flag_use_pnurl
                and _pnl_flag_aa
                and (_pnl_struct_w > 0.0 or _pnl_boundary_w > 0.0)
            )
            logger.info(
                f"[PROMPTNU_LITE_CONFIG] "
                f"enabled={_pnl_enabled} "
                f"phase={_pnl_phase} "
                f"target={_pnl_target} "
                f"struct_weight={_pnl_struct_w} "
                f"boundary_weight={_pnl_boundary_w} "
                f"instance_weight={_pnl_instance_w} "
                f"use_pnurl={_pnl_use_pnurl} "
                f"enable_attr_text_alignment={_pnl_aa} "
                f"condition_met={_pnl_condition_met} | "
                f"If condition_met=False, PromptNu-lite v2 forward is SILENTLY SKIPPED. "
                f"Check that struct_weight>0 or boundary_weight>0, "
                f"use_pnurl=True, enable_attr_text_alignment=True, and phase=semantic_injection."
            )

            # ── Inject logger for PromptNu-lite v2 audit (log file output) ──
            if hasattr(raw_model, "set_pnurl_lite_logger") and _pnl_enabled:
                raw_model.set_pnurl_lite_logger(logger)

            del built_model

        load_sam_checkpoint_with_asr_mapping(raw_model, args=args, logger=logger, rank=rank)

        if args.encoder_adapter:
            for n, p in raw_model.image_encoder.named_parameters():
                if "Adapter" in n and "weight" in n:
                    torch.nn.init.zeros_(p)

        # ── Phase C: strict resume pre-validation ──
        _phase_c_resume = args.phase == "semantic_alignment"
        if _phase_c_resume and args.resume:
            if not os.path.exists(args.resume):
                raise RuntimeError(
                    f"[PHASE_C_RESUME_ERROR] --resume path does not exist: {args.resume}. "
                    "Phase C (semantic_alignment) requires a valid Phase B checkpoint to initialize "
                    "multilevel_attr_heads weights. Please verify --resume points to a Phase B checkpoint "
                    "(e.g., best_multilevel_attr_model.pth)."
                )
# ── Phase D: resume audit (from Phase C checkpoint) ──
        _phase_d_resume = args.phase == "semantic_injection"

# ── PNuDP Dense Train: resume flag (from Phase C checkpoint) ──
        _pnudp_dense_resume = args.phase == "pnudp_dense_train"


        if args.resume and os.path.exists(args.resume):
            if rank == 0:
                logger.info(f"Loading model weights from: {args.resume}")
            try:
                checkpoint = torch.load(args.resume, map_location="cpu", weights_only=False)

                # ── Extract state_dict from checkpoint (support multiple formats) ──
                if isinstance(checkpoint, dict):
                    # Priority: model_state_dict > model > state_dict > fallback to whole checkpoint
                    if "model_state_dict" in checkpoint:
                        state_dict = checkpoint["model_state_dict"]
                    elif "model" in checkpoint:
                        state_dict = checkpoint["model"]
                    elif "state_dict" in checkpoint:
                        state_dict = checkpoint["state_dict"]
                    else:
                        state_dict = checkpoint  # fallback: use whole checkpoint as state_dict
                else:
                    state_dict = checkpoint

                # ── Strip common DDP/serialization prefixes from checkpoint keys ──
                _prefixes_to_strip = ("module.", "model.", "raw_model.")
                _stripped_count = 0
                if isinstance(state_dict, dict):
                    _new_sd = {}
                    for _k, _v in state_dict.items():
                        _stripped = _k
                        for _p in _prefixes_to_strip:
                            if _stripped.startswith(_p):
                                _stripped = _stripped[len(_p):]
                                _stripped_count += 1
                                break  # strip only one prefix
                        _new_sd[_stripped] = _v
                    state_dict = _new_sd
                if _stripped_count > 0 and rank == 0:
                    logger.info(f"[RESUME_PREFIX] Stripped {_stripped_count} keys with prefixes {_prefixes_to_strip}")

                state_dict = resize_pos_embed(state_dict, raw_model.state_dict())

                ckpt_phase = checkpoint.get("phase", "unknown") if isinstance(checkpoint, dict) else "unknown"
                skip_prefixes = ()
                # When entering PNuRL-v3 from a visual baseline or old checkpoint, keep visual weights
                # but reinitialize PNuRL-v3 to avoid incompatible or stale attribute-head weights.
                auto_skip_pnurl = (
                    args.phase in ("pnurl_warmup", "multilevel_attr_warmup", "semantic_injection", "semantic_alignment", "pnudp_dense_train")
                    and str(ckpt_phase).lower() not in ("pnurl_warmup", "multilevel_attr_warmup", "semantic_injection", "semantic_alignment", "pnudp_dense_train")
                )
                if getattr(args, "resume_skip_pnurl", False) or auto_skip_pnurl:
                    skip_prefixes = ("pnurl.",)

                # ── Handle text_bank buffer shape mismatches (CONCHLESS/CLIP mode) ──
                # The model registers _structure/boundary_text_bank_buffer as torch.zeros(0),
                # but the checkpoint may have them as [5,3,512] / [4,3,512]. Re-register with
                # correct checkpoint shape before filtering to avoid them being skipped.
                _model_sd_for_buf = raw_model.state_dict()
                for _buf_name in ("_structure_text_bank_buffer", "_boundary_text_bank_buffer"):
                    if _buf_name in state_dict and _buf_name in _model_sd_for_buf:
                        _ckpt_shape = state_dict[_buf_name].shape
                        _mdl_shape = _model_sd_for_buf[_buf_name].shape
                        if _ckpt_shape != _mdl_shape:
                            if rank == 0:
                                logger.info(f"[TEXT_BANK_RESIZE:train] {_buf_name}: model={_mdl_shape} → checkpoint={_ckpt_shape}")
                            raw_model.register_buffer(_buf_name, torch.zeros(_ckpt_shape, device=args.device), persistent=True)

                filtered_state_dict, filter_stats, mismatch_examples = filter_checkpoint_state_dict_for_model(
                    state_dict=state_dict,
                    model_state_dict=raw_model.state_dict(),
                    skip_prefixes=skip_prefixes,
                    filter_mismatch=getattr(args, "resume_filter_mismatch", True),
                )

                missing_keys, unexpected_keys = raw_model.load_state_dict(filtered_state_dict, strict=False)
                _log_sga_sb_resume_audit(
                    raw_model, state_dict, missing_keys, unexpected_keys,
                    args=args, logger=logger, rank=rank,
                )

                if rank == 0:
                    logger.info("Model weights loaded with mismatch-safe filtering. Newly added modules remain initialized by current code.")
                    logger.info(
                        "Resume filter stats: "
                        f"loaded={filter_stats['loaded']} | "
                        f"skipped_prefix={filter_stats['skipped_prefix']} | "
                        f"skipped_mismatch={filter_stats['skipped_mismatch']} | "
                        f"skipped_missing={filter_stats['skipped_missing']} | "
                        f"skip_prefixes={skip_prefixes}"
                    )
                    if mismatch_examples:
                        for key, src_shape, dst_shape in mismatch_examples[:10]:
                            logger.info(f"  skipped mismatch: {key} ckpt={src_shape} model={dst_shape}")
                    logger.info(f"Missing keys: {len(missing_keys)} | Unexpected keys: {len(unexpected_keys)}")
                    old_arch = checkpoint.get("architecture_version", "unknown") if isinstance(checkpoint, dict) else "unknown"
                    logger.info(f"Checkpoint architecture_version: {old_arch}")
                    if isinstance(checkpoint, dict):
                        logger.info(
                            f"Checkpoint phase={checkpoint.get('phase', 'unknown')} | "
                            f"asr_variant={checkpoint.get('asr_variant', 'unknown')} | "
                            f"asr_regression={checkpoint.get('asr_regression', 'unknown')}"
                        )

                # ── Phase C: attribute-head audit & validation ──
                if _phase_c_resume and rank == 0:
                    ckpt_keys = set(state_dict.keys())
                    ml_keys_in_ckpt = [k for k in ckpt_keys if k.startswith("multilevel_attr_heads.")]
                    sb_keys_in_ckpt = [k for k in ckpt_keys if k.startswith("structure_boundary_attr_heads.")]

                    if not ml_keys_in_ckpt:
                        logger.warning(
                            "[PHASE_C_RESUME_WARNING] Checkpoint contains zero 'multilevel_attr_heads.*' keys. "
                            "Phase C attr_align projection heads will read from randomly initialized multilevel_attr_heads. "
                            "Verify --resume points to a Phase B checkpoint that was saved with --enable_multilevel_attr_heads."
                        )
                    # Legacy structure_boundary_attr_heads: downgrade to info, only warn if multilevel_attr_heads also empty
                    if not sb_keys_in_ckpt:
                        if ml_keys_in_ckpt:
                            logger.info(
                                "[PHASE_C_RESUME_INFO] checkpoint has no legacy structure_boundary_attr_heads keys; "
                                "using multilevel_attr_heads if available."
                            )
                        else:
                            logger.warning(
                                "[PHASE_C_RESUME_WARNING] Checkpoint contains neither 'multilevel_attr_heads.*' "
                                "nor legacy 'structure_boundary_attr_heads.*' keys. "
                                "Structure/boundary visual feature extraction may be affected. "
                                "Verify --resume points to a valid Phase B checkpoint."
                            )

                    # Count how many multilevel_attr_heads keys were actually loaded (survived filtering)
                    loaded_ml_keys = [k for k in filtered_state_dict if k.startswith("multilevel_attr_heads.")]
                    model_ml_keys = [k for k in raw_model.state_dict().keys() if k.startswith("multilevel_attr_heads.")]
                    logger.info(
                        f"[PHASE_C_RESUME_AUDIT] multilevel_attr_heads loaded={len(loaded_ml_keys)}/{len(model_ml_keys)}"
                    )

                    if len(loaded_ml_keys) == 0 and len(model_ml_keys) > 0:
                        raise RuntimeError(
                            "[PHASE_C_RESUME_ERROR] multilevel_attr_heads loaded 0 keys from checkpoint. "
                            "Phase C (semantic_alignment) cannot start from completely randomly initialized "
                            "attribute heads. Check that --resume points to a Phase B checkpoint saved with "
                            f"--enable_multilevel_attr_heads. Current --resume={args.resume}"
                        )

                    # Phase C attr_align resume audit (newly initialized if checkpoint lacks them)
                    _aa_keys_in_ckpt = [k for k in ckpt_keys if k.startswith("attr_align_")]
                    _aa_model_keys = [k for k in raw_model.state_dict().keys() if k.startswith("attr_align_")]
                    _aa_loaded_keys = [k for k in filtered_state_dict if k.startswith("attr_align_")]
                    _aa_newly_init = max(0, len(_aa_model_keys) - len(_aa_loaded_keys))
                    logger.info(
                        f"[PHASE_C_RESUME_AUDIT] attr_align loaded={len(_aa_loaded_keys)}/{len(_aa_model_keys)} | "
                        f"newly_initialized={_aa_newly_init}"
                    )

                # ── Phase D: resume audit (when resuming from Phase C checkpoint) ──
                if _phase_d_resume:
                    _d_ckpt_phase = checkpoint.get("phase", "unknown") if isinstance(checkpoint, dict) else "unknown"

                    # ── Loaded keys from checkpoint ──
                    _d_ml_loaded = [k for k in filtered_state_dict if k.startswith("multilevel_attr_heads.")]
                    _d_aa_loaded = [k for k in filtered_state_dict if k.startswith("attr_align_")]

                    # ── Expected keys: must be based on model's ACTUAL parameter names,
                    #    NOT on requires_grad / freeze / optimizer group state.
                    #    Use named_parameters() as primary source (robust across PyTorch versions).
                    #    Fall back to state_dict() keys for safety.
                    _d_ml_named = [k for k, _ in raw_model.named_parameters() if k.startswith("multilevel_attr_heads.")]
                    _d_aa_named = [k for k, _ in raw_model.named_parameters() if k.startswith("attr_align_")]
                    _d_ml_sd = [k for k in raw_model.state_dict().keys() if k.startswith("multilevel_attr_heads.")]
                    _d_aa_sd = [k for k in raw_model.state_dict().keys() if k.startswith("attr_align_")]
                    # Use the larger count (handles edge cases where one set may be missing entries)
                    _d_ml_total = max(len(_d_ml_named), len(_d_ml_sd))
                    _d_aa_total = max(len(_d_aa_named), len(_d_aa_sd))

                    _d_ml_ok = len(_d_ml_loaded) == _d_ml_total
                    _d_aa_ok = len(_d_aa_loaded) == _d_aa_total

                    # ── Config flags for audit context ──
                    _d_enable_aa = bool(getattr(args, "enable_attr_text_alignment", False))
                    _d_enable_pnl = bool(getattr(args, "enable_promptnu_lite_align", False))

                    # ── Phase D resume audit summary (always show for error context) ──
                    audit.logger_debug(logger, rank,
                        f"[PHASE_D_RESUME_AUDIT] checkpoint_phase={_d_ckpt_phase} | "
                        f"multilevel_attr_heads loaded={len(_d_ml_loaded)}/{_d_ml_total} | "
                        f"attr_align loaded={len(_d_aa_loaded)}/{_d_aa_total}"
                    )

                    # ── Hard check: require attr_align expected > 0 when enable_attr_text_alignment=True ──
                    if _d_aa_total == 0 and _d_enable_aa:
                        raise RuntimeError(
                            f"[PHASE_D_RESUME_AUDIT_ERROR] attr_align expected keys is 0, "
                            f"check audit key matching logic. "
                            f"enable_attr_text_alignment={_d_enable_aa} | "
                            f"enable_promptnu_lite_align={_d_enable_pnl} | "
                            f"attr_align loaded from ckpt={len(_d_aa_loaded)} | "
                            f"attr_align model named_params={len(_d_aa_named)} | "
                            f"attr_align model state_dict={len(_d_aa_sd)}. "
                            f"Verify that TextSam was built with enable_attr_text_alignment=True."
                        )

                    if not (_d_ml_ok and _d_aa_ok):
                        raise RuntimeError(
                            f"[PHASE_D_RESUME_ERROR] semantic_injection requires "
                            f"multilevel_attr_heads loaded={_d_ml_total}/{_d_ml_total} and "
                            f"attr_align loaded={_d_aa_total}/{_d_aa_total}. "
                            f"Got multilevel_attr_heads={len(_d_ml_loaded)}/{_d_ml_total} and "
                            f"attr_align={len(_d_aa_loaded)}/{_d_aa_total}. "
                            f"Check that --resume points to a Phase C checkpoint saved with "
                            f"the updated save_phase_c_checkpoint() that includes 'model_state_dict'. "
                            f"Current --resume={args.resume}"
                        )

                    # ── Phase D resume audit detail (rank0 only, debug) ──
                    audit.logger_debug(logger, rank,
                        "[PHASE_D_RESUME_AUDIT_DETAIL] "
                        f"attr_align_expected={len(_d_aa_named)} loaded={len(_d_aa_loaded)} | "
                        f"enable_attr_text_alignment={_d_enable_aa} | "
                        f"enable_promptnu_lite_align={_d_enable_pnl}"
                    )

                    # Freeze attr_align in Phase D (all ranks: must freeze before DDP wrapping)
                    # When PromptNu-lite v2 is enabled, keep projection heads trainable.
                    _freeze_aa = not _d_enable_pnl
                    _aa_names = (
                        "attr_align_vis_proj_structure",
                        "attr_align_vis_proj_boundary",
                        "attr_align_vis_proj_instance",
                        "attr_align_text_proj",
                    )
                    if _freeze_aa:
                        for _name in _aa_names:
                            _mod = getattr(raw_model, _name, None)
                            if _mod is not None:
                                set_requires_grad(_mod, False)
                                audit.logger_debug(logger, rank,
                                    f"[PHASE_D_RESUME_AUDIT] frozen {_name} (attr_align not trainable in Phase D)"
                                )
                    else:
                        audit.logger_debug(logger, rank,
                            "[PHASE_D_RESUME_AUDIT] attr_align kept trainable "
                            "(enable_promptnu_lite_align=True)"
                        )

                # ── PNuDP Dense Train: resume audit ──
                if _pnudp_dense_resume:
                    _pnudp_loaded = [k for k in filtered_state_dict if k.startswith("pnudp_dense_train.")]
                    _pnudp_model_keys = [k for k in raw_model.state_dict().keys() if k.startswith("pnudp_dense_train.")]
                    audit.logger_debug(logger, rank,
                        f"[PNUDP_DENSE_TRAIN_RESUME_AUDIT] "
                        f"pnudp_dense_train loaded={len(_pnudp_loaded)}/{len(_pnudp_model_keys)} keys | "
                        f"pnudp_dense_train module will be newly initialized (not present in Phase C checkpoint) | "
                        f"enable_pnudp_dense_train={getattr(args, 'enable_pnudp_dense_train', False)} | "
                        f"pnudp_dense_alpha_init={getattr(args, 'pnudp_dense_alpha_init', 0.0)}"
                    )

            except RuntimeError:
                raise  # Re-raise Phase C RuntimeErrors; do not swallow
            except Exception as e:
                if rank == 0:
                    logger.warning(f"Resume failed: {e}")
                    logger.warning("Training will continue with currently initialized weights. This is not recommended for clean experiments.")

        # ── FreqPath modulator reinit for numeric guidance / semantic injection ──
        # After checkpoint resume, PhaseB checkpoints overwrite the small_normal init
        # of FreqPathASRBlock.attr_modulator[-1] / morphology_modulator[-1] with
        # zero weights. Reinit them here (before optimizer creation) so they start
        # with small non-zero values. Triggered by either:
        #   --reinit_freqpath_modulators_for_numeric_guidance (Exp5)
        #   --reinit_freqpath_modulators_for_semantic_injection (Exp6)
        _reinit_freqpath_modulators = (
            args.phase == "semantic_injection"
            and (
                getattr(args, "reinit_freqpath_modulators_for_numeric_guidance", False)
                or getattr(args, "reinit_freqpath_modulators_for_semantic_injection", False)
            )
        )
        if _reinit_freqpath_modulators:
            _reinit_std = args.freqpath_modulator_reinit_std
            _trigger_source = (
                "numeric_guidance_flag"
                if getattr(args, "reinit_freqpath_modulators_for_numeric_guidance", False)
                else "semantic_injection_flag"
            )

            # ── Collect matching modules ──
            _freqpath_modules = []
            for _mod in raw_model.modules():
                if hasattr(_mod, "attr_modulator") and hasattr(_mod, "morphology_modulator"):
                    _freqpath_modules.append(_mod)

            # ── FREQPATH_MODULATOR_POST_RESUME_AUDIT (before reinit) ──
            if rank == 0:
                for _mod in _freqpath_modules:
                    _mod_name = str(type(_mod).__name__)
                    _before_attr_w = _mod.attr_modulator[-1].weight.detach().float().norm().item()
                    _before_morph_w = _mod.morphology_modulator[-1].weight.detach().float().norm().item()
                    _before_attr_b = _mod.attr_modulator[-1].bias.detach().float().norm().item()
                    _before_morph_b = _mod.morphology_modulator[-1].bias.detach().float().norm().item()
                    print(
                        f"\n[FREQPATH_MODULATOR_POST_RESUME_AUDIT]\n"
                        f"  module_name={_mod_name}\n"
                        f"  phase={args.phase}\n"
                        f"  trigger_source={_trigger_source}\n"
                        f"  enable_numeric_attr_freqpath_guidance={getattr(args, 'enable_numeric_attr_freqpath_guidance', False)}\n"
                        f"  enable_promptnu_guided_v3={getattr(args, 'enable_promptnu_guided_v3', False)}\n"
                        f"  use_pnurl={getattr(args, 'use_pnurl', False)}\n"
                        f"  enable_conch_text_encoder={getattr(args, 'enable_conch_text_encoder', False)}\n"
                        f"  before_attr_last_weight_norm={_before_attr_w:.8f}\n"
                        f"  before_morph_last_weight_norm={_before_morph_w:.8f}\n"
                        f"  before_attr_last_bias_norm={_before_attr_b:.8f}\n"
                        f"  before_morph_last_bias_norm={_before_morph_b:.8f}",
                        flush=True,
                    )

            # ── Perform reinit ──
            for _mod in _freqpath_modules:
                nn.init.normal_(_mod.attr_modulator[-1].weight, mean=0.0, std=_reinit_std)
                nn.init.zeros_(_mod.attr_modulator[-1].bias)
                nn.init.normal_(_mod.morphology_modulator[-1].weight, mean=0.0, std=_reinit_std)
                nn.init.zeros_(_mod.morphology_modulator[-1].bias)

            # ── FREQPATH_MODULATOR_REINIT_AUDIT (after reinit) ──
            if rank == 0:
                print(
                    f"\n[FREQPATH_MODULATOR_REINIT_AUDIT]\n"
                    f"  enabled=True\n"
                    f"  std={_reinit_std}\n"
                    f"  phase={args.phase}\n"
                    f"  trigger_source={_trigger_source}\n"
                    f"  enable_numeric_attr_freqpath_guidance={getattr(args, 'enable_numeric_attr_freqpath_guidance', False)}\n"
                    f"  enable_promptnu_guided_v3={getattr(args, 'enable_promptnu_guided_v3', False)}\n"
                    f"  use_pnurl={getattr(args, 'use_pnurl', False)}\n"
                    f"  enable_conch_text_encoder={getattr(args, 'enable_conch_text_encoder', False)}\n"
                    f"  num_modules={len(_freqpath_modules)}",
                    flush=True,
                )
                for _mod in _freqpath_modules:
                    _mod_name = str(type(_mod).__name__)
                    _after_attr_w = _mod.attr_modulator[-1].weight.detach().float().norm().item()
                    _after_morph_w = _mod.morphology_modulator[-1].weight.detach().float().norm().item()
                    _after_attr_b = _mod.attr_modulator[-1].bias.detach().float().norm().item()
                    _after_morph_b = _mod.morphology_modulator[-1].bias.detach().float().norm().item()
                    print(
                        f"  module_name={_mod_name}\n"
                        f"  after_attr_last_weight_norm={_after_attr_w:.8f}\n"
                        f"  after_morph_last_weight_norm={_after_morph_w:.8f}\n"
                        f"  after_attr_last_bias_norm={_after_attr_b:.8f}\n"
                        f"  after_morph_last_bias_norm={_after_morph_b:.8f}",
                        flush=True,
                    )
        configure_pnurl_class_counts(raw_model, args=args, logger=logger, rank=rank, phase=args.phase)

        apply_stage_policy(raw_model, args.phase, args=args, logger=logger, rank=rank)

        # ── Phase D semantic gate config log (rank0 only) ──
        # expected_initial_gate_mean = sigmoid(open_value) * max_semantic_gate
        # With defaults: sigmoid(-3.0) ≈ 4.742587e-02
        #                expected_initial_gate_mean ≈ 4.742587e-02 * 1.000000e-01 ≈ 4.742587e-03
        if args.phase == "semantic_injection":
            audit.print_basic(
                f"[SEMANTIC_GATE_CONFIG] open_value={args.semantic_gate_open_value} | "
                f"max_semantic_gate={args.max_semantic_gate}",
                rank=rank,
            )

        # ── Semantic Guidance Config Audit ──
        if rank == 0:
            logger.info(
                f"[SEMANTIC_GUIDANCE_CONFIG] "
                f"enable_conch_text_encoder={getattr(args, 'enable_conch_text_encoder', False)} | "
                f"enable_attr_text_alignment={getattr(args, 'enable_attr_text_alignment', False)} | "
                f"enable_promptnu_guided_v3={getattr(args, 'enable_promptnu_guided_v3', False)} | "
                f"promptnu_guided_v3_use_text_bank={getattr(args, 'promptnu_guided_v3_use_text_bank', False)} | "
                f"enable_promptnu_lite_align={getattr(args, 'enable_promptnu_lite_align', False)} | "
                f"enable_pnudp_dense_train={getattr(args, 'enable_pnudp_dense_train', False)}"
            )

        if world_size > 1:
            debug_trainable_signature(raw_model, rank=rank, logger=logger if rank == 0 else None, tag="after_stage_policy")
            assert_same_trainable_across_ranks(
                raw_model,
                device=args.device,
                logger=logger if rank == 0 else None,
                tag="after_stage_policy",
            )
            dist.barrier()

        optimizer = build_optimizer_by_stage(raw_model, args.phase, args=args, logger=logger, rank=rank, audit=audit)

        # ── Phase B: print per-submodule param count for multilevel_attr_heads ──
        if is_phase_b_multilevel and rank == 0 and logger is not None:
            _ml_heads = getattr(raw_model, "multilevel_attr_heads", None)
            if _ml_heads is not None:
                for _sub_name in ("patch_structure_head", "dense_boundary_head", "instance_morph_head"):
                    _sub_mod = getattr(_ml_heads, _sub_name, None)
                    if _sub_mod is not None:
                        _n_trainable = sum(p.numel() for p in _sub_mod.parameters() if p.requires_grad)
                        _n_total = sum(p.numel() for p in _sub_mod.parameters())
                        logger.info(
                            f"[PHASE_B_PARAM_AUDIT] {_sub_name}: "
                            f"trainable_params={_n_trainable:,} / total_params={_n_total:,}"
                        )

        if world_size > 1:
            model = DDP(
                raw_model,
                device_ids=[local_rank],
                output_device=local_rank,
                find_unused_parameters=args.ddp_find_unused_parameters,
            )
        else:
            model = raw_model

        criterion = FocalDiceloss_IoULoss(weight=20.0, iou_scale=1.0, ignore_index=255)

        if args.use_amp:
            try:
                scaler = GradScaler("cuda")
            except TypeError:
                scaler = GradScaler()
        else:
            scaler = None

        warmup_epochs = min(args.warmup_epochs, max(args.epochs, 1))
        if warmup_epochs > 0:
            warmup_scheduler = LinearLR(optimizer, start_factor=0.01, total_iters=warmup_epochs)
            cosine_scheduler = CosineAnnealingLR(
                optimizer,
                T_max=max(1, args.epochs - warmup_epochs),
                eta_min=getattr(args, "min_lr", 1e-6),
            )
            scheduler = SequentialLR(
                optimizer,
                schedulers=[warmup_scheduler, cosine_scheduler],
                milestones=[warmup_epochs],
            )
        else:
            scheduler = CosineAnnealingLR(optimizer, T_max=max(1, args.epochs), eta_min=args.min_lr)

        best_aji = 0.0
        best_dice = 0.0
        best_pq = 0.0

        # ── Phase B / Phase C: separate best-metrics trackers ───────────
        phase_b_best_metrics = init_phase_b_best_metrics()
        phase_c_best_metrics = {
            "val_align_loss": float("inf"),
            "val_s_sim": float("-inf"),
            "val_b_sim": float("-inf"),
            "val_i_sim": float("-inf"),
        }

        # Parse Phase B loss weights from comma-separated string
        phase_b_loss_weights = None
        if args.phase_b_loss_weights is not None:
            try:
                parts = [float(x.strip()) for x in args.phase_b_loss_weights.split(",")]
                if len(parts) == 4:
                    phase_b_loss_weights = {
                        "structure_attr": parts[0],
                        "boundary_attr": parts[1],
                        "dense_boundary": parts[2],
                        "instance_attr": parts[3],
                    }
                else:
                    if rank == 0 and logger is not None:
                        logger.warning(
                            f"[PHASE_B] --phase_b_loss_weights expects 4 comma-separated values, "
                            f"got {len(parts)}. Using default equal weights."
                        )
            except ValueError as e:
                if rank == 0 and logger is not None:
                    logger.warning(
                        f"[PHASE_B] Failed to parse --phase_b_loss_weights: {e}. Using default equal weights."
                    )

        for epoch in range(args.start_epoch, args.epochs):
            if train_sampler:
                train_sampler.set_epoch(epoch)
            if val_sampler:
                val_sampler.set_epoch(epoch)

            # ────────────────────────────────────────────────────────────
            # Phase C: semantic alignment (decoupled train / val / ckpt)
            # ────────────────────────────────────────────────────────────
            if is_phase_c_alignment:
                train_stats = train_one_epoch_semantic_alignment(
                    model=model,
                    data_loader=train_loader,
                    optimizer=optimizer,
                    device=args.device,
                    epoch=epoch,
                    args=args,
                    logger=logger,
                    writer=writer,
                    rank=rank,
                )

                val_res = validate_one_epoch_semantic_alignment(
                    model=model,
                    data_loader=val_loader,
                    device=args.device,
                    epoch=epoch,
                    args=args,
                    logger=logger,
                    writer=writer,
                    rank=rank,
                )

                phase_c_best_metrics, updated = update_phase_c_best_metrics(
                    val_res, phase_c_best_metrics
                )

                save_phase_c_checkpoint_if_needed(
                    model=model,
                    epoch=epoch,
                    args=args,
                    val_res=val_res,
                    best_metrics=phase_c_best_metrics,
                    updated=updated,
                    logger=logger,
                    rank=rank,
                )

                run_phase_c_sanity_checks(
                    val_res, phase_c_best_metrics, args, logger=logger
                )

                if rank == 0:
                    _v_align = float(val_res.get("val_align_loss", float("nan")))
                    _v_ssim = float(val_res.get("val_s_sim", float("nan")))
                    _v_bsim = float(val_res.get("val_b_sim", float("nan")))
                    _v_isim = float(val_res.get("val_i_sim", float("nan")))
                    _v_tn = float(val_res.get("val_text_norm_mean", float("nan")))
                    _v_vn = float(val_res.get("val_visual_norm_mean", float("nan")))
                    _v_inst = int(val_res.get("valid_instance_count", 0))

                    logger.info(
                        f"Ep {epoch + 1}/{args.epochs} | Stage: {args.phase} | "
                        f"TrainAlignLoss={train_stats.get('attr_text_align_loss', float('nan')):.6f} | "
                        f"ValAlignLoss={_v_align:.6f} | "
                        f"SSim={_v_ssim:.4f} | BSim={_v_bsim:.4f} | ISim={_v_isim:.4f} | "
                        f"TN={_v_tn:.4f} | VN={_v_vn:.4f} | ValidInst={_v_inst} | "
                        f"BestAlignLoss={phase_c_best_metrics['val_align_loss']:.6f}"
                    )

            # ────────────────────────────────────────────────────────────
            # Phase D: semantic injection — segmentation training + semantic gate
            # Uses existing segmentation train_one_epoch / validate_one_epoch
            # with Phase D checkpoint naming and diagnostics.
            # ────────────────────────────────────────────────────────────
            elif is_phase_d_injection:
                train_stats = train_one_epoch(
                    args=args,
                    model=model,
                    optimizer=optimizer,
                    train_loader=train_loader,
                    epoch=epoch,
                    criterion=criterion,
                    scaler=scaler,
                    writer=writer,
                    rank=rank,
                )

                val_res = validate_one_epoch(
                    args=args,
                    model=model,
                    val_loader=val_loader,
                    epoch=epoch,
                    writer=writer,
                    rank=rank,
                )

                if rank == 0:
                    dice = float(val_res.get("dice", 0.0))
                    aji = float(val_res.get("mAJI", 0.0))
                    pq = float(val_res.get("mPQ", 0.0))

                    # PromptNu-lite v2 epoch breakdown (canonical keys)
                    _pl_struct = train_stats.get('promptnu_lite_struct_loss', float('nan'))
                    _pl_bound = train_stats.get('promptnu_lite_boundary_loss', float('nan'))
                    _pl_sim_s = train_stats.get('promptnu_lite_struct_sim', float('nan'))
                    _pl_sim_b = train_stats.get('promptnu_lite_boundary_sim', float('nan'))
                    # PromptNu-guided v3.1 epoch breakdown (canonical keys)
                    _v3_struct_loss = train_stats.get('v3_struct_loss', float('nan'))
                    _v3_bound_loss = train_stats.get('v3_bound_loss', float('nan'))
                    _v3_sim_s = train_stats.get('v3_s_sim', float('nan'))
                    _v3_sim_b = train_stats.get('v3_b_sim', float('nan'))
                    _v3_scale_std = train_stats.get('v3_text_scale_std', float('nan'))
                    _v3_delta_ratio = train_stats.get('v3_guided_delta_ratio', float('nan'))

                    logger.info(
                        f"Ep {epoch + 1}/{args.epochs} | Stage: {args.phase} | "
                        f"Loss: {train_stats['total']:.4f} "
                        f"(M:{train_stats['mask']:.3f}, H:{train_stats['heatmap']:.3f}, "
                        f"HV:{train_stats['hv']:.3f}, P:{train_stats['pnurl']:.3f}, "
                        f"PL:{train_stats['promptnu_lite_align_loss']:.6f}, "
                        f"PLStruct:{_pl_struct:.6f} PLBound:{_pl_bound:.6f} "
                        f"PLSimS:{_pl_sim_s:.4f} PLSimB:{_pl_sim_b:.4f} | "
                        f"PG3:{train_stats['promptnu_guided_v3_align_loss']:.6f} "
                        f"PG3Struct:{_v3_struct_loss:.6f} PG3Bound:{_v3_bound_loss:.6f} "
                        f"PG3SimS:{_v3_sim_s:.4f} PG3SimB:{_v3_sim_b:.4f} "
                        f"PG3ScaleStd:{_v3_scale_std:.6f} PG3DeltaRatio:{_v3_delta_ratio:.6f} | "
                        f"D:{train_stats['density']:.3f}, "
                        f"SBStructLoss:{train_stats['spatial_structure']:.6f}, "
                        f"SBBoundLoss:{train_stats['spatial_boundary']:.6f}, "
                        f"SBLoss:{train_stats['spatial_sb']:.6f}, "
                        f"Sd:{train_stats['semantic_stability']:.6e}, "
                        f"InjP:{train_stats['injection_penalty']:.6e}) | "
                        f"AttrAcc({_format_attr_acc(train_stats)}) | "
                        f"AttrLoss({_format_attr_loss(train_stats)}) | "
                        f"GateMean:{train_stats['semantic_channel_gate_mean']:.6e} | "
                        f"GateMin:{train_stats['semantic_channel_gate_min']:.6e} | "
                        f"GateMax:{train_stats['semantic_channel_gate_max']:.6e} | "
                        f"DeltaNorm:{train_stats['semantic_delta_norm']:.6e} | "
                        f"BaseNorm:{train_stats['base_feat_norm']:.6e} | "
                        f"InjectedNorm:{train_stats['injected_delta_norm']:.6e} | "
                        f"InjRatio:{train_stats['injection_ratio']:.6e} | "
                        f"DeltaRatio:{train_stats['semantic_delta_ratio']:.6e} | "
                        f"Dice:{dice:.4f} | AJI:{aji:.4f} | PQ:{pq:.4f}"
                    )

                    # ── Phase D checkpoint: latest + best-by-metric ──
                    checkpoint_dict = {
                        "epoch": epoch,
                        "model": unwrap_model(model).state_dict(),
                        "optimizer": optimizer.state_dict(),
                        "scheduler": scheduler.state_dict(),
                        "scaler": scaler.state_dict() if scaler else None,
                        "best_aji": best_aji,
                        "best_dice": best_dice,
                        "phase": args.phase,
                        "architecture_version": args.architecture_version,
                        "asr_variant": args.asr_variant,
                        "asr_regression": args.asr_regression,
                        "asr_regression_stage": args.asr_regression_stage,
                        "args": vars(args),
                    }

                    model_dir = os.path.join(args.work_dir, "models", args.run_name)
                    # Always save latest
                    latest_d_path = os.path.join(model_dir, "latest_semantic_injection_model.pth")
                    torch.save(checkpoint_dict, latest_d_path)

                    # Best AJI
                    if aji > best_aji:
                        best_aji = aji
                        best_dice = max(best_dice, dice)
                        checkpoint_dict["best_aji"] = best_aji
                        checkpoint_dict["best_dice"] = best_dice
                        best_aji_path = os.path.join(model_dir, "best_aji_model.pth")
                        torch.save(checkpoint_dict, best_aji_path)
                        logger.info(f"[PHASE_D_CKPT] New Best AJI: {best_aji:.4f}. Saved best_aji_model.pth")

                    # Best Dice
                    if dice > best_dice:
                        best_dice = dice
                        checkpoint_dict["best_dice"] = best_dice
                        best_dice_path = os.path.join(model_dir, "best_dice_model.pth")
                        torch.save(checkpoint_dict, best_dice_path)
                        logger.info(f"[PHASE_D_CKPT] New Best Dice: {dice:.4f}. Saved best_dice_model.pth")

                    # Best PQ
                    if pq > best_pq:
                        best_pq = pq
                        checkpoint_dict["best_pq"] = best_pq
                        best_pq_path = os.path.join(model_dir, "best_pq_model.pth")
                        torch.save(checkpoint_dict, best_pq_path)
                        logger.info(f"[PHASE_D_CKPT] New Best PQ: {pq:.4f}. Saved best_pq_model.pth")

            # ────────────────────────────────────────────────────────────
            # PNuDP Dense Training (Stage D): segmentation with pnudp_dense fusion
            # Uses existing train_one_epoch / validate_one_epoch with custom checkpoint naming.
            # ────────────────────────────────────────────────────────────
            elif is_pnudp_dense_train:
                train_stats = train_one_epoch(
                    args=args,
                    model=model,
                    optimizer=optimizer,
                    train_loader=train_loader,
                    epoch=epoch,
                    criterion=criterion,
                    scaler=scaler,
                    writer=writer,
                    rank=rank,
                )

                val_res = validate_one_epoch(
                    args=args,
                    model=model,
                    val_loader=val_loader,
                    epoch=epoch,
                    writer=writer,
                    rank=rank,
                )

                if rank == 0:
                    dice = float(val_res.get("dice", 0.0))
                    aji = float(val_res.get("mAJI", 0.0))
                    pq = float(val_res.get("mPQ", 0.0))

                    logger.info(
                        f"[TRAIN_SUMMARY] Ep {epoch + 1}/{args.epochs} | Stage: {args.phase} | "
                        f"Loss: {train_stats['total']:.4f} "
                        f"(M:{train_stats['mask']:.3f}, H:{train_stats['heatmap']:.3f}, "
                        f"HV:{train_stats['hv']:.3f}, P:{train_stats['pnurl']:.3f}, "
                        f"D:{train_stats['density']:.3f}, "
                        f"Sd:{train_stats['semantic_stability']:.6e}, "
                        f"InjP:{train_stats['injection_penalty']:.6e})"
                    )
                    logger.info(
                        f"[VAL_SUMMARY] Ep {epoch + 1}/{args.epochs} | Stage: {args.phase} | "
                        f"AttrAcc({_format_attr_acc(train_stats)}) | "
                        f"AttrLoss({_format_attr_loss(train_stats)}) | "
                        f"GateMean:{train_stats['semantic_channel_gate_mean']:.6e} | "
                        f"GateMin:{train_stats['semantic_channel_gate_min']:.6e} | "
                        f"GateMax:{train_stats['semantic_channel_gate_max']:.6e} | "
                        f"DeltaNorm:{train_stats['semantic_delta_norm']:.6e} | "
                        f"BaseNorm:{train_stats['base_feat_norm']:.6e} | "
                        f"InjectedNorm:{train_stats['injected_delta_norm']:.6e} | "
                        f"InjRatio:{train_stats['injection_ratio']:.6e} | "
                        f"DeltaRatio:{train_stats['semantic_delta_ratio']:.6e} | "
                        f"Dice:{dice:.4f} | AJI:{aji:.4f} | PQ:{pq:.4f}"
                    )

                    # ── PNuDP Dense Train checkpoint: latest + best-by-metric ──
                    checkpoint_dict = {
                        "epoch": epoch,
                        "model": unwrap_model(model).state_dict(),
                        "optimizer": optimizer.state_dict(),
                        "scheduler": scheduler.state_dict(),
                        "scaler": scaler.state_dict() if scaler else None,
                        "best_aji": best_aji,
                        "best_dice": best_dice,
                        "phase": args.phase,
                        "architecture_version": args.architecture_version,
                        "asr_variant": args.asr_variant,
                        "asr_regression": args.asr_regression,
                        "asr_regression_stage": args.asr_regression_stage,
                        "args": vars(args),
                    }

                    model_dir = os.path.join(args.work_dir, "models", args.run_name)
                    # Always save latest
                    latest_pnudp_path = os.path.join(model_dir, "latest_pnudp_dense_train_model.pth")
                    torch.save(checkpoint_dict, latest_pnudp_path)

                    # Best AJI
                    if aji > best_aji:
                        best_aji = aji
                        best_dice = max(best_dice, dice)
                        checkpoint_dict["best_aji"] = best_aji
                        checkpoint_dict["best_dice"] = best_dice
                        best_aji_path = os.path.join(model_dir, "best_aji_model.pth")
                        torch.save(checkpoint_dict, best_aji_path)
                        logger.info(f"[BEST_CKPT] New Best AJI: {best_aji:.4f}. Saved best_aji_model.pth")

                    # Best Dice
                    if dice > best_dice:
                        best_dice = dice
                        checkpoint_dict["best_dice"] = best_dice
                        best_dice_path = os.path.join(model_dir, "best_dice_model.pth")
                        torch.save(checkpoint_dict, best_dice_path)
                        logger.info(f"[BEST_CKPT] New Best Dice: {dice:.4f}. Saved best_dice_model.pth")

                    # Best PQ
                    if pq > best_pq:
                        best_pq = pq
                        checkpoint_dict["best_pq"] = best_pq
                        best_pq_path = os.path.join(model_dir, "best_pq_model.pth")
                        torch.save(checkpoint_dict, best_pq_path)
                        logger.info(f"[BEST_CKPT] New Best PQ: {pq:.4f}. Saved best_pq_model.pth")

            # ────────────────────────────────────────────────────────────
            # Phase B: Multilevel Attribute Warmup (decoupled train / val / ckpt)
            # ────────────────────────────────────────────────────────────
            elif is_phase_b_multilevel:
                train_stats = train_one_epoch_multilevel_attr(
                    model=model,
                    data_loader=train_loader,
                    optimizer=optimizer,
                    device=args.device,
                    epoch=epoch,
                    args=args,
                    logger=logger,
                    writer=writer,
                    rank=rank,
                    loss_weights=phase_b_loss_weights,
                )

                val_res = validate_one_epoch_multilevel_attr(
                    model=model,
                    data_loader=val_loader,
                    device=args.device,
                    epoch=epoch,
                    args=args,
                    logger=logger,
                    writer=writer,
                    rank=rank,
                )

                phase_b_best_metrics, updated = update_phase_b_best_metrics(
                    val_res, phase_b_best_metrics
                )

                save_phase_b_checkpoint_if_needed(
                    model=model,
                    epoch=epoch,
                    args=args,
                    val_stats=val_res,
                    best_metrics=phase_b_best_metrics,
                    updated=updated,
                    logger=logger,
                    rank=rank,
                )

                if rank == 0:
                    _s_loss = float(val_res.get("val_structure_attr_loss", float("nan")))
                    _b_loss = float(val_res.get("val_boundary_attr_loss", float("nan")))
                    _i_loss = float(val_res.get("val_instance_attr_loss", float("nan")))
                    _comp = float(val_res.get("val_composite_score", float("nan")))

                    # Aggregate training metrics
                    _t_mlsa = train_stats.get("MLStructAcc", float("nan"))
                    _t_mlba = train_stats.get("MLBoundaryAcc", float("nan"))
                    _t_inst = train_stats.get("InstanceAcc", float("nan"))
                    _t_dbf1 = train_stats.get("DenseBoundaryF1", float("nan"))
                    _t_combo = train_stats.get("AttrComboScore", float("nan"))
                    # Aggregate validation metrics
                    _v_mlsa = val_res.get("val_MLStructAcc", float("nan"))
                    _v_mlba = val_res.get("val_MLBoundaryAcc", float("nan"))
                    _v_inst = val_res.get("val_InstanceAcc", float("nan"))
                    _v_dbf1 = val_res.get("val_DenseBoundaryF1", float("nan"))
                    _v_combo = val_res.get("val_AttrComboScore", float("nan"))

                    logger.info(
                        f"Ep {epoch + 1}/{args.epochs} | Stage: {args.phase} | "
                        f"TrainStructLoss={train_stats.get('structure_attr_loss', float('nan')):.6f} | "
                        f"TrainBoundLoss={train_stats.get('boundary_attr_loss', float('nan')):.6f} | "
                        f"TrainInstLoss={train_stats.get('instance_attr_loss', float('nan')):.6f} | "
                        f"ValStructLoss={_s_loss:.6f} | ValBoundLoss={_b_loss:.6f} | ValInstLoss={_i_loss:.6f} | "
                        f"ValComposite={_comp:.6f} | "
                        f"BestComposite={phase_b_best_metrics.get('val_composite_score', float('-inf')):.6f} | "
                        f"T_MLSAcc={_t_mlsa:.4f} | T_MLBAcc={_t_mlba:.4f} | T_InstAcc={_t_inst:.4f} | "
                        f"T_DBF1={_t_dbf1:.4f} | T_Combo={_t_combo:.4f} | "
                        f"V_MLSAcc={_v_mlsa:.4f} | V_MLBAcc={_v_mlba:.4f} | V_InstAcc={_v_inst:.4f} | "
                        f"V_DBF1={_v_dbf1:.4f} | V_Combo={_v_combo:.4f}"
                    )

            # ────────────────────────────────────────────────────────────
            # Phase A / B (legacy): standard segmentation training
            # ────────────────────────────────────────────────────────────
            else:
                train_stats = train_one_epoch(
                    args=args,
                    model=model,
                    optimizer=optimizer,
                    train_loader=train_loader,
                    epoch=epoch,
                    criterion=criterion,
                    scaler=scaler,
                    writer=writer,
                    rank=rank,
                )

                val_res = validate_one_epoch(
                    args=args,
                    model=model,
                    val_loader=val_loader,
                    epoch=epoch,
                    writer=writer,
                    rank=rank,
                )

                if rank == 0:
                    dice = float(val_res.get("dice", 0.0))
                    iou = float(val_res.get("iou", 0.0))
                    aji = float(val_res.get("mAJI", 0.0))
                    pq = float(val_res.get("mPQ", 0.0))

                    if os.environ.get("SGA_SB_P3_MODE", "0") != "1":
                        logger.info(
                            f"Ep {epoch + 1}/{args.epochs} | Stage: {args.phase} | "
                            f"ASR:{args.asr_variant}/{args.asr_regression_stage if args.asr_regression else 'normal'} | "
                            f"Loss: {train_stats['total']:.4f} "
                            f"(M:{train_stats['mask']:.3f}, H:{train_stats['heatmap']:.3f}, "
                            f"HV:{train_stats['hv']:.3f}, P:{train_stats['pnurl']:.3f}, D:{train_stats['density']:.3f}, "
                            f"S:{train_stats['semantic_stability']:.4f}) | "
                            f"AttrAcc({_format_attr_acc(train_stats)}) | "
                            f"AttrLoss({_format_attr_loss(train_stats)}) | "
                            f"GateMean:{train_stats['semantic_channel_gate_mean']:.6e} | "
                            f"DeltaNorm:{train_stats['semantic_delta_norm']:.6e} | "
                            f"BaseNorm:{train_stats['base_feat_norm']:.6e} | "
                            f"InjectedNorm:{train_stats['injected_delta_norm']:.6e} | "
                            f"InjRatio:{train_stats['injection_ratio']:.6e} | "
                            f"DeltaRatio:{train_stats['semantic_delta_ratio']:.6e} | "
                            f"Dice:{dice:.4f} | AJI:{aji:.4f} | PQ:{pq:.4f}"
                        )

                    checkpoint_dict = {
                        "epoch": epoch,
                        "model": unwrap_model(model).state_dict(),
                        "optimizer": optimizer.state_dict(),
                        "scheduler": scheduler.state_dict(),
                        "scaler": scaler.state_dict() if scaler else None,
                        "best_aji": best_aji,
                        "best_dice": best_dice,
                        "phase": args.phase,
                        "architecture_version": args.architecture_version,
                        "asr_variant": args.asr_variant,
                        "asr_regression": args.asr_regression,
                        "asr_regression_stage": args.asr_regression_stage,
                        "args": vars(args),
                    }

                    latest_model_path = os.path.join(args.work_dir, "models", args.run_name, "latest_model.pth")
                    torch.save(checkpoint_dict, latest_model_path)

                    if os.environ.get("SGA_SB_P3_MODE", "0") == "1":
                        _record = {
                            "epoch": epoch + 1,
                            "learning_rate": float(optimizer.param_groups[0]["lr"]),
                            "segmentation_loss": float(train_stats["total"] - train_stats["spatial_sb"]),
                            "SBStructLoss": float(train_stats["spatial_structure"]),
                            "SBBoundLoss": float(train_stats["spatial_boundary"]),
                            "SBLoss": float(train_stats["spatial_sb"]),
                            "structure_probability_mean": float(train_stats["spatial_structure_prob_mean"]),
                            "structure_probability_std": float(train_stats["spatial_structure_prob_std"]),
                            "boundary_probability_mean": float(train_stats["spatial_boundary_prob_mean"]),
                            "boundary_probability_std": float(train_stats["spatial_boundary_prob_std"]),
                            "structure_delta_norm": float(train_stats["spatial_structure_delta_norm"]),
                            "boundary_delta_norm": float(train_stats["spatial_boundary_delta_norm"]),
                            "structure_injected_ratio": float(train_stats["spatial_structure_injected_ratio"]),
                            "boundary_injected_ratio": float(train_stats["spatial_boundary_injected_ratio"]),
                            "gamma_structure": float(train_stats["gamma_structure_value"]),
                            "gamma_boundary": float(train_stats["gamma_boundary_value"]),
                            "active_adapter_gradient_norm": float(train_stats["spatial_adapter_grad_norm"]),
                            "active_head_gradient_norm": float(train_stats["spatial_head_grad_norm"]),
                            "Dice": dice, "IoU": iou, "mAJI": aji, "mPQ": pq,
                        }
                        _history_path = os.path.join(args.work_dir, "models", args.run_name, "metrics_history.json")
                        _history = []
                        if os.path.isfile(_history_path):
                            with open(_history_path, "r", encoding="utf-8") as _f:
                                _history = json.load(_f)
                        _history = [item for item in _history if int(item.get("epoch", -1)) != epoch + 1]
                        _history.append(_record)
                        _history.sort(key=lambda item: int(item["epoch"]))
                        _history_tmp = _history_path + ".tmp"
                        with open(_history_tmp, "w", encoding="utf-8") as _f:
                            json.dump(_history, _f, indent=2, allow_nan=True)
                        os.replace(_history_tmp, _history_path)
                        logger.info(
                            "[P3_EPOCH_SUMMARY] "
                            f"epoch={epoch + 1} learning_rate={_record['learning_rate']:.6e} "
                            f"segmentation_loss={_record['segmentation_loss']:.6f} "
                            f"SBStructLoss={_record['SBStructLoss']:.6f} SBBoundLoss={_record['SBBoundLoss']:.6f} "
                            f"SBLoss={_record['SBLoss']:.6f} StructDeltaNorm={_record['structure_delta_norm']:.6e} "
                            f"BoundDeltaNorm={_record['boundary_delta_norm']:.6e} "
                            f"StructInjRatio={_record['structure_injected_ratio']:.6e} "
                            f"BoundInjRatio={_record['boundary_injected_ratio']:.6e} "
                            f"GammaStruct={_record['gamma_structure']:.6f} GammaBound={_record['gamma_boundary']:.6f} "
                            f"Dice={dice:.6f} IoU={iou:.6f} mAJI={aji:.6f} mPQ={pq:.6f}"
                        )
                        if epoch + 1 == 5:
                            torch.save(
                                checkpoint_dict,
                                os.path.join(args.work_dir, "models", args.run_name, "epoch_005_model.pth"),
                            )

                    if aji > best_aji:
                        best_aji = aji
                        best_dice = max(best_dice, dice)
                        checkpoint_dict["best_aji"] = best_aji
                        checkpoint_dict["best_dice"] = best_dice
                        best_model_path = os.path.join(args.work_dir, "models", args.run_name, "best_model.pth")
                        torch.save(checkpoint_dict, best_model_path)
                        logger.info(f"New Best AJI: {best_aji:.4f}. Model saved.")

            if dist.is_initialized():
                dist.barrier()

            scheduler.step()

        if rank == 0:
            logger.info(f"Training finished. Best AJI: {best_aji:.4f}")
            if writer is not None:
                writer.close()

    except Exception as e:
        if rank == 0 and logger is not None:
            logger.error("\n" + "=" * 50)
            logger.error(f"Fatal training error: {str(e)}")
            logger.error(f"Traceback:\n{traceback.format_exc()}")
            logger.error("=" * 50 + "\n")
        raise e
    finally:
        if rank == 0 and writer is not None:
            writer.close()
        if dist.is_initialized():
            dist.destroy_process_group()


if __name__ == "__main__":
    args = parse_args()
    main(args)
