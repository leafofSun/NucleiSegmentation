#!/usr/bin/env python3
"""Two-real-batch SGA-SB graph/update audit.

This is an audit driver, not a training entry point. It deliberately reuses the
project's training parser, dataset/collate, model/checkpoint builder, stage
policy, optimizer builder, segmentation helpers, and SGA-SB target/loss code.
"""

from __future__ import annotations

import argparse
import contextlib
import csv
import gc
import hashlib
import json
import logging
import math
import os
from pathlib import Path
import random
import sys
import traceback
from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple


# When invoked as ``python tools/audit_sga_sb_p2.py``, Python otherwise places
# only ``tools/`` on sys.path and cannot resolve the formal root-level train.py.
PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))


DEFAULT_CHECKPOINT = "workdir/models/Visual_baseline/best_model.pth"
EXPECTED_CHECKPOINT_SHA256 = "7321ee6652c53469d77e2e1af8c9d57e6772936ad12a2cea6a437c8421264f9c"
EXPECTED_LEGACY_CLIP_KEY_COUNT = 641
EXPECTED_LEGACY_PROMPT_LEARNER_KEYS = frozenset({
    "prompt_learner.ctx_general",
    "prompt_learner.ctx_specific",
    "prompt_learner.physical_adapter.adapter_low.0.weight",
    "prompt_learner.physical_adapter.adapter_low.0.bias",
    "prompt_learner.physical_adapter.adapter_low.2.weight",
    "prompt_learner.physical_adapter.adapter_low.2.bias",
    "prompt_learner.physical_adapter.adapter_high.0.weight",
    "prompt_learner.physical_adapter.adapter_high.0.bias",
    "prompt_learner.physical_adapter.adapter_high.2.weight",
    "prompt_learner.physical_adapter.adapter_high.2.bias",
})
EXPECTED_LEGACY_SEMANTIC_KEY_COUNT = 651
KEY_AUDIT_ROOT = Path("workdir/audits/sga_sb_p2_20260713")
SGA_PREFIXES = (
    "spatial_structure_head.",
    "spatial_boundary_head.",
    "spatial_structure_adapter.",
    "spatial_boundary_adapter.",
    "gamma_structure",
    "gamma_boundary",
